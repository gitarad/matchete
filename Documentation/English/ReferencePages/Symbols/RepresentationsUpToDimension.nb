Cell["\<\
For instance, the entry {6, {2, 0}} is a representation of dimension 6 with \
Dynkin coefficients {2, 0}. This is the two-index symmetric representation of \
SU(3). \
\>", "ExampleText",
 CellID->676452047,ExpressionUUID->"eba717c4-0c7d-4c96-8345-fb90135c71c2"]
}, Dynamic[CurrentValue[
 EvaluationNotebook[], {TaggingRules, "Openers", "ExampleSection", "0"}, 
