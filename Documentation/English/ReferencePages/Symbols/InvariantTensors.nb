Cell[TextData[{
 "An invariant tensor between three fundamental representations of SU(3)/",
 Cell[BoxData[
  SubscriptBox["A", "2"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "839d30f0-24fb-4687-976e-818661bc6b28"],
 " (note the use of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SU"]], "paclet:Matchete/ref/SU", "Matchete Package Symbol"},
