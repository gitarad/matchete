Cell[TextData[{
 "The invariant tensors are invariant when contracted with objects in of \
given representations. In other words, the indices of the produced tensors \
are {",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CRep"]], "paclet:Matchete/ref/CRep", 
     "Matchete Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   SubscriptBox[
    StyleBox["rep", "TI"], 
    StyleBox["1", "TR"]], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c5fc00bd-ac23-4fde-86f9-a065b2bdef04"],
 ", ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CRep"]], "paclet:Matchete/ref/CRep", 
     "Matchete Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   SubscriptBox[
    StyleBox["rep", "TI"], 
    StyleBox["2", "TR"]], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d4b27bcf-0769-44b2-a7d0-8de2b4478710"],
 ", \[Ellipsis]}."
}], "Notes",
 CellID->308265943,ExpressionUUID->"2b01a792-1349-438e-a530-7f4be7ea39ed"],

