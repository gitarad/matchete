Cell[TextData[{
 "In the product of an anti-fundamental, a fundamental, and two adjoint \
representations of SU(3), there is is a two-dimensional space of invariant \
tensors that are symmetric in the two adjoint indices. Typical basis vectors \
are  ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox["T", "cj", "i"], 
   SubscriptBox["d", "cab"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "659afb8b-bae4-460f-86bf-3879c2ec9709"],
 " and ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox["\[Delta]", "j", "i"], 
   SubscriptBox["\[Delta]", "ab"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "93e82905-18f3-412f-85bc-b70afc1ab320"],
 ". Note that the tensor generation does not now about this way of writing \
the basis "
}], "ExampleText",
 CellID->1077445782,ExpressionUUID->"e04231c3-02f5-49f5-a87b-fd7aeab2413d"],

