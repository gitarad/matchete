Cell["\<\
The only such tensor is proportional to the rank-3 Levi-Civita tensor, though \
the default normalization differs.\
\>", "ExampleText",
 CellID->1890146487,ExpressionUUID->"45a6f287-7c0e-4c79-91d8-2cf34a5efd84"]
}, Dynamic[CurrentValue[
 EvaluationNotebook[], {TaggingRules, "Openers", "ExampleSection", "0"}, 
  Closed]]]],

