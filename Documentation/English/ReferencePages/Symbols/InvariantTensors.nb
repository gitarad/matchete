Cell[TextData[{
 "In the product of an anti-fundamental, a fundamental, and two adjoint \
representations of SU(3), there is a single invariant tensor that is \
antisymmetric in the two adjoint indices. It is proportional to ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox["T", "cj", "i"], 
   SubscriptBox["f", "cab"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "553c23e2-9ac9-4a8b-bbe1-80c3faeb773f"],
 ":"
}], "ExampleText",
 CellID->2003339974,ExpressionUUID->"c3499d44-6056-41c6-a0e2-d1ed460264f7"],

