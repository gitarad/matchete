 RowBox[{"InvariantTensors", "[", 
  RowBox[{
   RowBox[{"SU", "[", "3", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"CRep", "@", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}], ",", " ", 
   RowBox[{"AntisymmetricIndices", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1850801849,ExpressionUUID->"7d12f952-6b10-42d5-bf0a-9c3aae2fc3c9"],

