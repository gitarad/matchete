Cell["Manually define the fundamental representation:", "ExampleText",
 CellID->969361223,ExpressionUUID->"d50e6a41-f7d6-492e-a751-0b4d08a63a9c"],

Cell[BoxData[
 RowBox[{"DefineRepresentation", "[", 
  RowBox[{"fund", ",", " ", "G", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"IndexAlphabet", "\[Rule]", " ", 
    RowBox[{"CharacterRange", "[", 
     RowBox[{
     "\"\<\[DoubleStruckA]\>\"", ",", " ", "\"\<\[DoubleStruckF]\>\""}], 
     "]"}]}]}], "]"}]], "Input",
