Cell["Loading the Standard Model:", "ExampleText",
 CellID->139001274,ExpressionUUID->"cc67ca05-3766-487f-9384-3e13838832e7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LSM", "=", 
   RowBox[{"LoadModel", "[", "\"\<SM\>\"", "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1687144654,ExpressionUUID->"8370ffe1-2620-419b-a5dd-06c79ad8ecb9"],

Cell[TextData[{
 "Defining two heavy BSM fields: a flavored Majorana fermion \[Chi] and a \
colored scalar \[Phi] with Hypercharge ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox["1", "3"]}]],ExpressionUUID->
  "b8d980fe-b69b-487d-b24f-843c7ef84a8b"],
 ":"
}], "ExampleText",
 CellID->1293820617,ExpressionUUID->"4db7da96-7115-49b1-bc2c-cb62d36a239b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefineField", "[", 
   RowBox[{"\[Chi]", ",", "Fermion", ",", "\n", "\t", 
    RowBox[{"SelfConjugate", "->", "True"}], ",", "\n", "\t", 
    RowBox[{"Indices", "->", 
     RowBox[{"{", "Flavor", "}"}]}], ",", "\n", "\t", 
    RowBox[{"Charges", "->", 
     RowBox[{"{", "}"}]}], ",", "\n", "\t", 
    RowBox[{"Mass", "->", 
     RowBox[{"{", 
      RowBox[{"Heavy", ",", "m\[Chi]", ",", 
       RowBox[{"{", "Flavor", "}"}]}], "}"}]}], ",", "\n", "\t", 
    RowBox[{"NiceForm", "->", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\[Chi]\>\"", ",", 
       "\"\<\!\(\*SubscriptBox[\(m\), \(\[Chi]\)]\)\>\""}], "}"}]}]}], "\n", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefineField", "[", 
   RowBox[{"\[Phi]", ",", "Scalar", ",", "\n", "\t", 
    RowBox[{"SelfConjugate", "->", "False"}], ",", "\n", "\t", 
    RowBox[{"Indices", " ", "->", 
     RowBox[{"{", 
      RowBox[{"SU3c", "[", "fund", "]"}], "}"}]}], ",", "\n", "\t", 
    RowBox[{"Charges", "->", 
     RowBox[{"{", 
      RowBox[{"U1Y", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "3"}], "]"}], "}"}]}], ",", "\n", "\t", 
    RowBox[{"Mass", " ", "->", 
     RowBox[{"{", 
      RowBox[{"Heavy", ",", "m\[Phi]"}], "}"}]}], ",", "\n", "\t", 
    RowBox[{"NiceForm", "->", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\[Phi]\>\"", ",", 
       "\"\<\!\(\*SubscriptBox[\(m\), \(\[Phi]\)]\)\>\""}], "}"}]}]}], "\n", 
   "]"}], ";"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->38362390,ExpressionUUID->"3fa2ecb6-5047-4607-b1f6-13a5b72d9005"],

Cell["Define a Yukawa coupling:", "ExampleText",
 CellID->2039749167,ExpressionUUID->"d67dbfe3-16a7-4d22-94c2-c6f9ccf4eae3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DefineCoupling", "[", 
   RowBox[{"\[Kappa]", ",", "\n", "\t", 
    RowBox[{"Indices", "->", 
     RowBox[{"{", 
      RowBox[{"Flavor", ",", "Flavor"}], "}"}]}], ",", "\n", "\t", 
    RowBox[{"SelfConjugate", "->", "False"}]}], "\n", "]"}], ";"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->678556610,ExpressionUUID->"4ea8f294-21cb-4003-8ea7-9baf66edc599"],

Cell["Define the BSM Lagrangian:", "ExampleText",
 CellID->1006889885,ExpressionUUID->"126e45be-e748-4393-90af-bf2dae69ec80"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"LNP", "=", 
   RowBox[{
    RowBox[{"FreeLag", "[", 
     RowBox[{"\[Chi]", ",", "\[Phi]"}], "]"}], " ", "+", " ", 
    RowBox[{"PlusHc", "[", 
     RowBox[{
      RowBox[{"\[Kappa]", "[", 
       RowBox[{"p", ",", "r"}], "]"}], "*", 
      RowBox[{
       RowBox[{"Bar", "[", 
        RowBox[{"d", "[", 
         RowBox[{"a", ",", "p"}], "]"}], "]"}], "**", 
       RowBox[{"\[Chi]", "[", "r", "]"}]}], "*", 
      RowBox[{"\[Phi]", "[", "a", "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"LNP", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[4]:=",
 CellID->7324576,ExpressionUUID->"649810bb-3bf3-46bb-9fea-000efbbff69b"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SubscriptBox["D", "\[Mu]"], 
      SubscriptBox[
       OverscriptBox["\[Phi]", 
        StyleBox["_", FontWeight -> Bold]], 
       StyleBox["a", FontSize -> 10]]},
     "RowDefault"], 
    TemplateBox[{
      SubscriptBox["D", "\[Mu]"], 
      SuperscriptBox["\[Phi]", 
       StyleBox["a", FontSize -> 10]]},
     "RowDefault"]}], "-", 
   RowBox[{
    SuperscriptBox[
     SubscriptBox["M", "\[Phi]"], "2"], 
    SubscriptBox[
     OverscriptBox["\[Phi]", 
      StyleBox["_",
       FontWeight->Bold]], 
     StyleBox["a",
      FontSize->10]], 
    SuperscriptBox["\[Phi]", 
     StyleBox["a",
      FontSize->10]]}], "+", 
   RowBox[{
    FractionBox["\[ImaginaryI]", "2"], 
    FormBox[
     StyleBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         SuperscriptBox["\[Chi]", 
          StyleBox["p",
           FontSize->10]], "T"], "\[CenterDot]", 
        RowBox[{"C", 
         SubscriptBox["\[Gamma]", 
          StyleBox["\[Mu]",
           FontSize->10]]}], "\[CenterDot]", 
        TemplateBox[{
          SubscriptBox["D", "\[Mu]"], 
          SuperscriptBox["\[Chi]", 
           StyleBox["p", FontSize -> 10]]},
         "RowDefault"]}], ")"}],
      SpanSymmetric->False],
     StandardForm]}], "-", 
   RowBox[{
    FractionBox["1", "2"], 
    SuperscriptBox[
     SubscriptBox["M", "\[Chi]"], 
     StyleBox["p",
      FontSize->10]], 
    FormBox[
     StyleBox[
      RowBox[{"(", 
       SuperscriptBox[
        SuperscriptBox["\[Chi]", 
         StyleBox["p",
          FontSize->10]], "T"], "\[CenterDot]", "C", "\[CenterDot]", 
       SuperscriptBox["\[Chi]", 
        StyleBox["p",
         FontSize->10]], ")"}],
      SpanSymmetric->False],
     StandardForm]}], "+", 
   RowBox[{
    SuperscriptBox["\[Kappa]", 
     StyleBox[
      TemplateBox[{"p", "r"},
       "RowDefault"],
      FontSize->10]], 
    SuperscriptBox["\[Phi]", 
     StyleBox["a",
      FontSize->10]], 
    FormBox[
     StyleBox[
      RowBox[{"(", 
       SubsuperscriptBox[
        OverscriptBox["d", 
         StyleBox["_",
          FontWeight->Bold]], 
        StyleBox["a",
         FontSize->10], 
        StyleBox["p",
         FontSize->10]], "\[CenterDot]", 
       SubscriptBox["P", "L"], "\[CenterDot]", 
       SuperscriptBox["\[Chi]", 
        StyleBox["r",
         FontSize->10]], ")"}],
      SpanSymmetric->False],
     StandardForm]}], "+", 
   RowBox[{
    SuperscriptBox[
     OverscriptBox["\[Kappa]", 
      StyleBox["_",
       FontWeight->Bold]], 
     StyleBox[
      TemplateBox[{"p", "r"},
       "RowDefault"],
      FontSize->10]], 
    SubscriptBox[
     OverscriptBox["\[Phi]", 
      StyleBox["_",
       FontWeight->Bold]], 
     StyleBox["a",
      FontSize->10]], 
    FormBox[
     StyleBox[
      RowBox[{"(", 
       SuperscriptBox[
        SuperscriptBox["\[Chi]", 
         StyleBox["r",
          FontSize->10]], "T"], "\[CenterDot]", 
       RowBox[{"C", 
        SubscriptBox["P", "R"]}], "\[CenterDot]", 
       SuperscriptBox["d", 
        StyleBox[
         TemplateBox[{"a", "p"},
          "RowDefault"],
         FontSize->10]], ")"}],
      SpanSymmetric->False],
     StandardForm]}]}], "StandardForm"]], "Output",
 CellLabel->"Out[4]//NiceForm=",
 CellID->294632815,ExpressionUUID->"9727142a-e758-46a2-966e-401f269499d9"]
}, Open  ]],

