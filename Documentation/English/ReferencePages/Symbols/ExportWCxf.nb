Cell[TextData[{
 "Generating the WCxf file ",
 StyleBox["\"WCxf-directory/ParamPoint_1.json\"", "InlineCode"],
 " from the EFT Lagrangian LEFT using the numerical input provided in the ",
 StyleBox["\"WCxf-input.json\"", "InlineCode"],
 " file:"
}], "ExampleText",
 CellID->249669210,ExpressionUUID->"51af8200-59d1-420b-b190-455506fa3872"],

Cell[BoxData[
 RowBox[{"ExportWCxf", "[", 
  RowBox[{
  "LEFT", ",", "\"\<WCxf-input.json\>\"", ",", "\"\<WCxf-directory\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->2139083662,ExpressionUUID->"5d57dfc3-72db-43e9-bfbd-d49e6e7cdc5c"],

Cell["\<\
Alternatively one can also first derive the matching conditions manually and \
pass these to the export function:\
\>", "ExampleText",
 CellID->1926796515,ExpressionUUID->"a90ee621-75c2-4e7a-aff3-e281c072e650"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mc", "=", 
   RowBox[{"MapEffectiveCouplings", "[", 
    RowBox[{"LEFT", ",", 
     RowBox[{"LoadModel", "[", "\"\<SMEFT\>\"", "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ShiftRenCouplings", "->", "True"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1776568506,ExpressionUUID->"f2ff2b03-7cb2-4035-8cfe-c6898610db3b"],

Cell[BoxData[
 RowBox[{"ExportWCxf", "[", 
  RowBox[{
  "mc", ",", "\"\<WCxf-input.json\>\"", ",", "\"\<WCxf-directory\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->174252454,ExpressionUUID->"88852975-5d45-4d00-9786-81eecf08fb16"],

Cell["\<\
Both ways produce identical WCxf files. Notice that it is required to use the \
default SMEFT model file. Models not matching onto this file are currently \
not supported.\
\>", "ExampleText",
 CellID->2038928632,ExpressionUUID->"daf7c2f4-b53c-40d2-a353-5d1963f2f81b"],

