Cell[TextData[{
 "The argument ",
 Cell[BoxData[
  StyleBox["arg", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8d346bc7-e8a9-4063-ac6e-99b302ba2015"],
 StyleBox[" ", "TI"],
 "must be either a SMEFT Lagrangian obtained by the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Match"]], "paclet:Matchete/ref/Match", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d9876689-95d5-4efd-9ffa-256d872a4f00"],
 " function, or directly a list of matching conditions obtained by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MapEffectiveCouplings"]], 
    "paclet:Matchete/ref/MapEffectiveCouplings", "Matchete Package Symbol"},
   "PackageLink",
