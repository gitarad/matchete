Cell[TextData[{
 "In some cases, particularly heavy masses, it is convenient to assume a \
diagonal structure for a coupling (meaning e.g. a mass matrix has elements \
only along the diagonal). In such cases it is convenient to use a single \
index instead of two \[Dash] it is even required for heavy masses when using ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Match"]], "paclet:Matchete/ref/Match", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5c820810-44a8-4e03-bf79-18d2dcde97b4"],
 ". Setting a flavor index to be diagonal with the ",
 Cell[BoxData["DiagonalCoupling"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "57365656-93e8-4d9a-84ff-b201c934ae30"],
 " option means that the index does not count in Einstein summation \
convention. For instance, the mass parameter"
}], "ExampleText",
 CellID->1515851332,ExpressionUUID->"ec9b90d0-1163-4410-8a36-bf6da948e4c5"],

Cell[BoxData[{
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"m", ",", " ", 
   RowBox[{"Indices", "\[Rule]", " ", "Flavor"}], ",", " ", 
   RowBox[{"DiagonalCoupling", "\[Rule]", "True"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"m", "[", "b", "]"}], " ", 
    RowBox[{"\[Lambda]", "[", 
     RowBox[{"b", ",", "c"}], "]"}]}], "//", "RelabelIndices"}], "//", 
  "NiceForm"}]}], "Input",
 CellLabel->"In[5]:=",
 CellID->2053649515,ExpressionUUID->"eb7258a4-2d50-45ff-a4f6-ed41201bdc68"],

Cell["\<\
If diagonal indices appear with two ordinary repeated indices, they are \
included in the sum and relabeled simmultaneously:\
\>", "ExampleText",
 CellID->1392735033,ExpressionUUID->"e6c67c92-7a26-41a8-89c8-6c788e8068c8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Bar", "@", " ", 
     RowBox[{"\[Lambda]", "[", 
      RowBox[{"a", ",", "b"}], "]"}]}], 
    RowBox[{"m", "[", "b", "]"}], 
    RowBox[{"\[Lambda]", "[", 
     RowBox[{"b", ",", "c"}], "]"}]}], "//", "RelabelIndices"}], "//", 
  "NiceForm"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->2066790066,ExpressionUUID->"2e0c2f9f-39d1-45b1-b524-7bbb3d4fb323"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{
    TagBox[
     FormBox["m", StandardForm], StandardForm, Editable -> True], 
    StyleBox[
     TemplateBox[{
       TagBox[
        StyleBox["\"x\"", 10, StripOnInput -> False], 
        Format[#, Matchete`NiceForm]& ]}, "RowDefault"], FontSize -> 12, 
     StripOnInput -> False]},
   "Superscript"], 
  TemplateBox[{
    TagBox[
     FormBox[
      OverscriptBox["\[Lambda]", "_"], StandardForm], StandardForm, Editable -> 
     True], 
    StyleBox[
     TemplateBox[{
       TagBox[
        StyleBox["\"a\"", 10, StripOnInput -> False], 
        Format[#, Matchete`NiceForm]& ], 
       TagBox[
        StyleBox["\"x\"", 10, StripOnInput -> False], 
        Format[#, Matchete`NiceForm]& ]}, "RowDefault"], FontSize -> 12, 
     StripOnInput -> False]},
   "Superscript"], 
  TemplateBox[{
    TagBox[
     FormBox["\[Lambda]", StandardForm], StandardForm, Editable -> True], 
    StyleBox[
     TemplateBox[{
       TagBox[
        StyleBox["\"x\"", 10, StripOnInput -> False], 
        Format[#, Matchete`NiceForm]& ], 
       TagBox[
        StyleBox["\"c\"", 10, StripOnInput -> False], 
        Format[#, Matchete`NiceForm]& ]}, "RowDefault"], FontSize -> 12, 
     StripOnInput -> False]},
   "Superscript"]}]], "Output",
 CellLabel->"Out[6]//NiceForm=",
 CellID->1566426087,ExpressionUUID->"692b1efa-ae65-472b-9390-eee8eac92d44"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Note that diagonality of coupling indices may not be stable under \
RG flow", "TI"],
 " of the theory unless it is protected by some (accidental) symmetry."
}], "ExampleText",
 CellID->486166709,ExpressionUUID->"fbbc8bab-91d7-437a-8092-cbeef1b69481"],

