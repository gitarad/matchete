Cell["\<\
The resulting association uses representation uses the Dynkin coefficients of \
the weights for its keys with multiplicities of the weights in the \
representation as values.\
\>", "Notes",
 CellID->2123714548,ExpressionUUID->"cb12caca-144e-4604-86eb-61eab80c32b2"],

Cell[TextData[{
 "The algebra argument must be a valid ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Alg"]], "paclet:Matchete/ref/Alg", "Matchete Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["class", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bb5a6271-d889-4d1d-8b7b-37cf95d61e7e"],
 " object."
}], "Notes",
 CellID->1846763481,ExpressionUUID->"bb3a7e6c-b1ac-4923-b0ff-ee58aa98a043"],

Cell["\<\
Representations are labeled with a list of integers corresponding to the \
Dynkin coefficients of the highest weight in the representation.\
\>", "Notes",
 CellID->1780800353,ExpressionUUID->"f99bdae9-fb92-4ddc-9af7-811d1c16bc3b"],

Cell["The following options can be given: ", "Notes",
 CellID->1923001920,ExpressionUUID->"a2f0855d-d84a-4e90-9f9f-af7cd80e058e"],

