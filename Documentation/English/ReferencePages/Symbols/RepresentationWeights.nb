Cell["\<\
The levels of a weight is obtain in the process of finding the weights of a \
representation by successively subtracting simple roots from the highest \
weight of the representation.\
\>", "Notes",
 CellID->60427574,ExpressionUUID->"177259e0-9611-418f-9a61-99100670d53a"]
}, Dynamic[CurrentValue[
 EvaluationNotebook[], {TaggingRules, "Openers", "NotesSection"}, Closed]]]],

