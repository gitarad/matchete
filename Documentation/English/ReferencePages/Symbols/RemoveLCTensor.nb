Cell[BoxData[GridBox[{
   {"", Cell["\<\
Get rid of Levi-Civita tensors either by combining with a Lorentz sigma to \
give a \!\(\*SubscriptBox[\(\[Gamma]\), \(5\)]\) or by expanding the product \
of two Levi-Civita tensor to give the fully antisymmetric product of metrics.\
\
\>",ExpressionUUID->"68a29ce6-b5ea-48d7-ac8a-3ca79f267a7d"]}
  }]], "Usage",
