Cell["Defining a SU(2) gauge group:", "ExampleText",
 CellID->926387710,ExpressionUUID->"c6a6fc7b-14ca-47ed-bdde-be7a791c6f98"],

Cell[BoxData[
 RowBox[{"DefineGaugeGroup", "[", 
  RowBox[{"SU2", ",", 
   RowBox[{"SU", "@", "2"}], ",", "g", ",", "F", ",", "\[IndentingNewLine]", 
   RowBox[{"FundAlphabet", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<i\>\"", ",", "\"\<j\>\"", ",", "\"\<k\>\"", ",", "\"\<l\>\""}], 
     "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AdjAlphabet", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<I\>\"", ",", "\"\<J\>\"", ",", "\"\<K\>\"", ",", "\"\<L\>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->494760235,ExpressionUUID->"f670da55-2136-47e6-8a0a-cc72a0cf64c4"],

Cell["\<\
Defining 3 fields: a fundamental scalar, an adjoint Majorana fermion, and a \
fundamental Dirac fermion:\
\>", "ExampleText",
 CellID->1048845750,ExpressionUUID->"3a3ee3e2-abcb-4740-8fcc-4e098af8f126"],

Cell[BoxData[{
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", "\[IndentingNewLine]", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", 
     RowBox[{"SU2", "@", "fund"}], "}"}]}], ",", " ", "\[IndentingNewLine]", 
   RowBox[{"Mass", "->", "Light"}]}], "\[IndentingNewLine]", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Chi]", ",", "Fermion", ",", "\[IndentingNewLine]", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", 
     RowBox[{"SU2", "@", "adj"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"SelfConjugate", "->", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Mass", "->", "Light"}]}], "\[IndentingNewLine]", "]"}], "\n", 
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Psi]", ",", "Fermion", ",", "\[IndentingNewLine]", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", 
     RowBox[{"SU2", "@", "fund"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"Mass", "->", "0"}]}], "\[IndentingNewLine]", "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->1667446653,ExpressionUUID->"ebcf7a9a-7d19-4b8c-b8aa-e24709a63845"],

Cell["Defining a Yukawa and quartic scalar coupling:", "ExampleText",
 CellID->1086477139,ExpressionUUID->"6cb467e6-4f72-4821-9159-14ffae26c174"],

Cell[BoxData[{
 RowBox[{"DefineCoupling", "[", "y", "]"}], "\n", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"\[Lambda]", ",", 
   RowBox[{"SelfConjugate", "->", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[3]:=",
 CellID->1955526469,ExpressionUUID->"112f3a8e-d406-4750-9755-38b334fcec0e"],

Cell["\<\
Defining a Lagrangian with a Yukawa interaction and a scalar quartic:\
\>", "ExampleText",
 CellID->1948856006,ExpressionUUID->"d5553557-a36e-4ade-868c-2098a233d892"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[ScriptCapitalL]int", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"PlusHc", "[", 
      RowBox[{
       RowBox[{"y", "[", "]"}], 
       RowBox[{
        RowBox[{"Bar", "@", 
         RowBox[{"\[Psi]", "[", "i", "]"}]}], "**", 
        RowBox[{"\[Chi]", "[", "J", "]"}]}], 
       RowBox[{"\[Phi]", "[", "j", "]"}], 
       RowBox[{"CG", "[", 
        RowBox[{
         RowBox[{"gen", "@", 
          RowBox[{"SU2", "[", "fund", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"J", ",", "i", ",", "j"}], "}"}]}], "]"}]}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"\[Lambda]", "[", "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Bar", "@", 
        RowBox[{"\[Phi]", "[", "i", "]"}]}], 
       RowBox[{"\[Phi]", "[", "i", "]"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Bar", "@", 
        RowBox[{"\[Phi]", "[", "j", "]"}]}], 
       RowBox[{"\[Phi]", "[", "j", "]"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{"\[ScriptCapitalL]", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"FreeLag", "[", "]"}], "+", "\[ScriptCapitalL]int"}], "//", 
    "RelabelIndices"}], "//", "NiceForm"}]}]}], "Input",
 CellLabel->"In[4]:=",
 CellID->1438085308,ExpressionUUID->"be86513c-dbc5-4ada-a6eb-8a7cb8dc16f5"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"-", 
