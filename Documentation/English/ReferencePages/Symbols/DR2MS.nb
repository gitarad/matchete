Cell[TextData[{
 "Mapping from the ",
 Cell[BoxData[
  OverscriptBox["DR", "_"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c0f72ccc-7788-4f92-8284-a46c98b5cc98"],
