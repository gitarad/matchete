Cell[TextData[{
 "The formatting of the canonical index names ",
 StyleBox["d$$1, d$$2, \[Ellipsis] ",
  FontWeight->"Bold"],
 "(as used for dummy indices under ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RelabelIndices"]], "paclet:Matchete/ref/RelabelIndices", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "58a26524-27e8-4f9e-8336-df98d7b61bb6"],
 ") can be specified with the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IndexAlphabet"]], "paclet:Matchete/ref/IndexAlphabet", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c16eba89-5d92-4c3e-a73f-ed7cd0df0fda"],
 " option. Here we have a fundamental representation of an SU(3) use \
double-struck letters:"
}], "ExampleText",
 CellID->1926787505,ExpressionUUID->"878f6f2d-7ed4-406d-b3a1-73aeb302be7a"],

