Cell[TextData[{
 "The internal representation of the charge conjugation matrix is rarely used \
directly by user; it can be more conveniently entered using the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CC"]], "paclet:Matchete/ref/CC", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a970db85-4a33-4457-84ad-f42c0198e005"],
 " short-hand."
}], "Notes",
 CellID->2038190839,ExpressionUUID->"ea0ad0d9-754a-479a-8377-815c99c7d5d9"],

Cell[TextData[{
 "Note that other Matchete manipulations assume that all Dirac matrices come \
wrapped inside the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
