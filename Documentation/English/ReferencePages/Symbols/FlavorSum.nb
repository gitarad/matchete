Cell[BoxData[
 StyleBox[
  RowBox[{" ", 
   RowBox[{
    RowBox[{
     FormBox[
      StyleBox[
       RowBox[{"(", 
        RowBox[{"-", 
         RowBox[{
          FractionBox["1", "4"], 
          FractionBox["1", 
           SuperscriptBox["g", "2"]]}], "+", 
         RowBox[{"\[HBar]", " ", 
