Cell["\<\
Special attention has to be paid when contracting flavor indices. This is \
because of certain flavor tensors, such as diagonal mass matrices, carrying \
only a single flavor index, which breaks the conventional Einstein summation \
convention. \
\>", "ExampleText",
 CellID->1957646044,ExpressionUUID->"0ef74ac1-7675-45e4-9b9c-1ae5afe3cc41"],

Cell["\<\
Consider  the following setup with a flavored scalar field, which has a \
flavor non-universal, but diagonal mass matrix:\
\>", "ExampleText",
 CellID->1335238479,ExpressionUUID->"974f9c9c-3ce7-4bc3-b0ca-86c5e216b2eb"],

Cell[BoxData[{
 RowBox[{"DefineFlavorIndex", "[", 
  RowBox[{"Flavor", ",", "nf", ",", 
   RowBox[{"IndexAlphabet", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<p\>\"", ",", "\"\<r\>\"", ",", "\"\<s\>\"", ",", "\"\<t\>\""}], 
     "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", "Flavor", "}"}]}], ",", 
   RowBox[{"Mass", "->", 
    RowBox[{"{", 
     RowBox[{"Heavy", ",", "M", ",", 
      RowBox[{"{", "Flavor", "}"}]}], "}"}]}]}], "]"}]}], "Input",
 CellProlog:>Needs["Matchete`"],
 CellLabel->"In[1]:=",
 CellID->800661792,ExpressionUUID->"3a3a47d2-15bf-46fe-bf22-2a793cc930d9"],

Cell[TextData[{
 "The following expression would be problematic if flavor deltas would \
automatically contract with each other such as gauge deltas do. In \
particular, the flavor index ",
 StyleBox["r", "TI"],
 " on the mass ",
 StyleBox["M ", "TI"],
 "would not be properly relabeled:"
}], "ExampleText",
 CellID->1202815051,ExpressionUUID->"bc1c82da-3102-4ba6-be2d-e2e07917e603"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"expr", "=", 
   RowBox[{
    RowBox[{"M", "[", "r", "]"}], 
    RowBox[{"Delta", "[", 
     RowBox[{
      RowBox[{"Index", "[", 
       RowBox[{"p", ",", "Flavor"}], "]"}], ",", 
      RowBox[{"Index", "[", 
       RowBox[{"r", ",", "Flavor"}], "]"}]}], "]"}], 
    RowBox[{"Delta", "[", 
     RowBox[{
      RowBox[{"Index", "[", 
       RowBox[{"r", ",", "Flavor"}], "]"}], ",", 
      RowBox[{"Index", "[", 
       RowBox[{"s", ",", "Flavor"}], "]"}]}], "]"}], 
    RowBox[{"Bar", "@", 
     RowBox[{"\[Phi]", "[", "p", "]"}]}], 
    RowBox[{"\[Phi]", "[", "s", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"expr", "//", "NiceForm"}]}], "Input",
 CellProlog:>Needs["Matchete`"],
 CellLabel->"In[2]:=",
 CellID->1670008608,ExpressionUUID->"347d83e2-dc56-44dc-a8f8-a4a1091f7e19"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   SuperscriptBox["M", 
    StyleBox["r",
     FontSize->10]], 
   SubscriptBox["\[Delta]", 
    StyleBox[
     TemplateBox[{"p", "r"},
      "RowDefault"],
     FontSize->10]], 
   SubscriptBox["\[Delta]", 
    StyleBox[
     TemplateBox[{"r", "s"},
      "RowDefault"],
     FontSize->10]], 
   SuperscriptBox[
    OverscriptBox["\[Phi]", 
     StyleBox["_",
      FontWeight->Bold]], 
    StyleBox["p",
     FontSize->10]], 
   SuperscriptBox["\[Phi]", 
    StyleBox["s",
     FontSize->10]]}], "StandardForm"]], "Output",
 CellLabel->"Out[2]//NiceForm=",
 CellID->2025404064,ExpressionUUID->"b8045170-333b-4978-9516-e9b4593e1e89"]
}, Open  ]],

Cell[TextData[{
 "Therefore, one has to manually use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Contract"]], "paclet:Matchete/ref/Contract", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "36634528-5ddf-4c88-a72f-665a407ea338"],
 " for flavor indices, which takes care of the proper relabeling of all \
flavor indices, including the ones on diagonal flavor tensors:"
}], "ExampleText",
 CellID->1224425320,ExpressionUUID->"697d9043-aca9-4e9e-aaf0-0a2e8688f4b2"],

Cell[CellGroupData[{

