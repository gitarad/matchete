 CellLabel->"In[1]:=",
 CellID->1751628755,ExpressionUUID->"c5ea17d5-c621-44b2-a8d8-d22520dd5076"],

Cell["Contracting expressions with one Delta:", "ExampleText",
 CellID->1628756212,ExpressionUUID->"ee5f0938-9946-4039-a549-e8b178fc9352"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"expr", "=", 
   RowBox[{
    RowBox[{"Bar", "@", 
     RowBox[{"\[Phi]", "[", "p", "]"}]}], 
    RowBox[{"\[Phi]", "[", "r", "]"}], 
    RowBox[{"Delta", "[", 
     RowBox[{
      RowBox[{"Index", "[", 
       RowBox[{"p", ",", "Flavor"}], "]"}], ",", 
      RowBox[{"Index", "[", 
       RowBox[{"r", ",", "Flavor"}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"expr", "//", "NiceForm"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Contract", "[", "expr", "]"}], "//", "NiceForm"}]}], "Input",
 CellProlog:>Needs["Matchete`"],
 CellLabel->"In[2]:=",
 CellID->1650876191,ExpressionUUID->"e4ec0ea7-630f-4476-8330-a7b87870135f"],

