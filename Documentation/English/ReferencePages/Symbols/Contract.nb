Cell["Defining a scalar field with a flavor index:", "ExampleText",
 CellID->1566025281,ExpressionUUID->"be796ac4-a3ed-4e90-bf78-09e1f6d00d0a"],

Cell[BoxData[{
 RowBox[{"DefineFlavorIndex", "[", 
  RowBox[{"Flavor", ",", "3", ",", 
   RowBox[{"IndexAlphabet", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<p\>\"", ",", "\"\<r\>\"", ",", "\"\<s\>\"", ",", "\"\<t\>\""}], 
     "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", "Flavor", "}"}]}]}], "]"}]}], "Input",
