 CellID->1251336640,ExpressionUUID->"e4dc2972-c336-4376-8055-059eb4fb1a3f"]
}, Open  ]],

Cell["\<\
Notice, however, that Contract should only be applied to full Lagrangian \
terms, but not to subexpressions. The problem can be seen with the example \
above:\
\>", "ExampleText",
 CellID->2135888189,ExpressionUUID->"e80b3e5a-7c43-4373-bfac-8b9928f85a66"],

Cell[CellGroupData[{

Cell["\<\
M[r]Contract[Delta[Index[p, Flavor], Index[r, Flavor]] Delta[Index[r, \
Flavor], Index[s, Flavor]] Bar@\[Phi][p] \[Phi][s]]//NiceForm\
\>", "Input",
 CellProlog:>Needs["Matchete`"],
 CellLabel->"In[4]:=",
 CellID->905890893,ExpressionUUID->"2c2b2637-7f77-4552-8541-641861c94846"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   SuperscriptBox["M", 
    StyleBox["r",
     FontSize->10]], 
   SuperscriptBox[
    OverscriptBox["\[Phi]", 
     StyleBox["_",
      FontWeight->Bold]], 
    StyleBox["p",
     FontSize->10]], 
   SuperscriptBox["\[Phi]", 
    StyleBox["p",
     FontSize->10]]}], "StandardForm"]], "Output",
 CellLabel->"Out[4]//NiceForm=",
 CellID->1285365084,ExpressionUUID->"648cc03b-5f80-4282-9408-6bc1c08ab3d6"]
}, Open  ]],

Cell[TextData[{
 "Here the flavor index ",
 StyleBox["r", "TI"],
 " outside the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Contract"]], "paclet:Matchete/ref/Contract", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "db93642c-6f52-4e71-b758-463102fad731"],
 " was not properly identified and relabeled, highlighting that special care \
should be paid to properly applying Contract only to full Lagrangian terms \
and not sup-expressions."
}], "ExampleText",
 CellID->1414448073,ExpressionUUID->"584658a0-f6cd-445d-94d7-748258ded5df"]
}, Dynamic[CurrentValue[
 EvaluationNotebook[], {TaggingRules, "Openers", "ExampleSection", "2"}, 
