  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SU"]], "paclet:Matchete/ref/SU", "Matchete Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "3", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "77087899-1d01-4450-9d5d-9bf0bda2b535"],
 " as short-hand for the algebra):"
}], "ExampleText",
