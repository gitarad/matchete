Cell[TextData[{
 "The ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Dimensions"]], "paclet:ref/Dimensions"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "47375b11-30a6-47e7-94c1-d2b38dce6ec8"],
 " option determines the dimensionality of the space in which the trace is \
performed. This matters when the there are repeated Lorentz indices in the \
Dirac product, which is contracted over the course of the trace."
}], "ExampleText",
 CellID->1017759726,ExpressionUUID->"91035ee4-aabc-487c-a0f6-cde06adddf07"],

