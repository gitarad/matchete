  RowBox[{
   RowBox[{"SU", "[", "3", "]"}], ",", 
   RowBox[{"CRep", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0"}], "}"}], "]"}]}], "]"}], "\n", 
 RowBox[{"RepresentationWeights", "[", 
  RowBox[{
   RowBox[{"SU", "[", "3", "]"}], ",", 
