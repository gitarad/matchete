Cell[TextData[{
 "When using the option ",
 StyleBox["Expand->False", "InlineCode"],
 " some expressions might generate error messages when relabeling, since the \
individual contractions of the indices in each term can no longer be clear \
identified."
}], "ExampleText",
 CellID->793355334,ExpressionUUID->"34f5d436-b69a-4e24-9585-d3abc191f625"],

