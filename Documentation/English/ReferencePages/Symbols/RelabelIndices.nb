Cell[BoxData[{
 RowBox[{
  RowBox[{"expr", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Bar", "@", 
       RowBox[{"\[Psi]", "[", 
        RowBox[{"a", ",", "p"}], "]"}]}], "**", 
      RowBox[{"\[Psi]", "[", 
       RowBox[{"a", ",", "p"}], "]"}]}], ")"}], "+", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Bar", "@", 
       RowBox[{"\[Psi]", "[", 
        RowBox[{"b", ",", "r"}], "]"}]}], "**", 
      RowBox[{"\[Psi]", "[", 
       RowBox[{"b", ",", "r"}], "]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
