Cell[BoxData[
 RowBox[{
  RowBox[{"expr", "=", 
   RowBox[{
    RowBox[{"Bar", "@", 
     RowBox[{"\[Psi]", "[", 
      RowBox[{"a", ",", "p"}], "]"}]}], "**", 
    RowBox[{"\[Psi]", "[", 
     RowBox[{"a", ",", "p"}], "]"}]}]}], ";"}]], "Input",
