Cell[TextData[{
 StyleBox["RelabelIndices[", "InlineCode"],
 StyleBox["expr", "TI"],
 StyleBox[",Unique->True]", "InlineCode"],
 " can be used to ensure a proper index relabeling when working with \
replacement rules:"
}], "ExampleText",
 CellID->1639622461,ExpressionUUID->"4d100e29-df42-483a-b33a-b69e74d1ffc6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rule", "=", 
   RowBox[{
    RowBox[{"\[Psi]", "[", 
     RowBox[{"a_", ",", "p_"}], "]"}], ":>", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], ",", 
      RowBox[{"RelabelIndices", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Psi]", "[", 
          RowBox[{"a", ",", "p"}], " ", "]"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Bar", "@", 
            RowBox[{"\[Psi]", "[", 
             RowBox[{"x", ",", "y"}], "]"}]}], "**", 
           RowBox[{"\[Psi]", "[", 
            RowBox[{"x", ",", "y"}], "]"}]}], ")"}]}], ",", 
        RowBox[{"Unique", "->", "True"}]}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"rule", "//", "NiceForm"}]}], "Input",
 CellProlog:>Needs["Matchete`"],
 CellLabel->"In[1]:=",
 CellID->2072972317,ExpressionUUID->"a078ca12-a15e-4771-b10d-2530e11ca20d"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   SuperscriptBox["\[Psi]", 
    StyleBox[
     TemplateBox[{"a_", "p_"},
      "RowDefault"],
     FontSize->10]], "\[RuleDelayed]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], ",", 
     RowBox[{"RelabelIndices", "[", 
      RowBox[{
       RowBox[{
        FormBox[
         StyleBox[
          RowBox[{"(", 
           SubsuperscriptBox[
            OverscriptBox["\[Psi]", 
             StyleBox["_",
              FontWeight->Bold]], 
            StyleBox["x",
             FontSize->10], 
            StyleBox["y",
             FontSize->10]], "\[CenterDot]", 
           SuperscriptBox["\[Psi]", 
            StyleBox[
             TemplateBox[{"x", "y"},
              "RowDefault"],
             FontSize->10]], ")"}],
          SpanSymmetric->False],
         StandardForm], 
        SuperscriptBox["\[Psi]", 
         StyleBox[
          TemplateBox[{"a", "p"},
           "RowDefault"],
          FontSize->10]]}], ",", 
       RowBox[{"Unique", "\[Rule]", "True"}]}], "]"}]}], "]"}]}], 
  "StandardForm"]], "Output",
 CellLabel->"Out[1]//NiceForm=",
 CellID->355501013,ExpressionUUID->"e8fb860d-abfa-4f20-8705-159a9fea39c5"]
}, Open  ]],

