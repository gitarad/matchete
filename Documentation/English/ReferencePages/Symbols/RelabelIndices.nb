Cell[TextData[{
 StyleBox["RelabelIndices", "InlineCode"],
 " relabels all dummy indices, that is, all indices appearing exactly twice \
in a term."
}], "ExampleText",
 CellID->386251049,ExpressionUUID->"82d93c54-e6fd-4750-91cb-aebaa01ead3d"],

Cell["\<\
The exception to this rule are flavor indices. Since heavy fields must be in \
their mass basis for the matching, their mass matrices must be diagonal and \
therefore only carry a single flavor index:\
\>", "ExampleText",
 CellID->1023929354,ExpressionUUID->"84a0ecbe-464e-45d2-97ae-14980a0de86b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", "Flavor", "}"}]}], ",", 
   RowBox[{"Mass", "->", 
    RowBox[{"{", 
     RowBox[{"Heavy", ",", "m\[Phi]", ",", 
      RowBox[{"{", "Flavor", "}"}]}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L", "=", 
   RowBox[{"FreeLag", "[", "\[Phi]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"L", "//", "NiceForm"}]}], "Input",
 CellProlog:>Needs["Matchete`"],
 CellLabel->"In[1]:=",
 CellID->947705834,ExpressionUUID->"71eea648-a5d6-4c8d-a3a4-0353245f7d51"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SubscriptBox["D", "\[Mu]"], 
      SuperscriptBox[
       OverscriptBox["\[Phi]", 
        StyleBox["_", FontWeight -> Bold]], 
       StyleBox["p", FontSize -> 10]]},
     "RowDefault"], 
    TemplateBox[{
      SubscriptBox["D", "\[Mu]"], 
      SuperscriptBox["\[Phi]", 
       StyleBox["p", FontSize -> 10]]},
     "RowDefault"]}], "-", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["m\[Phi]", 
       StyleBox["p",
        FontSize->10]], ")"}], "2"], 
    SuperscriptBox[
     OverscriptBox["\[Phi]", 
      StyleBox["_",
       FontWeight->Bold]], 
     StyleBox["p",
      FontSize->10]], 
    SuperscriptBox["\[Phi]", 
     StyleBox["p",
      FontSize->10]]}]}], "StandardForm"]], "Output",
 CellLabel->"Out[1]//NiceForm=",
 CellID->1168746394,ExpressionUUID->"a95c1e60-29ec-4a58-8fff-bcbf9299b0f0"]
}, Open  ]],

Cell["\<\
RelabelIndices is aware which flavor indices should be interpreted as \
belonging to diagonal couplings and which not. Therefore, it can be applied \
to these expressions:\
\>", "ExampleText",
 CellID->1801704893,ExpressionUUID->"720f8216-19fa-4a92-b9a5-ac67db32bb93"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"RelabelIndices", "[", 
   RowBox[{"L", ",", 
    RowBox[{"Unique", "->", "True"}]}], "]"}], "//", "NiceForm"}]], "Input",
 CellProlog:>Needs["Matchete`"],
 CellLabel->"In[2]:=",
 CellID->1217755301,ExpressionUUID->"6e8fea74-3c05-4356-82f0-8ac4bef4deca"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    TemplateBox[{
      SubscriptBox["D", "u31"], 
      SuperscriptBox[
       OverscriptBox["\[Phi]", 
        StyleBox["_", FontWeight -> Bold]], 
       StyleBox["u30", FontSize -> 10]]},
     "RowDefault"], 
    TemplateBox[{
      SubscriptBox["D", "u31"], 
      SuperscriptBox["\[Phi]", 
       StyleBox["u30", FontSize -> 10]]},
     "RowDefault"]}], "-", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["m\[Phi]", 
       StyleBox["u29",
        FontSize->10]], ")"}], "2"], 
    SuperscriptBox[
     OverscriptBox["\[Phi]", 
      StyleBox["_",
       FontWeight->Bold]], 
     StyleBox["u29",
      FontSize->10]], 
    SuperscriptBox["\[Phi]", 
     StyleBox["u29",
      FontSize->10]]}]}], "StandardForm"]], "Output",
 CellLabel->"Out[2]//NiceForm=",
 CellID->1987790257,ExpressionUUID->"dfc96a5b-f396-43de-adf4-222be83bfebe"]
}, Open  ]],

Cell["\<\
To manually define a coupling with a flavor index that should be interpreted \
as diagonal one can use:\
\>", "ExampleText",
 CellID->1925535136,ExpressionUUID->"12b55f40-484b-4b86-a917-d97a1ab38481"],

Cell["DefineCoupling[\[Xi],Indices->{Flavor},DiagonalCoupling->{True}]", \
"Input",
 CellProlog:>Needs["Matchete`"],
 CellLabel->"In[3]:=",
 CellID->229019532,ExpressionUUID->"fbebd10a-0f20-4726-a55c-756df061bb4b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"expr", "=", 
   RowBox[{
    RowBox[{"\[Xi]", "[", "x", "]"}], 
    RowBox[{"Bar", "@", 
     RowBox[{"\[Phi]", "[", "x", "]"}]}], 
    RowBox[{"\[Phi]", "[", "x", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"expr", "//", "NiceForm"}]}], "Input",
 CellProlog:>Needs["Matchete`"],
 CellLabel->"In[4]:=",
 CellID->698879671,ExpressionUUID->"ee34e210-2bf7-489e-93cf-ba42308c88ea"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   SuperscriptBox["\[Xi]", 
    StyleBox["x",
     FontSize->10]], 
   SuperscriptBox[
    OverscriptBox["\[Phi]", 
     StyleBox["_",
      FontWeight->Bold]], 
    StyleBox["x",
     FontSize->10]], 
   SuperscriptBox["\[Phi]", 
    StyleBox["x",
     FontSize->10]]}], "StandardForm"]], "Output",
 CellLabel->"Out[4]//NiceForm=",
 CellID->443528572,ExpressionUUID->"d9a79d31-7309-47db-a171-d3a33e86c59c"]
}, Open  ]],

Cell[CellGroupData[{

