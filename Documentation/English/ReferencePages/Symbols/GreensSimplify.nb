Cell[TextData[{
 "In a real-scalar toy model, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GreensSimplify"]], "paclet:Matchete/ref/GreensSimplify", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "69d5ded7-2d32-4275-b5a1-ea2544d4e84f"],
 " performs integration by parts relations (a real scalar is defined with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DefineField"]], "paclet:Matchete/ref/DefineField", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "32569cb8-2c19-48bc-9dec-85ffabebc9c6"],
 ")"
}], "ExampleText",
 CellID->49926713,ExpressionUUID->"f661f047-596d-4522-b9bd-c6505b442627"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"-", "2"}], " ", 
    RowBox[{"\[Phi]", "[", "]"}], 
    RowBox[{"CD", "[", 
     RowBox[{"\[Mu]", ",", 
      RowBox[{"\[Phi]", "[", "]"}]}], "]"}], 
    RowBox[{"CD", "[", 
     RowBox[{"\[Mu]", ",", 
      RowBox[{"\[Phi]", "[", "]"}]}], "]"}]}], "+", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[Phi]", "[", "]"}], "2"], 
    RowBox[{"CD", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Nu]", ",", "\[Nu]"}], "}"}], ",", 
      RowBox[{"\[Phi]", "[", "]"}]}], "]"}]}]}], "//", 
  "NiceForm"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "//", "GreensSimplify"}], "//", 
  "NiceForm"}], "\[IndentingNewLine]"}], "Input",
 CellLabel->"In[1]:=",
 CellID->530024857,ExpressionUUID->"5b4787e3-c917-4ea8-9afa-5391e8ec401f"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", "2"}], "\[Phi]", 
    SuperscriptBox[
