    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Mu]", ",", "\[Mu]"}], "}"}], ",", 
     RowBox[{"\[Phi]", "[", "]"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:=",
