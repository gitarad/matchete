Cell[TextData[{
 "The input Lagrangian is first treated using ",
 ButtonBox["GreensSimplify",
  BaseStyle->"Link",
  ButtonData->"paclet:Matchete/ref/EOMSimplify#574769717"],
 ". If the target basis is the on-shell one, GreensSimplify can thus be \
skipped after matching."
}], "Notes",
 CellID->574769717,ExpressionUUID->"1a22886c-35d4-423f-8e7d-f5e87d41a911"],

Cell["The following options can be given: ", "Notes",
 CellID->1524298907,ExpressionUUID->"0cb0d200-129f-496a-8179-ed34710c0c32"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "ae2c7518-c199-4cad-8327-15f0eb0d2c3d"], 
    TemplateBox[{
      Cell[
       TextData["Verbose"]], "paclet:ref/Verbose"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], 
    TemplateBox[{
      Cell[
       TextData["True"]], "paclet:ref/True"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell[TextData[{
     "whether or not the function reports on its progress. Can be ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["True"]], "paclet:Matchete/ref/EOMSimplify#1559304886", 
        "Matchete Package Symbol"},
       "PackageLink",
       BaseStyle->"3ColumnTableMod"]],ExpressionUUID->
      "80ad5ee2-eb8f-41e8-ace0-2767eb9900b4"],
     " or ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["False"]], "paclet:Matchete/ref/EOMSimplify#1559304886", 
        "Matchete Package Symbol"},
       "PackageLink",
       BaseStyle->"3ColumnTableMod"]],ExpressionUUID->
      "093caa50-595b-467f-8a65-0aba897cca6a"],
     ".  "
    }], "TableText",ExpressionUUID->"a3f48ad9-9ad0-4bd1-9315-e103dadba9f9"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "853a5682-a59d-439e-9c32-1e35a7da0f84"], 
    TemplateBox[{
      Cell[
       TextData["DummyCoefficients"]], 
      "paclet:Matchete/ref/DummyCoefficients", "Matchete Package Symbol"},
     "PackageLink",
     BaseStyle->"3ColumnTableMod"], 
    TemplateBox[{
      Cell[
       TextData["False"]], "paclet:ref/False"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell["\<\
determines whether the module replaces operator coefficients by temporary \
variables before applying the reductions. For Lagrangians where the matching \
coefficients consist of complicated loop functions, this can yield a better \
performance.\
\>", "TableText",ExpressionUUID->"13b588c6-5954-4c30-8bbc-e8ed2eb1411f"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "b8a48d1e-b8c8-4f6f-9364-a2e9c230fdf6"], 
    TemplateBox[{
      Cell[
       TextData["EFTOrder"]], "paclet:Matchete/ref/EFTOrder", 
      "Matchete Package Symbol"},
     "PackageLink",
     BaseStyle->"3ColumnTableMod"], 
    TemplateBox[{
      Cell[
       TextData["All"]], "paclet:ref/All"},
     "RefLink",
     BaseStyle->{"3ColumnTableMod"}], Cell[TextData[{
     "specifies the targeted order in power-counting to which field \
redefinitions are applied. The standard option ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["All"]], "paclet:Matchete/ref/EOMSimplify#1559304886", 
        "Matchete Package Symbol"},
       "PackageLink",
       BaseStyle->"3ColumnTableMod"]],ExpressionUUID->
      "7f666b43-92a6-4e17-baaf-46a5cc37f8dc"],
     " determines the order from the input Lagrangian and keeps the output at \
the same order."
    }], "TableText",ExpressionUUID->"c1992694-709d-4617-a948-6f7b445418de"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "f150d2e3-66c7-481a-a859-6e916b696d29"], 
    TemplateBox[{
      Cell[
       TextData["EffectiveCouplingSymbol"]], 
      "paclet:Matchete/ref/EffectiveCouplingSymbol", 
      "Matchete Package Symbol"},
     "PackageLink",
     BaseStyle->"3ColumnTableMod"], "\"\<C\>\"", Cell["\<\
the standard symbol used for effective couplings which are generated for \
superleading terms.\
\>", "TableText",ExpressionUUID->"7d160511-1efa-4a2f-9ffc-c00a20f786b6"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "b6543802-bf45-4cfa-9ff0-02cad31a4e50"], 
    TemplateBox[{
      Cell[
       TextData["ReductionIdentities"]], 
      "paclet:Matchete/ref/ReductionIdentities", "Matchete Package Symbol"},
     "PackageLink",
     BaseStyle->"3ColumnTableMod"], 
    TemplateBox[{
      Cell[
       TextData["EvanescenceFree"]], "paclet:Matchete/ref/EvanescenceFree", 
      "Matchete Package Symbol"},
     "PackageLink",
     BaseStyle->"3ColumnTableMod"], Cell["\<\
specifies whether or not to use the subset of identities valid only in 4 \
dimensions (fierz, gamma reduction and Levi-Civita relations) in intermediate \
simplifications.\
\>", "TableText",ExpressionUUID->"e45cc6dd-5065-4cf6-bcbc-1c684c52caaf"]}
  }]], "3ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{
  "Columns" -> {{None}}, "Rows" -> {None, None, None, None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True, True, True, True}}}},
 CellID->1559304886,ExpressionUUID->"163cdcaf-d1f4-4188-94ec-711fc94bf8bc"],

Cell[TextData[{
 "The option ",
 ButtonBox["EFTOrder",
  BaseStyle->"Link",
  ButtonData->"paclet:Matchete/ref/EOMSimplify#367043257"],
 " takes either an integer value greater or equal to 4, or the symbol ",
 ButtonBox["All",
  BaseStyle->"Link",
  ButtonData->"paclet:Matchete/ref/EOMSimplify#367043257"],
 ". In the latter case, ",
 ButtonBox["EOMSimplify",
  BaseStyle->"Link",
  ButtonData->"paclet:Matchete/ref/EOMSimplify#367043257"],
 " determines the order in power-counting from the input Lagrangian. When the \
option value is lower than the maximal order of the Lagrangian, redundant \
operators are only removed up to the specified order."
}], "Notes",
 CellID->367043257,ExpressionUUID->"33e698c2-98dd-4da6-81c2-1c4c74906c13"],

Cell["\<\
When the Lagrangian contains a term that is formally of lower order than \
dimension 4, it is replaced by an effective coupling with its power-counting \
defined such, that the term becomes dimension 4. These terms typically occur \
after matching when the light degrees of freedom do not have their masses \
protected by a symmetry (c.f. the Hierarchy Problem). Matchete then assumes \
the loop suppression to be equivalent to a power-suppression, trading a \
\"superleading-power\" loop function for a tree-level object that is of \
higher order in power-counting. The option EffectiveCouplingSymbol controls \
which letter is used for the generation of such couplings.\
\>", "Notes",
 CellID->2126913657,ExpressionUUID->"9bf3b2d4-aa35-43cb-819b-bacb0bcc53fa"],

Cell["The allowed options for ReductionIdentities are", "Notes",
 CellID->1267460636,ExpressionUUID->"958e1a6a-ac57-4b37-8b39-59c5c93eb089"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "6ee4fb17-cfc9-4876-b8a9-04885f049f0b"], "EvanescenceFree", Cell["\<\
uses 4-dimensional identities and evaluates evanescent contributions\
\>", "TableText",ExpressionUUID->"69834f77-99d5-45cc-b904-989d9d41f4ef"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "43dc1de4-e6cb-4cfa-9edb-0b8a5f78b1cf"], "Evanescent", Cell["\<\
uses 4-dimensional identities and keeps evanescent operators in the Lagrangian\
\>", "TableText",ExpressionUUID->"aae05d51-efed-452a-af2c-5cc981827ce8"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "241a04ac-3887-46b1-b73e-4c2c9b38649d"], "dDimensional", Cell["\<\
uses only reduction identities valid in dimensional regularization, which do \
not yield evanescent operators\
\>", "TableText",ExpressionUUID->"88cb3447-d674-4c27-a7fd-491a2b84be29"]},
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "23c21805-a912-429d-b4f0-6097878d330f"], "FourDimensional", Cell["\<\
uses 4-dimensional identities without including evanescent operators\
\>", "TableText",ExpressionUUID->"f762ab9e-561f-4772-b4f3-d3080531dde0"]}
  }]], "2ColumnTableMod",
 GridBoxOptions->{
 GridBoxBackground->{
  "Columns" -> {{None}}, "Rows" -> {None, None, None, {None}}},
 GridBoxDividers->{"Rows" -> {{True, True, True, True, True}}}},
 CellID->104978453,ExpressionUUID->"b6ded036-5e24-4b72-a549-d88b662b4eb0"]
}, Dynamic[CurrentValue[
 EvaluationNotebook[], {TaggingRules, "Openers", "NotesSection"}, Closed]]]],

