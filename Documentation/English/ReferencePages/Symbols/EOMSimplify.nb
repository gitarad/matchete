Cell["\<\
Defining a Yukawa theory with a heavy fermion and matching at one-loop:\
\>", "ExampleText",
 CellID->2033245772,ExpressionUUID->"13808a07-40e0-491b-b8c6-1a99058b84fb"],

Cell[BoxData[{
 RowBox[{"ResetAll", "[", "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}], ",", 
   RowBox[{"Mass", "\[Rule]", "Light"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Psi]", ",", "Fermion", ",", 
   RowBox[{"Mass", "\[Rule]", "Heavy"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"y", ",", 
   RowBox[{"SelfConjugate", "->", "True"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"\[Lambda]", ",", 
   RowBox[{"SelfConjugate", "->", "True"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalL]", " ", "=", " ", 
   RowBox[{
    RowBox[{"FreeLag", "[", "]"}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"\[Lambda]", "[", "]"}], 
      RowBox[{"4", "!"}]], 
     SuperscriptBox[
      RowBox[{"\[Phi]", "[", "]"}], "4"]}], "+", 
    RowBox[{
     RowBox[{"y", "[", "]"}], 
     RowBox[{
      RowBox[{"Bar", "@", 
       RowBox[{"\[Psi]", "[", "]"}]}], "**", 
      RowBox[{"\[Psi]", "[", "]"}]}], " ", 
     RowBox[{"\[Phi]", "[", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalL]0", "=", 
   RowBox[{"GreensSimplify", "[", 
    RowBox[{"Match", "[", "\[ScriptCapitalL]", "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->625261602,ExpressionUUID->"b265f6b4-4b90-4878-ab14-baf3f74bb556"],

