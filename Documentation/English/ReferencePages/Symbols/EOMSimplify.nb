Cell["\<\
Defining a Lagrangian with redundant operators at dimension 5 and 6\
\>", "ExampleText",
 CellID->1866356153,ExpressionUUID->"f84863d7-7a0d-4596-a0d8-45ebd12f63f8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}], ",", 
   RowBox[{"Mass", "\[Rule]", "Light"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"\[Lambda]", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"c1", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"c2", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalL]", " ", "=", " ", 
   RowBox[{
    RowBox[{"FreeLag", "[", "]"}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"\[Lambda]", "[", "]"}], 
      RowBox[{"4", "!"}]], 
     SuperscriptBox[
      RowBox[{"\[Phi]", "[", "]"}], "4"]}], "+", 
    RowBox[{
     RowBox[{"c1", "[", "]"}], " ", 
     SuperscriptBox[
      RowBox[{"\[Phi]", "[", "]"}], "2"], 
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Mu]", ",", "\[Mu]"}], "}"}], ",", 
       RowBox[{"\[Phi]", "[", "]"}]}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"c2", "[", "]"}], " ", 
     SuperscriptBox[
      RowBox[{"\[Phi]", "[", "]"}], "3"], 
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Mu]", ",", "\[Mu]"}], "}"}], ",", 
       RowBox[{"\[Phi]", "[", "]"}]}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"NiceForm", "[", "\[ScriptCapitalL]", "]"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->582450190,ExpressionUUID->"782c9e64-1a68-4759-96dd-9e95d7f7aa21"],

Cell[BoxData[
 RowBox[{
  FormBox[
   RowBox[{
    FormBox[
     FractionBox["1", "2"],
     StandardForm], 
    SuperscriptBox[
     FormBox[
      StyleBox[
       RowBox[{"(", 
        TagBox[
         FormBox[
          TemplateBox[{
            SubscriptBox["D", 
             StyleBox[
              TagBox[
               StyleBox["\"\[Mu]\"", 10, StripOnInput -> False], 
               Format[#, Matchete`NiceForm]& ], FontSize -> 12, StripOnInput -> 
              False]], 
            TagBox[
             FormBox["\[Phi]", StandardForm], StandardForm, Editable -> True]},
           "RowDefault"],
          StandardForm],
         StandardForm,
         Editable->True], ")"}],
       SpanSymmetric->False],
      StandardForm], "2"]}],
   StandardForm], "-", 
  FormBox[
   RowBox[{
    FormBox[
     FractionBox["1", "2"],
     StandardForm], 
    SuperscriptBox[
     TagBox[
      FormBox["m\[Phi]",
       StandardForm],
      StandardForm,
      Editable->True], 
     FormBox["2",
      StandardForm]], 
    SuperscriptBox[
     TagBox[
      FormBox["\[Phi]",
       StandardForm],
      StandardForm,
      Editable->True], "2"]}],
   StandardForm], "+", 
  FormBox[
   RowBox[{
    FormBox[
     FractionBox["1", "24"],
     StandardForm], 
    TagBox[
     FormBox["\[Lambda]",
      StandardForm],
     StandardForm,
     Editable->True], 
    SuperscriptBox[
     TagBox[
      FormBox["\[Phi]",
       StandardForm],
      StandardForm,
      Editable->True], "4"]}],
   StandardForm], "+", 
  FormBox[
   RowBox[{
    TagBox[
     FormBox["c1",
      StandardForm],
     StandardForm,
     Editable->True], 
    TagBox[
     FormBox[
      TemplateBox[{
        SuperscriptBox["D", "2"], 
        TagBox[
         FormBox["\[Phi]", StandardForm], StandardForm, Editable -> True]},
       "RowDefault"],
      StandardForm],
     StandardForm,
     Editable->True], 
    SuperscriptBox[
     TagBox[
      FormBox["\[Phi]",
       StandardForm],
      StandardForm,
      Editable->True], "2"]}],
   StandardForm], "+", 
  FormBox[
   RowBox[{
    TagBox[
     FormBox["c2",
      StandardForm],
     StandardForm,
     Editable->True], 
    TagBox[
     FormBox[
      TemplateBox[{
        SuperscriptBox["D", "2"], 
        TagBox[
         FormBox["\[Phi]", StandardForm], StandardForm, Editable -> True]},
       "RowDefault"],
      StandardForm],
     StandardForm,
     Editable->True], 
    SuperscriptBox[
     TagBox[
      FormBox["\[Phi]",
       StandardForm],
      StandardForm,
      Editable->True], "3"]}],
   StandardForm]}]], "Output",
 CellLabel->"Out[1]//NiceForm=",
 CellID->95365778,ExpressionUUID->"66e88550-cb5e-4334-b308-64927b517219"]
}, Open  ]],

