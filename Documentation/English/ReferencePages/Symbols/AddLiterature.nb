    archivePrefix = \"arXiv\",
    primaryClass = \"hep-ph\",
    reportNumber = \"MITP-20-076, TUM-HEP-1302/20, ZU-TH-54/20\",
    doi = \"10.1007/JHEP04(2021)281\",
    journal = \"JHEP\",
    volume = \"04\",
    pages = \"281\",
    year = \"2021\"
}\
\>", "Output",
