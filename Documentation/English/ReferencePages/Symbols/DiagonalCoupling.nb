Cell["Define a flavor non-universal but diagonal mass matrix:", "ExampleText",
 CellID->2015590703,ExpressionUUID->"62a51804-cb82-49ed-b3a6-7dc76ed40888"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"M", ",", 
   RowBox[{"SelfConjugate", "->", "True"}], ",", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", "Flavor", "}"}]}], ",", 
   RowBox[{"DiagonalCoupling", "->", 
    RowBox[{"{", "True", "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    SuperscriptBox[
     RowBox[{"M", "[", "r", "]"}], "2"], 
    RowBox[{"Bar", "@", 
     RowBox[{"\[Phi]", "[", "r", "]"}]}], 
    RowBox[{"\[Phi]", "[", "r", "]"}]}], "//", "RelabelIndices"}], "//", 
  "NiceForm"}]}], "Input",
 CellProlog:>Needs["Matchete`"],
 CellLabel->"In[3]:=",
 CellID->932091024,ExpressionUUID->"3acf531c-5ef1-4882-883d-cf0b1d2c0555"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     SuperscriptBox["M", 
      StyleBox["p",
       FontSize->10]], ")"}], "2"], 
   SuperscriptBox[
    OverscriptBox["\[Phi]", 
     StyleBox["_",
      FontWeight->Bold]], 
    StyleBox["p",
     FontSize->10]], 
   SuperscriptBox["\[Phi]", 
    StyleBox["p",
     FontSize->10]]}], "StandardForm"]], "Output",
 CellLabel->"Out[3]//NiceForm=",
 CellID->1656185920,ExpressionUUID->"7e08f9ad-efeb-41b1-8355-81e85749ca3f"]
}, Open  ]],

Cell[TextData[{
 "In this case the dummy index resummation by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RelabelIndices"]], "paclet:Matchete/ref/RelabelIndices", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4c31f518-c58c-439a-9bd9-81c292582143"],
 " ignores these indices when determining all contracted indices. However, a \
proper relabeling is still guaranteed."
}], "ExampleText",
 CellID->279808804,ExpressionUUID->"75cd0df8-ae6a-455d-8928-3f02b1fe391c"],

Cell[TextData[{
 "If the mass is defined without specifying the ",
 StyleBox["DiagonalCoupling", "InlineCode"],
 " options  (default), or equivalently using ",
 StyleBox["DiagonalCoupling\[Rule]{False}", "InlineCode"],
 ", the dummy index resummation is trying to interpret relabel the indices on \
the coupling as regular indices and an error message is generated in the \
example above:"
}], "ExampleText",
 CellID->1802715844,ExpressionUUID->"1357aa3f-4b76-4fb4-bd1a-0154d0ca933f"],

