Cell[TextData[{
 "Allowed values are a list of booleans or an empty list. The n-th boolean \
specifies whether the n-th flavor index is a diagonal in flavor space. By \
default all flavor indices are assumed to be non-diagonal. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagonalCoupling"]], "paclet:Matchete/ref/DiagonalCoupling", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f82497a7-193c-4e3a-9561-938f3f792d08"],
 " is also the corresponding key in the association returned by ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GetCouplings"]], "paclet:Matchete/ref/GetCouplings", 
     "Matchete Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "15a2eb63-0021-47f2-84c8-0475f556080b"],
 "."
}], "Notes",
 CellID->997256968,ExpressionUUID->"da7e1f5c-6788-4c36-b3e2-7455a05e008c"]
}, Dynamic[CurrentValue[
 EvaluationNotebook[], {TaggingRules, "Openers", "NotesSection"}, Closed]]]],

