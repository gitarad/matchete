Cell[TextData[{
 "In most cases ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DefineField"]], "paclet:Matchete/ref/DefineField", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "eb525fd0-42d8-4456-9b7c-f1e24f2c8624"],
 " is used with many options. For instance to define the three generations of \
left-handed quarks in the SM, we would use"
}], "ExampleText",
 CellID->1833501546,ExpressionUUID->"bce8092c-a9c8-47be-95d6-ceeb004b9450"],

Cell[BoxData[
 RowBox[{"DefineField", "[", 
  RowBox[{"q", ",", " ", "Fermion", ",", " ", 
   RowBox[{"Chiral", "\[Rule]", "LeftHanded"}], ",", " ", 
   RowBox[{"Mass", "\[Rule]", " ", "0"}], ",", " ", 
   RowBox[{"Charges", "\[Rule]", 
    RowBox[{"U1Y", "[", 
     RowBox[{"1", "/", "6"}], "]"}]}], ",", " ", 
   RowBox[{"Indices", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"SU3c", "[", "fund", "]"}], ",", " ", 
      RowBox[{"SU2L", "[", "fund", "]"}], ",", " ", "Flavor"}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1044290282,ExpressionUUID->"544303c1-9022-47f6-8fa5-18db3c794944"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"q", "[", 
  RowBox[{"c", ",", "u", ",", "p"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q", "[", 
   RowBox[{"c", ",", "i", ",", "p"}], "]"}], "//", "NiceForm"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->232292721,ExpressionUUID->"746b2646-5751-4e65-a80a-f812b815f431"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DiracProduct", "[", 
   RowBox[{"Proj", "[", 
    RowBox[{"-", "1"}], "]"}], "]"}], "**", 
  RowBox[{"Field", "[", 
   RowBox[{"q", ",", "Fermion", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Index", "[", 
       RowBox[{"c", ",", 
        RowBox[{"SU3c", "[", "fund", "]"}]}], "]"}], ",", 
      RowBox[{"Index", "[", 
       RowBox[{"u", ",", 
        RowBox[{"SU2L", "[", "fund", "]"}]}], "]"}], ",", 
      RowBox[{"Index", "[", 
       RowBox[{"p", ",", "Flavor"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", "}"}]}], "]"}]}]], "Output",
 CellLabel->"Out[2]=",
 CellID->235483139,ExpressionUUID->"0ef30457-7bc6-45a7-b958-882e13e310f8"],

Cell[BoxData[
 StyleBox[
  RowBox[{"(", 
   RowBox[{
    FormBox[
     SubscriptBox["\<\"P\"\>", "\<\"L\"\>"],
     StandardForm], "\[CenterDot]", 
    TemplateBox[{
      TagBox[
       FormBox["q", StandardForm], StandardForm, Editable -> True], 
      StyleBox[
       TemplateBox[{
         TagBox[
          StyleBox["\"c\"", 10, StripOnInput -> False], 
          Format[#, Matchete`NiceForm]& ], 
         TagBox[
          StyleBox["\"i\"", 10, StripOnInput -> False], 
          Format[#, Matchete`NiceForm]& ], 
         TagBox[
          StyleBox["\"p\"", 10, StripOnInput -> False], 
          Format[#, Matchete`NiceForm]& ]}, "RowDefault"], FontSize -> 12, 
       StripOnInput -> False]},
     "Superscript"]}], ")"}],
  SpanSymmetric->False]], "Output",
 CellLabel->"Out[2]//NiceForm=",
 CellID->2100239399,ExpressionUUID->"cce769d0-1cce-4a9d-8598-403f3390e615"]
}, Open  ]],

Cell[TextData[{
 "This example assumes that the SU3c, SU2L, and U1Y (SM) gauge groups have \
been initialized first, which can be done with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DefineGaugeGroup"]], "paclet:Matchete/ref/DefineGaugeGroup", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c69a486d-73f6-48ec-be8f-33a90440386f"],
 ". "
}], "ExampleText",
 CellID->1606838331,ExpressionUUID->"7930e423-4aeb-4c8f-9ec8-6496d0a7f8c1"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
