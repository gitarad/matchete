Cell[TextData[{
 "Massive vectors are also supported, and can be defined like scalar and \
fermion fields. Vector fields come with a Lorentz index in addition to the \
ones specified with the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indices"]], "paclet:Matchete/ref/Indices", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b4aaaeb5-9b1f-4778-bf8f-02bf3eb32eb2"],
 " option."
}], "ExampleText",
 CellID->1347535309,ExpressionUUID->"5ff62945-a714-477d-badb-889ab8cdf3b5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineField", "[", 
  RowBox[{"V", ",", "Vector", ",", 
   RowBox[{"Mass", "->", "Heavy"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"V", "[", "\[Mu]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"V", "[", "\[Mu]", "]"}], "//", "NiceForm"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->387802235,ExpressionUUID->"7f814bc6-b4fb-4661-bb76-6b8ead8e0a3f"],

Cell[BoxData[
 RowBox[{"Field", "[", 
  RowBox[{"V", ",", 
   RowBox[{"Vector", "[", 
    RowBox[{"Index", "[", 
     RowBox[{"\[Mu]", ",", "Lorentz"}], "]"}], "]"}], ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}]}], "]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->36390833,ExpressionUUID->"0c7d926b-dbcf-46b9-9a29-3f3152f2426c"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    FormBox["V", StandardForm], StandardForm, Editable -> True], 
   StyleBox[
    TemplateBox[{
      TagBox[
       StyleBox["\"\[Mu]\"", 10, StripOnInput -> False], 
       Format[#, Matchete`NiceForm]& ]}, "RowDefault"], FontSize -> 12, 
    StripOnInput -> False]},
  "Superscript"]], "Output",
 CellLabel->"Out[1]//NiceForm=",
 CellID->1735374483,ExpressionUUID->"b71e4605-0320-4702-8d70-a8c6d4a8e00a"]
}, Open  ]],

