Cell[TextData[{
 "With the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BackgroundField"]], "paclet:Matchete/ref/BackgroundField", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6d2ebdfb-27eb-42c8-8f6c-9a81bd9d4482"],
 " option, the user may set a field to be non-propagating, i.e., it is \
treated as a background field. A scalar field background field can be defined \
with"
}], "ExampleText",
 CellID->790478155,ExpressionUUID->"122838de-df82-434b-bbb3-b035b6728737"],

Cell[BoxData[
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", " ", "Scalar", ",", 
   RowBox[{"BackgroundField", "\[Rule]", " ", "True"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->2059778085,ExpressionUUID->"8fc2395c-917d-452f-aa17-021ab9948934"],

Cell[TextData[{
 "Background fields are treated as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Light"]], "paclet:Matchete/ref/Light", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c5d1eeb7-4a89-4967-b274-0fb99f15167e"],
 " fields with a vanishing mass (trying to associate a mass with a background \
field results in a failure). It does not have a kinetic term associated, and \
it cannot be passed to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FreeLag"]], "paclet:Matchete/ref/FreeLag", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "49179340-f2cb-4458-89ca-d74e04eeb59b"],
 ":"
}], "ExampleText",
 CellID->59223890,ExpressionUUID->"ea4a2315-c1d6-4105-8101-2ec74272f22e"],

