Cell[TextData[{
 "The ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Charges"]], "paclet:Matchete/ref/Charges", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "161ad20e-0a21-43f9-af2b-98c38ac65980"],
 " option is used to specify that the field is charged under one or more U(1) \
gauge groups. Having defined a U(1) group with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DefineGaugeGroup"]], "paclet:Matchete/ref/DefineGaugeGroup", 
    "Matchete Package Symbol"},
   "PackageLink",
