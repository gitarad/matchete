Cell["\<\
The chiral option is used exclusively for fermions. Matchete employs Dirac \
spinor notation, and the chirality option lets the user specify if the spinor \
is left- or right-handed or if it is vector-like.\
\>", "ExampleText",
 CellID->1871383609,ExpressionUUID->"710e63ca-887e-432a-b2dc-db7f3d665b46"],

Cell["\<\
The default option sets the field to be vector-like, which appears from the \
associated free Lagrangian \
\>", "ExampleText",
 CellID->1846503913,ExpressionUUID->"02bcc3b2-4ba6-41ba-a9b4-fb91b3639223"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineField", "[", 
  RowBox[{"\[CapitalPsi]", ",", "Fermion", ",", " ", 
   RowBox[{"Chiral", "\[Rule]", "False"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FreeLag", "[", "\[CapitalPsi]", "]"}], "//", 
  "NiceForm"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->458808180,ExpressionUUID->"04c245e4-9d6e-44a6-b941-bf9dd8226422"],

Cell[BoxData[
 RowBox[{
  FormBox[
   RowBox[{
    FormBox["\[ImaginaryI]",
     StandardForm], 
    FormBox[
     StyleBox[
      RowBox[{"(", 
       RowBox[{
        TagBox[
         FormBox[
          OverscriptBox["\[CapitalPsi]", "_"],
          StandardForm],
         StandardForm,
         Editable->True], "\[CenterDot]", 
        FormBox[
         SubscriptBox[
          FormBox["\[Gamma]",
           StandardForm], 
          TagBox[
           StyleBox["\<\"\[Mu]\"\>",
            StripOnInput->False,
            FontSize->10],
           Format[#, Matchete`NiceForm]& ]],
         StandardForm], "\[CenterDot]", 
        TagBox[
         FormBox[
          TemplateBox[{
            SubscriptBox["D", 
             StyleBox[
              TagBox[
               StyleBox["\"\[Mu]\"", 10, StripOnInput -> False], 
               Format[#, Matchete`NiceForm]& ], FontSize -> 12, StripOnInput -> 
              False]], 
            TagBox[
             FormBox["\[CapitalPsi]", StandardForm], StandardForm, Editable -> 
             True]},
           "RowDefault"],
          StandardForm],
         StandardForm,
         Editable->True]}], ")"}],
      SpanSymmetric->False],
     StandardForm]}],
   StandardForm], "-", 
  FormBox[
   RowBox[{
    TagBox[
     FormBox["M\[CapitalPsi]",
      StandardForm],
     StandardForm,
     Editable->True], 
    FormBox[
     StyleBox[
      RowBox[{"(", 
       TagBox[
        FormBox[
         OverscriptBox["\[CapitalPsi]", "_"],
         StandardForm],
        StandardForm,
        Editable->True], "\[CenterDot]", 
       TagBox[
        FormBox["\[CapitalPsi]",
         StandardForm],
        StandardForm,
        Editable->True], ")"}],
      SpanSymmetric->False],
     StandardForm]}],
   StandardForm]}]], "Output",
 CellLabel->"Out[1]//NiceForm=",
 CellID->224546759,ExpressionUUID->"9c7c40e0-24e6-473b-b30c-8c3a0cf1b857"]
}, Open  ]],

