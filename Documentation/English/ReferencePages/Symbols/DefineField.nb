Cell[TextData[{
 "The NiceForm option provides the possibility of defining how the field is \
displayed in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NiceForm"]], "paclet:Matchete/ref/NiceForm", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b2afa423-0dfa-4361-b4d0-e809670a4f46"],
 ". The Default choice uses the ",
 Cell[BoxData[
  StyleBox["label", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "86f8e3a8-e752-4a09-a2b6-4689c62cd935"],
 " for the field in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NiceForm"]], "paclet:Matchete/ref/NiceForm", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e85c29cf-114b-40c4-99f9-abaaef451ff0"],
 ", but this can be changed  "
}], "ExampleText",
 CellID->1938111257,ExpressionUUID->"14da36df-3e04-4e59-85e4-df5c57fe2626"],

Cell[BoxData[
 RowBox[{"DefineField", "[", 
  RowBox[{"f1", ",", "Scalar", ",", 
   RowBox[{
   "NiceForm", "\[Rule]", 
    "\"\<\!\(\*SubscriptBox[\(\[Phi]\), \(f\)]\)\>\""}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1762011999,ExpressionUUID->"b1619ee1-b21c-4d91-8bd9-00ca8d4c2050"],

Cell[TextData[{
 "This does not change the internal representation of the field ",
 StyleBox["f", "InlineCode"],
 ", but we see the difference in the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["NiceForm"]], "paclet:Matchete/ref/NiceForm", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2dc13d1f-8e40-4e69-b82b-90248482e629"],
 " display"
}], "ExampleText",
 CellID->222961595,ExpressionUUID->"9f744894-db5a-4121-999d-e6fc851d8cd1"],

