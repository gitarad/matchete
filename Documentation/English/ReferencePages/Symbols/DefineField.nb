 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]4", ",", "Scalar", ",", 
   RowBox[{"Mass", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Light", ",", " ", "mCustom"}], "}"}]}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FreeLag", "[", "\[Phi]4", "]"}], "//", "NiceForm"}]}], "Input",
 CellLabel->"In[1]:=",
