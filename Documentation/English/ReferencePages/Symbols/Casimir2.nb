Cell[TextData[{
 "The normalization of the quadratic Casimir operator follows from the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DynkinIndex"]], "paclet:Matchete/ref/DynkinIndex", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1696cd06-7cb3-443d-b10c-2f21c9e1d0e7"],
 ".  The Dynkin indices are normalized to 1/2 for fundamental \
representations, which fixes all other representations. "
}], "Notes",
 CellID->1043313733,ExpressionUUID->"9a5542c9-dd2f-4807-9b5c-adb2e72e31f9"],

Cell[TextData[{
 "The algebra argument must be a valid ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Alg"]], "paclet:Matchete/ref/Alg", "Matchete Package Symbol"},
    
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["class", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "234e7e16-2491-49ce-a740-a005cc7cfe4a"],
 " object."
}], "Notes",
 CellID->1846763481,ExpressionUUID->"9152c293-326d-4209-8087-14d1fdb64256"],

Cell["\<\
Representations are labeled with a list of integers corresponding to the \
Dynkin coefficients of the highest weight in the representation.\
\>", "Notes",
 CellID->1780800353,ExpressionUUID->"3383bd82-d3ff-4675-b640-21246e6dd8c4"]
}, Dynamic[CurrentValue[
 EvaluationNotebook[], {TaggingRules, "Openers", "NotesSection"}, Closed]]]],

