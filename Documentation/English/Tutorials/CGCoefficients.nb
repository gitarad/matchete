 RowBox[{"DefineCG", "[", 
  RowBox[{"d3", ",", 
   RowBox[{"{", 
    RowBox[{"adj", ",", "adj", ",", "adj"}], "}"}], ",", 
   RowBox[{"First", "@", 
    RowBox[{"InvariantTensors", "[", 
     RowBox[{
      RowBox[{"SU", "[", "3", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}]}], "}"}], ",", 
      RowBox[{"SymmetricIndices", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], ",", " ", 
      RowBox[{"Normalization", "\[Rule]", 
       RowBox[{"40", "/", "3"}]}]}], "]"}]}]}], " ", "]"}]}], "Input",
 CellLabel->"In[10]:=",
 CellID->1918125236,ExpressionUUID->"efb5431e-d015-4a58-9463-e5a78ceaa104"],

Cell[TextData[{
 "Here we have used ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvariantTensors"]], "paclet:Matchete/ref/InvariantTensors", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "53648e88-1f2e-4a13-9980-98eddb739f46"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["StructureConstants"]], 
    "paclet:Matchete/ref/StructureConstants", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "45ad3a9b-617f-46f2-9c78-ab49066dff5b"],
 " to obtain the appropriate numerical tensor for each CG.  A Kronecker delta \
CG for the adjoint representation, named ",
 StyleBox["del[adj]",
  FontWeight->"Bold"],
 ", was automatically initialized when we defined the representation. At any \
time we can check the numerical tensor associated with a CG with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GetCGTensor"]], "paclet:Matchete/ref/GetCGTensor", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d6061f42-ab46-4efe-b548-af8f7602ee60"],
 ":"
}], "TechNoteMathCaption",
 CellID->1472525733,ExpressionUUID->"6d8f5e27-919f-4c41-9f7e-7164bcd7cdba"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"TensorRank", "@", 
  RowBox[{"GetCGTensor", "@", "f3"}]}], "\[IndentingNewLine]", 
 RowBox[{"GetCGTensor", "@", 
  RowBox[{"del", "[", "adj", "]"}]}]}], "Input",
 CellLabel->"In[12]:=",
