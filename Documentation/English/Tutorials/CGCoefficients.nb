    FontSize->10]], "StandardForm"]], "Output",
 CellLabel->"Out[35]//NiceForm=",
 CellID->1565402681,ExpressionUUID->"7c298f15-320b-4702-9823-86d1ff9bc6ab"]
}, Open  ]],

Cell["\<\
It can also identify tensor products in contractions, e.g., in \
\>", "TechNoteMathCaption",
 CellID->540146888,ExpressionUUID->"8f4be64c-0bab-4749-ad68-c4c8666ea3f9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f3", "[", 
     RowBox[{"a", ",", "i", ",", "j"}], "]"}], 
    RowBox[{"f3", "[", 
     RowBox[{"b", ",", "j", ",", "k"}], "]"}], 
    RowBox[{"f3", "[", 
     RowBox[{"c", ",", "k", ",", "l"}], "]"}], 
    RowBox[{"f3", "[", 
     RowBox[{"d", ",", "l", ",", "i"}], "]"}]}], "//", "ContractCGs"}], "//", 
  "NiceForm"}]], "Input",
 CellLabel->"In[36]:=",
 CellID->835370747,ExpressionUUID->"ef6d994d-ceea-4c7a-96a2-db7d5114bef8"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"3", 
    SuperscriptBox["Tr4", 
     StyleBox[
      TemplateBox[{"b", "a", "d", "c"},
       "RowDefault"],
      FontSize->10]]}], "+", 
   RowBox[{"3", 
    SuperscriptBox["Tr4", 
     StyleBox[
      TemplateBox[{"b", "c", "d", "a"},
       "RowDefault"],
      FontSize->10]]}], "+", 
   RowBox[{
    FractionBox["1", "2"], 
    SuperscriptBox["\[Delta]", 
     StyleBox[
      TemplateBox[{"a", "d"},
       "RowDefault"],
      FontSize->10]], 
    SuperscriptBox["\[Delta]", 
     StyleBox[
      TemplateBox[{"b", "c"},
       "RowDefault"],
      FontSize->10]]}], "+", 
   RowBox[{
    FractionBox["1", "2"], 
    SuperscriptBox["\[Delta]", 
     StyleBox[
      TemplateBox[{"a", "c"},
       "RowDefault"],
      FontSize->10]], 
    SuperscriptBox["\[Delta]", 
     StyleBox[
      TemplateBox[{"b", "d"},
       "RowDefault"],
      FontSize->10]]}], "+", 
   RowBox[{
    FractionBox["1", "2"], 
    SuperscriptBox["\[Delta]", 
     StyleBox[
      TemplateBox[{"b", "a"},
       "RowDefault"],
      FontSize->10]], 
    SuperscriptBox["\[Delta]", 
     StyleBox[
      TemplateBox[{"d", "c"},
       "RowDefault"],
      FontSize->10]]}]}], "StandardForm"]], "Output",
 CellLabel->"Out[36]//NiceForm=",
 CellID->129551351,ExpressionUUID->"68f8c188-3a81-4879-8286-84c2bc937758"]
}, Open  ]],

Cell["or the Fierz identity for fundamental generators", "TechNoteMathCaption",
 CellID->1498261629,ExpressionUUID->"eac3b6af-41a5-4467-9e61-255c0b6b0313"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"t3", "[", 
     RowBox[{"a", ",", "i", ",", "j"}], "]"}], 
    RowBox[{"t3", "[", 
     RowBox[{"a", ",", "k", ",", "l"}], "]"}]}], "//", "ContractCGs"}], "//", 
  "NiceForm"}]], "Input",
 CellLabel->"In[37]:=",
 CellID->2037437528,ExpressionUUID->"53a7f9fa-6d6a-4950-b6d9-f689fc1f49bc"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], 
    SubsuperscriptBox["\[Delta]", 
     StyleBox["l",
      FontSize->10], 
     StyleBox["i",
      FontSize->10]], 
    SubsuperscriptBox["\[Delta]", 
     StyleBox["j",
      FontSize->10], 
     StyleBox["k",
      FontSize->10]]}], "-", 
   RowBox[{
    FractionBox["1", "6"], 
    SubsuperscriptBox["\[Delta]", 
     StyleBox["j",
      FontSize->10], 
     StyleBox["i",
      FontSize->10]], 
    SubsuperscriptBox["\[Delta]", 
     StyleBox["l",
      FontSize->10], 
     StyleBox["k",
      FontSize->10]]}]}], "StandardForm"]], "Output",
 CellLabel->"Out[37]//NiceForm=",
 CellID->25341095,ExpressionUUID->"c32e1ff2-ffcd-42f5-b745-b25a1b1188e8"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ContractCGs"]], "paclet:Matchete/ref/ContractCGs", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f297971e-4de2-412b-a713-8b4bc010c37f"],
 " is a versatile implementation of all manner of CG contractions. This \
versatility is due to contractions being performed numerically, a technique \
that is generally applicable to all possible CG contractions. However, \
numerical contractions of tensors can be computationally expensive, \
especially if the representations are large. "
}], "TechNoteText",
 CellID->1027299401,ExpressionUUID->"ad37c4a6-e6d2-4356-998f-6ea98c121c1a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Going outside the CG basis", "Subsection",
 CellID->1397868064,ExpressionUUID->"53ffb04a-3263-4d44-a2a1-397908c7ffa4"],

Cell[TextData[{
 "Finally, we see what happens when the predefined CGs are insufficient to \
identify a CG showing up in a product. In that case a new CG will simply be \
added and a message is displayed to inform the user about it. Any new CG \
defined this way can be used in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CG"]], "paclet:Matchete/ref/CG", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1d74b341-ab77-4334-8798-a590d35473e0"],
 " objects same as any user defined CGs."
}], "TechNoteText",
 CellID->149962616,ExpressionUUID->"28b9abf7-f0f2-494b-9d44-23570178f48f"],

Cell[TextData[{
 "An example of going outside the CG basis derived from the previously \
defined CGs is  the generator product ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["T", "A"], 
       SuperscriptBox["T", "B"]}], ")"}], "i"], "j"], TraditionalForm]],
  ExpressionUUID->"9b9b193b-89ee-4297-b2db-d7f10e5185e2"],
 " of two generators of the ",
 StyleBox["fund",
  FontWeight->"Bold"],
 " representation of ",
 StyleBox["SU3c",
  FontWeight->"Bold"],
 ": "
}], "TechNoteMathCaption",
 CellID->1326063212,ExpressionUUID->"00a6d355-80c6-47c3-85a4-a57062dddae4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"t3", "[", 
     RowBox[{"a", ",", "i", ",", "k"}], "]"}], 
    RowBox[{"t3", "[", 
     RowBox[{"b", ",", "k", ",", "j"}], "]"}]}], "//", "ContractCGs"}], "//", 
  "NiceForm"}]], "Input",
 CellLabel->"In[38]:=",
 CellID->559115518,ExpressionUUID->"9faa9767-d6c2-4c03-910c-bd369138935b"],

Cell[BoxData[
 InterpretationBox["\<\"Added new CG \\!\\(\\*RowBox[{\\\"cg1\\\"}]\\) with \
indices \\!\\(\\*RowBox[{\\\"{\\\", RowBox[{\\\"adj\\\", \\\",\\\", \
\\\"fund\\\", \\\",\\\", \\\"adj\\\", \\\",\\\", RowBox[{\\\"Bar\\\", \\\"[\\\
\", \\\"fund\\\", \\\"]\\\"}]}], \\\"}\\\"}]\\)\"\>",
  StringForm[
  "Added new CG `1` with indices `2`", $CellContext`cg1, {
   Matchete`adj, Matchete`fund, Matchete`adj, 
    Matchete`Bar[Matchete`fund]}],
  Editable->False]], "Echo",
 CellID->1658802775,ExpressionUUID->"f443917d-9699-4825-b958-64b5bfd25eef"],

Cell[BoxData[
 StyleBox[
  SubsuperscriptBox["cg1", 
   StyleBox["j",
    FontSize->10], 
   StyleBox[
    TemplateBox[{"a", "i", "b"},
     "RowDefault"],
    FontSize->10]], "StandardForm"]], "Output",
 CellLabel->"Out[38]//NiceForm=",
 CellID->865534071,ExpressionUUID->"f3adfdf0-d062-4b86-9e00-2f3b05eb1e9b"]
}, Open  ]],

Cell[TextData[{
 "The new CG gets a generic name, ",
 StyleBox["cg1",
  FontWeight->"Bold"],
 " in this case, the user might therefore wish to rename it for easier \
reference with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RenameCG"]], "paclet:Matchete/ref/RenameCG", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f38ae256-d26c-4233-b964-5e37bae612d1"],
 "; however, this is purely optional and not required to use the CG."
}], "TechNoteMathCaption",
 CellID->1561233747,ExpressionUUID->"d307db0f-2ffa-4e9c-9507-6dc560ffe68c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"RenameCG", "[", 
  RowBox[{"cg1", "\[Rule]", "t3t3"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"t3", "[", 
     RowBox[{"a", ",", "i", ",", "k"}], "]"}], 
    RowBox[{"t3", "[", 
     RowBox[{"b", ",", "k", ",", "j"}], "]"}]}], "//", "ContractCGs"}], "//", 
  "NiceForm"}]}], "Input",
 CellLabel->"In[39]:=",
 CellID->1700386783,ExpressionUUID->"d6f8be89-b924-4cb9-9a81-848d659f5f4b"],

Cell[BoxData[
 StyleBox[
  SubsuperscriptBox["t3t3", 
   StyleBox["j",
    FontSize->10], 
   StyleBox[
    TemplateBox[{"a", "i", "b"},
     "RowDefault"],
    FontSize->10]], "StandardForm"]], "Output",
 CellLabel->"Out[40]//NiceForm=",
 CellID->772010626,ExpressionUUID->"5e464aec-04d6-4773-819a-db3d38eeac2f"]
}, Open  ]],

Cell[TextData[{
 "Some detective work is typically required to figure out what a new CG is. \
Particularly if it got defined deep in some Matchete calculation outside the \
control of the user. It can also happen that a CG is defined during the \
course of an evaluation but never makes it to the output. The first clue is \
to look at the message informing about the creation of the new CG, which \
provides a list of the representation of all the indices of the new CG. In \
some simple cases the user might be able to identify the CG through the \
explicit tensor representation with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GetCGTensor"]], "paclet:Matchete/ref/GetCGTensor", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7799b95d-3fe7-48c9-81e4-ce72837e1aa7"],
 ", although more often than not this is next to meaningless to humans (and \
basis dependent). More commonly, the new CG can be traced back by using ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ReplaceCGs"]], "paclet:Matchete/ref/ReplaceCGs", 
     "Matchete Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dbea7d1d-9329-472d-9dd9-3f44a7fcbe16"],
 " to re-expand the new CG. By default ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ReplaceCGs"]], "paclet:Matchete/ref/ReplaceCGs", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "98526eda-5847-42af-968f-2231a039b36e"],
 " replaces all composite CGs created both by the user an automatically. \
Using the option ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CGsToReplace"]], "paclet:Matchete/ref/CGsToReplace", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "237cacc1-9e0e-4338-81a8-f0bb35391a22"],
 " (default ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ca23ac90-d826-46e6-a523-c2eecaa72720"],
 "), only the specified CGs will be replaced in an expression."
}], "TechNoteText",
 CellID->786367001,ExpressionUUID->"105f349f-b8ec-4371-b7bc-189d549dbd9e"],

Cell[TextData[{
 "The composite CGs ",
 StyleBox["Tr4",
  FontWeight->"Bold"],
 " (defined by the user with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DefineCompositeCG"]], "paclet:Matchete/ref/DefineCompositeCG", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d0fa461b-93b5-465a-b6e5-9e77b73bcdc7"],
 ") and ",
 StyleBox["t3t3",
  FontWeight->"Bold"],
 " (defined automatically during ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ContractCGs"]], "paclet:Matchete/ref/ContractCGs", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f6e3bfcd-8a43-4227-aa76-302560649d83"],
 ") can be replaced simultaneously or one at a time to reveal the underlying \
contraction of CGs: "
}], "TechNoteMathCaption",
 CellID->949318001,ExpressionUUID->"a80c4787-958b-4a04-8b8f-d57fbd91bd02"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ReplaceCGs", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Tr4", "[", 
       RowBox[{"a", ",", "b", ",", "c", ",", "e"}], "]"}], ",", 
      RowBox[{"t3t3", "[", 
       RowBox[{"a", ",", "i", ",", "b", ",", "j"}], "]"}]}], "}"}], "]"}], "//",
    "RelabelIndices"}], "//", "NiceForm"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ReplaceCGs", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Tr4", "[", 
        RowBox[{"a", ",", "b", ",", "c", ",", "e"}], "]"}], ",", 
       RowBox[{"t3t3", "[", 
        RowBox[{"a", ",", "i", ",", "b", ",", "j"}], "]"}]}], "}"}], ",", 
     RowBox[{"CGsToReplace", "\[Rule]", 
      RowBox[{"{", "t3t3", "}"}]}]}], "]"}], "//", "RelabelIndices"}], "//", 
  "NiceForm"}]}], "Input",
 CellLabel->"In[41]:=",
 CellID->1531629244,ExpressionUUID->"3e035f93-eb9e-410e-a2f6-a10e5b9aea3d"],

Cell[BoxData[
 StyleBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["t3", 
      StyleBox["y",
       FontSize->10], 
      StyleBox[
       TemplateBox[{"a", "x"},
        "RowDefault"],
       FontSize->10]], 
     SubsuperscriptBox["t3", 
      StyleBox["z",
       FontSize->10], 
      StyleBox[
       TemplateBox[{"b", "y"},
        "RowDefault"],
       FontSize->10]], 
     SubsuperscriptBox["t3", 
      StyleBox[
       SubscriptBox["x", "1"],
       FontSize->10], 
      StyleBox[
       TemplateBox[{"c", "z"},
        "RowDefault"],
       FontSize->10]], 
     SubsuperscriptBox["t3", 
      StyleBox["x",
       FontSize->10], 
      StyleBox[
       TemplateBox[{"e", 
         SubscriptBox["x", "1"]},
        "RowDefault"],
       FontSize->10]]}], ",", 
    RowBox[{
     SubsuperscriptBox["t3", 
      StyleBox["x",
       FontSize->10], 
      StyleBox[
       TemplateBox[{"a", "i"},
        "RowDefault"],
       FontSize->10]], 
     SubsuperscriptBox["t3", 
      StyleBox["j",
       FontSize->10], 
      StyleBox[
       TemplateBox[{"b", "x"},
        "RowDefault"],
       FontSize->10]]}]}], "}"}], "StandardForm"]], "Output",
 CellLabel->"Out[41]//NiceForm=",
 CellID->1354423416,ExpressionUUID->"ef60995a-0c86-46c1-88cb-69d5043d5507"],

Cell[BoxData[
 StyleBox[
  RowBox[{"{", 
   RowBox[{
    SuperscriptBox["Tr4", 
     StyleBox[
      TemplateBox[{"a", "b", "c", "e"},
       "RowDefault"],
      FontSize->10]], ",", 
    RowBox[{
     SubsuperscriptBox["t3", 
      StyleBox["x",
       FontSize->10], 
      StyleBox[
       TemplateBox[{"a", "i"},
        "RowDefault"],
       FontSize->10]], 
     SubsuperscriptBox["t3", 
      StyleBox["j",
       FontSize->10], 
      StyleBox[
       TemplateBox[{"b", "x"},
        "RowDefault"],
       FontSize->10]]}]}], "}"}], "StandardForm"]], "Output",
 CellLabel->"Out[42]//NiceForm=",
 CellID->467694512,ExpressionUUID->"f4ed90cc-be96-46f0-81c9-25c3453c2438"]
}, Open  ]],

Cell["\<\
The user might wonder what then is the reason for adding the new CG at all if \
we simply wish to deconstruct it again? The benefit is that it simplifies \
expressions, and removes all internal index contractions, which helps \
identify and collect terms in complicated expressions.\
\>", "TechNoteText",
 CellID->2098098696,ExpressionUUID->"25e1ada2-b121-4c69-acf1-3d042f754d91"],

Cell[TextData[{
 "Having defined ",
 StyleBox["t3t3", "Input",
  FontWeight->"Bold"],
 ", it becomes active in the CG basis and it can be identified in other CG \
contractions, such as"
}], "TechNoteMathCaption",
 CellID->1890811392,ExpressionUUID->"c5bf062e-dbcb-44ce-931a-484ebac5771f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"t3", "[", 
     RowBox[{"a", ",", "i", ",", "k"}], "]"}], 
    RowBox[{"t3", "[", 
     RowBox[{"c", ",", "k", ",", "l"}], "]"}], 
    RowBox[{"t3", "[", 
     RowBox[{"b", ",", "l", ",", "m"}], "]"}], 
    RowBox[{"t3", "[", 
     RowBox[{"c", ",", "m", ",", "j"}], "]"}]}], "//", "ContractCGs"}], "//", 
  "NiceForm"}]], "Input",
 CellLabel->"In[43]:=",
 CellID->404057038,ExpressionUUID->"63a4afe7-dc41-4f90-bbd7-e6ed8ff3f5f3"],

Cell[BoxData[
 StyleBox[
  RowBox[{"-", 
   FractionBox["1", "6"], 
   SubsuperscriptBox["t3t3", 
    StyleBox["j",
     FontSize->10], 
    StyleBox[
     TemplateBox[{"a", "i", "b"},
      "RowDefault"],
     FontSize->10]]}], "StandardForm"]], "Output",
 CellLabel->"Out[43]//NiceForm=",
 CellID->60237728,ExpressionUUID->"393164e4-d832-4cda-b88c-5d409a8d8956"]
}, Open  ]],

Cell["\<\
When dealing with new composite CGs showing up in a calculation, it can at \
times be beneficial to go back to the beginning and add a specific suitable \
CG to the basis (with definite symmetries) rather than relying on those that \
are automatically defined. Matchete does not attempt to be clever when \
assigning new CGs but takes the first new contraction that goes outside its \
basis as a new basis element with no consideration for further \
practicalities. \
\>", "TechNoteText",
 CellID->447073332,ExpressionUUID->"4611f3dd-eaba-4479-b156-6f630d135909"],

Cell[TextData[{
 "In place of the contraction of two ",
 StyleBox["fund",
  FontWeight->"Bold"],
 " generators, which does not poses any definite symmetry between the two \
adjoint indices, we might instead contract the generator with the ",
 StyleBox["f3",
  FontWeight->"Bold"],
 " or ",
 StyleBox["d3",
  FontWeight->"Bold"],
 " tensors. So we remove the automatically defined tensor (removing it from \
the basis) and define the two new tensors"
}], "TechNoteMathCaption",
 CellID->7963293,ExpressionUUID->"f1abdeb8-5748-4f5f-b044-1968ad3b33fd"],

Cell[BoxData[{
 RowBox[{"RemoveCG", "[", "t3t3", "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCompositeCG", "[", 
  RowBox[{"tf3", ",", 
   RowBox[{"{", 
    RowBox[{"f3", ",", "t3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "i", ",", "j"}], "}"}]}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCompositeCG", "[", 
  RowBox[{"td3", ",", 
   RowBox[{"{", 
    RowBox[{"d3", ",", "t3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "i", ",", "j"}], "}"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[44]:=",
 CellID->695079337,ExpressionUUID->"c7183d38-53d9-4128-b685-b118ecd9ed9b"],

Cell["\<\
This time the projection of the generator product onto the basis space is \
done exclusively in terms of CGs that we have manually defined: CGs with \
definite symmetries between the adjoint indices:\
\>", "TechNoteMathCaption",
 CellID->1449729939,ExpressionUUID->"097974dc-a0d3-4d9a-b334-41a15a099905"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"t3", "[", 
     RowBox[{"a", ",", "i", ",", "k"}], "]"}], 
    RowBox[{"t3", "[", 
     RowBox[{"b", ",", "k", ",", "j"}], "]"}]}], "//", "ContractCGs"}], "//", 
  "NiceForm"}]], "Input",
 CellLabel->"In[47]:=",
 CellID->261625911,ExpressionUUID->"3b2f21f8-3bf9-46fb-aa48-aab13742698b"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], 
    SubsuperscriptBox["td3", 
     StyleBox["j",
      FontSize->10], 
     StyleBox[
      TemplateBox[{"a", "b", "i"},
       "RowDefault"],
      FontSize->10]]}], "+", 
   RowBox[{
    FractionBox["\[ImaginaryI]", "2"], 
    SubsuperscriptBox["tf3", 
     StyleBox["j",
      FontSize->10], 
     StyleBox[
      TemplateBox[{"a", "b", "i"},
       "RowDefault"],
      FontSize->10]]}], "+", 
   RowBox[{
    FractionBox["1", "6"], 
    SuperscriptBox["\[Delta]", 
     StyleBox[
      TemplateBox[{"a", "b"},
       "RowDefault"],
      FontSize->10]], 
    SubsuperscriptBox["\[Delta]", 
     StyleBox["j",
      FontSize->10], 
     StyleBox["i",
      FontSize->10]]}]}], "StandardForm"]], "Output",
 CellLabel->"Out[47]//NiceForm=",
 CellID->657037245,ExpressionUUID->"e49cc6fa-a875-4740-a342-224f1132a781"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[BoxData[GridBox[{
   {
