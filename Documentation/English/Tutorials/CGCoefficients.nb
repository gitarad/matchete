Cell[CellGroupData[{

Cell["Cleanup", "Subsection",
 CellID->1313888525,ExpressionUUID->"91abe987-5724-4ad5-a914-4ee94bc65ebd"],

Cell[TextData[{
 "Several functions are available to remove already loaded definitions of \
groups, representations, and CGs. When removing any of these, the functions \
automatically removes all associated definitions that rely on the one \
removed. These functions can be convenient when making mistakes during the \
setup of a model or something similar. In most other cases, the user may \
simply rely on ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ResetAll"]], "paclet:Matchete/ref/ResetAll", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "84898c55-ac19-40a1-871f-3211a07b2581"],
 ", which also removes all group definitions."
}], "TechNoteText",
 CellID->1213726680,ExpressionUUID->"c73ad3bb-87eb-4f35-87b6-d9b9a9536a91"],

Cell[BoxData[GridBox[{
   {
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["RemoveCG"]], "paclet:Matchete/ref/RemoveCG", 
       "Matchete Package Symbol"},
      "PackageLink",
      BaseStyle->{"DefinitionBox", CellFrame -> 0}], "[", 
     StyleBox["cgName", "TI"], "]"}], Cell[
    "removes the definition of a CG symbol.", "TechNoteTableText",
     ExpressionUUID->"37a974d5-2fd8-4abb-8796-759372db2fbb"]},
   {
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["RemoveRepresentation"]], 
       "paclet:Matchete/ref/RemoveRepresentation", "Matchete Package Symbol"},
      
      "PackageLink",
      BaseStyle->{"DefinitionBox", CellFrame -> 0}], "[", 
     StyleBox["repName", "TI"], "]"}], Cell["\<\
removes the definition of a representation and all associated CGs.\
\>", "TechNoteTableText",ExpressionUUID->
     "1c03c23e-890a-4159-9ec7-93a2897e4b96"]},
   {
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["RemoveGroup"]], "paclet:Matchete/ref/RemoveGroup", 
       "Matchete Package Symbol"},
      "PackageLink",
      BaseStyle->{"DefinitionBox", CellFrame -> 0}], "[", 
     StyleBox["groupName", "TI"], "]"}], Cell["\<\
removes the definition of a group and all associated representations.\
\>", "TechNoteTableText",ExpressionUUID->
     "c2344284-9b31-478f-bcd8-b6c655e50fa9"]},
   {
    RowBox[{
     TemplateBox[{
       Cell[
        TextData["ClearGroups"]], "paclet:Matchete/ref/ClearGroups", 
       "Matchete Package Symbol"},
      "PackageLink",
      BaseStyle->{"DefinitionBox", CellFrame -> 0}], "[", "]"}], Cell[
    "Removes all defined groups, representations and CGs.", 
     "TechNoteTableText",ExpressionUUID->
     "c3aaae97-6342-42e4-8aad-665cca3891da"]}
  }]], "DefinitionBox",
 CellID->500697427,ExpressionUUID->"68366f02-1b4c-47f1-903a-ee42d6cc1aa3"],

Cell["\<\
Functions to remove previously defined group, representation, and CG symbols.\
\
\>", "TechNoteCaption",
 CellID->1380726643,ExpressionUUID->"366ba8c6-bbed-492a-be09-86b1ab173275"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Contracting CGs", "TechNoteSection",
 CellID->659413397,ExpressionUUID->"65d00db8-5cbb-438b-a6e4-0e2dfab133f6"],

Cell[CellGroupData[{

Cell["Evaluating CG contractions ", "Subsection",
 CellID->908394077,ExpressionUUID->"4254af29-1eaa-4f2c-84b4-3994956d3c3a"],

Cell[TextData[{
 "To evaluate contractions between CGs, we use the function ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ContractCGs"]], "paclet:Matchete/ref/ContractCGs", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "93f7cdda-5127-48fc-a47b-070af4d00d5f"],
 " , which will evaluate ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CG"]], "paclet:Matchete/ref/CG", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "35b94f67-8427-4dea-8b7e-26b7d2b29c77"],
 " contractions appearing in all terms of an expression. That is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ContractCGs"]], "paclet:Matchete/ref/ContractCGs", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3737c925-bc66-4017-8b87-e21db4dd3e48"],
 " carries out all Einstein summation between CGs,  producing a result with \
no dummy-index contractions between CGs . To see how this works in practice, \
consider the following examples:  "
}], "TechNoteText",
 CellID->850818125,ExpressionUUID->"194a1dbc-39f9-4470-9042-93812b19b0f2"],

Cell[TextData[{
 "The quadratic Casimir operator formed by two ",
 StyleBox["fund",
  FontWeight->"Bold"],
 " generators of ",
 StyleBox["SU3c",
  FontWeight->"Bold"],
 ":"
}], "TechNoteMathCaption",
 CellID->1319449335,ExpressionUUID->"755f3358-f096-493e-b4d1-f04eed05bd85"],

