Cell[TextData[{
 "This note discusses the details of the \[ScriptD]-dimensional Dirac algebra \
as implemented in Matchete. At present Matchete operates with an \
anti-commuting implementation of ",
 Cell[BoxData[
  SubscriptBox["\[Gamma]", "5"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b2f9c320-5914-41a9-94c5-ebc7e210c3a2"],
 " (Naive Dimensional Regularization), which implies that the ",
 StyleBox["Dirac trace is non-cyclic",
  FontSlant->"Italic"],
 " in order to avoid mathematical inconsistencies."
}], "TechNoteText",
 CellID->1504910134,ExpressionUUID->"dbebc0c8-bc89-40cd-93a0-a97baa8e2e72"],

Cell[BoxData[GridBox[{
   {Cell[TextData[Cell[BoxData[
     FormBox[Cell[TextData[Cell[BoxData[
       FormBox[
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           SubscriptBox["\[Gamma]", "\[Mu]"], ",", 
           SubscriptBox["\[Gamma]", "\[Nu]"]}], "}"}], " ", "=", " ", 
         RowBox[{"2", " ", 
          SubscriptBox["g", "\[Mu]\[Nu]"]}]}], TraditionalForm]], 
       "InlineFormula",ExpressionUUID->
       "c4a15262-fe15-430e-bf7f-07e098ff48b4"]],ExpressionUUID->
       "fc0ddc4f-1653-40ce-a669-d4da03dae7bc"], TraditionalForm]], 
     "InlineFormula",
     FontFamily->"Source Sans Pro",ExpressionUUID->
     "48b81155-e79e-4050-aeb1-d77580beec70"]],ExpressionUUID->
     "2e6d6f1a-beb7-474a-a10d-1529fc950cb0"], Cell[TextData[Cell[BoxData[
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["\[Gamma]", "\[Mu]"], ",", " ", 
        SubscriptBox["\[Gamma]", "5"]}], "}"}], " ", "=", " ", "0"}]], 
     "InlineFormula",
     FontFamily->"Source Sans Pro",ExpressionUUID->
     "1190598c-f8ef-4b5f-9d8a-191bd828cb57"]],ExpressionUUID->
     "2494da2e-096d-4931-9d9c-97515370a87f"], Cell[TextData[Cell[BoxData[
     RowBox[{
      SuperscriptBox[
       SubscriptBox["\[Gamma]", "5"], "2"], " ", "=", " ", "1"}]], 
     "InlineFormula",
     FontFamily->"Source Sans Pro",ExpressionUUID->
     "f21591d4-aa01-4f55-a79e-4e473352db02"]], "TechNoteTableText",
     ExpressionUUID->"3f083792-8575-4d88-8521-4201ff912555"]}
  }]], "DefinitionBox3Col",
 CellID->1631537412,ExpressionUUID->"2a9eb469-e75d-4c2b-9c9f-bece0f48c1b2"],

Cell["\<\
Definitions for the \[ScriptD]-dimensional continuation of the Dirac algebra.\
\
\>", "TechNoteCaption",
 CellID->30594941,ExpressionUUID->"dd8d98dd-ac47-4810-a96f-d731711f33db"],

Cell[TextData[{
 "Thus, ",
 Cell[BoxData[
  SubscriptBox["\[Gamma]", "5"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9a98fdd1-4f55-4a69-bea7-6f54171197bd"],
 " is treated as a purely symbolic object and does not equate to an \
antisymmetric combination of four ordinary Dirac matrices. "
}], "TechNoteText",
 CellID->1012962278,ExpressionUUID->"7d2fbc67-28df-4ee6-b8da-ff5820df0b83"],

