Cell["\<\
Basic objects of the Dirac algebra with their convenient user-exposed \
notation and their internal representation.\
\>", "TechNoteCaption",
 CellID->621993569,ExpressionUUID->"db0c29c0-d30e-44d5-a9b3-4645f30617fc"],

Cell[TextData[{
 "Matrix multiplication in the space of Dirac algebra is done with ",
 ButtonBox["NonCommutativeMultiply",
  BaseStyle->"Link",
  ButtonData->"paclet:Matchete/ref/NonCommutativeMultiply"],
 ", which can be input with the in build Mathematica notation \"",
 StyleBox["**", "Input"],
 ".\" This Dirac spinors in the form of fermion fields, can also multiply in \
to the spin chains, created with ",
 ButtonBox["NonCommutativeMultiply",
  BaseStyle->"Link",
  ButtonData->"paclet:Matchete/ref/NonCommutativeMultiply"],
 ". All Dirac matrices in a spin chain get merged into a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiracProduct"]], "paclet:Matchete/ref/DiracProduct", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "30cee8c1-bb21-4397-b465-133411d987b6"],
 " head."
}], "TechNoteText",
 CellID->60265350,ExpressionUUID->"5a8bb25a-3d80-44e9-b4ff-2420d841a49f"],

Cell["An example of a Dirac product contraction is", "TechNoteMathCaption",
 CellID->1450927200,ExpressionUUID->"cd4b5d0e-4eff-490a-a936-b2094525c4b2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Gamma]", "[", "\[Mu]", "]"}], "**", 
  "PL"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[3]:=",
 CellID->1056638715,ExpressionUUID->"a90562e0-8a34-4922-9587-04b34e96a717"],

Cell[BoxData[
 RowBox[{"NonCommutativeMultiply", "[", 
  RowBox[{"DiracProduct", "[", 
   RowBox[{
    RowBox[{"GammaM", "[", 
     RowBox[{"Index", "[", 
      RowBox[{"\[Mu]", ",", "Lorentz"}], "]"}], "]"}], ",", 
    RowBox[{"Proj", "[", 
     RowBox[{"-", "1"}], "]"}]}], "]"}], "]"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->251864891,ExpressionUUID->"88115c31-a854-4fd2-811a-ca91795449ab"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   SubscriptBox["\[Gamma]", 
    StyleBox["\[Mu]",
     FontSize->10]], 
   SubscriptBox["P", "L"]}], "StandardForm"]], "Output",
 CellLabel->"Out[4]//NiceForm=",
 CellID->402954800,ExpressionUUID->"c3e2f837-b13e-4772-8f7a-7851cbec872b"]
}, Open  ]],

