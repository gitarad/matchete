 CellID->1005607572,ExpressionUUID->"d8416f77-2c47-4410-a464-48755cbced3e"],

Cell[BoxData[
 StyleBox[
  SuperscriptBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["\[Mu]",
     FontSize->10]], "T"], "StandardForm"]], "Output",
 CellLabel->"Out[6]//NiceForm=",
 CellID->244108599,ExpressionUUID->"00f87280-4bed-442f-8673-6c60f8410d2d"]
}, Open  ]],

Cell[TextData[{
 "The charge conjugation matrices, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CC"]], "paclet:Matchete/ref/CC", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a6765da8-102d-4219-9f37-83910519a4ec"],
 "/",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GammaCC"]], "paclet:Matchete/ref/GammaCC", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7cb5073b-dc45-4616-a53c-a57b32c0b346"],
 ", in \[ScriptD]-dimensions, are defined by the properties "
}], "TechNoteText",
 CellID->1484938474,ExpressionUUID->"53f6ea5d-2dd4-4d6a-8701-7187043a5fad"],

Cell[BoxData[GridBox[{
   {Cell[TextData[Cell[BoxData[
     FormBox[
      RowBox[{
       SuperscriptBox["C", 
        RowBox[{"-", "1"}]], "=", 
       RowBox[{
        SuperscriptBox["C", "T"], "=", 
        RowBox[{"-", "C"}]}]}], TraditionalForm]], "InlineFormula",
     FontFamily->"Source Sans Pro",ExpressionUUID->
     "f4f6ac8f-0238-4fec-a13b-1d00b55858dc"]],ExpressionUUID->
     "5e24c796-4699-4f0b-8a20-63c7e328af57"], Cell[TextData[Cell[BoxData[
     FormBox[
      RowBox[{
       RowBox[{
        SubscriptBox["C\[Gamma]", "\[Mu]"], "C"}], "=", 
       SubsuperscriptBox["\[Gamma]", "\[Mu]", "T"]}], TraditionalForm]], 
     "InlineFormula",
     FontFamily->"Source Sans Pro",ExpressionUUID->
     "7b859f84-d333-44d4-8c9d-84b89c2d5164"]],ExpressionUUID->
     "89c9e449-31e5-4db0-8229-f4ec8ca3be59"], Cell[TextData[Cell[BoxData[
    Cell[TextData[Cell[BoxData[
      FormBox[
       RowBox[{
        RowBox[{
         SubscriptBox["C\[Gamma]", "5"], "C"}], "=", 
        RowBox[{"-", 
         SubsuperscriptBox["\[Gamma]", "5", "T"]}]}], TraditionalForm]], 
      "InlineFormula",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "1965435c-8767-4db7-a431-07678ed7a13c"]],ExpressionUUID->
      "56688645-a5ed-49af-a4c8-8f6f1b7afa9d"]],ExpressionUUID->
     "7d52603f-b3f0-4d00-be58-1375aac16627"]], "TechNoteTableText",
     ExpressionUUID->"b96cb324-2e5a-4eb1-adbb-2d0d26044d30"]}
  }]], "DefinitionBox3Col",
 CellID->1203310694,ExpressionUUID->"54d2a55c-89bd-4087-b666-e97a7e08ac22"],

Cell["Properties of the charge conjugation matrix.", "TechNoteCaption",
 CellID->1189330259,ExpressionUUID->"a6cd2ccc-13b3-4a7d-b6e8-929fdb8f4414"],

Cell["\<\
These properties are a continuation of the four-dimensional identities (with \
the choice of a real C)\
\>", "TechNoteText",
 CellID->1727980790,ExpressionUUID->"16c061e3-d03c-476a-bd28-1de3c97fbe72"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Simplifying \[ScriptD]-dimensional Dirac products ", "TechNoteSection",
 CellID->1827763707,ExpressionUUID->"dd76ae8e-11ef-469f-8a66-146c811c4d8f"],

Cell["\<\
The basis for the \[ScriptD]-dimensional Dirac algebra is infinite \
dimensional. A suitable basis is formed by all anti-symmetrized products of \
the gamma matrices. We use the notation \
\>", "TechNoteText",
 CellID->546840777,ExpressionUUID->"20185cc4-ba15-4cdf-bdc4-fd714c3d723a"],

Cell[TextData[{
 "\[RawEscape]",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", 
    RowBox[{
     SubscriptBox["\[Mu]", "1"], 
     SubscriptBox["\[Ellipsis]\[Mu]", "n"]}]], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"n", "!"}]], 
    RowBox[{
     UnderscriptBox["\[Sum]", "\[Sigma]"], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "\[Sigma]"], " ", 
      SubscriptBox["\[Gamma]", 
       SubscriptBox["\[Mu]", 
        RowBox[{"\[Sigma]", 
         RowBox[{"(", "1", ")"}]}]]], 
      SubscriptBox["\[Ellipsis]\[Gamma]", 
       SubscriptBox["\[Mu]", 
        RowBox[{"\[Sigma]", 
         RowBox[{"(", "n", ")"}]}]]]}]}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c180635b-8d0f-4c73-82e5-f11b2442996e"]
}], "DisplayMath",
 CellID->1938153869,ExpressionUUID->"e2d34472-74c1-436f-94ce-50a158c0ce53"],

Cell["\<\
for these basis tensors, and they can be entered conveniently as, e.g.,  \
\>", "TechNoteText",
 CellID->1384749460,ExpressionUUID->"877e2244-0230-4ab4-b747-be5563b582df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Gamma]", "[", 
   RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "//", "NiceForm"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->626937853,ExpressionUUID->"a14e92d6-9f9e-40a6-92dd-c323d6553525"],

Cell[BoxData[
 StyleBox[
  SubscriptBox["\[CapitalGamma]", 
   StyleBox[
    TemplateBox[{"\[Mu]", "\[Nu]"},
     "RowDefault"],
    FontSize->10]], "StandardForm"]], "Output",
 CellLabel->"Out[7]//NiceForm=",
 CellID->1039457623,ExpressionUUID->"8e8c3a5e-10e9-4ce1-9d27-01e8c5a894fe"]
}, Open  ]],

Cell[TextData[{
 "Matchete, therefore, do not operator with the familiar sigma tensor, but \
rather uses  ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[CapitalGamma]", "\[Mu]\[Nu]"], "=", " ", 
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    SubscriptBox["\[Sigma]", "\[Mu]\[Nu]"]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a972c18c-427c-4020-bf58-6f87f8721cd7"],
 ".  "
}], "TechNoteText",
 CellID->925673649,ExpressionUUID->"f4e124fb-0ffd-42a0-9b9a-bfbad28059ad"],

Cell[TextData[{
 "Any product of Dirac matrices can be expressed as a sum of the \
anti-symmetric basis tensors. This is done automatically with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RefineDiracProducts"]], 
    "paclet:Matchete/ref/RefineDiracProducts", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b8d4ac65-733f-4556-9c72-fc7972a6c1a9"],
 ": "
}], "TechNoteMathCaption",
 CellID->1883303921,ExpressionUUID->"a04b704a-a5f4-4fcf-b15c-23fd95ef55f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Gamma]", "[", 
     RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "**", 
    RowBox[{"\[Gamma]", "[", "\[Rho]", "]"}]}], "//", "RefineDiracProducts"}],
   "//", "NiceForm"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->927527114,ExpressionUUID->"fe3195ef-b592-46e3-a30d-e5dbb3a09f2d"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Gamma]", 
     StyleBox["\[Mu]",
      FontSize->10]], 
    SubscriptBox["g", 
     StyleBox[
      TemplateBox[{"\[Nu]", "\[Rho]"},
       "RowDefault"],
      FontSize->10]]}], "-", 
   RowBox[{
    SubscriptBox["\[Gamma]", 
     StyleBox["\[Nu]",
      FontSize->10]], 
    SubscriptBox["g", 
     StyleBox[
      TemplateBox[{"\[Mu]", "\[Rho]"},
       "RowDefault"],
      FontSize->10]]}], "+", 
   SubscriptBox["\[CapitalGamma]", 
    StyleBox[
     TemplateBox[{"\[Mu]", "\[Nu]", "\[Rho]"},
      "RowDefault"],
     FontSize->10]]}], "StandardForm"]], "Output",
 CellLabel->"Out[8]//NiceForm=",
 CellID->384801416,ExpressionUUID->"cbd92cbc-cbe1-4a46-b6ce-99c2015df328"]
}, Open  ]],

Cell["\<\
This function can also be used in cases where some of the Lorentz indices are \
contracted with each other:\
\>", "TechNoteMathCaption",
 CellID->1733982266,ExpressionUUID->"d79f927d-278d-4486-99c5-e43409259e14"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[Gamma]", "[", 
       RowBox[{"a", ",", "b"}], "]"}], "**", 
      RowBox[{"\[Gamma]", "[", 
       RowBox[{"b", ",", "c", ",", "d"}], "]"}], "**", "PL"}], "//", 
     "RefineDiracProducts"}], "//", "ContractMetric"}], "//", "Simplify"}], "//",
   "NiceForm"}]], "Input",
 CellLabel->"In[9]:=",
 CellID->591454702,ExpressionUUID->"25392bb9-cae9-4e62-9ff9-edd533af6187"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", " ", 
     FormBox[
      StyleBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], "+", "\[ScriptD]"}], ")"}],
       SpanSymmetric->False],
      StandardForm]}], 
    RowBox[{
     SubscriptBox["\[Gamma]", 
      StyleBox["c",
       FontSize->10]], 
     SubscriptBox["P", "L"]}], 
    SubscriptBox["g", 
     StyleBox[
      TemplateBox[{"a", "d"},
       "RowDefault"],
      FontSize->10]]}], "+", " ", 
   RowBox[{
    FormBox[
     StyleBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "\[ScriptD]"}], ")"}],
      SpanSymmetric->False],
     StandardForm], 
    RowBox[{
     SubscriptBox["\[Gamma]", 
      StyleBox["d",
       FontSize->10]], 
     SubscriptBox["P", "L"]}], 
    SubscriptBox["g", 
     StyleBox[
      TemplateBox[{"a", "c"},
       "RowDefault"],
      FontSize->10]]}], "+", " ", 
   RowBox[{
    FormBox[
     StyleBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "3"}], "+", "\[ScriptD]"}], ")"}],
      SpanSymmetric->False],
     StandardForm], 
    RowBox[{
     SubscriptBox["\[CapitalGamma]", 
      StyleBox[
       TemplateBox[{"a", "c", "d"},
        "RowDefault"],
       FontSize->10]], 
     SubscriptBox["P", "L"]}]}]}], "StandardForm"]], "Output",
 CellLabel->"Out[9]//NiceForm=",
 CellID->1284137595,ExpressionUUID->"16c62e86-cbe5-4039-b286-386d6199487d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Dirac traces", "TechNoteSection",
 CellID->405537326,ExpressionUUID->"2a91632b-9119-42b6-9534-4f0970e74fbb"],

Cell[TextData[{
 "Dirac traces of a product of Dirac matrices can be performed with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiracTrace"]], "paclet:Matchete/ref/DiracTrace", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "422c46df-b1b1-4177-a413-60ff5fc15c3c"],
 ". Dirac tracing using anti-commuting ",
 Cell[BoxData[
  SubscriptBox["\[Gamma]", "5"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a147915f-68c5-47a8-8b16-36dd27af2264"],
 " is known to cause mathematical ambiguities."
}], "TechNoteText",
 CellID->955253495,ExpressionUUID->"6b7b9a81-e9fb-4ef6-8f07-9ba02c3c12b9"],

Cell[TextData[{
 "For traces with and even number of ",
 Cell[BoxData[
  SubscriptBox["\[Gamma]", "5"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e2ff63e4-74a4-44a9-ba41-f78a822e0b94"],
 " matrices, the ",
 Cell[BoxData[
  SubscriptBox["\[Gamma]", "5"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4bb6f499-145b-4f57-93fc-afd1ac883eca"],
 " matrices can be anti-commuted until they are next to each other and \
produce the identity. These traces are unambiguous and reproduce the \
Four-dimensional result, but with \[ScriptD]-dimensional metrics (unless some \
of the indices are contracted)."
}], "TechNoteText",
 CellID->1082175686,ExpressionUUID->"8fbc98dd-f228-4df6-98ee-e6f226cbe4dd"],

Cell["A classic example is the trace of four gamma matrices. ", \
"TechNoteMathCaption",
 CellID->1672194018,ExpressionUUID->"01a5f47d-acca-414b-ad0c-8f07aeab337e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Gamma]", "[", "\[Mu]", "]"}], "**", 
    RowBox[{"\[Gamma]", "[", "\[Nu]", "]"}], "**", 
    RowBox[{"\[Gamma]", "[", "\[Rho]", "]"}], "**", 
    RowBox[{"\[Gamma]", "[", "\[Sigma]", "]"}]}], "//", "DiracTrace"}], "//", 
  "NiceForm"}]], "Input",
 CellLabel->"In[10]:=",
 CellID->1745838717,ExpressionUUID->"ae1b50f7-740d-4c7a-933d-385c975c94df"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"4", 
    SubscriptBox["g", 
     StyleBox[
      TemplateBox[{"\[Mu]", "\[Sigma]"},
       "RowDefault"],
      FontSize->10]], 
    SubscriptBox["g", 
     StyleBox[
      TemplateBox[{"\[Nu]", "\[Rho]"},
       "RowDefault"],
      FontSize->10]]}], "-", 
   RowBox[{"4", 
    SubscriptBox["g", 
     StyleBox[
      TemplateBox[{"\[Mu]", "\[Rho]"},
       "RowDefault"],
      FontSize->10]], 
    SubscriptBox["g", 
     StyleBox[
      TemplateBox[{"\[Nu]", "\[Sigma]"},
       "RowDefault"],
      FontSize->10]]}], "+", 
   RowBox[{"4", 
    SubscriptBox["g", 
     StyleBox[
      TemplateBox[{"\[Mu]", "\[Nu]"},
       "RowDefault"],
      FontSize->10]], 
    SubscriptBox["g", 
     StyleBox[
      TemplateBox[{"\[Rho]", "\[Sigma]"},
       "RowDefault"],
      FontSize->10]]}]}], "StandardForm"]], "Output",
 CellLabel->"Out[10]//NiceForm=",
 CellID->289906815,ExpressionUUID->"d1aab598-3013-42f6-81cf-4f564f279017"]
}, Open  ]],

Cell[TextData[{
 "In traces with an odd number of ",
 Cell[BoxData[
  SubscriptBox["\[Gamma]", "5"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b1bb65eb-78d8-496f-a3a1-cb88c4c1d0b0"],
 " matrices, mathematical consistency can be obtained only by giving up on \
trace cyclicity; that is, in traces with six or more ordinary Dirac matrices \
in addition to ",
 Cell[BoxData[
  SubscriptBox["\[Gamma]", "5"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fa01f01a-03c8-4cc5-8712-7627d3434087"],
 ", we cannot freely cycle matrices in the trace. This introduces an \
ambiguous ",
 Cell[BoxData[
  RowBox[{"\[ScriptCapitalO]", 
   RowBox[{"(", "\[Epsilon]", ")"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fd18b1df-d553-45ec-aeaf-bd57dc767395"],
 " piece of the trace, which depends on where the trace is started.  A \
definite value is assigned to the ",
 Cell[BoxData[
  SubscriptBox["\[Gamma]", "5"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "90f20c7a-db89-41b4-a5b7-9fc6d305721f"],
 "-odd traces following from the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["KKS prescription"]], 
    "https://inspirehep.net/literature/318268"},
   "WebLink",
   BaseStyle->{"TechNoteText"}]],ExpressionUUID->
  "9b257a00-02cc-4d8b-b29f-7da3d7f2e3a9"],
 ". This prescription relies on the unique projection of gamma matrices onto \
the basis of anti-symmetric combinations, ",
 Cell[BoxData[
  SubscriptBox["\[CapitalGamma]", 
   RowBox[{
    SubscriptBox["\[Mu]", "1"], 
    SubscriptBox["\[Mu]", "2"], "\[Ellipsis]"}]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fb09f971-3d4e-41ad-8c56-5264a3d45bc9"],
 ". We define "
}], "TechNoteText",
 CellID->119067779,ExpressionUUID->"a98ee4d6-7e63-48db-ab51-64d8ab4fc653"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Tr", "[", 
    RowBox[{
     SubscriptBox["\[CapitalGamma]", 
      RowBox[{
       SubscriptBox["\[Mu]", "1"], 
       SubscriptBox["\[Ellipsis]\[Mu]", "n"]}]], 
     SubscriptBox["\[Gamma]", "5"]}], "]"}], "=", 
   TagBox[GridBox[{
      {"\[Piecewise]", GridBox[{
         {
          RowBox[{
           RowBox[{"-", "4"}], 
           SubscriptBox["\[ImaginaryI]\[CurlyEpsilon]", 
            RowBox[{
             SubscriptBox["\[Mu]", "1"], 
             SubscriptBox["\[Mu]", "2"], 
             SubscriptBox["\[Mu]", "3"], 
             SubscriptBox["\[Mu]", "4"]}]]}], 
          RowBox[{
           RowBox[{"for", " ", "n"}], "=", "4"}]},
         {"0", 
          RowBox[{
           RowBox[{"for", " ", "n"}], "\[NotEqual]", "4"}]}
        },
        AllowedDimensions->{2, Automatic},
        Editable->True,
        GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
        GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.84]}, 
            Offset[0.27999999999999997`]}, "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}},
        Selectable->True]}
     },
     GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
     GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.35]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}],
    "Piecewise",
    DeleteWithContents->True,
    Editable->False,
    SelectWithContents->True,
    Selectable->False,
    StripWrapperBoxes->True]}], TraditionalForm]], "InlineFormula",
 FontFamily->
  "Source Sans Pro",ExpressionUUID->"7a319852-514e-4715-84da-103ef5be9c8b"]], \
"DisplayMath",
 CellID->1465942553,ExpressionUUID->"3a6b1a06-7c30-4bd6-b495-28591b039b68"],

Cell[TextData[{
 "which is consistent with other NDR manipulation of the Dirac matrices \
inside the trace (though of course ",
 StyleBox["not",
  FontSlant->"Italic"],
 " cyclicity!). As any product of Dirac matrices can be written in terms of \
the anti-symmetric products, the trace of ",
 Cell[BoxData[
  SubscriptBox["\[Gamma]", "5"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e9e66768-4eee-4e8d-81a4-ee6e10e91353"],
 "-odd products follows.  "
}], "TechNoteText",
 CellID->1441873540,ExpressionUUID->"fabd20dc-f037-4a1a-8e75-b5d38339fc17"],

Cell[TextData[{
 "We obtain the usual result for the trace with 4 ordinary Dirac matrices and \
",
 Cell[BoxData[
  SubscriptBox["\[Gamma]", "5"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e35bd5d2-da88-4d69-9f8c-6adebb470b1a"]
}], "TechNoteMathCaption",
 CellID->2086889666,ExpressionUUID->"d7fbc617-4e18-4470-aa3e-91def3546947"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Gamma]", "[", "\[Mu]", "]"}], "**", 
    RowBox[{"\[Gamma]", "[", "\[Nu]", "]"}], "**", 
    RowBox[{"\[Gamma]", "[", "\[Rho]", "]"}], "**", 
    RowBox[{"\[Gamma]", "[", "\[Sigma]", "]"}], "**", 
    RowBox[{"\[Gamma]", "@", "5"}]}], "//", "DiracTrace"}], "//", 
  "NiceForm"}]], "Input",
 CellLabel->"In[11]:=",
 CellID->1651693658,ExpressionUUID->"854f677e-8767-4a34-9b2a-c0715c2d27a1"],

Cell[BoxData[
 StyleBox[
  RowBox[{"-", 
   RowBox[{"4", " ", "\[ImaginaryI]"}], 
   SubscriptBox["\[CurlyEpsilon]", 
    StyleBox[
     TemplateBox[{"\[Mu]", "\[Nu]", "\[Rho]", "\[Sigma]"},
      "RowDefault"],
     FontSize->10]]}], "StandardForm"]], "Output",
 CellLabel->"Out[11]//NiceForm=",
 CellID->1970928309,ExpressionUUID->"85ed8bec-dd06-4466-8505-8fdff3fd66dd"]
}, Open  ]],

Cell[TextData[{
 "The non-cyclicity of ",
 Cell[BoxData[
  SubscriptBox["\[Gamma]", "5"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a0841ce6-b8f0-4d9c-920d-504d8d8b019e"],
 "-odd traces with 6 or more ordinary Dirac matrices readily appear in, e.g., \
the difference between the two traces"
}], "TechNoteMathCaption",
 CellID->74835986,ExpressionUUID->"85ecab24-23a4-4f53-acdc-cc53ae34210f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Gamma]", "[", "\[Mu]", "]"}], "**", 
    RowBox[{"\[Gamma]", "[", "\[Nu]", "]"}], "**", 
    RowBox[{"\[Gamma]", "[", "\[Rho]", "]"}], "**", 
    RowBox[{"\[Gamma]", "[", "\[Sigma]", "]"}], "**", 
    RowBox[{"\[Gamma]", "[", "\[Alpha]", "]"}], "**", 
    RowBox[{"\[Gamma]", "[", "\[Alpha]", "]"}], "**", 
    RowBox[{"\[Gamma]", "@", "5"}]}], "//", "DiracTrace"}], "//", 
  "NiceForm"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"-", 
    RowBox[{
     RowBox[{"\[Gamma]", "[", "\[Alpha]", "]"}], "**", 
     RowBox[{"\[Gamma]", "[", "\[Mu]", "]"}], "**", 
     RowBox[{"\[Gamma]", "[", "\[Nu]", "]"}], "**", 
     RowBox[{"\[Gamma]", "[", "\[Rho]", "]"}], "**", 
     RowBox[{"\[Gamma]", "[", "\[Sigma]", "]"}], "**", 
     RowBox[{"\[Gamma]", "[", "\[Alpha]", "]"}], "**", 
     RowBox[{"\[Gamma]", "@", "5"}]}]}], "//", "DiracTrace"}], "//", 
  "NiceForm"}]}], "Input",
 CellLabel->"In[12]:=",
 CellID->1490483207,ExpressionUUID->"04af4250-dd88-4707-ac65-4e0effd32dab"],

Cell[BoxData[
 StyleBox[
  RowBox[{"-", 
   RowBox[{"4", " ", "\[ImaginaryI]"}], "\[ScriptD]", 
   SubscriptBox["\[CurlyEpsilon]", 
    StyleBox[
     TemplateBox[{"\[Mu]", "\[Nu]", "\[Rho]", "\[Sigma]"},
      "RowDefault"],
     FontSize->10]]}], "StandardForm"]], "Output",
 CellLabel->"Out[12]//NiceForm=",
 CellID->456834388,ExpressionUUID->"ab0b843a-2a47-46dd-8cc4-fad5da2470fd"],

Cell[BoxData[
 StyleBox[
  RowBox[{"-", 
   RowBox[{
    RowBox[{"32", " ", "\[ImaginaryI]"}], 
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox[
      TemplateBox[{"\[Mu]", "\[Nu]", "\[Rho]", "\[Sigma]"},
       "RowDefault"],
      FontSize->10]]}], "+", 
   RowBox[{
    RowBox[{"4", " ", "\[ImaginaryI]"}], "\[ScriptD]", 
    SubscriptBox["\[CurlyEpsilon]", 
     StyleBox[
      TemplateBox[{"\[Mu]", "\[Nu]", "\[Rho]", "\[Sigma]"},
       "RowDefault"],
