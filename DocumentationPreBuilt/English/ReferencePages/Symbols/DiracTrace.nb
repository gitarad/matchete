Cell[TextData[{
 "The ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Dimensions"]], "paclet:ref/Dimensions"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
