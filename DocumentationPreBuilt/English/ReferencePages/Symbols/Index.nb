Cell[TextData[{
 "Indices of non-real representations are ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Bar"]], "paclet:Matchete/ref/Bar", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ab1c2c1e-d2e9-4b70-8c4d-1c7300626a07"],
 "-able, i.e. they can be conjugated. Non-real representations follow the \
convention that indices should always contract in pairs, where one of them is \
has a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Bar"]], "paclet:Matchete/ref/Bar", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "46b37e96-c780-4409-b89b-6464383ac70f"],
 "."
}], "Notes",
 CellID->1938400566,ExpressionUUID->"7b447949-93ea-4cad-8265-bd2b646bcd2d"],

