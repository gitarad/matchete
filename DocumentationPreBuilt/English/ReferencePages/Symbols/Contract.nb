 CellID->518117218,ExpressionUUID->"9953f318-2813-446f-90d2-c70f70a388aa"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   SuperscriptBox["M", 
    StyleBox["p",
     FontSize->10]], 
   SuperscriptBox[
    OverscriptBox["\[Phi]", 
     StyleBox["_",
      FontWeight->Bold]], 
    StyleBox["p",
     FontSize->10]], 
   SuperscriptBox["\[Phi]", 
    StyleBox["p",
     FontSize->10]]}], "StandardForm"]], "Output",
