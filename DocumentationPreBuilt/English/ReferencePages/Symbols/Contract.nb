 StyleBox[
  RowBox[{
   SubscriptBox["\[Delta]", 
    StyleBox[
     TemplateBox[{"p", "r"},
      "RowDefault"],
     FontSize->10]], 
   SuperscriptBox[
    OverscriptBox["\[Phi]", 
