Cell[BoxData[{
 RowBox[{
  RowBox[{"DefineGlobalGroup", "[", 
   RowBox[{"Gr", ",", 
    RowBox[{"SU", "@", "4"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tFundf", "[", "Gr", "]"}], "[", 
  RowBox[{"i", ",", "j", ",", "A", ",", "B"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
