Cell[BoxData[
 RowBox[{"CG", "[", 
  RowBox[{
   RowBox[{"tFundf", "[", "Gr", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Index", "[", 
      RowBox[{"i", ",", 
       RowBox[{"Gr", "[", "fund", "]"}]}], "]"}], ",", 
     RowBox[{"Bar", "[", 
      RowBox[{"Index", "[", 
       RowBox[{"j", ",", 
        RowBox[{"Gr", "[", "fund", "]"}]}], "]"}], "]"}], ",", 
     RowBox[{"Index", "[", 
      RowBox[{"A", ",", 
       RowBox[{"Gr", "[", "adj", "]"}]}], "]"}], ",", 
     RowBox[{"Index", "[", 
      RowBox[{"B", ",", 
       RowBox[{"Gr", "[", "adj", "]"}]}], "]"}]}], "}"}]}], "]"}]], "Output",
