Cell["The WCxf file produced by the above example takes the form:", \
"ExampleText",
 CellID->1093385419,ExpressionUUID->"d4fdeea4-350e-4f4d-a6bb-05ab769e1af9"],

Cell[TextData[StyleBox["{\n\t\"eft\":\"SMEFT\",\n\t\"basis\":\"Warsaw\",\n\t\
\"scale\":1000,\n\t\"values\":{\n\t\t\"dB_33\":7.052107105142169e-14,\n\t\t\
\"dd_1111\":-3.58954392937526e-12,\n\t\t\"dd_1122\":3.559919980212726e-12,\n\t\
\t\"dd_1133\":-4.3902937634319e-12,\n\t\t\"dd_1221\":-1.0739007838963246e-11,\
\n\t\t\"dd_1331\":1.502533139559438e-11,\n\t\t\
\"dd_2222\":-3.58954392937526e-12,\n\t\t\"dd_2233\":-4.3902937634319e-12,\n\t\
\t\"dd_2332\":1.502533139559438e-11,\n\t\t\"dd_3333\":3.6197382975819236e-12,\
\n\t\t\"dG_33\":-6.338220259560097e-13,\n\t\t\
\"dphi_33\":6.890430796112842e-16,\n\t\t\"ed_1111\":-5.924789832506864e-14,\n\
\t\t\"ed_1122\":-5.924789832506864e-14,\n\t\t\
\"ed_1133\":1.8544501052986743e-12,\n\t\t\"ed_2211\":-5.924789832506864e-14,\n\
\t\t\"ed_2222\":-5.924789832506864e-14,\n\t\t\
\"ed_2233\":1.8544501052986743e-12,\n\t\t\"ed_3311\":-5.924789832506864e-14,\n\
\t\t\"ed_3322\":-5.924789832506864e-14,\n\t\t\
\"ed_3333\":1.8544501052986743e-12,\n\t\t\"ee_1111\":-8.887184748760295e-14,\n\
\t\t\"ee_1122\":-1.777436949752059e-13,\n\t\t\
\"ee_1133\":-1.777436949752059e-13,\n\t\t\"ee_2222\":-8.887184748760295e-14,\n\
\t\t\"ee_2233\":-1.777436949752059e-13,\n\t\t\
\"ee_3333\":-8.887184748760295e-14,\n\t\t\"eu_1111\":1.1849579665013728e-13,\n\
\t\t\"eu_1122\":1.1849579665013728e-13,\n\t\t\
\"eu_1133\":1.1849579665013728e-13,\n\t\t\"eu_2211\":1.1849579665013728e-13,\n\
\t\t\"eu_2222\":1.1849579665013728e-13,\n\t\t\
\"eu_2233\":1.1849579665013728e-13,\n\t\t\"eu_3311\":1.1849579665013728e-13,\n\
