Cell["\<\
A one-loop renormalization group evolution from the input scale to the \
matching scale is employed for the gauge couplings and the top mass.\
\>", "Notes",
 CellID->1544207919,ExpressionUUID->"75b65b0b-51f8-4d21-9d02-a625a28dc439"],

Cell[TextData[{
 "The Wilson coefficients can be computed in the up- or down-quark mass basis \
by including a key ",
 StyleBox["\"flavor basis\"", "InlineCode"],
 " with value ",
 StyleBox["\"up\"", "InlineCode"],
 " or ",
 StyleBox["\"down\"", "InlineCode"],
 " (default) under the optional ",
 StyleBox["\"SM\"", "InlineCode"],
 " directory in the input ",
 StyleBox["JSON", "InlineCode"],
 " file."
}], "Notes",
 CellID->598838693,ExpressionUUID->"9ae4bce1-54b7-4711-909f-df66f15cd03c"],

Cell[TextData[{
 "The electroweak scheme can be specified with the ",
 StyleBox["\"EW scheme\"", "InlineCode"],
 " key under the optional ",
 StyleBox["\"SM\"", "InlineCode"],
 " directory in the input ",
 StyleBox["JSON", "InlineCode"],
 " file. The available choices are:"
}], "Notes",
 CellID->1121988770,ExpressionUUID->"77ef02de-ad3c-415c-bfff-c0fb114b374d"],

