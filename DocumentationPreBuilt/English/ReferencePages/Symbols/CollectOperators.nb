Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CollectOperators"]], "paclet:Matchete/ref/CollectOperators", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "72ab82a2-35b8-4e3e-81bb-a8e6b113851e"],
 " identifies unique operators accounting for relabeling of dummy indices and \
obvious symmetries of objects. It does not attempt to apply a full set of \
simplification identities such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GreensSimplify"]], "paclet:Matchete/ref/GreensSimplify", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ee737657-e23f-43f0-935f-45032ba96379"],
 ". "
}], "Notes",
 CellID->643463071,ExpressionUUID->"3351432f-e362-424a-aa63-8b4a7fceb808"],

Cell[TextData[{
 "The expression returned by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CollectOperators"]], "paclet:Matchete/ref/CollectOperators", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "97c97d8c-908f-4898-bff7-ce2578378593"],
 " typically contains many operators outside the (off-shell) basis. "
}], "Notes",
 CellID->11572706,ExpressionUUID->"17a6d978-2ed2-41bf-be3b-e230bd3fd7a4"],

Cell[TextData[{
 "By contrast to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RelabelIndices"]], "paclet:Matchete/ref/RelabelIndices", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8c148871-a2ae-436f-b0b5-017e63682d0e"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CollectOperators"]], "paclet:Matchete/ref/CollectOperators", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cd7e2a6a-0904-4a79-9004-7daa9de8b5f6"],
 " is much more robust, as it correctly identifies isomorphic graphs formed \
by the dummy index contractions"
}], "Notes",
 CellID->1343303225,ExpressionUUID->"67a1d0e8-a1a0-4bb6-80f3-f388169c790e"],

