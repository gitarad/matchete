Cell[BoxData[{
 RowBox[{
  RowBox[{"LoadModel", "[", "\"\<SM\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Ye", "[", 
     RowBox[{"p", ",", "r"}], "]"}], 
    RowBox[{
     RowBox[{"Bar", "@", 
      RowBox[{"l", "[", 
       RowBox[{"i", ",", "p"}], "]"}]}], "\[CenterDot]", 
     RowBox[{"e", "[", "r", "]"}]}], " ", 
    RowBox[{"H", "[", "i", "]"}]}], "+", 
   RowBox[{
    RowBox[{"Yu", "[", 
     RowBox[{"p", ",", "r"}], "]"}], 
    RowBox[{
     RowBox[{"Bar", "@", 
      RowBox[{"l", "[", 
       RowBox[{"i", ",", "p"}], "]"}]}], "\[CenterDot]", 
     RowBox[{"\[Sigma]", "[", 
      RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "\[CenterDot]", 
     RowBox[{"e", "[", "r", "]"}]}], " ", 
    RowBox[{"H", "[", "i", "]"}], 
    RowBox[{"FS", "[", 
     RowBox[{"B", ",", "\[Mu]", ",", "\[Nu]"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"Yd", "[", 
     RowBox[{"s", ",", "t"}], "]"}], 
    RowBox[{
     RowBox[{"Bar", "@", 
      RowBox[{"l", "[", 
       RowBox[{"j", ",", "s"}], "]"}]}], "\[CenterDot]", 
     RowBox[{"\[Sigma]", "[", 
      RowBox[{"\[Rho]", ",", "\[Sigma]"}], "]"}], "\[CenterDot]", 
     RowBox[{"e", "[", "t", "]"}]}], " ", 
    RowBox[{"H", "[", "j", "]"}], 
    RowBox[{"FS", "[", 
     RowBox[{"B", ",", "\[Rho]", ",", "\[Sigma]"}], "]"}]}]}], "//", 
  "NiceForm"}], "\n", 
 RowBox[{
  RowBox[{"CollectOperators", "@", "%"}], "//", "NiceForm"}]}], "Input",
