Cell["\<\
Introducing a global SU(2) group automatically initializes both fundamental \
and adjoint representations and generator and Levi-Civita CGs:\
\>", "ExampleText",
 CellID->430850645,ExpressionUUID->"65a5e180-6132-47da-a2b4-18ebccc2dfd0"],

Cell[BoxData[
 RowBox[{"DefineGlobalGroup", "[", 
  RowBox[{"G1", ",", 
   RowBox[{"SU", "@", "2"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1026993978,ExpressionUUID->"7ade00e4-9334-4601-bba0-c3b4a077ed56"],

Cell[TextData[{
 "This lets us define a new CG defined as the contraction ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["t2\[CurlyEpsilon]", "iac"], "=", " ", 
    RowBox[{
     SubsuperscriptBox["t", "b", "ia"], 
     SuperscriptBox["\[CurlyEpsilon]", "bc"]}]}], TraditionalForm]],
  ExpressionUUID->"c736aff6-e19d-49e0-9a89-53d237763081"],
 " of an generator of the fundamental representation with Levi-Civita \
tensor:"
}], "ExampleText",
 CellID->1307250127,ExpressionUUID->"e92b11f5-c4ea-4eeb-be6b-cdaad91b048f"],

Cell[BoxData[
 RowBox[{"DefineCompositeCG", "[", 
  RowBox[{"t2\[CurlyEpsilon]", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"gen", "[", 
      RowBox[{"G1", "[", "fund", "]"}], "]"}], ",", 
     RowBox[{"eps", "[", "G1", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", ",", "a", ",", "b"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", "c"}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->938305541,ExpressionUUID->"982e49d3-6108-4624-80be-8283baf4620a"],

Cell[TextData[{
 "This new CG ",
 StyleBox["t2\[CurlyEpsilon]",
  FontWeight->"Bold"],
 " can then be used as any other CG:"
}], "ExampleText",
 CellID->443246800,ExpressionUUID->"6412e4e5-0cbf-42fd-aded-4eca6d01bb65"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"CG", "[", 
  RowBox[{"t2\[CurlyEpsilon]", ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "b", ",", "c"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[3]:=",
 CellID->1942209473,ExpressionUUID->"bbe0e38b-470e-4fb3-841a-b7fdfb69b2c4"],

