Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SimplifyCouplings"]], "paclet:Matchete/ref/SimplifyCouplings", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b5ff9966-d428-4814-a786-994a07a936ad"],
 " accounts for the (anti-)symmetries of couplings used in coupling \
contractions. Take the case where we add a two-index symmetric coupling ",
 StyleBox["S", "InlineCode"],
 ", which is contracted with the up-type Yukawa coupling:"
}], "ExampleText",
 CellID->896899791,ExpressionUUID->"74e1f0ad-18e4-40f7-98bd-6150d46b7a40"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefineCoupling", "[", 
   RowBox[{"S", ",", " ", 
    RowBox[{"Indices", "\[Rule]", " ", 
     RowBox[{"{", 
      RowBox[{"Flavor", ",", "Flavor"}], "}"}]}], ",", 
    RowBox[{"Symmetries", "\[Rule]", " ", 
     RowBox[{"{", 
      RowBox[{"SymmetricPermutation", "[", 
       RowBox[{"2", ",", " ", "1"}], "]"}], "}"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"S", "[", 
     RowBox[{"p", ",", "s"}], "]"}], 
    RowBox[{"Yu", "[", 
     RowBox[{"s", ",", "r"}], "]"}]}], "+", 
   RowBox[{"2", 
    RowBox[{"S", "[", 
     RowBox[{"s", ",", "p"}], "]"}], 
    RowBox[{"Yu", "[", 
     RowBox[{"s", ",", "r"}], "]"}]}]}], "//", "NiceForm"}], "\n", 
 RowBox[{
  RowBox[{"%", "//", "SimplifyCouplings"}], "//", "NiceForm"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->519270404,ExpressionUUID->"023b1246-555d-4b14-a50d-5cf95a067ae2"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["S", 
     StyleBox[
      TemplateBox[{"p", "s"},
       "RowDefault"],
      FontSize->10]], 
    SuperscriptBox[
     SubscriptBox["Y", "u"], 
     StyleBox[
      TemplateBox[{"s", "r"},
       "RowDefault"],
      FontSize->10]]}], "+", 
   RowBox[{"2", 
    SuperscriptBox["S", 
     StyleBox[
      TemplateBox[{"s", "p"},
       "RowDefault"],
      FontSize->10]], 
    SuperscriptBox[
     SubscriptBox["Y", "u"], 
