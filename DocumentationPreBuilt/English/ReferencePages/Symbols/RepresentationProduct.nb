Cell[TextData[{
 "The representations in the product of a fundamental, an anti-fundamental \
and two adjoint representations of  SU(3)/",
 Cell[BoxData[
  SubscriptBox["A", "2"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b41287f9-0ece-4afa-982d-881faf57dddb"],
 " (note the use of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SU"]], "paclet:Matchete/ref/SU", "Matchete Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "3", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "77087899-1d01-4450-9d5d-9bf0bda2b535"],
 " as short-hand for the algebra):"
}], "ExampleText",
 CellID->1683620586,ExpressionUUID->"d86732ff-623f-40c1-bfa7-511144be4057"],

