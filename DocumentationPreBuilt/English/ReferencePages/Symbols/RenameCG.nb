Cell[TextData[{
 StyleBox["N.b.",
  FontWeight->"Bold"],
 " Renaming a CG in the internal Matchete state does not change any CGs that \
occur in expressions (e.g. Lagrangians). Such expressions are no longer valid \
after the renaming.  "
}], "Notes",
