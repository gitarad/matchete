Cell[TextData[{
 "The default for value for the norm square normalization of the tensors is \
",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{
     RowBox[{
      RowBox[{"d", "(", 
       SubscriptBox["R", "1"], ")"}], "..."}], 
     RowBox[{"d", "(", 
      SubscriptBox["R", "n"], ")"}]}]], TraditionalForm]],ExpressionUUID->
  "6a25ed03-7eca-44c2-ad83-3655a695c965"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "(", 
    SubscriptBox["R", "i"], ")"}], TraditionalForm]],ExpressionUUID->
  "a73bd1f3-642c-42b1-a6b4-96bc1e3d14d9"],
 " is the dimension of each representation. "
}], "Notes",
 CellID->1424657635,ExpressionUUID->"d95ff5c8-49c5-47e1-9e24-45867ba872f7"]
}, Dynamic[CurrentValue[
 EvaluationNotebook[], {TaggingRules, "Openers", "NotesSection"}, Closed]]]],

