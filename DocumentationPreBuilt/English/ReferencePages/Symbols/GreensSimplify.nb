Cell[TextData[{
 "The operator basis used by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GreensSimplify"]], "paclet:Matchete/ref/GreensSimplify", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "886c8019-38e6-4939-bb7a-23eb1b6b97a1"],
 " is determined from a heuristic scoring and will not typically agree with \
literature basis choices. The output is expressed in terms of the basis \
operators and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GreensSimplify"]], "paclet:Matchete/ref/GreensSimplify", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "28641946-1773-4150-96f0-974b443296df"],
 " will not attempt to reduce an expression to the minimal number of \
operators. As a result simple expressions may look more complicated after \
application of the simplification function. "
}], "Notes",
 CellID->2099536602,ExpressionUUID->"18d2fa2d-4d83-46fd-b59c-536a49161fc1"],

Cell[TextData[{
 "In addition to simplifying operators to a set of basis operators, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GreensSimplify"]], "paclet:Matchete/ref/GreensSimplify", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "22ff6a86-2b6d-4cc1-9fc5-0b8d43c01a18"],
 " also collects and simplify the coefficients in front of coefficients. "
}], "Notes",
 CellID->1893736222,ExpressionUUID->"476a93b4-c2c0-44b1-9107-60cf52694dae"],

Cell["The following options can be given: ", "Notes",
 CellID->72331263,ExpressionUUID->"1f732115-84ec-475a-80a1-faf3ab163bce"],

Cell[BoxData[GridBox[{
   {Cell["      ", "TableRowIcon",ExpressionUUID->
     "766e6b27-dd72-4091-9db1-a456c4c50e05"], 
    TemplateBox[{
      Cell[
       TextData["ReductionIdentities"]], 
