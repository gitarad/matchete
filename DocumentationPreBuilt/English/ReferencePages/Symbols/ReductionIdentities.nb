Cell[TextData[{
 "The option values for ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ReductionIdentities"]], 
    "paclet:Matchete/ref/ReductionIdentities", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "76907be5-3e01-479b-9d13-7a7fd9e154bb"],
 " are\n",
 Cell[BoxData[GridBox[{
    {Cell[
     "      ", "TableRowIcon",ExpressionUUID->
      "4038f5de-d797-4118-b86f-b8cd96d742bb"], 
     TemplateBox[{
       Cell[
        TextData["dDimensional"]], "paclet:Matchete/ref/dDimensional", 
       "Matchete Package Symbol"},
      "PackageLink",
      BaseStyle->"2ColumnTableMod"], Cell["\<\
applies only simplification identities that are strictly valid in \
\[ScriptD]-dimensional space time. \
\>", "TableText",ExpressionUUID->"fdba6e52-fcd1-4186-9402-f9a822211b0b"]},
    {Cell[
     "      ", "TableRowIcon",ExpressionUUID->
      "6545d4e8-daa1-4c84-811e-60e4de71374c"], 
     TemplateBox[{
       Cell[
        TextData["EvanescenceFree"]], "paclet:Matchete/ref/EvanescenceFree", 
       "Matchete Package Symbol"},
      "PackageLink",
      BaseStyle->"2ColumnTableMod"], Cell[TextData[{
      "reduces operators to a physical (four-dimensional) basis using the \
evanescent prescription and then performs a finite evanescent shift to remove \
resulting evanescent operators. This option requires that the imput is a ",
      StyleBox["full valid Lagrangian",
       FontWeight->"Bold"],
      " and not just a part.  "
     }], "TableText",ExpressionUUID->
      "bee53a1b-3751-4d61-9780-28f74a20980b"]},
    {Cell[
     "      ", "TableRowIcon",ExpressionUUID->
      "2c5ae9d3-6d30-4815-a9d4-e93526039c04"], 
     TemplateBox[{
       Cell[
        TextData["Evanescent"]], "paclet:Matchete/ref/Evanescent", 
       "Matchete Package Symbol"},
      "PackageLink",
      BaseStyle->"2ColumnTableMod"], Cell["\<\
reduces operators to a physical (four-dimensional) basis using the evanescent \
prescription. The resulting evanescent operators are kept in the output. \
\>", "TableText",ExpressionUUID->"2b6f789f-7f9f-46b9-8dba-056548007554"]},
    {Cell[
     "      ", "TableRowIcon",ExpressionUUID->
      "0aa885ce-d51d-4995-8e77-45aa16afb3ee"], 
     TemplateBox[{
       Cell[
        TextData["FourDimensional"]], "paclet:Matchete/ref/FourDimensional", 
       "Matchete Package Symbol"},
      "PackageLink",
      BaseStyle->"2ColumnTableMod"], Cell[TextData[{
      "simplifies with four-dimensional identities. This is ",
      StyleBox["incompatible with other \[ScriptD]-dimensional calculations",
       FontWeight->"Bold"],
      ", such as one-loop matching."
     }], "TableText",ExpressionUUID->"e6bf7c33-072c-4c40-957c-b6ba4ef157a5"]}
   }]], "2ColumnTableMod",
  GridBoxOptions->{
  GridBoxBackground->{
   "Columns" -> {{None}}, "Rows" -> {None, None, None, {None}}},
  GridBoxDividers->{"Rows" -> {{True, True, True, True, True}}}},
