   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1cfa876e-e86b-4825-933d-08bef505e2b9"],
 "] and ",
 Cell[BoxData[
  StyleBox["groupName", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4041f125-1f84-4aab-803a-d3303827602f"],
 "[",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["adj"]], "paclet:Matchete/ref/adj", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "10efc84d-7146-4f42-82f2-0c4fa2ff466a"],
 "], respectively."
}], "Notes",
 CellID->18485150,ExpressionUUID->"47780185-0278-4221-84d7-7543a0f7647f"],

Cell[TextData[{
