     TextData["DefineGaugeGroup"]], "paclet:Matchete/ref/DefineGaugeGroup", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f71c97a9-ae4d-4d7c-a0c5-e4b9117e30ca"],
 " also defines the fundamental and adjoint representations of the \
corresponding non-Abelian group. They are referred to as ",
 Cell[BoxData[
  StyleBox["groupName", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "70b465a5-da85-4df0-85a4-5a43d82c5eb1"],
 "[",
