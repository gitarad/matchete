Cell[TextData[{
 "The ",
 StyleBox["LieGroup", "TI"],
 " can either be ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["U1"]], "paclet:Matchete/ref/U1", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "904d3c37-2bc3-4635-b262-c69b010287df"],
 " or a simple group. The simple group are more accurately defined by their \
Lie algebra (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Alg"]], "paclet:Matchete/ref/Alg", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "46309d2c-6b6e-4d5c-be74-0f71f07df416"],
 ") in this case, although the functions ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SU"]], "paclet:Matchete/ref/SU", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c67fff79-a763-44f2-acc5-96f7217ca2d2"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SO"]], "paclet:Matchete/ref/SO", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4d218197-4a3d-4ea5-8167-da17501db15b"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Sp"]], "paclet:Matchete/ref/Sp", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fa6d52b2-c372-408b-a1dc-02057f8dc77f"],
 " provide convenient shortcuts to get the Algebra of the group in question. \
"
}], "Notes",
 CellID->66672247,ExpressionUUID->"e88cedf1-cb38-4647-beac-645789b849cd"],

Cell[TextData[{
 "A scalar coupling with the name ",
 Cell[BoxData[
  StyleBox["coupling", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "73bf8e85-86ac-4fbd-9c6d-ecd94cb286a2"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EFTOrder"]], "paclet:Matchete/ref/EFTOrder", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6b23e74a-7ede-45bb-8cf8-6f42cef2ccfd"],
 " 0 is initialized with the gauge group (as with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DefineCoupling"]], "paclet:Matchete/ref/DefineCoupling", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "417ec494-7efc-4a47-820d-d245078664b7"],
 "). "
}], "Notes",
 CellID->1324974463,ExpressionUUID->"0b6727d9-4a9f-472f-ae73-2e433e847b53"],

Cell[TextData[{
 Cell[BoxData[
