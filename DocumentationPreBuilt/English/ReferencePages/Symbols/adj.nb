  FontFamily->"Source Sans Pro",ExpressionUUID->
  "16dfe11a-16b1-4466-8424-06fcfc4a9efc"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DefineGlobalGroup"]], "paclet:Matchete/ref/DefineGlobalGroup", 
    "Matchete Package Symbol"},
