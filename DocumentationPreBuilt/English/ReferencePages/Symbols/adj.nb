Cell[TextData[{
 "If we initialize a new symmetry group Gr, its adjoint representation is \
referred to as Gr[adj]. This is seen here in the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Index"]], "paclet:Matchete/ref/Index", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "82720d18-6bcb-43ca-858a-66059579301e"],
 " labels of the structure constant in the internal Matchete form:"
}], "ExampleText",
 CellID->63602367,ExpressionUUID->"07584da9-04e4-43c8-9e0d-ccb640b1a3dd"],

