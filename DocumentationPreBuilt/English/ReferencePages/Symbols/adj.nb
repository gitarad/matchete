Cell[TextData[{
 "The adjoint representation of a (gauge or global) group named ",
 StyleBox["G", "InlineCode"],
 " is referred to by ",
 StyleBox["G[", "InlineCode"],
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["adj"]], "paclet:Matchete/ref/adj", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d7a5c7ca-1e19-4815-8cbf-4b0d3f9abc53"],
 StyleBox["]", "InlineCode"],
 ". The representation is automatically initialized with the group when using \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DefineGaugeGroup"]], "paclet:Matchete/ref/DefineGaugeGroup", 
    "Matchete Package Symbol"},
   "PackageLink",
