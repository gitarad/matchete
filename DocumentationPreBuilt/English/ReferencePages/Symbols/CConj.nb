Cell[BoxData[GridBox[{
   {"", Cell["\<\
CConj[field] is the charge conjugation operator and can only be used to act \
on fermion fields, for example CConj[\[Psi]]= \
\!\(\*SuperscriptBox[\(\[Psi]\), \(c\)]\)= \!\(\*TemplateBox[{\"C\"}, \
\"RowDefault\"]\) \!\(\*SuperscriptBox[OverscriptBox[\(\[Psi]\), \(_\)], \
\(T\)]\).\
\>",ExpressionUUID->"8eeb0928-a145-4622-b6a1-c81d8928a258"]}
  }]], "Usage",
 CellID->1636766256,ExpressionUUID->"62ce8f69-84ed-4432-8db5-2bd44935b839"]
}, Open  ]],

