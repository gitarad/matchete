Cell[TextData[{
 "The fundamental representation of a (gauge or global) group named ",
 StyleBox["G", "InlineCode"],
 " is referred to by ",
 StyleBox["G[", "InlineCode"],
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["fund"]], "paclet:Matchete/ref/fund", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a1952af3-55b4-40e0-881c-a98838bd2f38"],
 StyleBox["]", "InlineCode"],
 ". The representation is automatically initialized with the group when using \
",
