Cell[TextData[{
 "If we initialize a new symmetry group Gr, its fundamental representation is \
referred to as Gr[adj]. This is seen here in the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Index"]], "paclet:Matchete/ref/Index", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "418efbe9-9e7b-486f-a447-86ff89c3ab9f"],
 " labels of the generator of the fundamental representation in the internal \
Matchete form:"
}], "ExampleText",
 CellID->63602367,ExpressionUUID->"a17e101a-9b3f-4b5b-8bd1-acb5b717b495"],

