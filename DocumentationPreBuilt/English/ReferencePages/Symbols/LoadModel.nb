     RowBox[{"SetModelOptions", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"DefineField", ",", " ", "\[Phi]", ",", " ", 
        RowBox[{"Mass", "\[Rule]", "Heavy"}]}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"GetFields", "[", "\[Phi]", "]"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->1556727317,ExpressionUUID->"88ff88c4-903d-4e68-9718-94f8b6d0b571"],

