Cell[TextData[{
 "Since ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SetModelOptions"]], "paclet:Matchete/ref/SetModelOptions", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0a60a178-2b34-4e47-a007-22936a0304f1"],
 " can be used to change all optional properties, it is possible to make \
changes that make the model Lagrangian invalid or even produce outright \
errors. For instance, giving right-handed charged leptons of the SM an ",
 Cell[BoxData[
  RowBox[{"SU", 
   SubscriptBox[
    RowBox[{"(", "2", ")"}], "L"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e99acd9f-35eb-4004-93e6-c31e047f3b63"],
 " index will produce an error, as the model file Lagrangian uses only one \
index to the field: "
}], "ExampleText",
 CellID->552306627,ExpressionUUID->"1aebad9b-6459-4e38-b371-f8eea1140b33"],

