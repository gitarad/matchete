Cell["\<\
Define a diagonal but flavor non-universal coupling or mass matrix:\
\>", "ExampleText",
 CellID->883871940,ExpressionUUID->"3fdf17cc-6b28-4b45-acd6-d802e3c86173"],

Cell[BoxData[
 RowBox[{"DefineCoupling", "[", 
