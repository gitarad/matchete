                    FontWeight->Bold]], "2"], 
                  SuperscriptBox[
                   RowBox[{"(", 
                    SuperscriptBox["M", 
                    StyleBox["p",
                    FontSize->10]], ")"}], "2"]], "]"}],
                StandardForm]}]}], ")"}],
            SpanSymmetric->False],
