   RowBox[{"SelfConjugate", "->", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", "Flavor", "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"DiagonalCoupling", "->", 
    RowBox[{"{", "True", "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
