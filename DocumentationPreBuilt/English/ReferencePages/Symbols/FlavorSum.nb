}], "ExampleText",
 CellID->1007515972,ExpressionUUID->"b76bdaa9-136e-442e-b982-5c8bf6832d99"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[ScriptCapitalL]", "=", 
   RowBox[{"FreeLag", "[", 
    RowBox[{"F", ",", "\[Phi]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
 CellProlog:>Needs["Matchete`"],
 CellLabel->"In[3]:=",
 CellID->610546270,ExpressionUUID->"afc685fd-d812-4956-bc94-e0a8d12da126"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"-", 
    RowBox[{
     FractionBox["1", "4"], 
     FractionBox["1", 
      SuperscriptBox["g", "2"]], 
     SuperscriptBox[
      SuperscriptBox["F", 
       StyleBox[
        TemplateBox[{"\[Mu]", "\[Nu]", "A"},
         "RowDefault"],
        FontSize->10]], "2"]}]}], "+", 
   RowBox[{
    TemplateBox[{
      SubscriptBox["D", "\[Mu]"], 
      SubsuperscriptBox[
       OverscriptBox["\[Phi]", 
        StyleBox["_", FontWeight -> Bold]], 
       StyleBox["a", FontSize -> 10], 
       StyleBox["p", FontSize -> 10]]},
     "RowDefault"], 
    TemplateBox[{
      SubscriptBox["D", "\[Mu]"], 
      SuperscriptBox["\[Phi]", 
       StyleBox[
        TemplateBox[{"a", "p"}, "RowDefault"], FontSize -> 10]]},
     "RowDefault"]}], "-", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["M", 
       StyleBox["p",
        FontSize->10]], ")"}], "2"], 
    SubsuperscriptBox[
     OverscriptBox["\[Phi]", 
      StyleBox["_",
       FontWeight->Bold]], 
     StyleBox["a",
      FontSize->10], 
     StyleBox["p",
      FontSize->10]], 
    SuperscriptBox["\[Phi]", 
     StyleBox[
      TemplateBox[{"a", "p"},
       "RowDefault"],
      FontSize->10]]}]}], "StandardForm"]], "Output",
 CellLabel->"Out[3]//NiceForm=",
 CellID->1438094400,ExpressionUUID->"d60e05f2-8ed1-44b7-b35b-0f9496ec84d6"]
}, Open  ]],

