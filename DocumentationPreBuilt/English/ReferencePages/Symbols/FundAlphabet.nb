Cell["\<\
Define a SU(3) gauge group with fundamental alphabet \"a\", \"b\", \
\"c\",\"d\":\
\>", "ExampleText",
 CellID->1520267031,ExpressionUUID->"9aa898a5-0f46-4716-97a6-16062d5d8c21"],

Cell[BoxData[
 RowBox[{"DefineGaugeGroup", "[", 
  RowBox[{"G", ",", 
   RowBox[{"SU", "@", "3"}], ",", "g", ",", "F", ",", "\[IndentingNewLine]", 
   "\t", 
   RowBox[{"FundAlphabet", "->", 
    RowBox[{"CharacterRange", "[", 
     RowBox[{"\"\<a\>\"", ",", "\"\<d\>\""}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
