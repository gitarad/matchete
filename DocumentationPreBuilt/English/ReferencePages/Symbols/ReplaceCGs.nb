Cell[BoxData[{
 RowBox[{"DefineGlobalGroup", "[", 
  RowBox[{"G", ",", 
   RowBox[{"SU", "[", "3", "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCompositeCG", "[", 
  RowBox[{"ff", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"fStruct", "@", "G"}], ",", " ", 
     RowBox[{"fStruct", "@", "G"}]}], "}"}], ",", 
