Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["\[Sigma]"]], "paclet:Matchete/ref/Sigma", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fdf88c43-1053-4c71-b770-a6641bb67f4a"],
 " does not exist an internal object in ",
 ButtonBox["Matchete",
  BaseStyle->"Link",
  ButtonData->"paclet:Matchete/guide/Matchete"],
 ".  It is represented as a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GammaM"]], "paclet:Matchete/ref/GammaM", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "94100a25-c000-4cd5-a6d9-a4075e645f9c"],
 " object using the relation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "\[Mu]\[Nu]"], "=", 
    RowBox[{
     RowBox[{
      FractionBox["\[ImaginaryI]", "2"], "[", 
      RowBox[{
       SubscriptBox["\[Gamma]", "\[Mu]"], ",", " ", 
       SubscriptBox["\[Gamma]", "\[Nu]"]}], "]"}], "=", 
     RowBox[{"\[ImaginaryI]", " ", 
      SubscriptBox["\[CapitalGamma]", "\[Mu]\[Nu]"]}]}]}], TraditionalForm]],
  ExpressionUUID->"da44b198-c2de-4353-9098-3ce69b1a8421"],
 "."
}], "Notes",
 CellID->1529689642,ExpressionUUID->"891a5c79-795e-4816-aa1b-e97a492c4eb5"]
