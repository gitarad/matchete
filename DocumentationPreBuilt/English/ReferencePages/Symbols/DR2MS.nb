  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Bar", "@", 
       RowBox[{"\[Phi]", "[", "i", "]"}]}], 
      RowBox[{"\[Phi]", "[", "i", "]"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Bar", "@", 
       RowBox[{"\[Phi]", "[", "j", "]"}]}], 
      RowBox[{"\[Phi]", "[", "j", "]"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Bar", "@", 
       RowBox[{"\[Phi]", "[", "k", "]"}]}], 
      RowBox[{"\[Phi]", "[", "k", "]"}]}], ")"}]}], "//", 
   "NiceForm"}]}]], "Input",
