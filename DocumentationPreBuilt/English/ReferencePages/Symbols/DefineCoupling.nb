Cell["\<\
Multiple couplings (sharing properties) can be defined at once using a list \
of labels\
\>", "ExampleText",
 CellID->1938729136,ExpressionUUID->"f88cd611-f261-4110-a72f-52044287ab9b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineCoupling", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"c1", ",", "c2"}], "}"}], ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"c1", "[", "]"}], ",", 
   RowBox[{"c2", "[", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->878575348,ExpressionUUID->"c25df19d-ae13-40da-8122-872ec44e2eec"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Coupling", "[", 
    RowBox[{"c1", ",", 
     RowBox[{"{", "}"}], ",", "0"}], "]"}], ",", 
   RowBox[{"Coupling", "[", 
    RowBox[{"c2", ",", 
     RowBox[{"{", "}"}], ",", "0"}], "]"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->1491440819,ExpressionUUID->"b3aa8809-2d64-4c82-ac9f-a4d3d70567d6"]
}, Open  ]],

Cell["\<\
