Cell["\<\
When couplings have multiple indices of the same type, it might be \
(anti-)symmetric under permutation of the indices. Including this information \
allows the simplification methods to perform better. \
\>", "ExampleText",
 CellID->1651493344,ExpressionUUID->"7b617b08-00b1-430d-9020-694db36c81e0"],

Cell[TextData[{
 "An example of such symmetries are from the SMEFT operator ",
 Cell[BoxData[
  SubscriptBox["C", "ee"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4168fcf1-b459-46c3-accb-406caa52f01f"],
 ", which has four flavor indices. It is symmetric under exchanges of the two \
first and two last indices in addition to under the exchange of indices 2 and \
4:"
}], "ExampleText",
 CellID->991523310,ExpressionUUID->"2ac86492-380f-4030-b450-c4aaae24531c"],

Cell[BoxData[{
 RowBox[{"DefineFlavorIndex", "[", 
  RowBox[{"Flavor", ",", " ", "3"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"Cee", ",", 
   RowBox[{"Indices", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Flavor", ",", "Flavor", ",", "Flavor", ",", "Flavor"}], "}"}]}],
    ",", 
   RowBox[{"Symmetries", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"SymmetricPermutation", "[", 
       RowBox[{"3", ",", "4", ",", "1", ",", "2"}], "]"}], ",", 
      RowBox[{"SymmetricPermutation", "[", 
       RowBox[{"1", ",", "4", ",", "3", ",", "2"}], "]"}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->131513117,ExpressionUUID->"af75fbb1-ae90-4a37-bbf4-7a670ca8c730"],

Cell["\<\
We can verify that the coupling is in fact initialized with symmetries under \
the full symmetry group generated by the elements we provided. In this case \
we also get symmetry under the exchange of indices 1 and 3:\
\>", "ExampleText",
 CellID->849250985,ExpressionUUID->"1df600bb-5177-4939-82c6-e924a2c122b3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GetCouplings", "[", 
  RowBox[{"Cee", ",", "Symmetries"}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->40315600,ExpressionUUID->"ae9a0de7-2932-4edf-bbbb-7473ea46819e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], "\[Rule]", "1"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", "4", ",", "1", ",", "2"}], "}"}], "\[Rule]", "1"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "4", ",", "3", ",", "2"}], "}"}], "\[Rule]", "1"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", "2", ",", "1", ",", "4"}], "}"}], "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->1957146197,ExpressionUUID->"e935b360-6f14-47a2-9ceb-46a4804c3756"]
}, Open  ]]
