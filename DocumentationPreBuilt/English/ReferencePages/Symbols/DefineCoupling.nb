Cell[TextData[{
 "The EFT power counting behavior of the coupling as specified by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EFTOrder"]], "paclet:Matchete/ref/EFTOrder", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "30cb278f-6ecc-4edb-bce7-4164440933ac"],
 " is used by Matchete to truncate the EFTexpansion in functions such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Match"]], "paclet:Matchete/ref/Match", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8bf14f9d-fec5-465b-96a9-9f1e249ec9e1"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SeriesEFT"]], "paclet:Matchete/ref/SeriesEFT", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "34a77aed-37f6-439b-8f84-4ef2d5a4d369"],
 ". The counting (EFTOrder) of light bosons and covariant derivatives are 1."
}], "Notes",
 CellID->1942479575,ExpressionUUID->"a13ed542-e8b3-4daf-9b10-7d4ae3c1106a"],

