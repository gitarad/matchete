Cell[TextData[{
 "Covariant derivatives always apply the product rule. Therefore, the Warsaw \
basis operator ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"H", "\[ConjugateTranspose]"}], "H"}], ")"}], 
    RowBox[{"\[Square]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"H", "\[ConjugateTranspose]"}], "H"}], ")"}]}]}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"H", "\[ConjugateTranspose]"}], "H"}], ")"}], 
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"H", "\[ConjugateTranspose]"}], "H"}], ")"}]}]}]}]], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8da7f4cd-df36-4d5c-bb87-d92203e05a88"],
 " cannot be kept in its unevaluated form in Matchete."
}], "ExampleText",
 CellID->2142227926,ExpressionUUID->"e40f3f34-276d-4e3e-80f1-ec01527a43e4"],

