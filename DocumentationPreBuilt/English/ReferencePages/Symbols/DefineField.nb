Cell[TextData[{
 "Defining a field with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DefineField"]], "paclet:Matchete/ref/DefineField", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8f2815fe-162f-4cc7-9dad-550befecd756"],
 " informs Matchete of the quantum numbers and masses of the field in \
question. All fields must be defined before a Lagrangian can be written down. "
}], "Notes",
 CellID->1791757087,ExpressionUUID->"f93d4444-ac90-4c4b-a240-2192807cdabf"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DefineField"]], "paclet:Matchete/ref/DefineField", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c5439998-3d64-42fb-9059-fcd0406056f7"],
 " provides a new function ",
 Cell[BoxData[
  StyleBox["label", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ddea9c3f-35fc-4dd5-965e-4014a4f4c3b9"],
 "[] (or ",
 Cell[BoxData[
  StyleBox["label", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b7b5f756-f766-411f-8318-fa7ea5a1daa7"],
 "[i, j, ...] if Indices are provided with the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Indices"]], "paclet:Matchete/ref/Indices", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4dc7ab78-e03a-4ef8-8c7e-7e2cc5c54cd2"],
 " option) that provides a shortcut for the user to write the field in the \
internal format used in Matchete. It gives an instance of the field with the \
indices given. "
}], "Notes",
 CellID->914697409,ExpressionUUID->"7be088af-473e-4446-9a88-e59b1cf1c246"],

