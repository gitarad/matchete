Cell[BoxData[
 RowBox[{
  FormBox[
   RowBox[{
    FormBox["\[ImaginaryI]",
     StandardForm], 
    FormBox[
     StyleBox[
      RowBox[{"(", 
       RowBox[{
        TagBox[
         FormBox[
          OverscriptBox["\[CapitalPsi]1", "_"],
          StandardForm],
         StandardForm,
         Editable->True], "\[CenterDot]", 
        FormBox[
         RowBox[{
          SubscriptBox[
           FormBox["\[Gamma]",
            StandardForm], 
           TagBox[
            StyleBox["\<\"\[Mu]\"\>",
             StripOnInput->False,
             FontSize->10],
            Format[#, Matchete`NiceForm]& ]], 
          SubscriptBox["\<\"P\"\>", "\<\"R\"\>"]}],
         StandardForm], "\[CenterDot]", 
        TagBox[
         FormBox[
          TemplateBox[{
            SubscriptBox["D", 
             StyleBox[
              TagBox[
               StyleBox["\"\[Mu]\"", 10, StripOnInput -> False], 
               Format[#, Matchete`NiceForm]& ], FontSize -> 12, StripOnInput -> 
              False]], 
            TagBox[
             FormBox["\[CapitalPsi]1", StandardForm], StandardForm, Editable -> 
             True]},
           "RowDefault"],
          StandardForm],
         StandardForm,
         Editable->True]}], ")"}],
      SpanSymmetric->False],
     StandardForm]}],
   StandardForm], "-", 
  FormBox[
   RowBox[{
    FormBox[
     FractionBox["1", "2"],
     StandardForm], 
    TagBox[
     FormBox["M\[CapitalPsi]1",
      StandardForm],
     StandardForm,
     Editable->True], 
    FormBox[
     StyleBox[
      RowBox[{"(", 
       RowBox[{
        TagBox[
         FormBox[
          OverscriptBox["\[CapitalPsi]1", "_"],
          StandardForm],
         StandardForm,
         Editable->True], "\[CenterDot]", 
        FormBox[
         RowBox[{"\<\"C\"\>", 
          SubscriptBox["\<\"P\"\>", "\<\"L\"\>"]}],
         StandardForm], "\[CenterDot]", 
        TemplateBox[{
          TagBox[
           FormBox[
            OverscriptBox["\[CapitalPsi]1", "_"], StandardForm], StandardForm,
            Editable -> True], "\"T\""},
         "Superscript"]}], ")"}],
      SpanSymmetric->False],
     StandardForm]}],
   StandardForm], "-", 
  FormBox[
   RowBox[{
    FormBox[
     FractionBox["1", "2"],
     StandardForm], 
    TagBox[
     FormBox["M\[CapitalPsi]1",
      StandardForm],
     StandardForm,
     Editable->True], 
    FormBox[
     StyleBox[
      RowBox[{"(", 
       RowBox[{
        TemplateBox[{
          TagBox[
           FormBox["\[CapitalPsi]1", StandardForm], StandardForm, Editable -> 
           True], "\"T\""},
         "Superscript"], "\[CenterDot]", 
        FormBox[
         RowBox[{"\<\"C\"\>", 
          SubscriptBox["\<\"P\"\>", "\<\"R\"\>"]}],
         StandardForm], "\[CenterDot]", 
        TagBox[
         FormBox["\[CapitalPsi]1",
          StandardForm],
         StandardForm,
         Editable->True]}], ")"}],
      SpanSymmetric->False],
     StandardForm]}],
   StandardForm]}]], "Output",
 CellLabel->"Out[1]//NiceForm=",
 CellID->667534403,ExpressionUUID->"81654d0d-2a76-4afa-8223-562f30f56410"]
}, Open  ]],

Cell["By default such fields are assumed to have a Majorana mass. ", \
