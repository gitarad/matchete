Cell[TextData[{
 "To set up a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CG"]], "paclet:Matchete/ref/CG", "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3aa5735c-393a-4300-a12f-eb6cf156f20b"],
 " one must first define a group and one or more representations. In this \
case, we define a fundamental representation of an SU(2) group:"
}], "ExampleText",
 CellID->52038240,ExpressionUUID->"b0e49861-c9f6-4751-b270-76fa53b94957"],

Cell[BoxData[{
 RowBox[{"DefineCGGroup", "[", 
  RowBox[{"SU2", ",", 
   RowBox[{"SU", "[", "2", "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineRepresentation", "[", 
  RowBox[{"fund", ",", "SU2", ",", 
   RowBox[{"{", "1", "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->380354646,ExpressionUUID->"fc64d270-510c-4a68-ae73-8f24f53531db"],

Cell[TextData[{
 "With that, we may define the Levi-Civita invariant tensor of the \
fundamental representation. The numerical values of the tensor is determined \
with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InvariantTensors"]], "paclet:Matchete/ref/InvariantTensors", 
    "Matchete Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7d6bb044-b551-46c7-8d69-1073ee0a92ad"],
 " to ensure that the basis is compatible with any other CG we might define:"
}], "ExampleText",
 CellID->1985762811,ExpressionUUID->"bc53b426-c23a-4d2e-bcb2-bdda1511f8d3"],

Cell[BoxData[
 RowBox[{"DefineCG", "[", 
  RowBox[{"\[CurlyEpsilon]", ",", 
   RowBox[{"{", 
    RowBox[{"fund", ",", " ", "fund"}], "}"}], ",", " ", 
   RowBox[{"First", "@", " ", 
    RowBox[{"InvariantTensors", "[", 
     RowBox[{
      RowBox[{"SU", "[", "2", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"CRep", "[", 
         RowBox[{"{", "1", "}"}], "]"}], ",", " ", 
        RowBox[{"CRep", "[", 
         RowBox[{"{", "1", "}"}], "]"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[2]:=",
 CellID->1535400941,ExpressionUUID->"4769b356-83c0-4707-a5d1-90360abc3d1f"],

Cell[TextData[{
 "When the CG has been defined, the user can input it and ",
 ButtonBox["Matchete",
  BaseStyle->"Link",
  ButtonData->"paclet:Matchete/guide/Matchete"],
 " will recognize it:"
}], "ExampleText",
 CellID->1721903425,ExpressionUUID->"456f80d5-ddbd-4108-bb2e-81641d29db5f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"\[CurlyEpsilon]", "[", 
  RowBox[{"a", ",", "b"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[3]:=",
 CellID->558958528,ExpressionUUID->"cb008e0a-2e38-4ce5-8746-bd095ef51d58"],

Cell[BoxData[
 RowBox[{"CG", "[", 
  RowBox[{"\[CurlyEpsilon]", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Index", "[", 
      RowBox[{"a", ",", "fund"}], "]"}], ",", 
     RowBox[{"Index", "[", 
      RowBox[{"b", ",", "fund"}], "]"}]}], "}"}]}], "]"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->2015725330,ExpressionUUID->"54d79c81-875f-4d3d-8568-96291e018250"],

Cell[BoxData[
 StyleBox[
  SuperscriptBox["\[CurlyEpsilon]", 
   StyleBox[
    TemplateBox[{"a", "b"},
     "RowDefault"],
    FontSize->10]], "StandardForm"]], "Output",
 CellLabel->"Out[3]//NiceForm=",
 CellID->1741089885,ExpressionUUID->"ec174923-a568-4a23-957d-10bd56261588"]
}, Open  ]]
}, Dynamic[CurrentValue[
