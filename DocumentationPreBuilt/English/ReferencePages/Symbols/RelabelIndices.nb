Cell[TextData[{
 StyleBox["RelabelIndices[", "InlineCode"],
 StyleBox["expr", "TI"],
 StyleBox[",Unique->True]", "InlineCode"],
 " can be used to ensure a proper index relabeling when working with \
replacement rules:"
}], "ExampleText",
 CellID->1639622461,ExpressionUUID->"4d100e29-df42-483a-b33a-b69e74d1ffc6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rule", "=", 
   RowBox[{
    RowBox[{"\[Psi]", "[", 
     RowBox[{"a_", ",", "p_"}], "]"}], ":>", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], ",", 
      RowBox[{"RelabelIndices", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Psi]", "[", 
          RowBox[{"a", ",", "p"}], " ", "]"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Bar", "@", 
            RowBox[{"\[Psi]", "[", 
             RowBox[{"x", ",", "y"}], "]"}]}], "**", 
           RowBox[{"\[Psi]", "[", 
            RowBox[{"x", ",", "y"}], "]"}]}], ")"}]}], ",", 
        RowBox[{"Unique", "->", "True"}]}], "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"rule", "//", "NiceForm"}]}], "Input",
 CellProlog:>Needs["Matchete`"],
 CellLabel->"In[1]:=",
 CellID->2072972317,ExpressionUUID->"a078ca12-a15e-4771-b10d-2530e11ca20d"],

