  SubscriptBox["A", "2"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0049404c-ffa2-4699-b58e-91d5dc4511b9"],
 " (note the use of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SU"]], "paclet:Matchete/ref/SU", "Matchete Package Symbol"},
    "PackageLink",
