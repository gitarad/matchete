    RowBox[{"\[Phi]", ",", "Scalar", ",", 
     RowBox[{"{", 
      RowBox[{"Index", "[", 
       RowBox[{"d$$1", ",", 
        RowBox[{"G", "[", "adj", "]"}]}], "]"}], "}"}], ",", 
