Cell["\<\
Define a SU(3) gauge group with adjoint alphabet \"A\", \"B\", \"C\",\"D\":\
\>", "ExampleText",
 CellID->1520267031,ExpressionUUID->"85bccdba-6996-4dff-8fbb-4ed94ad114e5"],

Cell[BoxData[
 RowBox[{"DefineGaugeGroup", "[", 
  RowBox[{"G", ",", 
   RowBox[{"SU", "@", "3"}], ",", "g", ",", "F", ",", "\[IndentingNewLine]", 
   "\t", 
   RowBox[{"AdjAlphabet", "->", 
    RowBox[{"CharacterRange", "[", 
     RowBox[{"\"\<A\>\"", ",", "\"\<D\>\""}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->386109940,ExpressionUUID->"b6a31689-1e46-4e82-88fd-726cbef65225"],

Cell["\<\
Define a field transforming under under adjoint of this gauge group:\
\>", "ExampleText",
 CellID->2050907684,ExpressionUUID->"08219e41-949a-4691-9a4e-06731381dc6f"],

Cell[BoxData[
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", 
     RowBox[{"G", "[", "adj", "]"}], "}"}]}], ",", 
   RowBox[{"SelfConjugate", "->", "True"}]}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->707681659,ExpressionUUID->"65024af5-c9e7-49b0-95fb-e064c90ab318"],

Cell["NiceForm printing of the fields with given labels:", "ExampleText",
 CellID->1708077093,ExpressionUUID->"d161020f-d445-421b-80f2-4a87afad23bc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"expr", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Phi]", "[", "J1", "]"}], 
      RowBox[{"\[Phi]", "[", "J1", "]"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Phi]", "[", "J2", "]"}], 
      RowBox[{"\[Phi]", "[", "J2", "]"}]}], ")"}]}], "//", 
   "NiceForm"}]}]], "Input",
 CellLabel->"In[3]:=",
 CellID->1398012651,ExpressionUUID->"bf5b383f-15f4-44ec-8490-5b4bb4ace7bb"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    SuperscriptBox[
     SuperscriptBox["\[Phi]", 
      StyleBox["J1",
       FontSize->10]], "2"], 
    SuperscriptBox[
     SuperscriptBox["\[Phi]", 
      StyleBox["J2",
       FontSize->10]], "2"]}], "StandardForm"], Matchete`NiceForm]], "Output",\

 CellLabel->"Out[3]//NiceForm=",
 CellID->271952,ExpressionUUID->"3309e578-a5c5-4392-856b-de75127eb29e"]
}, Open  ]],

Cell["NiceForm printing of the fields with canonic labels:", "ExampleText",
 CellID->1009644317,ExpressionUUID->"73c7a6ad-b4a3-4c8a-bcfe-bb160a01d543"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"expr", "//", "RelabelIndices"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[4]:=",
 CellID->1679301087,ExpressionUUID->"04722a48-953e-4959-beb1-7c6c090763d9"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox[
