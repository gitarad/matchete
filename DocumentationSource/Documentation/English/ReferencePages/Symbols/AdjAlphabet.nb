     RowBox[{"{", "}"}]}], "]"}], "2"]}]], "Output",
 CellLabel->"Out[4]=",
 CellID->812997760,ExpressionUUID->"dcc17eb2-038e-4355-a498-ec6a1119fa63"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    SuperscriptBox[
     SuperscriptBox["\[Phi]", 
      StyleBox["A",
       FontSize->10]], "2"], 
    SuperscriptBox[
     SuperscriptBox["\[Phi]", 
      StyleBox["B",
       FontSize->10]], "2"]}], "StandardForm"], Matchete`NiceForm]], "Output",\

 CellLabel->"Out[5]//NiceForm=",
 CellID->1762390106,ExpressionUUID->"4b8bcfff-0868-4a0d-a105-890f46409ef1"]
}, Open  ]],

Cell["\<\
If more canonic labels are present than symbols specified in AdjAlphabet, the \
labels are repeated with additional integer subscripts to distinguish the \
indices:\
\>", "ExampleText",
 CellID->424623955,ExpressionUUID->"661ae031-dddb-4b3e-b9a6-ee103c698502"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Phi]", "[", "J1", "]"}], 
      RowBox[{"\[Phi]", "[", "J1", "]"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Phi]", "[", "J2", "]"}], 
      RowBox[{"\[Phi]", "[", "J2", "]"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Phi]", "[", "J3", "]"}], 
      RowBox[{"\[Phi]", "[", "J3", "]"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Phi]", "[", "J4", "]"}], 
      RowBox[{"\[Phi]", "[", "J4", "]"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Phi]", "[", "J5", "]"}], 
      RowBox[{"\[Phi]", "[", "J5", "]"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Phi]", "[", "J6", "]"}], 
      RowBox[{"\[Phi]", "[", "J6", "]"}]}], ")"}]}], "//", "RelabelIndices"}],
   "//", "NiceForm"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->854510085,ExpressionUUID->"687852c7-ce7e-41c6-96d7-d05244bdd012"],

Cell[BoxData[
 FormBox[
  StyleBox[
