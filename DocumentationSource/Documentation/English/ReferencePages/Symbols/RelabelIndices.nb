Cell["\<\
Define a fermionic theory with an SU(3) gauge group and a flavor index:\
\>", "ExampleText",
 CellID->1566807452,ExpressionUUID->"3787e7f4-0e58-450c-b8f5-9531e3775b81"],

Cell[BoxData[{
 RowBox[{"DefineGaugeGroup", "[", 
  RowBox[{"SU3", ",", 
   RowBox[{"SU", "[", "3", "]"}], ",", "g", ",", "G", ",", 
   RowBox[{"FundAlphabet", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<\[Alpha]\>\"", ",", "\"\<\[Beta]\>\"", ",", "\"\<\[Gamma]\>\"", 
      ",", "\"\<\[Delta]\>\""}], "}"}]}]}], "]"}], "\n", 
 RowBox[{"DefineFlavorIndex", "[", 
  RowBox[{"Flavor", ",", "3", ",", 
   RowBox[{"IndexAlphabet", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<p\>\"", ",", "\"\<r\>\"", ",", "\"\<s\>\"", ",", "\"\<t\>\""}], 
     "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Psi]", ",", "Fermion", ",", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"SU3", "[", "fund", "]"}], ",", "Flavor"}], "}"}]}]}], 
  "]"}]}], "Input",
 CellID->1839004668,ExpressionUUID->"9bcbf11b-6a1e-415f-aec2-d843fcac18b6"],

Cell[TextData[{
 Cell[BoxData[
 "RelabelIndices"], "InlineFormula",ExpressionUUID->
  "315e3a4b-8d26-4a97-8407-abd94a5f3970"],
 " identifies all dummy indices in an expression and relabels them to their \
canonic form:"
}], "ExampleText",
 CellID->1508712533,ExpressionUUID->"e58fc92c-1865-4e3e-9161-5dc93726c44f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"expr", "=", 
   RowBox[{
    RowBox[{"Bar", "@", 
     RowBox[{"\[Psi]", "[", 
      RowBox[{"a", ",", "p"}], "]"}]}], "**", 
    RowBox[{"\[Psi]", "[", 
     RowBox[{"a", ",", "p"}], "]"}]}]}], ";"}]], "Input",
 CellID->1988333765,ExpressionUUID->"0494a6e8-9e37-46b3-9cf2-e1ffa733eccd"],

