Cell["\<\
RelabelIndices is aware which flavor indices should be interpreted as \
belonging to diagonal couplings and which not. Therefore, it can be applied \
to these expressions:\
\>", "ExampleText",
 CellID->1801704893,ExpressionUUID->"720f8216-19fa-4a92-b9a5-ac67db32bb93"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"RelabelIndices", "[", 
   RowBox[{"L", ",", 
    RowBox[{"Unique", "->", "True"}]}], "]"}], "//", "NiceForm"}]], "Input",
 CellLabel->"In[53]:=",
 CellID->1217755301,ExpressionUUID->"6e8fea74-3c05-4356-82f0-8ac4bef4deca"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{
     TemplateBox[{
       SubscriptBox["D", "u31"], 
       SuperscriptBox[
        OverscriptBox["\[Phi]", 
         StyleBox["_", FontWeight -> Bold]], 
        StyleBox["u30", FontSize -> 10]]},
      "RowDefault"], 
     TemplateBox[{
       SubscriptBox["D", "u31"], 
       SuperscriptBox["\[Phi]", 
        StyleBox["u30", FontSize -> 10]]},
      "RowDefault"]}], "-", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox["m\[Phi]", 
        StyleBox["u29",
         FontSize->10]], ")"}], "2"], 
     SuperscriptBox[
      OverscriptBox["\[Phi]", 
       StyleBox["_",
        FontWeight->Bold]], 
      StyleBox["u29",
       FontSize->10]], 
     SuperscriptBox["\[Phi]", 
      StyleBox["u29",
       FontSize->10]]}]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[53]//NiceForm=",
 CellID->1987790257,ExpressionUUID->"dfc96a5b-f396-43de-adf4-222be83bfebe"]
}, Open  ]],

Cell["\<\
To manually define a coupling with a flavor index that should be interpreted \
as diagonal one can use:\
\>", "ExampleText",
 CellID->1925535136,ExpressionUUID->"12b55f40-484b-4b86-a917-d97a1ab38481"],

