 FormBox[
  StyleBox[
   RowBox[{
    SuperscriptBox["\[Psi]", 
     StyleBox[
      TemplateBox[{"a_", "p_"},
       "RowDefault"],
      FontSize->10]], "\[RuleDelayed]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], ",", 
      RowBox[{"RelabelIndices", "[", 
       RowBox[{
        RowBox[{
         FormBox[
          StyleBox[
           RowBox[{"(", 
            SubsuperscriptBox[
             OverscriptBox["\[Psi]", 
              StyleBox["_",
               FontWeight->Bold]], 
             StyleBox["x",
              FontSize->10], 
             StyleBox["y",
              FontSize->10]], "\[CenterDot]", 
            SuperscriptBox["\[Psi]", 
             StyleBox[
              TemplateBox[{"x", "y"},
               "RowDefault"],
              FontSize->10]], ")"}],
           SpanSymmetric->False],
          StandardForm], 
         SuperscriptBox["\[Psi]", 
          StyleBox[
           TemplateBox[{"a", "p"},
            "RowDefault"],
           FontSize->10]]}], ",", 
        RowBox[{"Unique", "\[Rule]", "True"}]}], "]"}]}], "]"}]}], 
   "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[45]//NiceForm=",
 CellID->355501013,ExpressionUUID->"e8fb860d-abfa-4f20-8705-159a9fea39c5"]
}, Open  ]],

