Notebook[{

Cell[CellGroupData[{
Cell["ExportWCxf", "ObjectName",
 CellID->839927791,ExpressionUUID->"e4bc73b7-a622-4206-98df-a670abeb25fb"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bcf4803b-f00f-4d59-b959-234e5aacd6fd"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportWCxf",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/ExportWCxf"], "[", 
   RowBox[{
    StyleBox["arg", "TI"], ",", 
    StyleBox["input", "TI"], ",", 
    StyleBox["output", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3b9691b7-24a5-4d32-b27a-de95d2b0e6aa"],
 "\[LineSeparator]generates WCxf files for the EFT Lagrangian or matching \
conditions specified by ",
 Cell[BoxData[
  StyleBox["arg", "TI"]], "InlineFormula",ExpressionUUID->
  "6dcb1b3c-0a20-494e-9169-6ee894d74283"],
 " in the ",
 Cell[BoxData[
  StyleBox["output", "TI"]], "InlineFormula",ExpressionUUID->
  "db48a83f-f710-48f5-a051-673afb686505"],
 " directory. The parameter points must be specified through an ",
 Cell[BoxData[
  StyleBox["input", "TI"]], "InlineFormula",ExpressionUUID->
  "2633d55a-6c36-420d-883b-e0b7e3583ee1"],
 " ",
 StyleBox["JSON", "InlineCode"],
 " file."
}], "Usage",
 CellID->1256371606,ExpressionUUID->"6f617811-77cc-4418-bc5d-14f6c73e37c1"],

Cell[TextData[{
 "The argument ",
 Cell[BoxData[
  StyleBox["arg", "TI"]], "InlineFormula",ExpressionUUID->
  "8d346bc7-e8a9-4063-ac6e-99b302ba2015"],
 StyleBox[" ", "TI"],
 "must be either a SMEFT Lagrangian obtained by the ",
 Cell[BoxData[
  ButtonBox["Match",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Match"]], "InlineFormula",ExpressionUUID->
  "d9876689-95d5-4efd-9ffa-256d872a4f00"],
 " function, or directly a list of matching conditions obtained by ",
 Cell[BoxData[
  ButtonBox["MapEffectiveCouplings",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/MapEffectiveCouplings"]], "InlineFormula",
  ExpressionUUID->"5bae2500-4355-449f-b011-ad806f218745"],
 " with the option  ",
 Cell[BoxData[
  ButtonBox["ShiftRenCouplings",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/ShiftRenCouplings"]], "InlineFormula",
  ExpressionUUID->"d1f3d7d8-d224-49c9-8560-22bc72533838"],
 StyleBox["->", "InlineCode"],
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "3e7d1c13-0397-4b23-a82c-d326d7d5eb45"],
 ". Notice that only BSM models matching directly onto the default SMEFT \
Lagrangian obtained by ",
 Cell[BoxData[
  ButtonBox["LoadModel",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/LoadModel"]], "InlineFormula",
  ExpressionUUID->"ffab14ab-5957-411a-84cf-932d5603b0e0"],
 "[",
 StyleBox["\"SMEFT\"", "InlineCode"],
 "] used by Matchete are currently supported. "
}], "Notes",
 CellID->1778364738,ExpressionUUID->"133c4445-2413-482e-be2f-f5549fdab263"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["input", "TI"]], "InlineFormula",ExpressionUUID->
  "5ba6e26d-8263-44ac-95a6-c58c27de2aca"],
 " argument must specify a path to a ",
 StyleBox["JSON", "InlineCode"],
 "  file containing the following keys: "
}], "Notes",
 CellID->511144537,ExpressionUUID->"543820d6-c2b7-439a-a51e-6cfb3a7e643a"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "62cdd3fe-bcc8-44fa-a971-5ef2c9730c0b"], "\"\<matching scale\>\"", Cell[
    "Matching scale in GeV.", "TableText",ExpressionUUID->
     "d3610ef0-4815-4571-bf42-daa30e75fa96"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e7734df6-36a5-420b-9d0d-b31cd06549f5"], "\"\<parameters\>\"", Cell["\<\
List of all parameter names for which numerical input is provided.\
\>", "TableText",ExpressionUUID->"172dfd9c-19f1-43d6-847c-a4625a9ac0c9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "af188dd5-5ada-40b5-bbce-8adfed49b5ba"], "\"\<dictionary\>\"", Cell[
    TextData[{
     "Dictionary mapping from Matchete notation to the parameter names given \
under ",
     StyleBox["\"parameters\"", "InlineCode"],
     "."
    }], "TableText",ExpressionUUID->"45c48dd2-5fae-4fd7-91bd-cd36db73c161"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8ccce327-cab2-4a95-9e13-17ecc2437de6"], "\"\<parameter points\>\"", 
    Cell[TextData[{
     "Dictionary containing all numerical values: keys are integer IDs for \
each parameter points and values are lists of numbers for the all parameters \
specified in the same order as in ",
     StyleBox["\"parameters\"", "InlineCode"],
     ".\n"
    }], "TableText",ExpressionUUID->"342a91a5-aada-44fa-9e42-9c85e202dee8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c408f203-a032-485d-ada3-3fd03d5cd796"], "\"\<SM\>\"", Cell["\<\
Optional dictionary for overwriting default SM values or scheme choices. \
\>", "TableText",ExpressionUUID->"2a0e3b1d-b333-497e-8e40-2885b19c5313"]}
  }]], "2ColumnTableMod",
 CellID->486644236,ExpressionUUID->"c8d248bb-0268-463b-bcc5-c3e53f9631cc"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["output", "TI"]], "InlineFormula",ExpressionUUID->
  "1deac8f7-2e30-433f-b2d5-f1c681b3774a"],
 " argument specifies a path to the directory where all WCxf files should be \
saved."
}], "Notes",
 CellID->377946473,ExpressionUUID->"6a4c9610-9263-4ab0-968d-354aed6262e4"],

