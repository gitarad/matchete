Cell["\<\
The numerical value of the input parameters listed above that are not used by \
the specified scheme are ignored.\
\>", "Notes",
 CellID->2002522563,ExpressionUUID->"0e5204dc-6f57-4467-829e-6bb91623d525"],

Cell["\<\
Warning: Input redefinitions for these schemes are currently not implemented, \
since these are dimension-eight effects and this function is restricted to \
dimension six.\
\>", "Notes",
 CellID->1538252726,ExpressionUUID->"d80e4c12-7548-442c-9e56-8c071a5fd3f4"],

Cell["\<\
Baryon or lepton number violating operators are currently not supported.\
\>", "Notes",
 CellID->984716411,ExpressionUUID->"41bbd35c-7cb4-4d26-bcfe-4eba821eb27d"]
}, Open  ]],

