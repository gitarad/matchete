Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Indices", "ExampleSubsection",ExpressionUUID->
   "d1188c32-ab57-44ac-b33e-dc8dc22486dd"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->411765530,ExpressionUUID->"c5ba0e12-923c-44ae-b05b-e5a7b6cd7a5a"],

Cell[TextData[{
 "Couplings can have flavor indices in theories where such have been defined. \
Using ",
 Cell[BoxData[
  ButtonBox["DefineFlavorIndex",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DefineFlavorIndex"]], "InlineFormula",
  ExpressionUUID->"9667b060-2330-4d17-a4a8-20338f9b9638"],
 " to initialize a flavor representation with dimension 3,"
}], "ExampleText",
 CellID->1882729934,ExpressionUUID->"fa5879f2-0a90-44d7-8059-c3b65ab983f3"],

Cell[BoxData[
 RowBox[{"DefineFlavorIndex", "[", 
  RowBox[{"Flavor", ",", " ", "3"}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->97647015,ExpressionUUID->"df3981e4-fe02-4c47-b131-7289d58048a1"],

Cell["\<\
we may define a coupling with indices in that space. For instance, the SM \
lepton Yukawa coupling matrix is given by\
\>", "ExampleText",
 CellID->420004561,ExpressionUUID->"dda05d49-f5bf-4e37-9394-18a0951d1061"],

Cell[BoxData[
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"Ye", ",", 
   RowBox[{"Indices", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Flavor", ",", " ", "Flavor"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->1288350383,ExpressionUUID->"6e5c7d22-be4c-4f86-a5df-0289fcb851d4"],

Cell["\<\
The resulting coupling has two flavor indices, which means it must be called \
with two arguments in its definition:\
\>", "ExampleText",
 CellID->1124195584,ExpressionUUID->"416788ba-f0c9-455b-9474-8923d0671580"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Ye", "[", 
   RowBox[{"i", ",", "j"}], "]"}], "//", "NiceForm"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->1196914614,ExpressionUUID->"81168f69-ba81-4194-86a0-8046930adbe5"],

Cell[BoxData[
 FormBox[
  TemplateBox[{
    TagBox[
     FormBox["Ye", StandardForm], StandardForm, Editable -> True], 
    StyleBox[
     TemplateBox[{
       TagBox[
        FormBox[
         FormBox[
          StyleBox["\"i\"", 10, StripOnInput -> False], Matchete`NiceForm], 
         Matchete`NiceForm], Format[#, Matchete`NiceForm]& ], 
       TagBox[
        FormBox[
         FormBox[
          StyleBox["\"j\"", 10, StripOnInput -> False], Matchete`NiceForm], 
         Matchete`NiceForm], Format[#, Matchete`NiceForm]& ]}, "RowDefault"], 
     FontSize -> 12, StripOnInput -> False]},
   "Superscript"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[5]//NiceForm=",
 CellID->2080009281,ExpressionUUID->"5bc9513e-4d0d-46f1-94fe-706d0fa904f9"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
