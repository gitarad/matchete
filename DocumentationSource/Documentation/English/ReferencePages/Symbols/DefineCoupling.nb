Cell["\<\
In advanced situation a coupling can have multiple indices, some of which are \
diagonal and some which are not. Consider \
\>", "ExampleText",
 CellID->311470800,ExpressionUUID->"d0bf223c-9fc5-49e9-a2a8-19f99ecbadc2"],

Cell[BoxData[
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"k", ",", 
   RowBox[{"Indices", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Flavor", ",", " ", "Flavor"}], "}"}]}], ",", " ", 
   RowBox[{"DiagonalCoupling", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[26]:=",
 CellID->1084777189,ExpressionUUID->"2315d19d-c93f-43f8-842d-c3efc516d8f5"],

Cell["\<\
with two indices, the first of which is diagonal. In some sense we might \
think of this as a rank-three tensor that is diagonal under the first two \
indices. In summation situations we have, e.g.,\
\>", "ExampleText",
 CellID->663072322,ExpressionUUID->"0a5fdac6-73fc-43b4-9534-00e5ecd6fa1c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"k", "[", 
     RowBox[{"a", ",", "b"}], "]"}], 
    RowBox[{"\[Lambda]", "[", 
     RowBox[{"a", ",", "b"}], "]"}]}], "//", "RelabelIndices"}], "//", 
  "NiceForm"}]], "Input",
 CellLabel->"In[27]:=",
 CellID->738308049,ExpressionUUID->"c06a772b-13b1-4297-8028-6c53200202e0"],

Cell[BoxData[
 RowBox[{
  FormBox[
   TemplateBox[{
     TagBox[
      FormBox["k", StandardForm], StandardForm, Editable -> True], 
     StyleBox[
      TemplateBox[{
        TagBox[
         FormBox[
          FormBox[
           StyleBox["\"a\"", 10, StripOnInput -> False], Matchete`NiceForm], 
          Matchete`NiceForm], Format[#, Matchete`NiceForm]& ], 
        TagBox[
         FormBox[
          FormBox[
           StyleBox["\"x\"", 10, StripOnInput -> False], Matchete`NiceForm], 
          Matchete`NiceForm], Format[#, Matchete`NiceForm]& ]}, "RowDefault"],
       FontSize -> 12, StripOnInput -> False]},
    "Superscript"],
   Matchete`NiceForm], 
  FormBox[
   TemplateBox[{
     TagBox[
      FormBox["\[Lambda]", StandardForm], StandardForm, Editable -> True], 
     StyleBox[
      TemplateBox[{
        TagBox[
         FormBox[
          FormBox[
           StyleBox["\"a\"", 10, StripOnInput -> False], Matchete`NiceForm], 
          Matchete`NiceForm], Format[#, Matchete`NiceForm]& ], 
        TagBox[
         FormBox[
          FormBox[
           StyleBox["\"x\"", 10, StripOnInput -> False], Matchete`NiceForm], 
          Matchete`NiceForm], Format[#, Matchete`NiceForm]& ]}, "RowDefault"],
       FontSize -> 12, StripOnInput -> False]},
    "Superscript"],
   Matchete`NiceForm]}]], "Output",
 CellLabel->"Out[27]//NiceForm=",
 CellID->1082130913,ExpressionUUID->"9dfbe615-4d2e-40a8-aac2-c069c464b237"]
}, Open  ]],

Cell["\<\
Thus there is only a sum over the second index, which is non-diagonal and \
thus repeated for summation purposes. \
\>", "ExampleText",
 CellID->1643651694,ExpressionUUID->"9baa2f9d-0343-4a41-af75-56000408f78b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

