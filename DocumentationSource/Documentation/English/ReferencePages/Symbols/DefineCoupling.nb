   RowBox[{"{", "}"}], ",", "4"}], "]"}]], "Output",
 CellLabel->"Out[7]=",
 CellID->2022727555,ExpressionUUID->"9364c6e3-c7bc-4d5c-8360-998808dde076"]
}, Open  ]]
