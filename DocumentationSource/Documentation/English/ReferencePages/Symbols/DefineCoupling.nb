 CellID->1419328858,ExpressionUUID->"718ecfae-3978-4aa8-b9d1-bdd3fc8822b4"],

Cell[TextData[{
 "The option ",
 Cell[BoxData[
  ButtonBox["EFTOrder",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/EFTOrder"]], "InlineFormula",
  ExpressionUUID->"119ef0c5-7a5d-42f2-b0d7-e663b88aadd3"],
 " dictates the power-counting behavior of the coupling. A coupling"
}], "ExampleText",
 CellID->1906924565,ExpressionUUID->"3b6d48e9-bdb3-4643-953f-240812512746"],

Cell[BoxData[
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"\[Eta]", ",", " ", 
   RowBox[{"EFTOrder", "\[Rule]", "4"}]}], "]"}]], "Input",
