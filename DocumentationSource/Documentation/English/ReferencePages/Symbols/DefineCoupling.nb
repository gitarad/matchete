   FormBox["\<\"\\!\\(\\*SubscriptBox[\\(y\\), \\(\[Phi]\\)]\\)\"\>",
    StandardForm],
   StandardForm,
   Editable->True], Matchete`NiceForm]], "Output",
 CellLabel->"Out[11]//NiceForm=",
 CellID->1387410676,ExpressionUUID->"581ecd82-7cde-4402-a31f-b61e62b74cc7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "SelfConjugate", "ExampleSubsection",ExpressionUUID->
   "035843ea-99c1-4a40-9204-8e72d5ab5955"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->106941601,ExpressionUUID->"a6effa8f-3478-4229-bb3b-3bd6d4f96298"],

Cell[TextData[{
 "Couplings are by default assumed to be complex; however, in many cases the \
form of the Lagrangian may require that they should be real. In such cases, \
it is important to specify this, so that the simplification algorithms can \
work as well as possible.  To do this, we may use the option ",
 Cell[BoxData[
  ButtonBox["SelfConjugate",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/SelfConjugate"]], "InlineFormula",
  ExpressionUUID->"ef814956-ec68-40a8-8ede-d45b98a348f5"],
 ". To illustrate the behavior of real and complex couplings consider  "
}], "ExampleText",
 CellID->833792406,ExpressionUUID->"2e6f20a3-5954-40ea-9c8c-7a5d13f7ac7b"],

Cell[BoxData[{
 RowBox[{"DefineCoupling", "[", "yComplex", "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"yReal", ",", " ", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[12]:=",
 CellID->2055907054,ExpressionUUID->"27c35517-a33a-4a12-accc-d5a362410eb0"],

Cell[TextData[{
 "Complex conjugation with ",
 Cell[BoxData[
  ButtonBox["Bar",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Bar"]], "InlineFormula",ExpressionUUID->
  "f1276435-03c9-4d64-9ef9-37184829fce9"],
 " gives "
}], "ExampleText",
 CellID->1302374349,ExpressionUUID->"cc25889c-172c-4589-8c4b-97aceb4fd1a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Bar", "@", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"yComplex", "[", "]"}], ",", " ", 
     RowBox[{"yReal", "[", "]"}]}], "}"}]}], "//", "NiceForm"}]], "Input",
 CellLabel->"In[14]:=",
 CellID->377511257,ExpressionUUID->"69f07e5d-c21a-4ea8-8b61-a3a77c882c3f"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    FormBox[
     TagBox[
      FormBox[
       OverscriptBox["yComplex", "_"],
       StandardForm],
      StandardForm,
      Editable->True],
     Matchete`NiceForm], ",", 
    FormBox[
     TagBox[
      FormBox["yReal",
       StandardForm],
      StandardForm,
      Editable->True],
     Matchete`NiceForm]}], "}"}], Matchete`NiceForm]], "Output",
 CellLabel->"Out[14]//NiceForm=",
 CellID->1379811846,ExpressionUUID->"164f09d1-64a2-4da3-8cfa-015106264c11"]
}, Open  ]],

Cell["\<\
demonstrating that Bar acts non-trivially only on the complex coupling.\
\>", "ExampleText",
 CellID->807809663,ExpressionUUID->"fb19e995-6e68-4baf-8173-33e042240cd2"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "e2fdf8ec-439a-41b9-8bf3-f400aa53f13a"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->1479745458,ExpressionUUID->"83685563-f479-4152-a6a9-72f0b7d852a4"],

Cell["\<\
If a coupling is a tensor in flavor space, complex conjugation can also have \
the effect of exchanging the indices of the coupling. For instance, we may \
define a Hermitian coupling matrix (complex conjugation exchanges the first \
and second indices)\
\>", "ExampleText",
 CellID->1203055774,ExpressionUUID->"8be1ce62-005d-49b3-8c6f-9e05154cd639"],

Cell[BoxData[{
 RowBox[{"DefineFlavorIndex", "[", 
  RowBox[{"Flavor", ",", " ", "3"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"\[Kappa]", ",", 
   RowBox[{"Indices", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Flavor", ",", "Flavor"}], "}"}]}], ",", " ", 
   RowBox[{"SelfConjugate", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[42]:=",
 CellID->73796699,ExpressionUUID->"595546ab-2d7a-4b47-9a9f-3ddf7daa6551"],

Cell["In that event ", "ExampleText",
 CellID->353594287,ExpressionUUID->"016c7745-4b97-436a-be0b-dada83cb259c"],

Cell[CellGroupData[{

Cell["\<\
\[Kappa][a,b]// NiceForm
Bar@ \[Kappa][a,b]// NiceForm\
\>", "Input",
 CellLabel->"In[47]:=",
 CellID->881248536,ExpressionUUID->"403fffa2-8373-46e6-a7ce-cec7586eaaac"],

Cell[BoxData[
 FormBox[
  TemplateBox[{
    TagBox[
     FormBox["\[Kappa]", StandardForm], StandardForm, Editable -> True], 
    StyleBox[
     TemplateBox[{
       TagBox[
        FormBox[
         FormBox[
          StyleBox["\"a\"", 10, StripOnInput -> False], Matchete`NiceForm], 
         Matchete`NiceForm], Format[#, Matchete`NiceForm]& ], 
       TagBox[
        FormBox[
         FormBox[
          StyleBox["\"b\"", 10, StripOnInput -> False], Matchete`NiceForm], 
         Matchete`NiceForm], Format[#, Matchete`NiceForm]& ]}, "RowDefault"], 
     FontSize -> 12, StripOnInput -> False]},
   "Superscript"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[47]//NiceForm=",
 CellID->283409419,ExpressionUUID->"663e6f69-1c95-4250-a3f5-e842f0640479"],

Cell[BoxData[
 FormBox[
  TemplateBox[{
    TagBox[
     FormBox["\[Kappa]", StandardForm], StandardForm, Editable -> True], 
    StyleBox[
     TemplateBox[{
       TagBox[
        FormBox[
         FormBox[
          StyleBox["\"b\"", 10, StripOnInput -> False], Matchete`NiceForm], 
         Matchete`NiceForm], Format[#, Matchete`NiceForm]& ], 
       TagBox[
        FormBox[
         FormBox[
          StyleBox["\"a\"", 10, StripOnInput -> False], Matchete`NiceForm], 
         Matchete`NiceForm], Format[#, Matchete`NiceForm]& ]}, "RowDefault"], 
     FontSize -> 12, StripOnInput -> False]},
   "Superscript"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[48]//NiceForm=",
 CellID->143376087,ExpressionUUID->"9b7ba06c-d053-406e-9114-19c23e2c0784"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Symmetries", "ExampleSubsection",ExpressionUUID->
   "d0c9acfd-1ed9-4947-a523-a85c35ff7531"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->2071159115,ExpressionUUID->"28bd315a-5ad7-43aa-9d13-3e5ab386eff9"],

Cell["\<\
When couplings have multiple indices of the same type, it might be \
(anti-)symmetric under permutation of the indices. Including this information \
allows the simplification methods to perform better. \
\>", "ExampleText",
 CellID->1651493344,ExpressionUUID->"7b617b08-00b1-430d-9020-694db36c81e0"],

Cell[TextData[{
 "An example of such symmetries are from the SMEFT operator ",
 Cell[BoxData[
  SubscriptBox["C", "ee"]], "InlineFormula",ExpressionUUID->
  "4168fcf1-b459-46c3-accb-406caa52f01f"],
 ", which has four flavor indices. It is symmetric under exchanges of the two \
first and two last indices in addition to under the exchange of indices 2 and \
4:"
}], "ExampleText",
 CellID->991523310,ExpressionUUID->"2ac86492-380f-4030-b450-c4aaae24531c"],

Cell[BoxData[{
 RowBox[{"DefineFlavorIndex", "[", 
  RowBox[{"Flavor", ",", " ", "3"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"Cee", ",", 
   RowBox[{"Indices", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Flavor", ",", "Flavor", ",", "Flavor", ",", "Flavor"}], "}"}]}],
    ",", 
   RowBox[{"Symmetries", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"SymmetricPermutation", "[", 
       RowBox[{"3", ",", "4", ",", "1", ",", "2"}], "]"}], ",", 
      RowBox[{"SymmetricPermutation", "[", 
       RowBox[{"1", ",", "4", ",", "3", ",", "2"}], "]"}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[38]:=",
 CellID->131513117,ExpressionUUID->"af75fbb1-ae90-4a37-bbf4-7a670ca8c730"],

Cell["\<\
We can verify that the coupling is in fact initialized with symmetries under \
the full symmetry group generated by the elements we provided. In this case \
we also get symmetry under the exchange of indices 1 and 3:\
\>", "ExampleText",
 CellID->849250985,ExpressionUUID->"1df600bb-5177-4939-82c6-e924a2c122b3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GetCouplings", "[", 
  RowBox[{"Cee", ",", "Symmetries"}], "]"}]], "Input",
 CellLabel->"In[41]:=",
 CellID->40315600,ExpressionUUID->"ae9a0de7-2932-4edf-bbbb-7473ea46819e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], "\[Rule]", "1"}], 
   ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", "4", ",", "1", ",", "2"}], "}"}], "\[Rule]", "1"}], 
   ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "4", ",", "3", ",", "2"}], "}"}], "\[Rule]", "1"}], 
   ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", "2", ",", "1", ",", "4"}], "}"}], "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[41]=",
 CellID->1957146197,ExpressionUUID->"e935b360-6f14-47a2-9ceb-46a4804c3756"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

