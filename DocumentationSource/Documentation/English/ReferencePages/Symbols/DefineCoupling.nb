  "NiceForm", "ExampleSubsection",ExpressionUUID->
   "904330ae-9985-4c58-b9e6-0a611482b095"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->1350952076,ExpressionUUID->"fc6f2803-ed67-4997-9649-329f5b22703f"],

Cell[TextData[{
 "The option ",
 Cell[BoxData[
  ButtonBox["NiceForm",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/NiceForm"]], "InlineFormula",
  ExpressionUUID->"a952c234-0e79-4764-ba76-64ce60c29f16"],
 " can be provided to the coupling definition to change how it displays under \
",
 Cell[BoxData[
  ButtonBox["NiceForm",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/NiceForm"]], "InlineFormula",
  ExpressionUUID->"6a1ee3f2-3573-4d76-a543-988cebb52ba7"],
 " output. The default is to use the label of the coupling, but it can be \
changed by providing a string. For instance to display the coupling with a \
subscript, we would use "
}], "ExampleText",
 CellID->1298571887,ExpressionUUID->"a9ec235a-374c-4116-9137-5dd75d25881e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"y\[Phi]", ",", " ", 
   RowBox[{
   "NiceForm", "\[Rule]", 
    "\"\<\!\(\*SubscriptBox[\(y\), \(\[Phi]\)]\)\>\""}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"y\[Phi]", "[", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y\[Phi]", "[", "]"}], "//", "NiceForm"}]}], "Input",
 CellLabel->"In[9]:=",
 CellID->189100156,ExpressionUUID->"cf318833-5516-4141-86c1-da27f1296bac"],

Cell[BoxData[
 RowBox[{"Coupling", "[", 
  RowBox[{"y\[Phi]", ",", 
   RowBox[{"{", "}"}], ",", "0"}], "]"}]], "Output",
 CellLabel->"Out[10]=",
