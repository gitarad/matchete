Cell["\<\
The default behavior of flavor indices of couplings is that they respect \
Einstein summation convention. An ordinary two-index coupling \
\>", "ExampleText",
 CellID->2097083120,ExpressionUUID->"ce193250-e9c0-4e78-b405-4176b2bd75c1"],

Cell[BoxData[
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"\[Lambda]", ",", 
   RowBox[{"Indices", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Flavor", ",", "Flavor"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[19]:=",
 CellID->234394200,ExpressionUUID->"763400bf-965a-4ad2-96e9-78abf552e097"],

Cell[TextData[{
 "can, thus, freely have repeated indices relabeled (with ",
 Cell[BoxData[
  ButtonBox["RelabelIndices",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/RelabelIndices"]], "InlineFormula",
  ExpressionUUID->"1e5bbdf1-854b-4b88-9158-3290c3ecbb32"],
 ")"
}], "ExampleText",
 CellID->1551897559,ExpressionUUID->"6ea46501-be18-4008-81a0-bc6e1c1982cc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Bar", "@", " ", 
     RowBox[{"\[Lambda]", "[", 
      RowBox[{"a", ",", "b"}], "]"}]}], 
    RowBox[{"\[Lambda]", "[", 
     RowBox[{"b", ",", "c"}], "]"}]}], "//", "RelabelIndices"}], "//", 
  "NiceForm"}]], "Input",
 CellLabel->"In[20]:=",
 CellID->1978586148,ExpressionUUID->"2bac9291-5ddb-448c-9e2e-758c0aba1727"],

Cell[BoxData[
 RowBox[{
  FormBox[
   TemplateBox[{
     TagBox[
      FormBox[
       OverscriptBox["\[Lambda]", "_"], StandardForm], StandardForm, Editable -> 
      True], 
     StyleBox[
      TemplateBox[{
        TagBox[
         FormBox[
          FormBox[
           StyleBox["\"a\"", 10, StripOnInput -> False], Matchete`NiceForm], 
          Matchete`NiceForm], Format[#, Matchete`NiceForm]& ], 
        TagBox[
         FormBox[
          FormBox[
           StyleBox["\"x\"", 10, StripOnInput -> False], Matchete`NiceForm], 
          Matchete`NiceForm], Format[#, Matchete`NiceForm]& ]}, "RowDefault"],
       FontSize -> 12, StripOnInput -> False]},
    "Superscript"],
   Matchete`NiceForm], 
  FormBox[
   TemplateBox[{
     TagBox[
      FormBox["\[Lambda]", StandardForm], StandardForm, Editable -> True], 
     StyleBox[
      TemplateBox[{
        TagBox[
         FormBox[
          FormBox[
           StyleBox["\"x\"", 10, StripOnInput -> False], Matchete`NiceForm], 
          Matchete`NiceForm], Format[#, Matchete`NiceForm]& ], 
        TagBox[
         FormBox[
          FormBox[
           StyleBox["\"c\"", 10, StripOnInput -> False], Matchete`NiceForm], 
          Matchete`NiceForm], Format[#, Matchete`NiceForm]& ]}, "RowDefault"],
       FontSize -> 12, StripOnInput -> False]},
    "Superscript"],
   Matchete`NiceForm]}]], "Output",
 CellLabel->"Out[20]//NiceForm=",
 CellID->628743597,ExpressionUUID->"a73a92cb-00be-4ef7-b357-414b103781c7"]
}, Open  ]],

