 " are"
}], "Notes",
 CellID->1206187962,ExpressionUUID->"1977e804-e4d0-4cd7-8a9b-4c73896ccb1d"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "81c82328-5f08-4dd7-9921-b75ab3b42e8a"], 
    ButtonBox["Default",
     BaseStyle->"Link"], Cell[
    "all indices are taken to be non-diagonal", "TableText",ExpressionUUID->
     "5115b17e-b040-4417-b391-4788fdddd3dc"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cccae966-c1ce-47c9-9966-fab88e2386f6"], "Boolean", Cell[
    "specifies if the single index is diagonal or not", "TableText",
     ExpressionUUID->"8854c31f-fe1b-4d41-9eaf-a86ea6eb9ce5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "272b5732-cf08-4eae-97d7-7f0340c78574"], 
    RowBox[{"{", 
     RowBox[{"Boolean", ",", " ", "Boolean", ",", " ", "\[Ellipsis]"}], "}"}],
     Cell["\<\
the n'th Boolean specifies whether the n'th flavor index is a diagonal in \
flavor space\
\>", "TableText",ExpressionUUID->"b148839f-506e-4df9-b35b-147033994b68"]}
  }]], "2ColumnTableMod",
 CellID->411930956,ExpressionUUID->"dc635615-d189-4e2e-a9f2-5cd6b19284fa"],

Cell[TextData[{
 "The EFT power counting behavior of the coupling as specified by ",
 Cell[BoxData[
  ButtonBox["EFTOrder",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/EFTOrder"]], "InlineFormula",
  ExpressionUUID->"30cb278f-6ecc-4edb-bce7-4164440933ac"],
 " is used by Matchete to truncate the EFTexpansion in functions such as ",
 Cell[BoxData[
  ButtonBox["Match",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Match"]], "InlineFormula",ExpressionUUID->
  "8bf14f9d-fec5-465b-96a9-9f1e249ec9e1"],
 " or ",
 Cell[BoxData[
  ButtonBox["SeriesEFT",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/SeriesEFT"]], "InlineFormula",
  ExpressionUUID->"34a77aed-37f6-439b-8f84-4ef2d5a4d369"],
 ". The counting (EFTOrder) of light bosons and covariant derivatives are 1."
}], "Notes",
 CellID->1942479575,ExpressionUUID->"a13ed542-e8b3-4daf-9b10-7d4ae3c1106a"],

