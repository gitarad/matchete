Cell[CellGroupData[{
Cell["DefineCoupling", "ObjectName",
 CellID->1005415536,ExpressionUUID->"4b8c63ae-4a63-4edd-9080-c67bf6dc8b8e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1da900ed-617e-4514-a316-0e6b5e4260f8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DefineCoupling",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/DefineCoupling"], "[", 
   StyleBox["label", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "be5671e9-37e7-4f0d-8030-4088b9a9e0cd"],
 "\[LineSeparator]defines a new coupling referred to by its ",
 Cell[BoxData[
  StyleBox["label", "TI"]], "InlineFormula",ExpressionUUID->
  "9795fbf9-b611-4d9b-9c60-ac0724a65d22"],
 " to be used in Lagrangians. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"0425039a-ccd0-40b4-8311-5cc67fa4fbd0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DefineCoupling",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/DefineCoupling"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["label", "TI"], 
      StyleBox["1", "TR"]], ",", 
     SubscriptBox[
      StyleBox["label", "TI"], 
      StyleBox["2", "TR"]], ",", 
     StyleBox["\[Ellipsis]", "TR"]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"504ab6a7-4c82-4169-9a44-a4daf1538376"],
 "\[LineSeparator]defines multiple new couplings referred to by ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["label", "TI"], 
    StyleBox["1", "TR"]], ",", " ", 
   SubscriptBox[
    StyleBox["label", "TI"], 
    StyleBox["2", "TR"]], ",", 
   StyleBox["\[Ellipsis]", "TR"]}]], "InlineFormula",ExpressionUUID->
  "f0cee7f3-b8ed-4c69-8ea0-2a57e59ba47c"],
 " that all share the same properties. "
}], "Usage",
 CellID->1617578956,ExpressionUUID->"5e1e5ab5-ddfa-4cb1-9bb8-8ede14bf79ae"],

Cell[TextData[{
 "Defining a coupling with ",
 Cell[BoxData[
  ButtonBox["DefineCoupling",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DefineCoupling"]], "InlineFormula",
  ExpressionUUID->"eed60b0e-c7f3-4cec-975b-e4166d36eadb"],
 " informs Matchete of the EFT order counting and indices of the coupling in \
question. All couplings must be defined before a Lagrangian can be written \
down. "
}], "Notes",
 CellID->1765356201,ExpressionUUID->"f65ab811-7249-4b10-b1bc-b96f9d0e4689"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["DefineCoupling",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DefineCoupling"]], "InlineFormula",
  ExpressionUUID->"dd0527f0-b180-4424-a254-9cf4d7da0b5b"],
 " provides a new function ",
 Cell[BoxData[
  StyleBox["label", "TI"]], "InlineFormula",ExpressionUUID->
  "36c591cb-9c32-451d-ab36-0f51c67a9ca4"],
 "[] (or ",
 Cell[BoxData[
  StyleBox["label", "TI"]], "InlineFormula",ExpressionUUID->
  "ff5c73de-194e-4655-a1f7-f8b3a2dc9c61"],
 "[i, j, ...] if indices are provided with the ",
 Cell[BoxData[
  ButtonBox["Indices",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Indices"]], "InlineFormula",
  ExpressionUUID->"863dfb7c-8f67-4733-ae2b-a33b994155ad"],
 " option) that provides a shortcut for the user to write the coupling in the \
internal format used in Matchete. It gives an instance of the coupling with \
the given indices. "
}], "Notes",
 CellID->1938043328,ExpressionUUID->"ee46d247-94fd-4726-a5b8-ad9f868946ef"],

Cell["The following options can be given: ", "Notes",
 CellID->1654026119,ExpressionUUID->"0ae3fdaf-badd-4717-b3c1-0a572d40b3a6"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "0f7281c1-2f7d-4b4f-b451-f4cd51e44d4f"], 
    ButtonBox["DiagonalCoupling",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/DiagonalCoupling"], 
    ButtonBox["Default",
     BaseStyle->"Link"], Cell["\<\
specifies if any of the indices are diagonal in flavor space, meaning \
irrelevant for Einstein summation convention.\
\>", "TableText",ExpressionUUID->"310d2eb2-7b90-46a9-b039-455f8fa0c904"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "0436e20c-f011-4717-86a6-2e4ed9e3a1c0"], 
    ButtonBox["EFTOrder",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/EFTOrder"], "0", Cell["\<\
specifies the EFT power-counting of the coupling with a non-negative integer.\
\
\>", "TableText",ExpressionUUID->"c50ae6bf-2e6e-4a37-bbd9-2af61c8cc691"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "037225b9-7a57-4e07-9e11-56ea59636a46"], 
    ButtonBox["Indices",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/Indices"], 
    RowBox[{"{", "}"}], Cell["\<\
specifies a (list of) representation(s) corresponding to the flavor indices \
carried by the coupling. \
\>", "TableText",ExpressionUUID->"fc86807d-7506-421c-85dd-e60c4c7fb15f"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "4ca8b00c-aa36-406a-b2d6-8e6b50cc9b5b"], 
    ButtonBox["NiceForm",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/NiceForm"], 
    ButtonBox["Default",
     BaseStyle->"Link"], Cell[TextData[{
     "provides the display of the field under ",
     Cell[BoxData[
      ButtonBox["NiceForm",
       BaseStyle->"Link",
       ButtonData->"paclet:Matchete/ref/NiceForm"]], "InlineFormula",
