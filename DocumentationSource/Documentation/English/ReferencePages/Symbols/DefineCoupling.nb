 CellID->309694361,ExpressionUUID->"052c5268-5bde-47a5-9d93-39b5abe1e659"],

Cell["\<\
with EFTOrder 4, vanishes when truncating the EFT series at dimension 3:\
\>", "ExampleText",
 CellID->1760579641,ExpressionUUID->"8b1e446c-7e42-4a23-b411-9a88915d1f7f"],

Cell[CellGroupData[{

Cell["\<\
SeriesEFT[\[Eta][], EFTOrder\[Rule] 3]
SeriesEFT[\[Eta][], EFTOrder\[Rule] 4]\
\>", "Input",
 CellLabel->"In[6]:=",
 CellID->66160461,ExpressionUUID->"85274984-9e0a-43d7-8eb5-435c66ad32a5"],

Cell[BoxData["0"], "Output",
