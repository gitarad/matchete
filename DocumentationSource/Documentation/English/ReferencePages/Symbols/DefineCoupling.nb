     " formatting."
    }], "TableText",ExpressionUUID->"2226c032-556b-4872-a05b-875c862e34a4"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "00840ae7-2b0d-416a-add9-f883ffb9d8ed"], 
    ButtonBox["SelfConjugate",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/SelfConjugate"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[
    "specifies whether the field is self-conjugated (real).", "TableText",
     ExpressionUUID->"866b8594-59c3-4b29-a6de-8e4210904cc4"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c1470c0f-4aae-4ee1-a12d-57940c48d0b8"], 
    ButtonBox["Symmetries",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/Symmetries"], 
    RowBox[{"{", "}"}], Cell["\<\
provides a list of symmetries among the indices of the coupling.\
\>", "TableText",ExpressionUUID->"07b8bf60-d5fd-4cce-8fb4-2d8ac25de08a"]}
  }]], "3ColumnTableMod",
 CellID->41171618,ExpressionUUID->"62e0b369-ecb7-4596-b9f6-4b0e1b3ba519"],

Cell[TextData[{
 "The allowed values for the option ",
 Cell[BoxData[
  ButtonBox["DiagonalCoupling",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DiagonalCoupling"]], "InlineFormula",
