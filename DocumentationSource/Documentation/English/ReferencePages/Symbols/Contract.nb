Cell["Defining a scalar field with a flavor index:", "ExampleText",
 CellID->1566025281,ExpressionUUID->"be796ac4-a3ed-4e90-bf78-09e1f6d00d0a"],

Cell[BoxData[{
 RowBox[{"DefineFlavorIndex", "[", 
  RowBox[{"Flavor", ",", "3", ",", 
   RowBox[{"IndexAlphabet", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<p\>\"", ",", "\"\<r\>\"", ",", "\"\<s\>\"", ",", "\"\<t\>\""}], 
     "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", "Flavor", "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->1751628755,ExpressionUUID->"c5ea17d5-c621-44b2-a8d8-d22520dd5076"],

Cell["Contracting expressions with one Delta:", "ExampleText",
 CellID->1628756212,ExpressionUUID->"ee5f0938-9946-4039-a549-e8b178fc9352"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"expr", "=", 
   RowBox[{
    RowBox[{"Bar", "@", 
     RowBox[{"\[Phi]", "[", "p", "]"}]}], 
    RowBox[{"\[Phi]", "[", "r", "]"}], 
    RowBox[{"Delta", "[", 
     RowBox[{
      RowBox[{"Index", "[", 
       RowBox[{"p", ",", "Flavor"}], "]"}], ",", 
      RowBox[{"Index", "[", 
       RowBox[{"r", ",", "Flavor"}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"expr", "//", "NiceForm"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Contract", "[", "expr", "]"}], "//", "NiceForm"}]}], "Input",
 CellLabel->"In[3]:=",
 CellID->1650876191,ExpressionUUID->"e4ec0ea7-630f-4476-8330-a7b87870135f"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    SubscriptBox["\[Delta]", 
     StyleBox[
      TemplateBox[{"p", "r"},
       "RowDefault"],
      FontSize->10]], 
    SuperscriptBox[
     OverscriptBox["\[Phi]", 
      StyleBox["_",
       FontWeight->Bold]], 
     StyleBox["p",
      FontSize->10]], 
    SuperscriptBox["\[Phi]", 
     StyleBox["r",
      FontSize->10]]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[4]//NiceForm=",
 CellID->1433541368,ExpressionUUID->"9b01d38d-0070-4c9e-872b-78e0dc4ab012"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox["\[Phi]", 
      StyleBox["_",
       FontWeight->Bold]], 
     StyleBox["p",
      FontSize->10]], 
    SuperscriptBox["\[Phi]", 
     StyleBox["p",
      FontSize->10]]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[5]//NiceForm=",
 CellID->910736283,ExpressionUUID->"4416d213-76c8-4718-a4ec-626d0945d7d8"]
}, Open  ]],

