 Cell[BoxData[
  RowBox[{
   ButtonBox["Metric",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/Metric"], "[", 
   RowBox[{
    StyleBox["\[Mu]", "TR"], ",", 
    StyleBox["\[Nu]", "TR"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e03048fa-ddf4-4f19-8341-4ba385602ab5"],
 " tensors in the expression ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "19e77764-2145-4937-8328-03fde2a50666"],
 " whenever possible."
}], "Usage",
 CellID->275847646,ExpressionUUID->"f9092958-85e5-41d6-85e5-19d93c30a87d"],

Cell[TextData[{
 "When contracting flavor indices, Contract should only be applied to entire \
Lagrangian terms and not to sub-expressions. For more details see ",
 ButtonBox["Possible Issues",
  BaseStyle->"Link",
  ButtonData->"paclet:Matchete/ref/Contract#89502682"],
 " section."
}], "Notes",
 CellID->1901676096,ExpressionUUID->"8ee54d0e-6836-4d32-aed6-65870d4ee2cf"]
