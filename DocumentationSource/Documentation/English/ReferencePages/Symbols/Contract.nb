Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"07964893-2d41-4bc3-a027-d5bb05d84617"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Contract",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/Contract"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "0f2e039b-91f6-4ff4-832f-a7606d131e88"],
 "\[LineSeparator]contracts all ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Delta",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/Delta"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4b2a904a-3a6a-4358-903e-8464ff49c1f1"],
