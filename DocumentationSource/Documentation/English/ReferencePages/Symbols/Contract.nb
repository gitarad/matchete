Cell["\<\
Special attention has to be paid when contracting flavor indices. This is \
because of certain flavor tensors, such as diagonal mass matrices, carrying \
only a single flavor index, which breaks the conventional Einstein summation \
convention. \
\>", "ExampleText",
 CellID->1957646044,ExpressionUUID->"0ef74ac1-7675-45e4-9b9c-1ae5afe3cc41"],

Cell["\<\
Consider  the following setup with a flavored scalar field, which has a \
flavor non-universal, but diagonal mass matrix:\
\>", "ExampleText",
 CellID->1335238479,ExpressionUUID->"974f9c9c-3ce7-4bc3-b0ca-86c5e216b2eb"],

Cell[BoxData[{
 RowBox[{"DefineFlavorIndex", "[", 
  RowBox[{"Flavor", ",", "nf", ",", 
   RowBox[{"IndexAlphabet", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<p\>\"", ",", "\"\<r\>\"", ",", "\"\<s\>\"", ",", "\"\<t\>\""}], 
     "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", "Flavor", "}"}]}], ",", 
   RowBox[{"Mass", "->", 
    RowBox[{"{", 
     RowBox[{"Heavy", ",", "M", ",", 
      RowBox[{"{", "Flavor", "}"}]}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->800661792,ExpressionUUID->"3a3a47d2-15bf-46fe-bf22-2a793cc930d9"],

Cell[TextData[{
 "The following expression would be problematic if flavor deltas would \
automatically contract with each other such as gauge deltas do. In \
particular, the flavor index ",
 StyleBox["r", "TI"],
 " on the mass ",
 StyleBox["M ", "TI"],
 "would not be properly relabeled:"
}], "ExampleText",
 CellID->1202815051,ExpressionUUID->"bc1c82da-3102-4ba6-be2d-e2e07917e603"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"expr", "=", 
   RowBox[{
    RowBox[{"M", "[", "r", "]"}], 
    RowBox[{"Delta", "[", 
     RowBox[{
      RowBox[{"Index", "[", 
       RowBox[{"p", ",", "Flavor"}], "]"}], ",", 
      RowBox[{"Index", "[", 
       RowBox[{"r", ",", "Flavor"}], "]"}]}], "]"}], 
    RowBox[{"Delta", "[", 
     RowBox[{
      RowBox[{"Index", "[", 
       RowBox[{"r", ",", "Flavor"}], "]"}], ",", 
      RowBox[{"Index", "[", 
       RowBox[{"s", ",", "Flavor"}], "]"}]}], "]"}], 
    RowBox[{"Bar", "@", 
     RowBox[{"\[Phi]", "[", "p", "]"}]}], 
    RowBox[{"\[Phi]", "[", "s", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"expr", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[6]:=",
 CellID->1670008608,ExpressionUUID->"347d83e2-dc56-44dc-a8f8-a4a1091f7e19"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    SuperscriptBox["M", 
     StyleBox["r",
      FontSize->10]], 
    SubscriptBox["\[Delta]", 
     StyleBox[
      TemplateBox[{"p", "r"},
       "RowDefault"],
      FontSize->10]], 
    SubscriptBox["\[Delta]", 
     StyleBox[
      TemplateBox[{"r", "s"},
       "RowDefault"],
      FontSize->10]], 
    SuperscriptBox[
     OverscriptBox["\[Phi]", 
      StyleBox["_",
       FontWeight->Bold]], 
     StyleBox["p",
      FontSize->10]], 
    SuperscriptBox["\[Phi]", 
     StyleBox["s",
      FontSize->10]]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[7]//NiceForm=",
 CellID->2025404064,ExpressionUUID->"b8045170-333b-4978-9516-e9b4593e1e89"]
}, Open  ]],

Cell[TextData[{
 "Therefore, one has to manually use ",
 Cell[BoxData[
  ButtonBox["Contract",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Contract"]], "InlineFormula",
  ExpressionUUID->"36634528-5ddf-4c88-a72f-665a407ea338"],
 " for flavor indices, which takes care of the proper relabeling of all \
flavor indices, including the ones on diagonal flavor tensors:"
}], "ExampleText",
 CellID->1224425320,ExpressionUUID->"697d9043-aca9-4e9e-aaf0-0a2e8688f4b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Contract", "[", "expr", "]"}], "//", "NiceForm"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->518117218,ExpressionUUID->"9953f318-2813-446f-90d2-c70f70a388aa"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    SuperscriptBox["M", 
     StyleBox["p",
      FontSize->10]], 
    SuperscriptBox[
     OverscriptBox["\[Phi]", 
      StyleBox["_",
       FontWeight->Bold]], 
     StyleBox["p",
      FontSize->10]], 
    SuperscriptBox["\[Phi]", 
     StyleBox["p",
      FontSize->10]]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[8]//NiceForm=",
 CellID->1251336640,ExpressionUUID->"e4dc2972-c336-4376-8055-059eb4fb1a3f"]
}, Open  ]],

Cell["\<\
Notice, however, that Contract should only be applied to full Lagrangian \
terms, but not to subexpressions. The problem can be seen with the example \
above:\
\>", "ExampleText",
 CellID->2135888189,ExpressionUUID->"e80b3e5a-7c43-4373-bfac-8b9928f85a66"],

Cell[CellGroupData[{

Cell["\<\
M[r]Contract[Delta[Index[p, Flavor], Index[r, Flavor]] Delta[Index[r, \
Flavor], Index[s, Flavor]] Bar@\[Phi][p] \[Phi][s]]//NiceForm\
\>", "Input",
 CellLabel->"In[14]:=",
 CellID->905890893,ExpressionUUID->"2c2b2637-7f77-4552-8541-641861c94846"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    SuperscriptBox["M", 
     StyleBox["r",
      FontSize->10]], 
    SuperscriptBox[
     OverscriptBox["\[Phi]", 
      StyleBox["_",
       FontWeight->Bold]], 
     StyleBox["p",
      FontSize->10]], 
    SuperscriptBox["\[Phi]", 
     StyleBox["p",
      FontSize->10]]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[14]//NiceForm=",
 CellID->1285365084,ExpressionUUID->"648cc03b-5f80-4282-9408-6bc1c08ab3d6"]
}, Open  ]],

Cell[TextData[{
 "Here the flavor index ",
 StyleBox["r", "TI"],
 " outside the ",
 Cell[BoxData[
  ButtonBox["Contract",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Contract"]], "InlineFormula",
  ExpressionUUID->"db93642c-6f52-4e71-b758-463102fad731"],
 " was not properly identified and relabeled, highlighting that special care \
should be paid to properly applying Contract only to full Lagrangian terms \
and not sup-expressions."
}], "ExampleText",
 CellID->1414448073,ExpressionUUID->"584658a0-f6cd-445d-94d7-748258ded5df"]
}, Open  ]],

