 " to ",
 StyleBox["True", "InlineCode"],
 " results in ",
 StyleBox["NiceForm", "InlineCode"],
 " showing the representations of each index as well:"
}], "ExampleText",
 CellID->2045007915,ExpressionUUID->"a8f1d26c-9e72-43ee-84fe-5b80327d44b8"],

Cell[CellGroupData[{

Cell[BoxData[{
