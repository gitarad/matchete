  RowBox[{"\[Phi]", "[", "i", "]"}], "//", "NiceForm"}]}], "Input",
 CellLabel->"In[15]:=",
 CellID->896243250,ExpressionUUID->"ffe2e995-fb99-4bcd-8688-c1bdd57a2c09"],

Cell[BoxData[
 FormBox[
  StyleBox[
   SuperscriptBox["\[Phi]", 
    StyleBox[
     SuperscriptBox["i", 
      RowBox[{"G", "[", "fund", "]"}]],
     FontSize->10]], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[16]//NiceForm=",
 CellID->1418950597,ExpressionUUID->"1e7aeb4a-aeb3-498a-a9b4-cd2dd12df88f"]
}, Open  ]]
