Cell["Defining a gauge group:", "ExampleText",
 CellID->496783844,ExpressionUUID->"2614362a-ddcb-4263-8917-078cfe619d54"],

Cell[BoxData[
 RowBox[{"DefineGaugeGroup", "[", 
  RowBox[{"G", ",", 
   RowBox[{"SU", "@", "3"}], ",", "g", ",", "F", ",", "\[IndentingNewLine]", 
   "\t", 
   RowBox[{"FundAlphabet", "->", 
    RowBox[{"CharacterRange", "[", 
     RowBox[{"\"\<a\>\"", ",", "\"\<d\>\""}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[11]:=",
 CellID->2019247664,ExpressionUUID->"a2b39a9a-f06a-47ad-aacf-d2079aff6dbc"],

Cell["\<\
Defining a field transforming under the fundamental representation of the \
gauge group:\
\>", "ExampleText",
 CellID->1143268760,ExpressionUUID->"ed806768-ee2b-4926-b5a5-4ae46eccc6d2"],

Cell[BoxData[
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", 
     RowBox[{"G", "[", "fund", "]"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[12]:=",
 CellID->478527177,ExpressionUUID->"5f5b9b3e-4e97-40e8-a483-8c97be33f9cb"],

Cell["By default the indices are just printed as a simple label:", \
"ExampleText",
 CellID->1877691236,ExpressionUUID->"93f5ec20-d0d2-47e3-a2f2-9178714ce30b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Phi]", "[", "i", "]"}], "//", "NiceForm"}]], "Input",
 CellLabel->"In[13]:=",
 CellID->1547612276,ExpressionUUID->"6a22d08a-6095-410a-bf3e-6af72bf1ca74"],

Cell[BoxData[
 FormBox[
  StyleBox[
   SuperscriptBox["\[Phi]", 
    StyleBox["i",
     FontSize->10]], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[13]//NiceForm=",
 CellID->2062369802,ExpressionUUID->"4be26e9d-1a52-4ed0-a739-1df454f1ce3f"]
}, Open  ]],

Cell[TextData[{
 "Setting ",
