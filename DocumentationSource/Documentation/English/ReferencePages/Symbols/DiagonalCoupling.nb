Cell["Defining a flavor index type:", "ExampleText",
 CellID->106796810,ExpressionUUID->"d920daef-bbfa-41b1-b3c3-8d4bbae125b6"],

Cell[BoxData[
 RowBox[{"DefineFlavorIndex", "[", 
  RowBox[{"Flavor", ",", "3", ",", 
   RowBox[{"IndexAlphabet", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<p\>\"", ",", "\"\<r\>\"", ",", "\"\<s\>\"", ",", "\"\<t\>\""}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->272604914,ExpressionUUID->"bc7d9130-79f0-4c50-9ffc-0e13bf871476"],

Cell["Defining a flavored scalar field:", "ExampleText",
 CellID->1577595689,ExpressionUUID->"4bf51d8f-0dac-4f01-80e5-7d6c805c8ac1"],

Cell[BoxData[
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", "Flavor", "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->938973923,ExpressionUUID->"179c844d-874c-40e2-a705-5575d6d24d54"],

Cell["Define a flavor non-universal but diagonal mass matrix:", "ExampleText",
 CellID->2015590703,ExpressionUUID->"62a51804-cb82-49ed-b3a6-7dc76ed40888"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"M", ",", 
   RowBox[{"SelfConjugate", "->", "True"}], ",", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", "Flavor", "}"}]}], ",", 
   RowBox[{"DiagonalCoupling", "->", 
    RowBox[{"{", "True", "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    SuperscriptBox[
     RowBox[{"M", "[", "r", "]"}], "2"], 
    RowBox[{"Bar", "@", 
     RowBox[{"\[Phi]", "[", "r", "]"}]}], 
    RowBox[{"\[Phi]", "[", "r", "]"}]}], "//", "RelabelIndices"}], "//", 
  "NiceForm"}]}], "Input",
 CellLabel->"In[16]:=",
 CellID->932091024,ExpressionUUID->"3acf531c-5ef1-4882-883d-cf0b1d2c0555"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["M", 
       StyleBox["p",
        FontSize->10]], ")"}], "2"], 
    SuperscriptBox[
     OverscriptBox["\[Phi]", 
      StyleBox["_",
       FontWeight->Bold]], 
     StyleBox["p",
      FontSize->10]], 
    SuperscriptBox["\[Phi]", 
     StyleBox["p",
      FontSize->10]]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[17]//NiceForm=",
 CellID->1656185920,ExpressionUUID->"7e08f9ad-efeb-41b1-8355-81e85749ca3f"]
}, Open  ]],

Cell[TextData[{
 "In this case the dummy index resummation by ",
 Cell[BoxData[
  ButtonBox["RelabelIndices",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/RelabelIndices"]], "InlineFormula",
  ExpressionUUID->"4c31f518-c58c-439a-9bd9-81c292582143"],
 " ignores these indices when determining all contracted indices. However, a \
proper relabeling is still guaranteed."
}], "ExampleText",
 CellID->279808804,ExpressionUUID->"75cd0df8-ae6a-455d-8928-3f02b1fe391c"],

Cell[TextData[{
 "If the mass is defined without specifying the ",
 StyleBox["DiagonalCoupling", "InlineCode"],
 " options  (default), or equivalently using ",
 StyleBox["DiagonalCoupling\[Rule]{False}", "InlineCode"],
 ", the dummy index resummation is trying to interpret relabel the indices on \
the coupling as regular indices and an error message is generated in the \
example above:"
}], "ExampleText",
 CellID->1802715844,ExpressionUUID->"1357aa3f-4b76-4fb4-bd1a-0154d0ca933f"],

