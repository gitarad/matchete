Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GetCouplings", "[", "]"}]], "Input",
 CellLabel->"In[18]:=",
 CellID->25066016,ExpressionUUID->"d6088b49-0e39-43f5-a92e-d8f407c92c38"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"m", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"EFTOrder", "\[Rule]", "0"}], ",", 
      RowBox[{"Indices", "\[Rule]", 
       RowBox[{"{", "Flavor", "}"}]}], ",", 
      RowBox[{"SelfConjugate", "\[Rule]", "True"}], ",", 
      RowBox[{"Symmetries", "\[Rule]", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"DiagonalCoupling", "\[Rule]", 
       RowBox[{"{", "False", "}"}]}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"M", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"EFTOrder", "\[Rule]", "0"}], ",", 
      RowBox[{"Indices", "\[Rule]", 
       RowBox[{"{", "Flavor", "}"}]}], ",", 
      RowBox[{"SelfConjugate", "\[Rule]", "True"}], ",", 
      RowBox[{"Symmetries", "\[Rule]", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"DiagonalCoupling", "\[Rule]", 
       RowBox[{"{", "True", "}"}]}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"M\[Phi]", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"EFTOrder", "\[Rule]", "0"}], ",", 
      RowBox[{"Indices", "\[Rule]", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"SelfConjugate", "\[Rule]", "True"}], ",", 
      RowBox[{"Symmetries", "\[Rule]", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"DiagonalCoupling", "\[Rule]", 
