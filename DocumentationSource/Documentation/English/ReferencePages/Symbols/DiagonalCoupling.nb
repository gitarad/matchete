Notebook[{

Cell[CellGroupData[{
Cell["DiagonalCoupling", "ObjectName",
 CellID->2050872546,ExpressionUUID->"57d64bb2-7009-4112-92f4-cc4fa2f35124"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5184ae03-8d21-468c-aaa0-dba5a886232a"],
 Cell[BoxData[
 "DiagonalCoupling"], "InlineFormula",ExpressionUUID->
  "6288a8e8-5191-40e5-a0db-104a3fa3839d"],
 "\[LineSeparator]is an option for the routine ",
 Cell[BoxData[
  ButtonBox["DefineCoupling",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DefineCoupling"]], "InlineFormula",
  ExpressionUUID->"5ba8998a-7e43-4743-82b3-d1975d9ac72d"],
 ". Its value must be a list of booleans or empty and specifies which flavor \
indices of the coupling should be considered as corresponding to a diagonal \
tensor structure.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"84a468ad-764a-4eb5-9185-69638438c88b"],
 Cell[BoxData[
 "DiagonalCoupling"], "InlineFormula",ExpressionUUID->
  "37ae987f-af5f-4224-80c3-fe18eaef469c"],
 "\[LineSeparator]is also the corresponding key in the association returned \
by ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetCouplings",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/GetCouplings"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"ff4e184d-8473-4495-9b21-1f94dffbc34a"],
 "."
}], "Usage",
 CellID->1902346272,ExpressionUUID->"c80171e6-4b80-45cc-9c14-ee2e3cc42782"],

Cell[TextData[{
 "Allowed values are a list of booleans or an empty list. The n-th boolean \
specifies whether the n-th flavor index is a diagonal in flavor space. By \
default all flavor indices are assumed to be non-diagonal. ",
 Cell[BoxData[
  ButtonBox["DiagonalCoupling",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DiagonalCoupling"]], "InlineFormula",
  ExpressionUUID->"f82497a7-193c-4e3a-9561-938f3f792d08"],
 " is also the corresponding key in the association returned by ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetCouplings",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/GetCouplings"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"15a2eb63-0021-47f2-84c8-0475f556080b"],
 "."
}], "Notes",
 CellID->997256968,ExpressionUUID->"da7e1f5c-6788-4c36-b3e2-7455a05e008c"]
}, Open  ]],

