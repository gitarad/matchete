Cell["\<\
One  can use this option also for multiple indices and each index is \
individually treated as either belonging to a diagonal tensor structure or \
not:\
\>", "ExampleText",
 CellID->1752686256,ExpressionUUID->"faa9f68d-8e8f-473a-9272-f7c0c642fc3a"],

Cell["\<\
DefineFlavorIndex[Flavor, 3, IndexAlphabet -> {\"p\", \"r\", \"s\", \"t\"}]\
\>", "Input",
 CellLabel->"In[20]:=",
 CellID->1111284318,ExpressionUUID->"c44c0220-3101-407a-914a-d56299c20456"],

Cell[BoxData[
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", "Flavor", "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[21]:=",
 CellID->1036580296,ExpressionUUID->"2a66669c-09f2-402a-8d6b-bd4431ec4130"],

Cell[BoxData[
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"\[Lambda]", ",", "\[IndentingNewLine]", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", 
     RowBox[{
     "Flavor", ",", "Flavor", ",", "Flavor", ",", "Flavor", ",", "Flavor"}], 
     "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"DiagonalCoupling", "->", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False", ",", "True", ",", "True", ",", "False"}], 
     "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[22]:=",
