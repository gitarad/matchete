Cell[TextData[{
 "If we initialize a new SU(4) group ",
 StyleBox["Gr", "InlineCode"],
 ", the delta ",
 Cell[BoxData[
  ButtonBox["CG",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/CG"]], "InlineFormula",ExpressionUUID->
  "31a1682e-5fa2-46ac-a8af-c16137f4b296"],
 " associated with the fundamental representation will be referred to as ",
 StyleBox["del[Gr@ fund]", "InlineCode"],
 "(the Gr[",
 Cell[BoxData[
  ButtonBox["fund",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/fund"]], "InlineFormula",ExpressionUUID->
  "6d3c67ed-6740-4df3-9eb5-671e0bcf9fd4"],
 "] is the standard name for the fundamental representation):"
}], "ExampleText",
 CellID->63602367,ExpressionUUID->"5b089415-32da-435a-bd3f-effcd7ba32c2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefineGlobalGroup", "[", 
   RowBox[{"Gr", ",", 
    RowBox[{"SU", "@", "4"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"del", "[", 
   RowBox[{"Gr", "@", "fund"}], "]"}], "[", 
  RowBox[{"a", ",", "b"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[20]:=",
 CellID->950104424,ExpressionUUID->"896f5371-57c9-45ed-b3db-caae317ba490"],

Cell[BoxData[
 RowBox[{"CG", "[", 
  RowBox[{
   RowBox[{"del", "[", 
    RowBox[{"Gr", "[", "fund", "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Index", "[", 
      RowBox[{"a", ",", 
       RowBox[{"Gr", "[", "fund", "]"}]}], "]"}], ",", 
     RowBox[{"Bar", "[", 
      RowBox[{"Index", "[", 
       RowBox[{"b", ",", 
        RowBox[{"Gr", "[", "fund", "]"}]}], "]"}], "]"}]}], "}"}]}], 
  "]"}]], "Output",
 CellLabel->"Out[21]=",
 CellID->517211956,ExpressionUUID->"d633742b-c03c-42b2-a77b-35e84da82244"],

Cell[BoxData[
 FormBox[
  StyleBox[
   SubsuperscriptBox["\[Delta]", 
    StyleBox["b",
     FontSize->10], 
    StyleBox["a",
     FontSize->10]], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[22]//NiceForm=",
 CellID->1915025083,ExpressionUUID->"d65848e5-9e6c-467b-a334-dae38b2270f2"]
}, Open  ]]
}, Open  ]],

