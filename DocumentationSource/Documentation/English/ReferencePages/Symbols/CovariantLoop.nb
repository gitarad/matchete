Notebook[{

Cell[CellGroupData[{
Cell["CovariantLoop", "ObjectName",
 CellID->303897489,ExpressionUUID->"91ea7762-8e66-49d9-82b6-c81171906767"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8b46c091-8e56-478f-b9b0-d23c1d1e7767"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CovariantLoop",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/CovariantLoop"], "[", 
   RowBox[{
    StyleBox["lagrangian", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox[
       SubscriptBox[
        StyleBox["field", "TI"], 
        StyleBox["1", "TR"]], "TI"], 
      StyleBox[",", "TI"], 
      StyleBox[" ", "TI"], 
      StyleBox[
       SubscriptBox[
        StyleBox["field", "TI"], 
        StyleBox["2", "TR"]], "TI"], 
      StyleBox[",", "TI"], 
      StyleBox[" ", "TI"], 
      StyleBox["\[Ellipsis]", "TR"]}], 
     StyleBox["}", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a9d57031-50cb-4366-9c6a-591a2b8fe7ac"],
 "\[LineSeparator]calculates the one-loop supertraces involving exactly the \
degrees of freedom specified in the field list. "
}], "Usage",
 CellID->888985057,ExpressionUUID->"16d77e4e-dc0f-4d9a-ad17-15c7f0e577b0"],

Cell["The following options can be given: ", "Notes",
 CellID->1128120820,ExpressionUUID->"77e16428-7862-4e40-a5f1-bed16d6ea17e"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "16f758f5-d82b-464a-a89a-4e571682c0bc"], 
    ButtonBox["EFTOrder",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/EFTOrder"], "6", Cell[
    "specifies the targeted order in the EFT power counting.", "TableText",
     ExpressionUUID->"d0daf249-e64a-4f96-a5c1-7b6979de58a8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "54ec2859-b848-4915-9f13-b6d2df4a6715"], "Mode", 
    ButtonBox["Matching",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/Matching"], Cell[
    "sets the kind of loop calculation performed.", "TableText",
     ExpressionUUID->"d4281a04-f9b6-483c-b55a-0def94b0a78f"]}
  }]], "3ColumnTableMod",
 CellID->193502377,ExpressionUUID->"8a9f4fdb-30e8-4a86-aad8-59de51743b3a"],

Cell["The values of the Mode option are", "Notes",
 CellID->1255240917,ExpressionUUID->"c97c038b-c15d-480f-b4a2-e2fadee3edad"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "cb602d2a-10ab-4d2f-920e-471a573f572e"], 
    ButtonBox["Matching",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/Matching"], Cell["\<\
the function outputs the EFT matching contribution resulting from the \
trace(s).\
\>", "TableText",ExpressionUUID->"01893c38-265b-480e-b55b-6c29dbb29056"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "76e88770-8037-49a4-8405-8dab22e50125"], 
    ButtonBox["Divergence",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/Divergence"], Cell[TextData[{
     "the function returns the 1/",
     Cell[BoxData[
      ButtonBox["\[Epsilon]",
       BaseStyle->"Link",
       ButtonData->"paclet:Matchete/ref/Epsilon"]], "InlineFormula",
      ExpressionUUID->"8e94ff54-89c6-4210-b33c-a048105a306d"],
     " pole of the trace(s). N.b. it is the divergence of a contribution to \
the effective action and minus the value of the counterterms needed to \
renormalize the theory. "
    }], "TableText",ExpressionUUID->"d3b08dc0-b9be-482f-ba1f-9a7cb8746842"]}
  }]], "2ColumnTableMod",
 CellID->505851159,ExpressionUUID->"c5d243df-d891-438c-b3dc-3bbd3c3072eb"]
}, Open  ]],

