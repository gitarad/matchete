Cell["Defining some type of flavor index:", "ExampleText",
 CellID->213863691,ExpressionUUID->"18914307-4cf0-44df-bb99-aca6a5d1f5e4"],

Cell[BoxData[
 RowBox[{"DefineFlavorIndex", "[", 
  RowBox[{"Flavor", ",", "3", ",", 
   RowBox[{"IndexAlphabet", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<p\>\"", ",", "\"\<r\>\"", ",", "\"\<s\>\"", ",", "\"\<t\>\""}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1429865360,ExpressionUUID->"0ecbeca9-7580-4f98-9186-7ef11dde1261"],

Cell["\<\
Define a diagonal but flavor non-universal coupling or mass matrix:\
\>", "ExampleText",
 CellID->883871940,ExpressionUUID->"3fdf17cc-6b28-4b45-acd6-d802e3c86173"],

Cell[BoxData[
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"m", ",", "\[IndentingNewLine]", 
   RowBox[{"SelfConjugate", "->", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", "Flavor", "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"DiagonalCoupling", "->", 
    RowBox[{"{", "True", "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->1908501565,ExpressionUUID->"4d23a98c-eabb-4650-a2f3-0602b8cdaade"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  ButtonBox["FlavorSum",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/FlavorSum"]], "InlineFormula",
  ExpressionUUID->"58d23cf0-785d-424b-948c-d7cd4719ee1d"],
 " prints as a sum symbol under ",
 Cell[BoxData[
  ButtonBox["NiceForm",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/NiceForm"]], "InlineFormula",
  ExpressionUUID->"2edfa747-effb-4ba6-8085-27ce591bb6cb"],
 " and indicated that the following expression should be summed over the \
indicated flavor index despite the absence of repeated indices:"
}], "ExampleText",
 CellID->996372390,ExpressionUUID->"d48a27f0-fd31-43c3-b535-28c9abd68722"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"FlavorSum", "[", 
   RowBox[{"Index", "[", 
    RowBox[{"p", ",", "Flavor"}], "]"}], "]"}], 
  RowBox[{"m", "[", "p", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[5]:=",
 CellID->862400399,ExpressionUUID->"1dd9f04f-180b-46ed-acd2-7c3e356bc97f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Coupling", "[", 
   RowBox[{"m", ",", 
    RowBox[{"{", 
     RowBox[{"Index", "[", 
      RowBox[{"p", ",", "Flavor"}], "]"}], "}"}], ",", "0"}], "]"}], " ", 
  RowBox[{"FlavorSum", "[", 
   RowBox[{"Index", "[", 
    RowBox[{"p", ",", "Flavor"}], "]"}], "]"}]}]], "Output",
 CellLabel->"Out[5]=",
 CellID->1289626141,ExpressionUUID->"635bc4ef-d494-4854-9178-3ea10dad22ba"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    UnderscriptBox[
     StyleBox["\[Sum]",
      FontSize->18], 
     StyleBox[
      StyleBox["p", "StandardForm"],
      FontSize->10]], 
    SuperscriptBox["m", 
     StyleBox["p",
      FontSize->10]]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[6]//NiceForm=",
 CellID->194102616,ExpressionUUID->"a638f723-4dbc-4348-8c59-b95739011df8"]
}, Open  ]],

Cell[TextData[{
 "Notice that the sum symbol only appears at the beginning of a term when \
using ",
 ButtonBox["NiceForm",
  BaseStyle->"Link",
  ButtonData->"paclet:Matchete/ref/NiceForm"],
 " but not necessarily in StandardForm. In the latter case ",
 ButtonBox["FlavorSum",
  BaseStyle->"Link",
  ButtonData->"paclet:Matchete/ref/FlavorSum"],
 " indicated that everything it is multiplied with should be summer over the \
flavor index it carries."
}], "ExampleText",
 CellID->1075449322,ExpressionUUID->"94023b6f-fadd-480a-823b-78aa1c3e0996"]
}, Open  ]],

