Cell["Defining a flavor index and a gauge group:", "ExampleText",
 CellID->1700840097,ExpressionUUID->"ce050e7a-6b7c-4360-a829-18f5ef94260d"],

Cell[BoxData[{
 RowBox[{"DefineFlavorIndex", "[", 
  RowBox[{"Flavor", ",", "3", ",", 
   RowBox[{"IndexAlphabet", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<p\>\"", ",", "\"\<r\>\"", ",", "\"\<s\>\"", ",", "\"\<t\>\""}], 
     "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineGaugeGroup", "[", 
  RowBox[{"G", ",", 
   RowBox[{"SU", "@", "3"}], ",", "g", ",", "F", ",", "\[IndentingNewLine]", 
   RowBox[{"FundAlphabet", "->", 
    RowBox[{"CharacterRange", "[", 
     RowBox[{"\"\<a\>\"", ",", "\"\<d\>\""}], "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AdjAlphabet", "->", 
    RowBox[{"CharacterRange", "[", 
     RowBox[{"\"\<A\>\"", ",", "\"\<D\>\""}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->171407911,ExpressionUUID->"af15c3d4-245f-420c-b781-b69f7c0d2de3"],

Cell["Defining a heavy, flavor n-universal scalar:", "ExampleText",
 CellID->1272174682,ExpressionUUID->"756902c4-f2ed-4722-beb4-c9ba72b16b2e"],

Cell[BoxData[
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"G", "[", "fund", "]"}], ",", "Flavor"}], "}"}]}], ",", 
   RowBox[{"Mass", "->", 
    RowBox[{"{", 
     RowBox[{"Heavy", ",", "M", ",", 
      RowBox[{"{", "Flavor", "}"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->2083878943,ExpressionUUID->"09176e0b-5dc0-479c-a516-7fcca6fb02d9"],

Cell[TextData[{
 "Obtain the ",
 ButtonBox["FreeLag",
  BaseStyle->"Link",
  ButtonData->"paclet:Matchete/ref/FreeLag"],
 "rangian for this theory:"
}], "ExampleText",
 CellID->1007515972,ExpressionUUID->"b76bdaa9-136e-442e-b982-5c8bf6832d99"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[ScriptCapitalL]", "=", 
   RowBox[{"FreeLag", "[", 
    RowBox[{"F", ",", "\[Phi]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[4]:=",
 CellID->610546270,ExpressionUUID->"afc685fd-d812-4956-bc94-e0a8d12da126"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      FractionBox["1", "4"], 
      FractionBox["1", 
       SuperscriptBox["g", "2"]], 
      SuperscriptBox[
       SuperscriptBox["F", 
        StyleBox[
         TemplateBox[{"\[Mu]", "\[Nu]", "A"},
          "RowDefault"],
         FontSize->10]], "2"]}]}], "+", 
    RowBox[{
     TemplateBox[{
       SubscriptBox["D", "\[Mu]"], 
       SubsuperscriptBox[
        OverscriptBox["\[Phi]", 
         StyleBox["_", FontWeight -> Bold]], 
        StyleBox["a", FontSize -> 10], 
        StyleBox["p", FontSize -> 10]]},
      "RowDefault"], 
     TemplateBox[{
       SubscriptBox["D", "\[Mu]"], 
       SuperscriptBox["\[Phi]", 
        StyleBox[
         TemplateBox[{"a", "p"}, "RowDefault"], FontSize -> 10]]},
      "RowDefault"]}], "-", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox["M", 
        StyleBox["p",
         FontSize->10]], ")"}], "2"], 
     SubsuperscriptBox[
      OverscriptBox["\[Phi]", 
       StyleBox["_",
        FontWeight->Bold]], 
      StyleBox["a",
       FontSize->10], 
      StyleBox["p",
       FontSize->10]], 
     SuperscriptBox["\[Phi]", 
      StyleBox[
       TemplateBox[{"a", "p"},
        "RowDefault"],
       FontSize->10]]}]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[5]//NiceForm=",
 CellID->1438094400,ExpressionUUID->"d60e05f2-8ed1-44b7-b35b-0f9496ec84d6"]
}, Open  ]],

Cell["\<\
Integrate out the heavy scalar \[Phi] at one loop and up to dimension six \
operators:\
\>", "ExampleText",
 CellID->1186305683,ExpressionUUID->"e47f1b09-2f32-4df4-bd1d-049e43fb6f04"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalL]EFT", "=", 
   RowBox[{"Match", "[", 
    RowBox[{"\[ScriptCapitalL]", ",", 
     RowBox[{"EFTOrder", "->", "6"}], ",", 
     RowBox[{"LoopOrder", "->", "1"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->1400877791,ExpressionUUID->"58441fd8-aafb-47b2-a2b5-423bea3048e6"],

Cell[TextData[{
 "This generates an EFT with the gauge bosons ",
 Cell[BoxData[
  SubscriptBox["F", "\[Mu]\[Nu]"]], "InlineFormula",ExpressionUUID->
  "fcb0e636-142b-46ec-8639-e61eb111c8cd"],
 " as only dynamical Degrees of freedom:"
}], "ExampleText",
 CellID->1519207451,ExpressionUUID->"369626bf-d703-49c4-8e24-2832f3afd38c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalL]EFT", "//", "GreensSimplify"}], "//", 
  "NiceForm"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->1733520605,ExpressionUUID->"edbf0570-a7d9-4620-b490-a0a9f4e24f0f"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{
      FormBox[
       StyleBox[
        RowBox[{"(", 
         RowBox[{"-", 
          RowBox[{
           FractionBox["1", "4"], 
           FractionBox["1", 
            SuperscriptBox["g", "2"]]}], "+", 
          RowBox[{"\[HBar]", " ", 
           FormBox[
            StyleBox[
             RowBox[{"(", 
              RowBox[{"-", 
               RowBox[{
                FractionBox["1", "8"], 
                FractionBox["1", "\[Epsilon]"]}], "-", 
               RowBox[{
                FractionBox["1", "24"], 
                UnderscriptBox[
                 StyleBox["\[Sum]",
                  FontSize->18], 
                 StyleBox[
                  StyleBox["p", "StandardForm"],
                  FontSize->10]], 
                FormBox[
                 RowBox[{"Log", "[", 
                  FractionBox[
                   SuperscriptBox[
                    OverscriptBox["\[Mu]", 
                    StyleBox["_",
                    FontWeight->Bold]], "2"], 
                   SuperscriptBox[
                    RowBox[{"(", 
                    SuperscriptBox["M", 
                    StyleBox["p",
                    FontSize->10]], ")"}], "2"]], "]"}],
                 StandardForm]}]}], ")"}],
             SpanSymmetric->False],
            StandardForm]}]}], ")"}],
        SpanSymmetric->False],
       StandardForm], 
      SuperscriptBox[
       SuperscriptBox["F", 
        StyleBox[
         TemplateBox[{"\[Mu]", "\[Nu]", "A"},
          "RowDefault"],
         FontSize->10]], "2"]}], "-", 
     RowBox[{
      FractionBox["1", "120"], "\[HBar]", 
      RowBox[{
       UnderscriptBox[
        StyleBox["\[Sum]",
         FontSize->18], 
        StyleBox[
         StyleBox["p", "StandardForm"],
         FontSize->10]], 
       RowBox[{
        FractionBox["1", 
         SuperscriptBox[
          RowBox[{"(", 
           SuperscriptBox["M", 
            StyleBox["p",
             FontSize->10]], ")"}], "2"]], 
        TemplateBox[{
          SubscriptBox["D", "\[Nu]"], 
          SuperscriptBox["F", 
           StyleBox[
            TemplateBox[{"\[Mu]", "\[Nu]", "A"}, "RowDefault"], FontSize -> 
            10]]},
         "RowDefault"], 
        TemplateBox[{
          SubscriptBox["D", "\[Rho]"], 
          SuperscriptBox["F", 
           StyleBox[
            TemplateBox[{"\[Mu]", "\[Rho]", "A"}, "RowDefault"], FontSize -> 
            10]]},
         "RowDefault"]}]}]}], "+", 
     RowBox[{
      FractionBox["1", "360"], "\[HBar]", 
      UnderscriptBox[
       StyleBox["\[Sum]",
        FontSize->18], 
       StyleBox[
        StyleBox["p", "StandardForm"],
        FontSize->10]], 
      FractionBox["1", 
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox["M", 
          StyleBox["p",
           FontSize->10]], ")"}], "2"]], 
      SuperscriptBox["F", 
       StyleBox[
        TemplateBox[{"\[Mu]", "\[Nu]", "B"},
         "RowDefault"],
        FontSize->10]], 
      SuperscriptBox["F", 
       StyleBox[
        TemplateBox[{"\[Mu]", "\[Rho]", "C"},
         "RowDefault"],
        FontSize->10]], 
      SuperscriptBox["F", 
       StyleBox[
        TemplateBox[{"\[Nu]", "\[Rho]", "A"},
         "RowDefault"],
        FontSize->10]], 
      SuperscriptBox["f", 
       StyleBox[
        TemplateBox[{"A", "B", "C"},
         "RowDefault"],
        FontSize->10]]}]}]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[8]//NiceForm=",
 CellID->1924653773,ExpressionUUID->"caec995d-b590-409e-b9f1-f15e6969f88c"]
}, Open  ]],

Cell[TextData[{
 "The Feynman diagrams contributing to the gauge boson self-energy correction \
contain closed loops of heavy scalars, and thus also closed loops of flavor \
indices. The latter should therefore be summed over as is indicated by the ",
 ButtonBox["FlavorSum",
  BaseStyle->"Link",
  ButtonData->"paclet:Matchete/ref/FlavorSum"],
 "."
}], "ExampleText",
 CellID->109788050,ExpressionUUID->"b2714444-4020-4368-ba12-26ac7f801835"]
}, Open  ]],

