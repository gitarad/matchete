Cell["Defining a SU(2) gauge group:", "ExampleText",
 CellID->926387710,ExpressionUUID->"c6a6fc7b-14ca-47ed-bdde-be7a791c6f98"],

Cell[BoxData[
 RowBox[{"DefineGaugeGroup", "[", 
  RowBox[{"SU2", ",", 
   RowBox[{"SU", "@", "2"}], ",", "g", ",", "F", ",", "\[IndentingNewLine]", 
   RowBox[{"FundAlphabet", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<i\>\"", ",", "\"\<j\>\"", ",", "\"\<k\>\"", ",", "\"\<l\>\""}], 
     "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AdjAlphabet", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<I\>\"", ",", "\"\<J\>\"", ",", "\"\<K\>\"", ",", "\"\<L\>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->494760235,ExpressionUUID->"f670da55-2136-47e6-8a0a-cc72a0cf64c4"],

Cell["\<\
Defining 3 fields: a fundamental scalar, an adjoint Majorana fermion, and a \
fundamental Dirac fermion:\
\>", "ExampleText",
 CellID->1048845750,ExpressionUUID->"3a3ee3e2-abcb-4740-8fcc-4e098af8f126"],

Cell[BoxData[{
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", "\[IndentingNewLine]", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", 
     RowBox[{"SU2", "@", "fund"}], "}"}]}], ",", " ", "\[IndentingNewLine]", 
   RowBox[{"Mass", "->", "Light"}]}], "\[IndentingNewLine]", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Chi]", ",", "Fermion", ",", "\[IndentingNewLine]", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", 
     RowBox[{"SU2", "@", "adj"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"SelfConjugate", "->", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Mass", "->", "Light"}]}], "\[IndentingNewLine]", "]"}], "\n", 
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Psi]", ",", "Fermion", ",", "\[IndentingNewLine]", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", 
     RowBox[{"SU2", "@", "fund"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"Mass", "->", "0"}]}], "\[IndentingNewLine]", "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->1667446653,ExpressionUUID->"ebcf7a9a-7d19-4b8c-b8aa-e24709a63845"],

Cell["Defining a Yukawa and quartic scalar coupling:", "ExampleText",
 CellID->1086477139,ExpressionUUID->"6cb467e6-4f72-4821-9159-14ffae26c174"],

Cell[BoxData[{
 RowBox[{"DefineCoupling", "[", "y", "]"}], "\n", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"\[Lambda]", ",", 
   RowBox[{"SelfConjugate", "->", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[5]:=",
 CellID->1955526469,ExpressionUUID->"112f3a8e-d406-4750-9755-38b334fcec0e"],

Cell["\<\
Defining a Lagrangian with a Yukawa interaction and a scalar quartic:\
\>", "ExampleText",
 CellID->1948856006,ExpressionUUID->"d5553557-a36e-4ade-868c-2098a233d892"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[ScriptCapitalL]int", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"PlusHc", "[", 
      RowBox[{
       RowBox[{"y", "[", "]"}], 
       RowBox[{
        RowBox[{"Bar", "@", 
         RowBox[{"\[Psi]", "[", "i", "]"}]}], "**", 
        RowBox[{"\[Chi]", "[", "J", "]"}]}], 
       RowBox[{"\[Phi]", "[", "j", "]"}], 
       RowBox[{"CG", "[", 
        RowBox[{
         RowBox[{"gen", "@", 
          RowBox[{"SU2", "[", "fund", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"J", ",", "i", ",", "j"}], "}"}]}], "]"}]}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"\[Lambda]", "[", "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Bar", "@", 
        RowBox[{"\[Phi]", "[", "i", "]"}]}], 
       RowBox[{"\[Phi]", "[", "i", "]"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Bar", "@", 
        RowBox[{"\[Phi]", "[", "j", "]"}]}], 
       RowBox[{"\[Phi]", "[", "j", "]"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{"\[ScriptCapitalL]", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"FreeLag", "[", "]"}], "+", "\[ScriptCapitalL]int"}], "//", 
    "RelabelIndices"}], "//", "NiceForm"}]}]}], "Input",
 CellLabel->"In[7]:=",
 CellID->1438085308,ExpressionUUID->"be86513c-dbc5-4ada-a6eb-8a7cb8dc16f5"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      FractionBox["1", "4"], 
      FractionBox["1", 
       SuperscriptBox["g", "2"]], 
      SuperscriptBox[
       SuperscriptBox["F", 
        StyleBox[
         TemplateBox[{"\[Mu]", "\[Nu]", "I"},
          "RowDefault"],
         FontSize->10]], "2"]}]}], "+", 
    RowBox[{
     TemplateBox[{
       SubscriptBox["D", "\[Mu]"], 
       SubscriptBox[
        OverscriptBox["\[Phi]", 
         StyleBox["_", FontWeight -> Bold]], 
        StyleBox["i", FontSize -> 10]]},
      "RowDefault"], 
     TemplateBox[{
       SubscriptBox["D", "\[Mu]"], 
       SuperscriptBox["\[Phi]", 
        StyleBox["i", FontSize -> 10]]},
      "RowDefault"]}], "-", 
    RowBox[{
     SuperscriptBox["m\[Phi]", "2"], 
     SubscriptBox[
      OverscriptBox["\[Phi]", 
       StyleBox["_",
        FontWeight->Bold]], 
      StyleBox["i",
       FontSize->10]], 
     SuperscriptBox["\[Phi]", 
      StyleBox["i",
       FontSize->10]]}], "+", 
    RowBox[{"\[ImaginaryI]", 
     FormBox[
      StyleBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox[
          OverscriptBox["\[Psi]", 
           StyleBox["_",
            FontWeight->Bold]], 
          StyleBox["i",
           FontSize->10]], "\[CenterDot]", 
         SubscriptBox["\[Gamma]", 
          StyleBox["\[Mu]",
           FontSize->10]], "\[CenterDot]", 
         TemplateBox[{
           SubscriptBox["D", "\[Mu]"], 
           SuperscriptBox["\[Psi]", 
            StyleBox["i", FontSize -> 10]]},
          "RowDefault"]}], ")"}],
       SpanSymmetric->False],
      StandardForm]}], "+", 
    RowBox[{
     FractionBox["\[ImaginaryI]", "2"], 
     FormBox[
      StyleBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          SuperscriptBox["\[Chi]", 
           StyleBox["I",
            FontSize->10]], "T"], "\[CenterDot]", 
         RowBox[{"C", 
          SubscriptBox["\[Gamma]", 
           StyleBox["\[Mu]",
            FontSize->10]]}], "\[CenterDot]", 
         TemplateBox[{
           SubscriptBox["D", "\[Mu]"], 
           SuperscriptBox["\[Chi]", 
            StyleBox["I", FontSize -> 10]]},
          "RowDefault"]}], ")"}],
       SpanSymmetric->False],
      StandardForm]}], "-", 
    RowBox[{
     FractionBox["1", "2"], "m\[Chi]", 
     FormBox[
      StyleBox[
       RowBox[{"(", 
        SuperscriptBox[
         SuperscriptBox["\[Chi]", 
          StyleBox["I",
           FontSize->10]], "T"], "\[CenterDot]", "C", "\[CenterDot]", 
        SuperscriptBox["\[Chi]", 
         StyleBox["I",
          FontSize->10]], ")"}],
       SpanSymmetric->False],
      StandardForm]}], "-", 
    RowBox[{"\[Lambda]", 
     SubscriptBox[
      OverscriptBox["\[Phi]", 
       StyleBox["_",
        FontWeight->Bold]], 
      StyleBox["i",
       FontSize->10]], 
     SubscriptBox[
      OverscriptBox["\[Phi]", 
       StyleBox["_",
        FontWeight->Bold]], 
      StyleBox["j",
       FontSize->10]], 
     SuperscriptBox["\[Phi]", 
      StyleBox["i",
       FontSize->10]], 
     SuperscriptBox["\[Phi]", 
      StyleBox["j",
       FontSize->10]]}], "-", 
    RowBox[{"y", 
     SuperscriptBox["\[Phi]", 
      StyleBox["j",
       FontSize->10]], 
     FormBox[
      StyleBox[
       RowBox[{"(", 
        SubscriptBox[
         OverscriptBox["\[Psi]", 
          StyleBox["_",
           FontWeight->Bold]], 
         StyleBox["i",
          FontSize->10]], "\[CenterDot]", 
        SuperscriptBox["\[Chi]", 
         StyleBox["I",
          FontSize->10]], ")"}],
       SpanSymmetric->False],
      StandardForm], 
     SubsuperscriptBox["T", 
      StyleBox["j",
       FontSize->10], 
      StyleBox[
       TemplateBox[{"I", "i"},
        "RowDefault"],
       FontSize->10]]}], "-", 
    RowBox[{
     OverscriptBox["y", 
      StyleBox["_",
       FontWeight->Bold]], 
     SubscriptBox[
      OverscriptBox["\[Phi]", 
       StyleBox["_",
        FontWeight->Bold]], 
      StyleBox["i",
       FontSize->10]], 
     FormBox[
      StyleBox[
       RowBox[{"(", 
        SuperscriptBox[
         SuperscriptBox["\[Chi]", 
          StyleBox["I",
           FontSize->10]], "T"], "\[CenterDot]", "C", "\[CenterDot]", 
        SuperscriptBox["\[Psi]", 
         StyleBox["j",
          FontSize->10]], ")"}],
       SpanSymmetric->False],
      StandardForm], 
     SubsuperscriptBox["T", 
      StyleBox["j",
       FontSize->10], 
      StyleBox[
       TemplateBox[{"I", "i"},
        "RowDefault"],
       FontSize->10]]}]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[8]//NiceForm=",
 CellID->355483107,ExpressionUUID->"d37c9112-926c-401f-b118-68d0dd0a8bbb"]
}, Open  ]],

