  $Line = 0; Null]], "ExampleSection",
 CellID->975346591,ExpressionUUID->"1899a442-263f-459a-812a-219cd6e88322"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "0c9e2583-50a4-41ba-9edd-62fb50f0a800"],
  $Line = 0; Null]], "ExampleSection",
 CellID->907477386,ExpressionUUID->"69359b28-f7e0-4ee9-9756-e60407ff5112"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  ButtonBox["DR2MS",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DR2MS"]], "InlineFormula",ExpressionUUID->
  "b6ac80af-0012-45f3-8153-3466219f8031"],
 " function only works for renormalizable interaction terms, since it uses \
the formulas from https://arxiv.org/abs/hep-ph/9308222 for the computation of \
the counterterms. Higher-dimensional operators are currently not supported. "
}], "ExampleText",
 CellID->46018199,ExpressionUUID->"595ffe9c-e1dd-46c6-a744-50b9387a53c7"],

Cell["Defining a SU(2) gauge group:", "ExampleText",
 CellID->2061324617,ExpressionUUID->"81b1b166-9641-4a3d-897b-1c61fc037bc4"],

Cell[BoxData[
 RowBox[{"DefineGaugeGroup", "[", 
  RowBox[{"SU2", ",", 
   RowBox[{"SU", "@", "2"}], ",", "g", ",", "F", ",", "\[IndentingNewLine]", 
   RowBox[{"FundAlphabet", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<i\>\"", ",", "\"\<j\>\"", ",", "\"\<k\>\"", ",", "\"\<l\>\""}], 
     "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"AdjAlphabet", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<I\>\"", ",", "\"\<J\>\"", ",", "\"\<K\>\"", ",", "\"\<L\>\""}], 
     "}"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[10]:=",
 CellID->51633318,ExpressionUUID->"09fd66a9-980c-412e-b779-6a025e0b5a71"],

Cell["Defining a fundamental scalar:", "ExampleText",
 CellID->1158624549,ExpressionUUID->"f1441690-bc69-4abe-8a88-56899b7e13b3"],

Cell[BoxData[
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", "\[IndentingNewLine]", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", 
     RowBox[{"SU2", "@", "fund"}], "}"}]}], ",", " ", "\[IndentingNewLine]", 
   RowBox[{"Mass", "->", "Light"}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[11]:=",
 CellID->217782238,ExpressionUUID->"6bbc0ac4-5061-4b2f-b596-15a5c48c1075"],

Cell["Defining a six-scalar interaction term:", "ExampleText",
 CellID->503928274,ExpressionUUID->"d1688307-e9b6-4bcb-b9b9-ec49d0875452"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[ScriptCapitalL]\[Phi]6", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Bar", "@", 
       RowBox[{"\[Phi]", "[", "i", "]"}]}], 
      RowBox[{"\[Phi]", "[", "i", "]"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Bar", "@", 
       RowBox[{"\[Phi]", "[", "j", "]"}]}], 
      RowBox[{"\[Phi]", "[", "j", "]"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Bar", "@", 
       RowBox[{"\[Phi]", "[", "k", "]"}]}], 
      RowBox[{"\[Phi]", "[", "k", "]"}]}], ")"}]}], "//", 
   "NiceForm"}]}]], "Input",
 CellLabel->"In[17]:=",
 CellID->598109275,ExpressionUUID->"7d65c65f-4099-4e35-a304-6c039a910569"],

