Cell[TextData[{
 "If we initialize a new SU(4) group ",
 StyleBox["Gr", "InlineCode"],
 ", the generator ",
 Cell[BoxData[
  ButtonBox["CG",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/CG"]], "InlineFormula",ExpressionUUID->
  "8fd4c0eb-9d20-4629-a3f6-07bc5913b366"],
 " associated with the fundamental representation will be referred to as ",
 StyleBox["gen[Gr@ fund]", "InlineCode"],
 "(the Gr[",
 Cell[BoxData[
  ButtonBox["fund",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/fund"]], "InlineFormula",ExpressionUUID->
  "b4144a15-ebd4-4232-8c94-e3795876125b"],
 "] is the standard name for the fundamental representation):"
}], "ExampleText",
 CellID->63602367,ExpressionUUID->"8832aeb8-edfb-4603-aa09-97bf7b74c2c1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefineGlobalGroup", "[", 
   RowBox[{"Gr", ",", 
    RowBox[{"SU", "@", "4"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gen", "[", 
   RowBox[{"Gr", "@", "fund"}], "]"}], "[", 
  RowBox[{"A", ",", "i", ",", "j"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[34]:=",
 CellID->950104424,ExpressionUUID->"779be386-404e-4096-b1e0-6f740c49002f"],

Cell[BoxData[
 RowBox[{"CG", "[", 
  RowBox[{
   RowBox[{"gen", "[", 
    RowBox[{"Gr", "[", "fund", "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Index", "[", 
      RowBox[{"A", ",", 
       RowBox[{"Gr", "[", "adj", "]"}]}], "]"}], ",", 
     RowBox[{"Index", "[", 
      RowBox[{"i", ",", 
       RowBox[{"Gr", "[", "fund", "]"}]}], "]"}], ",", 
     RowBox[{"Bar", "[", 
      RowBox[{"Index", "[", 
       RowBox[{"j", ",", 
        RowBox[{"Gr", "[", "fund", "]"}]}], "]"}], "]"}]}], "}"}]}], 
  "]"}]], "Output",
 CellLabel->"Out[35]=",
 CellID->682564965,ExpressionUUID->"d5fd92aa-3cab-4607-9817-17f01f57380d"],

Cell[BoxData[
 FormBox[
  StyleBox[
   SubsuperscriptBox["T", 
