Cell[TextData[{
 "To use a custom mass label rather than the generic one, one has to specify \
the label in addition to ",
 Cell[BoxData[
  ButtonBox["Light",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Light"]], "InlineFormula",ExpressionUUID->
  "993a7350-215a-461b-8274-c9af6de24074"],
 " or ",
 Cell[BoxData[
  ButtonBox["Heavy",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Heavy"]], "InlineFormula",ExpressionUUID->
  "49a3ab5e-cef5-4f31-8093-bfd8deeac691"],
