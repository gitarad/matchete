Cell[CellGroupData[{
Cell["DefineField", "ObjectName",
 CellID->1316811972,ExpressionUUID->"e6439c4d-e27e-4eba-97b4-ea0efa6c9e63"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"44b515db-15b1-4534-917c-3c7d760132ee"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DefineField",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/DefineField"], "[", 
   RowBox[{
    StyleBox["label", "TI"], ",", 
    StyleBox["type", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "096abfc6-1b2c-4198-afd3-48d964f085e0"],
 "\[LineSeparator]defines a new field referred to by its ",
 Cell[BoxData[
  StyleBox["label", "TI"]], "InlineFormula",ExpressionUUID->
  "de318f41-0930-413a-8415-06ad8bf28f14"],
 " to be used in Lagrangians. The ",
 Cell[BoxData[
  StyleBox["type", "TI"]], "InlineFormula",ExpressionUUID->
  "78c9e79e-3579-4591-8443-ee60ff3187fe"],
 " defines the spin and can take the values ",
 Cell[BoxData[
  ButtonBox["Scalar",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Scalar"]], "InlineFormula",ExpressionUUID->
  "d0dd15cb-9c46-42dc-b43b-976f2293f892"],
 ", ",
 Cell[BoxData[
  ButtonBox["Fermion",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Fermion"]], "InlineFormula",
  ExpressionUUID->"35f3c0d5-3342-4e1b-83b0-124afc59f49c"],
 " or ",
 Cell[BoxData[
  ButtonBox["Vector",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Vector"]], "InlineFormula",ExpressionUUID->
  "68cae3de-0b54-466b-8317-322b062b1641"],
 ". "
}], "Usage",
 CellChangeTimes->{{3.935756234836838*^9, 3.935756234977744*^9}, {
   3.936188955124269*^9, 3.93618904612836*^9}, 3.936190064878191*^9},
 CellID->1839831069,ExpressionUUID->"7c2b5c0e-739a-4d84-b31c-54e0d267f41a"],

Cell[TextData[{
 "Defining a field with ",
 Cell[BoxData[
  ButtonBox["DefineField",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DefineField"]], "InlineFormula",
  ExpressionUUID->"8f2815fe-162f-4cc7-9dad-550befecd756"],
 " informs Matchete of the quantum numbers and masses of the field in \
question. All fields must be defined before a Lagrangian can be written down. "
}], "Notes",
 CellChangeTimes->{{3.936190130782338*^9, 3.936190225147069*^9}, {
  3.936191139127612*^9, 3.93619114342282*^9}},
 CellID->1791757087,ExpressionUUID->"f93d4444-ac90-4c4b-a240-2192807cdabf"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["DefineField",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DefineField"]], "InlineFormula",
  ExpressionUUID->"c5439998-3d64-42fb-9059-fcd0406056f7"],
 " provides a new function ",
 Cell[BoxData[
  StyleBox["label", "TI"]], "InlineFormula",ExpressionUUID->
  "ddea9c3f-35fc-4dd5-965e-4014a4f4c3b9"],
 "[] (or ",
 Cell[BoxData[
  StyleBox["label", "TI"]], "InlineFormula",ExpressionUUID->
  "b7b5f756-f766-411f-8318-fa7ea5a1daa7"],
 "[i, j, ...] if Indices are provided with the ",
 Cell[BoxData[
  ButtonBox["Indices",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Indices"]], "InlineFormula",
  ExpressionUUID->"4dc7ab78-e03a-4ef8-8c7e-7e2cc5c54cd2"],
 " option) that provides a shortcut for the user to write the field in the \
internal format used in Matchete. It gives an instance of the field with the \
indices given. "
}], "Notes",
 CellChangeTimes->{{3.9361902263451443`*^9, 3.936190279473989*^9}, {
  3.936190344224361*^9, 3.9361905126350613`*^9}, {3.9362538534544907`*^9, 
  3.93625388595502*^9}},
 CellID->914697409,ExpressionUUID->"7be088af-473e-4446-9a88-e59b1cf1c246"],

Cell["The following options can be given: ", "Notes",
 CellID->423743530,ExpressionUUID->"0d58abd6-8283-42f5-934e-6de74f793220"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2b275a84-2395-4808-9997-c3e1c9f9d415"], 
    ButtonBox["BackgroundField",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/BackgroundField"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell["\<\
specifies if the field is a background field (non-propagating).\
\>", "TableText",ExpressionUUID->"cbd46f05-5c80-41e0-a42a-18d702762807"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ebc8ace2-7723-4128-85e4-55efef5f573b"], 
    ButtonBox["Charges",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/Charges"], 
    RowBox[{"{", "}"}], Cell["\<\
specifies a (list of) U(1) group(s) and corresponding charge(s) of the field.\
\
\>", "TableText",ExpressionUUID->"31b23836-9862-43c2-a7c0-2ef4d4f2f19b"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "452b5794-6b40-4784-aa76-c58ebce40500"], 
    ButtonBox["Chiral",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/Chiral"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     "specifies if a fermion field is ",
     Cell[BoxData[
      ButtonBox["LeftHanded",
       BaseStyle->"Link",
       ButtonData->"paclet:Matchete/ref/LeftHanded"]], "InlineFormula",
      ExpressionUUID->"6aa1d27d-4f48-44e6-890a-1f9c65aa62fa"],
     " or ",
     Cell[BoxData[
      ButtonBox["RightHanded",
       BaseStyle->"Link",
       ButtonData->"paclet:Matchete/ref/RightHanded"]], "InlineFormula",
      ExpressionUUID->"38843b25-5b5e-4f7b-ae8f-ee5e2c040461"],
     ". The option is only valid if the ",
     Cell[BoxData[
      StyleBox["type", "TI"]], "InlineFormula",ExpressionUUID->
      "cba43805-03df-44c2-9b55-b01b11e56780"],
     " is ",
     Cell[BoxData[
      ButtonBox["Fermion",
       BaseStyle->"Link",
       ButtonData->"paclet:Matchete/ref/Fermion"]], "InlineFormula",
      ExpressionUUID->"b7a11cfc-a9bc-43b3-ba24-66fe8bd0e48a"],
     "."
    }], "TableText",ExpressionUUID->"a5887d7c-6ab1-42c3-9cb1-32b0e2367672"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "a9f0a867-994b-4354-baa6-8e94e619ed09"], 
    ButtonBox["Indices",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/Indices"], 
    RowBox[{"{", "}"}], Cell["\<\
specifies a (list of) representation(s) under which the field transforms. \
Theses can be representations of gauge or global groups or flavor indices.\
\>", "TableText",ExpressionUUID->"fcc257d3-b48e-4dac-8f73-9b85bdaae43e"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "1b91e6ed-8cce-4bd5-8f6c-a5a66d12a0c6"], 
    ButtonBox["Mass",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/Mass"], 
    ButtonBox["Heavy",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/Heavy"], Cell["\<\
specifies the mass label and EFT scaling of the field.  If no mass label is \
given, a default value based on the field label is used.\
\>", "TableText",ExpressionUUID->"e99cfc61-55e8-4f3c-80d2-b8c452c45d1d"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "3a9e25cd-be6a-485c-a08f-9c2af0cfa51e"], 
    ButtonBox["NiceForm",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/NiceForm"], 
    ButtonBox["Default",
     BaseStyle->"Link"], Cell[TextData[{
     "provides the display of the field under ",
     Cell[BoxData[
      ButtonBox["NiceForm",
       BaseStyle->"Link",
       ButtonData->"paclet:Matchete/ref/NiceForm"]], "InlineFormula",
      ExpressionUUID->"1443748e-a5f5-4b36-9e7f-b94b7f179622"],
     " formatting."
    }], "TableText",ExpressionUUID->"c17b27e0-2cae-430f-8c5d-28344aff766b"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "8268433e-d4c4-43fc-aef1-f2a3c241fd16"], 
    ButtonBox["SelfConjugate",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/SelfConjugate"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[
    "specifies whether the field is self-conjugated (real).", "TableText",
     ExpressionUUID->"1267a212-a127-4885-8dbd-af5b2f6f3521"]}
  }]], "3ColumnTableMod",
 CellChangeTimes->{{3.936189102299005*^9, 3.936189104365843*^9}, {
  3.936189258889482*^9, 3.936189258889488*^9}, {3.93618928969307*^9, 
