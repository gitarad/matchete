     StandardForm], 
    SuperscriptBox[
     TagBox[
      FormBox["MS",
       StandardForm],
      StandardForm,
      Editable->True], 
     FormBox["2",
      StandardForm]], 
    SuperscriptBox[
     TagBox[
      FormBox["S",
       StandardForm],
      StandardForm,
      Editable->True], "2"]}],
   StandardForm]}]], "Output",
 CellChangeTimes->{3.936254333584243*^9, 3.936255870744439*^9},
 CellLabel->"Out[55]//NiceForm=",
 CellID->1597593413,ExpressionUUID->"d5130b08-b5b7-4a1e-9ec2-c56a9a27eddd"]
}, Open  ]],

Cell[TextData[{
 "and in complex conjugation (",
