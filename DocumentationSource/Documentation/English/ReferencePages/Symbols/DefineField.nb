Cell[TextData[{
 "In most cases ",
 Cell[BoxData[
  ButtonBox["DefineField",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DefineField"]], "InlineFormula",
  ExpressionUUID->"eb525fd0-42d8-4456-9b7c-f1e24f2c8624"],
 " is used with many options. For instance to define the three generations of \
left-handed quarks in the SM, we would use"
}], "ExampleText",
 CellChangeTimes->{{3.936191698758297*^9, 3.936191742105564*^9}, {
  3.93623277892959*^9, 3.936232827038417*^9}},
 CellID->1833501546,ExpressionUUID->"bce8092c-a9c8-47be-95d6-ceeb004b9450"],

Cell[BoxData[
 RowBox[{"DefineField", "[", 
  RowBox[{"q", ",", " ", "Fermion", ",", " ", 
   RowBox[{"Chiral", "\[Rule]", "LeftHanded"}], ",", " ", 
   RowBox[{"Mass", "\[Rule]", " ", "0"}], ",", " ", 
   RowBox[{"Charges", "\[Rule]", 
    RowBox[{"U1Y", "[", 
     RowBox[{"1", "/", "6"}], "]"}]}], ",", " ", 
   RowBox[{"Indices", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"SU3c", "[", "fund", "]"}], ",", " ", 
      RowBox[{"SU2L", "[", "fund", "]"}], ",", " ", "Flavor"}], "}"}]}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.936232834248972*^9, 3.936232893140595*^9}, {
  3.936233401460991*^9, 3.9362334422428217`*^9}, {3.936233585150012*^9, 
  3.936233599037779*^9}, {3.93623363356012*^9, 3.936233670703167*^9}},
 CellLabel->"In[8]:=",
 CellID->1044290282,ExpressionUUID->"544303c1-9022-47f6-8fa5-18db3c794944"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"q", "[", 
  RowBox[{"c", ",", "u", ",", "p"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q", "[", 
   RowBox[{"c", ",", "i", ",", "p"}], "]"}], "//", "NiceForm"}]}], "Input",
 CellChangeTimes->{{3.936233673211565*^9, 3.936233694193929*^9}},
 CellLabel->"In[9]:=",
 CellID->232292721,ExpressionUUID->"746b2646-5751-4e65-a80a-f812b815f431"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DiracProduct", "[", 
   RowBox[{"Proj", "[", 
    RowBox[{"-", "1"}], "]"}], "]"}], "**", 
  RowBox[{"Field", "[", 
   RowBox[{"q", ",", "Fermion", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Index", "[", 
       RowBox[{"c", ",", 
        RowBox[{"SU3c", "[", "fund", "]"}]}], "]"}], ",", 
      RowBox[{"Index", "[", 
       RowBox[{"u", ",", 
        RowBox[{"SU2L", "[", "fund", "]"}]}], "]"}], ",", 
      RowBox[{"Index", "[", 
       RowBox[{"p", ",", "Flavor"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", "}"}]}], "]"}]}]], "Output",
 CellChangeTimes->{
  3.9362336945148478`*^9, {3.936234101998578*^9, 3.9362341199980083`*^9}, 
   3.936255797441319*^9},
 CellLabel->"Out[9]=",
 CellID->235483139,ExpressionUUID->"0ef30457-7bc6-45a7-b958-882e13e310f8"],

Cell[BoxData[
 StyleBox[
  RowBox[{"(", 
   RowBox[{
    FormBox[
     FormBox[
      SubscriptBox["\<\"P\"\>", "\<\"L\"\>"],
      Matchete`NiceForm],
     StandardForm], "\[CenterDot]", 
    FormBox[
     TemplateBox[{
       TagBox[
        FormBox["q", StandardForm], StandardForm, Editable -> True], 
       StyleBox[
        TemplateBox[{
          TagBox[
           FormBox[
            FormBox[
             StyleBox["\"c\"", 10, StripOnInput -> False], Matchete`NiceForm],
             Matchete`NiceForm], Format[#, Matchete`NiceForm]& ], 
          TagBox[
           FormBox[
            FormBox[
             StyleBox["\"i\"", 10, StripOnInput -> False], Matchete`NiceForm],
             Matchete`NiceForm], Format[#, Matchete`NiceForm]& ], 
          TagBox[
           FormBox[
            FormBox[
             StyleBox["\"p\"", 10, StripOnInput -> False], Matchete`NiceForm],
             Matchete`NiceForm], Format[#, Matchete`NiceForm]& ]}, 
         "RowDefault"], FontSize -> 12, StripOnInput -> False]},
      "Superscript"],
     Matchete`NiceForm]}], ")"}],
  SpanSymmetric->False]], "Output",
 CellChangeTimes->{
  3.9362336945148478`*^9, {3.936234101998578*^9, 3.9362341199980083`*^9}, 
   3.936255797442593*^9},
 CellLabel->"Out[10]//NiceForm=",
 CellID->2100239399,ExpressionUUID->"cce769d0-1cce-4a9d-8598-403f3390e615"]
}, Open  ]],

Cell[TextData[{
 "This example assumes that the SU3c, SU2L, and U1Y (SM) gauge groups have \
been initialized first, which can be done with ",
 Cell[BoxData[
  ButtonBox["DefineGaugeGroup",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DefineGaugeGroup"]], "InlineFormula",
  ExpressionUUID->"c69a486d-73f6-48ec-be8f-33a90440386f"],
 ". "
}], "ExampleText",
 CellChangeTimes->{{3.9362337660578403`*^9, 3.936233841763856*^9}},
 CellID->1606838331,ExpressionUUID->"7930e423-4aeb-4c8f-9ec8-6496d0a7f8c1"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "c4b44bea-2b49-4f7e-8da2-eead91944070"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->183306901,ExpressionUUID->"8366bf64-763f-4ee6-8098-9e50b5ba70a7"],

Cell[TextData[{
 "Massive vectors are also supported, and can be defined like scalar and \
fermion fields. Vector fields come with a Lorentz index in addition to the \
ones specified with the ",
 Cell[BoxData[
  ButtonBox["Indices",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Indices"]], "InlineFormula",
  ExpressionUUID->"b4aaaeb5-9b1f-4778-bf8f-02bf3eb32eb2"],
 " option."
}], "ExampleText",
 CellChangeTimes->{{3.936191210193492*^9, 3.936191217525324*^9}, {
  3.936191507782624*^9, 3.936191515520927*^9}, {3.936191575308251*^9, 
  3.9361916000426483`*^9}, {3.936191637673727*^9, 3.936191643619666*^9}},
 CellID->1347535309,ExpressionUUID->"5ff62945-a714-477d-badb-889ab8cdf3b5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineField", "[", 
  RowBox[{"V", ",", "Vector", ",", 
   RowBox[{"Mass", "->", "Heavy"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"V", "[", "\[Mu]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"V", "[", "\[Mu]", "]"}], "//", "NiceForm"}]}], "Input",
 CellChangeTimes->{{3.9361916108172913`*^9, 3.936191661555891*^9}, 
   3.9363285404507113`*^9},
 CellLabel->"In[6]:=",
 CellID->387802235,ExpressionUUID->"7f814bc6-b4fb-4661-bb76-6b8ead8e0a3f"],

Cell[BoxData[
 RowBox[{"Field", "[", 
  RowBox[{"V", ",", 
   RowBox[{"Vector", "[", 
    RowBox[{"Index", "[", 
     RowBox[{"\[Mu]", ",", "Lorentz"}], "]"}], "]"}], ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}]}], "]"}]], "Output",
 CellChangeTimes->{{3.936191652015851*^9, 3.936191661863085*^9}, 
   3.936233425107358*^9, 3.936255799880299*^9, 3.936328542147423*^9},
 CellLabel->"Out[7]=",
 CellID->36390833,ExpressionUUID->"0c7d926b-dbcf-46b9-9a29-3f3152f2426c"],

Cell[BoxData[
 FormBox[
  TemplateBox[{
    TagBox[
     FormBox["V", StandardForm], StandardForm, Editable -> True], 
    StyleBox[
     TemplateBox[{
       TagBox[
        FormBox[
         FormBox[
          StyleBox["\"\[Mu]\"", 10, StripOnInput -> False], 
          Matchete`NiceForm], Matchete`NiceForm], 
        Format[#, Matchete`NiceForm]& ]}, "RowDefault"], FontSize -> 12, 
     StripOnInput -> False]},
   "Superscript"], Matchete`NiceForm]], "Output",
 CellChangeTimes->{{3.936191652015851*^9, 3.936191661863085*^9}, 
   3.936233425107358*^9, 3.936255799880299*^9, 3.936328542148037*^9},
 CellLabel->"Out[8]//NiceForm=",
 CellID->1735374483,ExpressionUUID->"b71e4605-0320-4702-8d70-a8c6d4a8e00a"]
}, Open  ]],

Cell[TextData[{
 "Massless vectors are associated with gauge groups and are implicitly \
defined through ",
 Cell[BoxData[
  ButtonBox["DefineGaugeGroup",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DefineGaugeGroup"]], "InlineFormula",
  ExpressionUUID->"b364b3df-0e76-437d-ad61-4af320fd91df"],
