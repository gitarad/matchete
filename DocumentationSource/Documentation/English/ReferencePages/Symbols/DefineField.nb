Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "NiceForm", "ExampleSubsection",ExpressionUUID->
   "3fddbbcc-599a-4265-85f8-daafbf5a9204"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->463543447,ExpressionUUID->"8e571087-f28d-412f-956b-96c583451b77"],

Cell[TextData[{
 "The NiceForm option provides the possibility of defining how the field is \
displayed in ",
 Cell[BoxData[
  ButtonBox["NiceForm",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/NiceForm"]], "InlineFormula",
  ExpressionUUID->"b2afa423-0dfa-4361-b4d0-e809670a4f46"],
 ". The Default choice uses the ",
 Cell[BoxData[
  StyleBox["label", "TI"]], "InlineFormula",ExpressionUUID->
  "86f8e3a8-e752-4a09-a2b6-4689c62cd935"],
 " for the field in ",
 Cell[BoxData[
  ButtonBox["NiceForm",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/NiceForm"]], "InlineFormula",
  ExpressionUUID->"e85c29cf-114b-40c4-99f9-abaaef451ff0"],
 ", but this can be changed  "
}], "ExampleText",
 CellChangeTimes->{{3.936254838409404*^9, 3.936254975204034*^9}, 
   3.9362557594072657`*^9},
 CellID->1938111257,ExpressionUUID->"14da36df-3e04-4e59-85e4-df5c57fe2626"],

Cell[BoxData[
 RowBox[{"DefineField", "[", 
  RowBox[{"f1", ",", "Scalar", ",", 
   RowBox[{
   "NiceForm", 
    "\[Rule]", "\"\<\!\(\*SubscriptBox[\(\[Phi]\), \(f\)]\)\>\""}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.936254989802463*^9, 3.936255030164218*^9}, 
   3.936255191406528*^9},
 CellLabel->"In[49]:=",
 CellID->1762011999,ExpressionUUID->"b1619ee1-b21c-4d91-8bd9-00ca8d4c2050"],

Cell[TextData[{
 "This does not change the internal representation of the field ",
 StyleBox["f", "InlineCode"],
 ", but we see the difference in the ",
 Cell[BoxData[
  ButtonBox["NiceForm",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/NiceForm"]], "InlineFormula",
  ExpressionUUID->"2dc13d1f-8e40-4e69-b82b-90248482e629"],
 " display"
}], "ExampleText",
 CellChangeTimes->{{3.936255042331747*^9, 3.936255102571094*^9}},
 CellID->222961595,ExpressionUUID->"9f744894-db5a-4121-999d-e6fc851d8cd1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"f1", "[", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f1", "[", "]"}], "//", "NiceForm", " "}]}], "Input",
 CellChangeTimes->{{3.936255039309061*^9, 3.936255039868827*^9}, {
  3.9362551059091263`*^9, 3.936255110422619*^9}, {3.936255193801759*^9, 
  3.936255194676895*^9}},
 CellLabel->"In[50]:=",
 CellID->500355107,ExpressionUUID->"c4ca27f5-3f58-4aa1-ac4d-8d3b7b4e608e"],

Cell[BoxData[
 RowBox[{"Field", "[", 
  RowBox[{"f1", ",", "Scalar", ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}]}], "]"}]], "Output",
 CellChangeTimes->{3.936255110879747*^9, 3.936255198960681*^9, 
  3.936255864737465*^9},
 CellLabel->"Out[50]=",
 CellID->19032739,ExpressionUUID->"902898c6-1c6c-4f62-b13d-35115034f871"],

