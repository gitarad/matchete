 CellLabel->"In[53]:=",
 CellID->1163616493,ExpressionUUID->"a085c84c-6cbb-4ce0-89d5-414fd25e887b"],

Cell[BoxData[
 RowBox[{
  FormBox[
   RowBox[{
    TagBox[
     FormBox[
      TemplateBox[{
        SubscriptBox["D", 
         StyleBox[
          TagBox[
           StyleBox["\"\[Mu]\"", 10, StripOnInput -> False], 
           Format[#, Matchete`NiceForm]& ], FontSize -> 12, StripOnInput -> 
          False]], 
        TagBox[
         FormBox[
          OverscriptBox[
          "\"\\!\\(\\*SubscriptBox[\\(\[Phi]\\), \\(f\\)]\\)\"", "_"], 
          StandardForm], StandardForm, Editable -> True]},
       "RowDefault"],
      StandardForm],
     StandardForm,
     Editable->True], 
    TagBox[
     FormBox[
      TemplateBox[{
        SubscriptBox["D", 
         StyleBox[
          TagBox[
           StyleBox["\"\[Mu]\"", 10, StripOnInput -> False], 
           Format[#, Matchete`NiceForm]& ], FontSize -> 12, StripOnInput -> 
          False]], 
        TagBox[
         FormBox[
         "\"\\!\\(\\*SubscriptBox[\\(\[Phi]\\), \\(f\\)]\\)\"", StandardForm],
          StandardForm, Editable -> True]},
       "RowDefault"],
      StandardForm],
     StandardForm,
