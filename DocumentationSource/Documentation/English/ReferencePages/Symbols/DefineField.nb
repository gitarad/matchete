}, Open  ]],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  ButtonBox["Default",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "753f2e41-b2d3-4084-8cfc-107efbbd3f8b"],
 " value can be used in place of either string to use the default ",
 Cell[BoxData[
  ButtonBox["NiceForm",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/NiceForm"]], "InlineFormula",
  ExpressionUUID->"e22a3757-312a-4de5-a762-3e0c3deb33da"],
 " that would be associated to the field ",
 Cell[BoxData[
  StyleBox["label", "TI"]], "InlineFormula",ExpressionUUID->
  "ebbc9470-2f73-4da6-9db1-ae548b906abc"],
 "."
}], "ExampleText",
 CellChangeTimes->{{3.936255690741848*^9, 3.93625574652533*^9}},
 CellID->139270512,ExpressionUUID->"0f7c9d88-54c7-4b48-b28a-fca7e872628e"]
}, Open  ]]
}, Open  ]],

