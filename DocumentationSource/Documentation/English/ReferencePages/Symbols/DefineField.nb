Cell[TextData[{
 "With the ",
 Cell[BoxData[
  ButtonBox["BackgroundField",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/BackgroundField"]], "InlineFormula",
  ExpressionUUID->"6d2ebdfb-27eb-42c8-8f6c-9a81bd9d4482"],
 " option, the user may set a field to be non-propagating, i.e., it is \
treated as a background field. A scalar field background field can be defined \
with"
}], "ExampleText",
 CellChangeTimes->{{3.9608812007883472`*^9, 3.96088126980416*^9}, {
  3.9608814681042423`*^9, 3.9608814796607933`*^9}},
 CellID->790478155,ExpressionUUID->"122838de-df82-434b-bbb3-b035b6728737"],

Cell[BoxData[
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", " ", "Scalar", ",", 
   RowBox[{"BackgroundField", "\[Rule]", " ", "True"}]}], "]"}]], "Input",
 CellChangeTimes->{
  3.960881282309003*^9, {3.960881376766839*^9, 3.960881381053275*^9}, {
   3.9608814226986723`*^9, 3.960881441640758*^9}},
 CellLabel->"In[6]:=",
 CellID->2059778085,ExpressionUUID->"8fc2395c-917d-452f-aa17-021ab9948934"],

Cell[TextData[{
 "Background fields are treated as ",
 Cell[BoxData[
  ButtonBox["Light",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Light"]], "InlineFormula",ExpressionUUID->
  "c5d1eeb7-4a89-4967-b274-0fb99f15167e"],
 " fields with a vanishing mass (trying to associate a mass with a background \
field results in a failure). It does not have a kinetic term associated, and \
it cannot be passed to ",
 Cell[BoxData[
  ButtonBox["FreeLag",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/FreeLag"]], "InlineFormula",
  ExpressionUUID->"49179340-f2cb-4458-89ca-d74e04eeb59b"],
 ":"
}], "ExampleText",
 CellChangeTimes->{{3.960881285357831*^9, 3.96088141858961*^9}},
 CellID->59223890,ExpressionUUID->"ea4a2315-c1d6-4105-8101-2ec74272f22e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FreeLag", "[", "\[Phi]", "]"}]], "Input",
 CellChangeTimes->{{3.9608814463830013`*^9, 3.9608814497293873`*^9}},
 CellLabel->"In[7]:=",
 CellID->750771608,ExpressionUUID->"75a9a125-c910-4bc9-bcfc-d158ee1ea4ad"],

Cell[BoxData[
 TemplateBox[{
  "FreeLag", "bkgfield", 
   "\"The field '\\!\\(\\*RowBox[{\\\"\[Phi]\\\"}]\\)' is a background field \
and has no associated kinetic term/free Lagrangian.\"", 2, 7, 2, 
   24292945549018001893, "Local", "Matchete`FreeLag"},
  "MessageTemplate2",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{3.960881450538362*^9},
 CellLabel->"During evaluation of In[7]:=",
 CellID->309512758,ExpressionUUID->"2fa243eb-bb32-41e4-a92a-a612155d5bb4"],

Cell[BoxData["$Aborted"], "Output",
 CellChangeTimes->{3.96088145054221*^9},
 CellLabel->"Out[7]=",
 CellID->775530672,ExpressionUUID->"d244faa6-8f0f-4645-a872-912e7fc52e63"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Charges", "ExampleSubsection",ExpressionUUID->
   "fc5fd569-05b0-479d-99da-163022fe1acd"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->232288910,ExpressionUUID->"ae9c9611-6380-4472-928c-3b2d5e515bb2"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  ButtonBox["Charges",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Charges"]], "InlineFormula",
  ExpressionUUID->"161ad20e-0a21-43f9-af2b-98c38ac65980"],
 " option is used to specify that the field is charged under one or more U(1) \
gauge groups. Having defined a U(1) group with ",
 Cell[BoxData[
  ButtonBox["DefineGaugeGroup",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DefineGaugeGroup"]], "InlineFormula",
  ExpressionUUID->"aaf9e748-9626-4273-ac19-deac7311de3d"],
 ", "
}], "ExampleText",
 CellChangeTimes->{{3.936236416216044*^9, 3.936236545248623*^9}, {
  3.960881183361024*^9, 3.96088119833912*^9}},
 CellID->500291033,ExpressionUUID->"db918988-46ff-42ac-ab89-8efee6773161"],

Cell[BoxData[
 RowBox[{"DefineGaugeGroup", "[", 
  RowBox[{"U1Y", ",", "U1", ",", "gY", ",", "B"}], "]"}]], "Input",
 CellLabel->"In[14]:=",
 CellID->1560934494,ExpressionUUID->"eb0890e1-4492-497d-8880-1da03603711d"],

Cell[TextData[{
 "it becomes possible to specify the charge of a field under that group. The \
charge under the group is specified in the format ",
 StyleBox["groupName[charge]", "InlineCode"],
 ". Thus to specify a scalar with charge 2, use the option   "
}], "ExampleText",
 CellChangeTimes->{{3.936236555737947*^9, 3.936236615446313*^9}, {
  3.936236671767516*^9, 3.936236770256578*^9}},
 CellID->911623616,ExpressionUUID->"251de772-8930-4e22-a84a-246d8b5ea774"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineField", "[", 
  RowBox[{"\[CapitalPhi]1", ",", "Scalar", ",", " ", 
   RowBox[{"Charges", "\[Rule]", 
    RowBox[{"U1Y", "[", "2", "]"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"GetFields", "[", "\[CapitalPhi]1", "]"}]}], "Input",
 CellChangeTimes->{{3.9362366289740252`*^9, 3.93623666101997*^9}, {
  3.936236774178355*^9, 3.936236779109296*^9}},
 CellLabel->"In[15]:=",
 CellID->1960087021,ExpressionUUID->"90cd406f-4bb4-4184-b15b-aa8d64944f64"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"Type", "\[Rule]", "Scalar"}], ",", 
   RowBox[{"Indices", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"Charges", "\[Rule]", 
    RowBox[{"U1Y", "[", "2", "]"}]}], ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "False"}], ",", 
   RowBox[{"Chiral", "\[Rule]", "False"}], ",", 
   RowBox[{"Mass", "\[Rule]", "M\[CapitalPhi]1"}], ",", 
   RowBox[{"Heavy", "\[Rule]", "True"}]}], "\[RightAssociation]"}]], "Output",\

 CellChangeTimes->{3.9362367795145407`*^9, 3.9362558101138897`*^9},
 CellLabel->"Out[16]=",
 CellID->216164004,ExpressionUUID->"0ff15149-5632-4b35-a932-38d4a35129d5"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["Charges",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Charges"]], "InlineFormula",
  ExpressionUUID->"a21c485a-4f31-47ad-95d7-affce6c4978a"],
 " can also take a list of charges as a value."
}], "ExampleText",
