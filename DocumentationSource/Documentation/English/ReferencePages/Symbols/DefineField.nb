   "4582aed4-f088-425f-9e09-b3aef2f205e4"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->1466480238,ExpressionUUID->"b348a221-db30-468e-9d87-2ac24636ddc4"],

Cell[TextData[{
 "The mass option is used to specify the label for the default mass of the \
field (used in ",
 Cell[BoxData[
  ButtonBox["FreeLag",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/FreeLag"]], "InlineFormula",
  ExpressionUUID->"301da79d-73f9-4964-992c-d2ce1d1b35d2"],
 ") and to inform the program whether the field is considered heavy or light \
for the purposes of matching. "
}], "ExampleText",
 CellChangeTimes->{{3.936234173814035*^9, 3.936234181652079*^9}, {
  3.936234240719589*^9, 3.936234324054881*^9}, {3.936234480226285*^9, 
  3.936234507449658*^9}},
 CellID->2017538067,ExpressionUUID->"51ff6891-ab73-4283-aedb-f73f2e3a5980"],

Cell["\<\
