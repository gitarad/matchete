Cell["\<\
We can control also the display of the mass, by giving a list of two strings \
to the option:\
\>", "ExampleText",
 CellChangeTimes->{{3.936255118196741*^9, 3.9362551829263887`*^9}},
 CellID->1227897984,ExpressionUUID->"e93c07d3-72b0-4c53-95e8-ea4e4f7b50fb"],

Cell[BoxData[
 RowBox[{"DefineField", "[", 
  RowBox[{"f2", ",", " ", "Scalar", ",", " ", 
   RowBox[{"NiceForm", "\[Rule]", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Phi]\), \(f\)]\)\>\"", ",", 
      " ", "\"\<m\[Phi]\>\""}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.936255621955329*^9, 3.936255668272448*^9}},
 CellLabel->"In[52]:=",
