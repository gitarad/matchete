   "fa12f5ca-23a7-4908-8d4a-dbc1fd838f1c"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->905029541,ExpressionUUID->"66029b55-5d57-42a7-9198-98c3fa7950ec"],

Cell["\<\
When more indices are specified for the same field, for instance and SU(3) \
triplet with 2 generations, the ordering in which the indices are specified \
informs the ordering of the labels in the field short cut. \
\>", "ExampleText",
 CellChangeTimes->{{3.9362535556054173`*^9, 3.936253628312768*^9}, {
  3.936253659228519*^9, 3.9362536663142242`*^9}},
 CellID->204823886,ExpressionUUID->"1240f8c2-6cf2-4499-aaf4-01b6bb6e7fd0"],

