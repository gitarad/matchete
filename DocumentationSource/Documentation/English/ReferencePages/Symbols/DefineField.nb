Cell[TextData[{
 "It is not possible to define a light field with a mass carrying flavor \
indices. In that event, the mass should be defined separately with ",
 Cell[BoxData[
  ButtonBox["DefineCoupling",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DefineCoupling"]], "InlineFormula",
  ExpressionUUID->"a108a349-b91f-4376-ba16-993ddfe58085"],
 " "
}], "ExampleText",
 CellChangeTimes->{{3.9362355805839787`*^9, 3.936235626652068*^9}, {
  3.93623571779883*^9, 3.936235768077791*^9}},
 CellID->660017830,ExpressionUUID->"410c31ba-35ec-4e25-b196-c08196802978"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DefineField", "[", 
  RowBox[{"s", ",", "Scalar", ",", 
   RowBox[{"Indices", "\[Rule]", "Flavor"}], ",", " ", 
   RowBox[{"Mass", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Light", ",", " ", "m\[Phi]", ",", 
      RowBox[{"{", "Flavor", "}"}]}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.936235630633346*^9, 3.936235633605529*^9}, 
   3.936255893238742*^9},
 CellLabel->"In[62]:=",
 CellID->2001185775,ExpressionUUID->"a382403a-67aa-4df6-8186-ad5279ea0f2e"],

Cell[BoxData[
 TemplateBox[{
  "DefineField", "LightIndices", 
   "\"DefineField does not support light scalar/vector masses with flavor \
indices. Light mass should be set to 0 in DefineField and the squared mass \
should be defined separately with DefineCoupling with EFTOrder->2. \"", 2, 62,
    4, 24131561823289580448, "Local", "Matchete`DefineField"},
  "MessageTemplate2"]], "Message", "MSG",
 CellChangeTimes->{
  3.93623577776715*^9, {3.936255881319812*^9, 3.936255893657372*^9}},
