Cell[BoxData[
 RowBox[{
  FormBox[
   RowBox[{
    FormBox[
     FractionBox["1", "2"],
     StandardForm], 
    SuperscriptBox[
     FormBox[
      StyleBox[
       RowBox[{"(", 
        TagBox[
         FormBox[
          TemplateBox[{
            SubscriptBox["D", 
             StyleBox[
              TagBox[
               StyleBox["\"\[Mu]\"", 10, StripOnInput -> False], 
               Format[#, Matchete`NiceForm]& ], FontSize -> 12, StripOnInput -> 
              False]], 
