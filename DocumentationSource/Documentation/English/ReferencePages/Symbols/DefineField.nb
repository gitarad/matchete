Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Indices", "ExampleSubsection",ExpressionUUID->
   "ae219451-522c-408f-b84e-9c2b6bf6d5aa"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->926826047,ExpressionUUID->"0aaa165a-01b9-470d-885e-215573ef7892"],

Cell[TextData[{
 "The index option specifies all the indices of a field associated with \
non-Abelian gauged or global groups or simple flavor (generation). Thus, \
indices are implicitly used to specify the transformation of the field under \
the non-Abelian gauge groups. First Matchete needs to recognize the index \
type we wish to specify. For instance defining a gauge group with ",
 Cell[BoxData[
  ButtonBox["DefineGaugeGroup",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DefineGaugeGroup"]], "InlineFormula",
  ExpressionUUID->"62632065-544f-47eb-a1ce-2d566a7b3e6c"],
 " automatically defines some common representations, e.g., "
}], "ExampleText",
 CellChangeTimes->{{3.9362526568416758`*^9, 3.936252788147572*^9}, 
   3.936252822612689*^9, {3.936252887382916*^9, 3.936252894027787*^9}, {
   3.936252925862083*^9, 3.936253038047064*^9}, {3.936253253991908*^9, 
   3.9362532689323397`*^9}},
 CellID->947998980,ExpressionUUID->"4a197b1d-76a6-49b0-9a13-2574abebeba8"],

Cell[BoxData[
 RowBox[{"DefineGaugeGroup", "[", 
  RowBox[{"SU3", ",", 
   RowBox[{"SU", "[", "3", "]"}], ",", "g", ",", "G3"}], "]"}]], "Input",
 CellChangeTimes->{{3.93625282001257*^9, 3.9362528309036703`*^9}, {
   3.936252883773499*^9, 3.936252897781075*^9}, 3.936253095298401*^9, {
   3.936253128546879*^9, 3.936253129287931*^9}, {3.936255833843569*^9, 
   3.93625583456345*^9}},
 CellLabel->"In[24]:=",
 CellID->1893423347,ExpressionUUID->"29b9a0f6-519f-4e5f-b8e6-5935a4de04d7"],

Cell[TextData[{
 "Then we may make a new field with a fundamental representation (",
 Cell[BoxData[
  ButtonBox["fund",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/fund"]], "InlineFormula",ExpressionUUID->
  "851ee5d0-b82a-44c8-a082-439ff56c10c6"],
 ") of the SU3 group"
}], "ExampleText",
 CellChangeTimes->{{3.9362530420111437`*^9, 3.9362530479041348`*^9}, {
  3.936253399365672*^9, 3.9362534289645023`*^9}, {3.936253470017749*^9, 
  3.936253473264007*^9}},
 CellID->1639037916,ExpressionUUID->"ece33607-d9e6-4102-b96d-f6425a93e16e"],

Cell[BoxData[
 RowBox[{"DefineField", "[", 
  RowBox[{"\[CapitalPhi]2", ",", " ", "Scalar", ",", 
   RowBox[{"Indices", "\[Rule]", " ", 
    RowBox[{"SU3", "[", "fund", "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{
  3.9362530514438667`*^9, {3.936253100265856*^9, 3.936253155956959*^9}, 
   3.936253456683305*^9},
 CellLabel->"In[25]:=",
 CellID->1682086663,ExpressionUUID->"2606d8a6-b1c6-48e4-a473-c26db3c338d5"],

Cell["which now needs to be specified with one index. For instance", \
"ExampleText",
 CellChangeTimes->{{3.936253162628315*^9, 3.936253206758196*^9}},
 CellID->1998833852,ExpressionUUID->"5d43244b-ec94-40e4-90f2-97b9a3dc2528"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"\[CapitalPhi]2", "[", "a", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalPhi]2", "[", "a", "]"}], "//", "NiceForm"}]}], "Input",
 CellChangeTimes->{{3.9362533517648783`*^9, 3.9362533526046457`*^9}},
 CellLabel->"In[26]:=",
 CellID->1536551804,ExpressionUUID->"b7535c9a-61b3-4b6a-97be-5a2a9f743f62"],

Cell[BoxData[
 RowBox[{"Field", "[", 
  RowBox[{"\[CapitalPhi]2", ",", "Scalar", ",", 
   RowBox[{"{", 
    RowBox[{"Index", "[", 
     RowBox[{"a", ",", 
      RowBox[{"SU3", "[", "fund", "]"}]}], "]"}], "}"}], ",", 
   RowBox[{"{", "}"}]}], "]"}]], "Output",
 CellChangeTimes->{3.936253208496705*^9, 3.936253352998165*^9, 
  3.936255837564307*^9},
 CellLabel->"Out[26]=",
 CellID->1557836470,ExpressionUUID->"026eb5b8-f463-405f-b23a-3a2d965c5b90"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    FormBox["\[CapitalPhi]2", StandardForm], StandardForm, Editable -> True], 
   
   StyleBox[
    TemplateBox[{
      TagBox[
       StyleBox["\"a\"", 10, StripOnInput -> False], 
       Format[#, Matchete`NiceForm]& ]}, "RowDefault"], FontSize -> 12, 
    StripOnInput -> False]},
  "Superscript"]], "Output",
 CellChangeTimes->{3.936253208496705*^9, 3.936253352998165*^9, 
  3.9362558375653667`*^9},
 CellLabel->"Out[27]//NiceForm=",
 CellID->436927066,ExpressionUUID->"65bb7dee-122a-449e-8f00-1f10ef570153"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "26fb57c2-b4e1-4924-8cd0-98e9b20d4122"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->761528069,ExpressionUUID->"c2db1ab1-376f-4fa8-baed-b7a2b9add6fd"],

Cell[TextData[{
 "Flavor indices for a field are specified in a similar way. Defining a \
generation index counting 2 generations  with ",
 Cell[BoxData[
  ButtonBox["DefineFlavorIndex",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DefineFlavorIndex"]], "InlineFormula",
  ExpressionUUID->"32e9626b-31ab-404a-9400-e08e80f0db05"]
}], "ExampleText",
 CellChangeTimes->{{3.9362532193020287`*^9, 3.9362533232018223`*^9}, 
   3.93625375078012*^9},
 CellID->234862965,ExpressionUUID->"778f38af-1e37-480f-a6c9-85430e0896b6"],

Cell[BoxData[
 RowBox[{"DefineFlavorIndex", "[", 
  RowBox[{"Generation", ",", "2"}], "]"}]], "Input",
 CellChangeTimes->{{3.936253327377028*^9, 3.9362533312140093`*^9}},
 CellLabel->"In[28]:=",
 CellID->699396657,ExpressionUUID->"36a5a50f-6457-4a54-ad7b-dac6f69462ab"],

Cell["lets us define a field with that generation index:", "ExampleText",
 CellChangeTimes->{{3.936253333615037*^9, 3.936253368738955*^9}},
 CellID->1657753132,ExpressionUUID->"979b0c78-0842-41db-a0b7-031b9f291b63"],

Cell["DefineField[\[CapitalPhi]3, Scalar, Indices\[Rule]Generation]", "Input",
 CellChangeTimes->{{3.936253374763248*^9, 3.936253390208304*^9}, {
  3.936253492221098*^9, 3.936253492293483*^9}},
 CellLabel->"In[29]:=",
 CellID->1590833656,ExpressionUUID->"c60d3a60-df2d-4367-827c-2500a1b11fb8"],

Cell["We see that the index is of the appropriate type", "ExampleText",
 CellChangeTimes->{{3.9362535024298153`*^9, 3.936253543056979*^9}},
 CellID->1346144137,ExpressionUUID->"de3fb042-d527-40b0-951b-bf4faa4aec7a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"\[CapitalPhi]3", "[", "p", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalPhi]3", "[", "p", "]"}], "//", "NiceForm"}]}], "Input",
 CellChangeTimes->{{3.936253510240341*^9, 3.93625351183815*^9}, {
  3.936253700389399*^9, 3.9362537013795357`*^9}},
 CellLabel->"In[30]:=",
 CellID->920094860,ExpressionUUID->"feacbd65-53c9-46af-882b-cce040fe409f"],

Cell[BoxData[
 RowBox[{"Field", "[", 
  RowBox[{"\[CapitalPhi]3", ",", "Scalar", ",", 
   RowBox[{"{", 
    RowBox[{"Index", "[", 
     RowBox[{"p", ",", "Generation"}], "]"}], "}"}], ",", 
   RowBox[{"{", "}"}]}], "]"}]], "Output",
 CellChangeTimes->{3.936253512709189*^9, 3.9362537017760878`*^9, 
  3.936255841946844*^9},
 CellLabel->"Out[30]=",
 CellID->359986054,ExpressionUUID->"e5567348-4993-4e96-a873-e805a2f1e54d"],

Cell[BoxData[
 TemplateBox[{
   TagBox[
    FormBox["\[CapitalPhi]3", StandardForm], StandardForm, Editable -> True], 
   
   StyleBox[
    TemplateBox[{
      TagBox[
       StyleBox["\"p\"", 10, StripOnInput -> False], 
       Format[#, Matchete`NiceForm]& ]}, "RowDefault"], FontSize -> 12, 
    StripOnInput -> False]},
  "Superscript"]], "Output",
 CellChangeTimes->{3.936253512709189*^9, 3.9362537017760878`*^9, 
  3.936255841947875*^9},
 CellLabel->"Out[31]//NiceForm=",
 CellID->824175979,ExpressionUUID->"963e612e-7d71-40b8-8397-ffaf3f760fc6"]
