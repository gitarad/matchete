 CellLabel->"In[54]:=",
 CellID->1464112779,ExpressionUUID->"642f42aa-95b3-4a89-913f-7a290015ffbb"],

Cell["This is reflected both in the generic free Lagrangian ", "ExampleText",
 CellChangeTimes->{{3.9362542481011143`*^9, 3.936254268312454*^9}, {
  3.9362543446167717`*^9, 3.936254347992815*^9}},
