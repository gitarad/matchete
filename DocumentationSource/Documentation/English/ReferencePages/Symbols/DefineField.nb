}, Open  ]],

Cell["By default such fields are assumed to have a Majorana mass. ", \
"ExampleText",
 CellChangeTimes->{{3.936237305188347*^9, 3.9362373324397078`*^9}},
 CellID->718341711,ExpressionUUID->"c2b3ec02-4969-4c68-b37d-2423990d95bc"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "bdc745f4-13c4-487a-a761-fc72cc2cda2b"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->1098490237,ExpressionUUID->"eb134e43-836b-4dd0-84a3-5dde39b5f1f6"],

Cell["\<\
A common use case, known from the SM, is to have massless chiral fermions. In \
that case, one can also invoke the mass option to obtain\
\>", "ExampleText",
 CellChangeTimes->{{3.936237343856134*^9, 3.936237388790002*^9}, {
  3.936237445819206*^9, 3.9362374628112*^9}},
 CellID->1320755931,ExpressionUUID->"6601ef44-d626-4885-bd3b-63ad837a4f21"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineField", "[", 
  RowBox[{"\[CapitalPsi]2", ",", "Fermion", ",", " ", 
   RowBox[{"Chiral", "\[Rule]", "RightHanded"}], ",", " ", 
   RowBox[{"Mass", "\[Rule]", "0"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FreeLag", "[", "\[CapitalPsi]2", "]"}], "//", 
  "NiceForm"}]}], "Input",
 CellChangeTimes->{{3.9362373396910267`*^9, 3.936237340404315*^9}, 
   3.936237438210898*^9, {3.936237471651925*^9, 3.9362374867146177`*^9}},
 CellLabel->"In[21]:=",
 CellID->154280541,ExpressionUUID->"a5803032-d00b-4f30-b2a9-072558472d8f"],

Cell[BoxData[
 RowBox[{
  FormBox["\[ImaginaryI]",
   StandardForm], 
  FormBox[
   StyleBox[
    RowBox[{"(", 
     RowBox[{
      TagBox[
       FormBox[
        OverscriptBox["\[CapitalPsi]2", "_"],
        StandardForm],
       StandardForm,
       Editable->True], "\[CenterDot]", 
      FormBox[
       RowBox[{
        SubscriptBox[
         FormBox["\[Gamma]",
          StandardForm], 
         TagBox[
          StyleBox["\<\"\[Mu]\"\>",
           StripOnInput->False,
           FontSize->10],
          Format[#, Matchete`NiceForm]& ]], 
        SubscriptBox["\<\"P\"\>", "\<\"R\"\>"]}],
       StandardForm], "\[CenterDot]", 
      TagBox[
