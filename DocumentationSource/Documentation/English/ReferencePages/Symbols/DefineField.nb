Cell["\<\
The free Lagrangian in this case provides a Majorana mass for the fermion\
\>", "ExampleText",
 CellChangeTimes->{{3.936254599754586*^9, 3.936254640702667*^9}},
 CellID->1743019876,ExpressionUUID->"c99e2019-42f2-4725-a7b4-448b069a5654"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FreeLag", "@", "\[Chi]"}], "//", "NiceForm"}]], "Input",
 CellChangeTimes->{{3.9362543834076157`*^9, 3.9362543971812077`*^9}},
 CellLabel->"In[59]:=",
 CellID->1618449420,ExpressionUUID->"72dda175-35cd-4e0e-be41-c064ee0be761"],

Cell[BoxData[
 RowBox[{
  FormBox[
   RowBox[{
    FormBox[
     FractionBox["\[ImaginaryI]", "2"],
     StandardForm], 
    FormBox[
     StyleBox[
      RowBox[{"(", 
       RowBox[{
        TemplateBox[{
          TagBox[
           FormBox["\[Chi]", StandardForm], StandardForm, Editable -> True], 
          "\"T\""},
         "Superscript"], "\[CenterDot]", 
        FormBox[
         RowBox[{"\<\"C\"\>", 
          SubscriptBox[
           FormBox["\[Gamma]",
            StandardForm], 
           TagBox[
            StyleBox["\<\"\[Mu]\"\>",
             StripOnInput->False,
             FontSize->10],
            Format[#, Matchete`NiceForm]& ]]}],
         StandardForm], "\[CenterDot]", 
        TagBox[
         FormBox[
          TemplateBox[{
            SubscriptBox["D", 
             StyleBox[
              TagBox[
               StyleBox["\"\[Mu]\"", 10, StripOnInput -> False], 
               Format[#, Matchete`NiceForm]& ], FontSize -> 12, StripOnInput -> 
              False]], 
            TagBox[
             FormBox["\[Chi]", StandardForm], StandardForm, Editable -> True]},
           "RowDefault"],
