           FormBox["\[CapitalPsi]1", StandardForm], StandardForm, Editable -> 
           True], "\"T\""},
         "Superscript"], "\[CenterDot]", 
        FormBox[
         RowBox[{"\<\"C\"\>", 
          SubscriptBox["\<\"P\"\>", "\<\"R\"\>"]}],
         StandardForm], "\[CenterDot]", 
        TagBox[
         FormBox["\[CapitalPsi]1",
          StandardForm],
         StandardForm,
         Editable->True]}], ")"}],
      SpanSymmetric->False],
     StandardForm]}],
   StandardForm]}]], "Output",
 CellChangeTimes->{3.936237265823469*^9, 3.936255814965727*^9},
