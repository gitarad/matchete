Cell[BoxData[
 RowBox[{
  FormBox[
   RowBox[{
    FormBox["\[ImaginaryI]",
     StandardForm], 
    FormBox[
     StyleBox[
      RowBox[{"(", 
       RowBox[{
        TagBox[
         FormBox[
          OverscriptBox["\[CapitalPsi]1", "_"],
          StandardForm],
         StandardForm,
         Editable->True], "\[CenterDot]", 
        FormBox[
         RowBox[{
          SubscriptBox[
           FormBox["\[Gamma]",
            StandardForm], 
           TagBox[
            StyleBox["\<\"\[Mu]\"\>",
             StripOnInput->False,
             FontSize->10],
            Format[#, Matchete`NiceForm]& ]], 
          SubscriptBox["\<\"P\"\>", "\<\"R\"\>"]}],
         StandardForm], "\[CenterDot]", 
        TagBox[
         FormBox[
          TemplateBox[{
            SubscriptBox["D", 
             StyleBox[
              TagBox[
               StyleBox["\"\[Mu]\"", 10, StripOnInput -> False], 
               Format[#, Matchete`NiceForm]& ], FontSize -> 12, StripOnInput -> 
              False]], 
            TagBox[
             FormBox["\[CapitalPsi]1", StandardForm], StandardForm, Editable -> 
             True]},
           "RowDefault"],
          StandardForm],
         StandardForm,
         Editable->True]}], ")"}],
      SpanSymmetric->False],
     StandardForm]}],
   StandardForm], "-", 
  FormBox[
   RowBox[{
    FormBox[
     FractionBox["1", "2"],
     StandardForm], 
    TagBox[
     FormBox["M\[CapitalPsi]1",
      StandardForm],
     StandardForm,
     Editable->True], 
    FormBox[
     StyleBox[
      RowBox[{"(", 
       RowBox[{
        TagBox[
         FormBox[
          OverscriptBox["\[CapitalPsi]1", "_"],
          StandardForm],
         StandardForm,
         Editable->True], "\[CenterDot]", 
        FormBox[
         RowBox[{"\<\"C\"\>", 
          SubscriptBox["\<\"P\"\>", "\<\"L\"\>"]}],
         StandardForm], "\[CenterDot]", 
        TemplateBox[{
          TagBox[
           FormBox[
            OverscriptBox["\[CapitalPsi]1", "_"], StandardForm], StandardForm,
            Editable -> True], "\"T\""},
         "Superscript"]}], ")"}],
      SpanSymmetric->False],
     StandardForm]}],
   StandardForm], "-", 
  FormBox[
   RowBox[{
    FormBox[
     FractionBox["1", "2"],
     StandardForm], 
    TagBox[
     FormBox["M\[CapitalPsi]1",
      StandardForm],
     StandardForm,
     Editable->True], 
    FormBox[
     StyleBox[
      RowBox[{"(", 
       RowBox[{
        TemplateBox[{
