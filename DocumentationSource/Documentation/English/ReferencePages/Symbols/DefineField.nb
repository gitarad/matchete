Cell["\<\
To run the following examples we will load the SM gauge and flavor groups. \
This is not shown in the built documentation\
\>", "ExampleText",
 CellChangeTimes->{{3.936232515808071*^9, 3.936232524986538*^9}, {
  3.936232573872898*^9, 3.936232593172831*^9}, {3.93623269024399*^9, 
  3.936232695163525*^9}, {3.936233736939349*^9, 3.93623374623825*^9}},
 CellID->2063534172,ExpressionUUID->"487e3317-47e8-470f-91be-85a1bf73b5ae"],

Cell[BoxData[{
 RowBox[{"Needs", "[", "\"\<Matchete`\>\"", "]"}], "\[LineSeparator]", 
 RowBox[{"DefineGaugeGroup", "[", 
  RowBox[{"SU3c", ",", 
   RowBox[{"SU", "@", "3"}], ",", "gs", ",", "G", ",", "\n", "\t", 
   RowBox[{"FundAlphabet", "->", 
    RowBox[{"CharacterRange", "[", 
     RowBox[{"\"\<a\>\"", ",", "\"\<f\>\""}], "]"}]}], ",", "\n", "\t", 
   RowBox[{"AdjAlphabet", "->", 
    RowBox[{"CharacterRange", "[", 
     RowBox[{"\"\<A\>\"", ",", "\"\<F\>\""}], "]"}]}]}], "]"}], "\n", 
 RowBox[{"DefineGaugeGroup", "[", 
  RowBox[{"SU2L", ",", 
   RowBox[{"SU", "@", "2"}], ",", "gL", ",", "W", ",", " ", "\n", "\t", 
   RowBox[{"FundAlphabet", "->", 
    RowBox[{"CharacterRange", "[", 
     RowBox[{"\"\<i\>\"", ",", "\"\<n\>\""}], "]"}]}], ",", "\n", "\t", 
   RowBox[{"AdjAlphabet", "->", 
    RowBox[{"CharacterRange", "[", 
     RowBox[{"\"\<I\>\"", ",", "\"\<N\>\""}], "]"}]}]}], "]"}], "\n", 
 RowBox[{"DefineGaugeGroup", "[", 
  RowBox[{"U1Y", ",", "U1", ",", "gY", ",", "B"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineFlavorIndex", "[", 
  RowBox[{"Flavor", ",", "3", ",", "\n", "\t", 
   RowBox[{"IndexAlphabet", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<p\>\"", ",", "\"\<r\>\"", ",", "\"\<s\>\"", ",", "\"\<t\>\"", ",", 
      "\"\<u\>\"", ",", "\"\<v\>\""}], "}"}]}]}], 
  "]"}]}], "ExampleInitialization",
 CellChangeTimes->{{3.936232378925489*^9, 3.936232403718431*^9}, {
   3.936232482684073*^9, 3.9362324892281294`*^9}, {3.9362327549459047`*^9, 
   3.936232760657607*^9}, {3.936232908989807*^9, 3.936232910675739*^9}, {
   3.936233456389464*^9, 3.936233462293339*^9}, {3.936233542347574*^9, 
   3.936233544940049*^9}, 3.936233618931931*^9, {3.93623398024993*^9, 
   3.936233983787029*^9}, {3.936234115139553*^9, 3.936234116655459*^9}},
 CellID->167260172,ExpressionUUID->"5bda518f-c81c-4b1f-a339-77fe6c78a424"]
}, Open  ]],

