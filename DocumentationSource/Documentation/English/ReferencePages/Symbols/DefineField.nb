Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Chiral", "ExampleSubsection",ExpressionUUID->
   "b274d646-8df1-4e90-a4b8-468f8517ff91"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->2101923771,ExpressionUUID->"abdff063-c7a4-45ff-ace3-f857429bbdc0"],

Cell["\<\
The chiral option is used exclusively for fermions. Matchete employs Dirac \
spinor notation, and the chirality option lets the user specify if the spinor \
is left- or right-handed or if it is vector-like.\
\>", "ExampleText",
 CellChangeTimes->{{3.936236958941579*^9, 3.936237008429597*^9}, {
  3.936237045389884*^9, 3.936237066043756*^9}},
 CellID->1871383609,ExpressionUUID->"710e63ca-887e-432a-b2dc-db7f3d665b46"],

Cell["\<\
The default option sets the field to be vector-like, which appears from the \
associated free Lagrangian \
\>", "ExampleText",
 CellChangeTimes->{{3.93623706961967*^9, 3.936237074068879*^9}, {
  3.936237111390745*^9, 3.9362371530964737`*^9}},
 CellID->1846503913,ExpressionUUID->"02bcc3b2-4ba6-41ba-a9b4-fb91b3639223"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineField", "[", 
  RowBox[{"\[CapitalPsi]", ",", "Fermion", ",", " ", 
   RowBox[{"Chiral", "\[Rule]", "False"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FreeLag", "[", "\[CapitalPsi]", "]"}], "//", 
  "NiceForm"}]}], "Input",
 CellChangeTimes->{{3.936237084231241*^9, 3.936237156686659*^9}},
 CellLabel->"In[17]:=",
 CellID->458808180,ExpressionUUID->"04c245e4-9d6e-44a6-b941-bf9dd8226422"],

Cell[BoxData[
 RowBox[{
  FormBox[
   RowBox[{
    FormBox["\[ImaginaryI]",
     StandardForm], 
    FormBox[
     StyleBox[
      RowBox[{"(", 
       RowBox[{
        TagBox[
         FormBox[
          OverscriptBox["\[CapitalPsi]", "_"],
          StandardForm],
         StandardForm,
         Editable->True], "\[CenterDot]", 
        FormBox[
         SubscriptBox[
          FormBox["\[Gamma]",
           StandardForm], 
          TagBox[
           StyleBox["\<\"\[Mu]\"\>",
            StripOnInput->False,
            FontSize->10],
           Format[#, Matchete`NiceForm]& ]],
         StandardForm], "\[CenterDot]", 
        TagBox[
         FormBox[
          TemplateBox[{
            SubscriptBox["D", 
             StyleBox[
              TagBox[
               StyleBox["\"\[Mu]\"", 10, StripOnInput -> False], 
               Format[#, Matchete`NiceForm]& ], FontSize -> 12, StripOnInput -> 
              False]], 
            TagBox[
             FormBox["\[CapitalPsi]", StandardForm], StandardForm, Editable -> 
             True]},
           "RowDefault"],
          StandardForm],
         StandardForm,
         Editable->True]}], ")"}],
      SpanSymmetric->False],
     StandardForm]}],
   StandardForm], "-", 
  FormBox[
   RowBox[{
    TagBox[
     FormBox["M\[CapitalPsi]",
      StandardForm],
     StandardForm,
     Editable->True], 
    FormBox[
     StyleBox[
      RowBox[{"(", 
       TagBox[
        FormBox[
         OverscriptBox["\[CapitalPsi]", "_"],
         StandardForm],
        StandardForm,
        Editable->True], "\[CenterDot]", 
       TagBox[
        FormBox["\[CapitalPsi]",
         StandardForm],
        StandardForm,
        Editable->True], ")"}],
      SpanSymmetric->False],
     StandardForm]}],
   StandardForm]}]], "Output",
 CellChangeTimes->{3.936237157074683*^9, 3.9362558134142103`*^9},
 CellLabel->"Out[18]//NiceForm=",
 CellID->224546759,ExpressionUUID->"9c7c40e0-24e6-473b-b30c-8c3a0cf1b857"]
}, Open  ]],

