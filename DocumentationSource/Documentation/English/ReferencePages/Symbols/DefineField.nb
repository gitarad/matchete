Cell[TextData[{
 "If the mass of the heavy field is non-universal, it can be defined with a \
third entry to the list of mass arguments ",
 StyleBox["{<Heavy>,<label>,<List of flavor indices>}", "InlineCode"],
 ". Note, that the heavy mass matrix is assumed to be diagonal; hence, it \
receives just a single diagonal index. "
}], "ExampleText",
 CellChangeTimes->{{3.9362352703434553`*^9, 3.936235273014801*^9}, 
   3.936235329839453*^9, {3.936235793377103*^9, 3.9362359322139063`*^9}, {
   3.936254740359593*^9, 3.936254745071072*^9}},
 CellID->89187122,ExpressionUUID->"6a8d5410-36eb-4e41-a2fd-77702cba1805"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]6", ",", "Scalar", ",", 
   RowBox[{"Mass", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Heavy", ",", " ", "M\[Phi]6", ",", 
      RowBox[{"{", "Flavor", "}"}]}], "}"}]}], ",", 
   RowBox[{"Indices", "\[Rule]", "Flavor"}]}], "]"}], "\[IndentingNewLine]", 
