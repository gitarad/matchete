    TagBox[
     FormBox["\<\"\\!\\(\\*SubscriptBox[\\(\[Phi]\\), \\(f\\)]\\)\"\>",
      StandardForm],
     StandardForm,
     Editable->True]}],
   StandardForm]}]], "Output",
 CellChangeTimes->{3.936255681266121*^9, 3.9362558677454576`*^9},
 CellLabel->"Out[53]//NiceForm=",
