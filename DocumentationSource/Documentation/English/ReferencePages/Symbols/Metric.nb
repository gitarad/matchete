Cell["\<\
If metric tensors are multiplied, they are automatically contracted:\
\>", "ExampleText",
 CellID->645434496,ExpressionUUID->"ed4434ae-425b-4862-ac00-7ee6606f7e82"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Metric", "[", 
   RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], 
  RowBox[{"Metric", "[", 
   RowBox[{"\[Nu]", ",", "\[Rho]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[6]:=",
 CellID->892763715,ExpressionUUID->"a649b759-e145-4fb6-b675-080e69e0723e"],

Cell[BoxData[
 RowBox[{"Metric", "[", 
  RowBox[{
   RowBox[{"Index", "[", 
    RowBox[{"\[Mu]", ",", "Lorentz"}], "]"}], ",", 
   RowBox[{"Index", "[", 
    RowBox[{"\[Rho]", ",", "Lorentz"}], "]"}]}], "]"}]], "Output",
 CellLabel->"Out[6]=",
 CellID->465962614,ExpressionUUID->"fcee96d9-0e51-4eb5-bbb4-dc8983de26ee"],

Cell[BoxData[
 FormBox[
  StyleBox[
   SubscriptBox["g", 
    StyleBox[
     TemplateBox[{"\[Mu]", "\[Rho]"},
      "RowDefault"],
     FontSize->10]], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[7]//NiceForm=",
 CellID->1708276536,ExpressionUUID->"9daf739e-d058-4c8c-952e-13d220998812"]
}, Open  ]],

