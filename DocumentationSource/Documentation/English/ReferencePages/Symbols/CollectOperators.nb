Cell[CellGroupData[{
Cell["CollectOperators", "ObjectName",
 CellID->1937680261,ExpressionUUID->"19057353-5fe9-41e5-ae5a-82d2a09d0f7d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cc7fad23-4a88-4188-97eb-5c16bad0b522"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CollectOperators",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/CollectOperators"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a0a5c31e-bd41-4321-b361-85a24c38c5d6"],
 "\[LineSeparator]gathers a Lagrangian expression by unique operators."
}], "Usage",
 CellID->2639872,ExpressionUUID->"9eaf7ff5-abeb-40c2-b3f5-c82a4894a9b2"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["CollectOperators",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/CollectOperators"]], "InlineFormula",
  ExpressionUUID->"72ab82a2-35b8-4e3e-81bb-a8e6b113851e"],
 " identifies unique operators accounting for relabeling of dummy indices and \
obvious symmetries of objects. It does not attempt to apply a full set of \
simplification identities such as ",
 Cell[BoxData[
  ButtonBox["GreensSimplify",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/GreensSimplify"]], "InlineFormula",
  ExpressionUUID->"ee737657-e23f-43f0-935f-45032ba96379"],
 ". "
}], "Notes",
 CellID->643463071,ExpressionUUID->"3351432f-e362-424a-aa63-8b4a7fceb808"],

Cell[TextData[{
 "The expression returned by ",
 Cell[BoxData[
  ButtonBox["CollectOperators",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/CollectOperators"]], "InlineFormula",
  ExpressionUUID->"97c97d8c-908f-4898-bff7-ce2578378593"],
 " typically contains many operators outside the (off-shell) basis. "
}], "Notes",
 CellID->11572706,ExpressionUUID->"17a6d978-2ed2-41bf-be3b-e230bd3fd7a4"],

Cell[TextData[{
 "By contrast to ",
 Cell[BoxData[
  ButtonBox["RelabelIndices",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/RelabelIndices"]], "InlineFormula",
  ExpressionUUID->"8c148871-a2ae-436f-b0b5-017e63682d0e"],
 ", ",
 Cell[BoxData[
  ButtonBox["CollectOperators",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/CollectOperators"]], "InlineFormula",
  ExpressionUUID->"cd7e2a6a-0904-4a79-9004-7daa9de8b5f6"],
 " is much more robust, as it correctly identifies isomorphic graphs formed \
by the dummy index contractions"
}], "Notes",
 CellID->1343303225,ExpressionUUID->"67a1d0e8-a1a0-4bb6-80f3-f388169c790e"],

Cell["The following options can be given: ", "Notes",
 CellID->1418655764,ExpressionUUID->"d38abe51-82fa-4851-86cb-2142afcbaf4d"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "648eb482-fac5-4603-8e31-49e02a0a8729"], 
    ButtonBox["Simplify",
     BaseStyle->"Link"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell["\<\
applies simplification steps to the coefficient of each operator, seeking to \
identify similar index contraction of couplings.\
\>", "TableText",ExpressionUUID->"c34e4186-f7c4-4767-aabc-0233cd3aacb7"]}
  }]], "3ColumnTableMod",
 CellID->1983976554,ExpressionUUID->"f5cdaf19-ebf0-4cdb-adb1-2a63976491ca"]
}, Open  ]],

