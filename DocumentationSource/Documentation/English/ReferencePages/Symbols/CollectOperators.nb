Cell[TextData[{
 "For a simple example we load the SM definitions with ",
 Cell[BoxData[
  ButtonBox["LoadModel",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/LoadModel"]], "InlineFormula",
  ExpressionUUID->"a058e325-629c-4c4c-b222-5a8c0cc16dc4"],
 ". A call to ",
 Cell[BoxData[
  ButtonBox["CollectOperators",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/CollectOperators"]], "InlineFormula",
  ExpressionUUID->"1e1fd463-2cbe-4b37-84dc-0e954acc991c"],
 " groups the expression below by the unique operators.  "
}], "ExampleText",
 CellID->1149305909,ExpressionUUID->"b39d5a87-d30f-43f6-a2ca-f9cc502c8e7a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"LoadModel", "[", "\"\<SM\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Ye", "[", 
     RowBox[{"p", ",", "r"}], "]"}], 
    RowBox[{
     RowBox[{"Bar", "@", 
      RowBox[{"l", "[", 
       RowBox[{"i", ",", "p"}], "]"}]}], "\[CenterDot]", 
     RowBox[{"e", "[", "r", "]"}]}], " ", 
    RowBox[{"H", "[", "i", "]"}]}], "+", 
   RowBox[{
    RowBox[{"Yu", "[", 
     RowBox[{"p", ",", "r"}], "]"}], 
    RowBox[{
     RowBox[{"Bar", "@", 
      RowBox[{"l", "[", 
       RowBox[{"i", ",", "p"}], "]"}]}], "\[CenterDot]", 
     RowBox[{"\[Sigma]", "[", 
      RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "\[CenterDot]", 
     RowBox[{"e", "[", "r", "]"}]}], " ", 
    RowBox[{"H", "[", "i", "]"}], 
    RowBox[{"FS", "[", 
     RowBox[{"B", ",", "\[Mu]", ",", "\[Nu]"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"Yd", "[", 
     RowBox[{"s", ",", "t"}], "]"}], 
    RowBox[{
     RowBox[{"Bar", "@", 
      RowBox[{"l", "[", 
       RowBox[{"j", ",", "s"}], "]"}]}], "\[CenterDot]", 
     RowBox[{"\[Sigma]", "[", 
      RowBox[{"\[Rho]", ",", "\[Sigma]"}], "]"}], "\[CenterDot]", 
     RowBox[{"e", "[", "t", "]"}]}], " ", 
    RowBox[{"H", "[", "j", "]"}], 
    RowBox[{"FS", "[", 
     RowBox[{"B", ",", "\[Rho]", ",", "\[Sigma]"}], "]"}]}]}], "//", 
  "NiceForm"}], "\n", 
 RowBox[{
  RowBox[{"CollectOperators", "@", "%"}], "//", "NiceForm"}]}], "Input",
 CellLabel->"In[73]:=",
 CellID->1252263530,ExpressionUUID->"717d1af6-7f82-44b6-a562-5d0ba421dc4f"],

