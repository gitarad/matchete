Cell[TextData[{
 "Here a simple contraction of two up-type Yukawa matrices of the SM \
(initialized with ",
 Cell[BoxData[
  ButtonBox["LoadModel",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/LoadModel"]], "InlineFormula",
  ExpressionUUID->"331e50ac-c2d9-4daf-8e1e-da24bed6787a"],
 "). ",
 Cell[BoxData[
  ButtonBox["SimplifyCouplings",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/SimplifyCouplings"]], "InlineFormula",
  ExpressionUUID->"0e8ff981-b98c-491b-a96c-43d5e7c423ce"],
 " identifies the two terms in the sum:"
}], "ExampleText",
 CellChangeTimes->{{3.977299408812323*^9, 3.977299485201733*^9}},
 CellID->1780674590,ExpressionUUID->"19f9768b-28ed-46e9-acf1-06790d1f4de2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"LoadModel", "[", "\"\<SM\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Yu", "[", 
     RowBox[{"p", ",", "r"}], "]"}], 
    RowBox[{"Bar", "@", 
     RowBox[{"Yu", "[", 
      RowBox[{"s", ",", "r"}], "]"}]}]}], "-", 
   RowBox[{"2", 
    RowBox[{"Yu", "[", 
     RowBox[{"p", ",", "t"}], "]"}], 
    RowBox[{"Bar", "@", 
     RowBox[{"Yu", "[", 
      RowBox[{"s", ",", "t"}], "]"}]}]}]}], "//", "NiceForm"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "//", "SimplifyCouplings"}], "//", "NiceForm"}]}], "Input",
 CellChangeTimes->{{3.977299376720419*^9, 3.97729940395117*^9}},
 CellLabel->"In[19]:=",
 CellID->1064385267,ExpressionUUID->"71f40ec6-e725-43a2-bdcf-4cca4838e235"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      OverscriptBox[
       SubscriptBox["Y", "u"], 
       StyleBox["_",
        FontWeight->Bold]], 
      StyleBox[
       TemplateBox[{"s", "r"},
        "RowDefault"],
       FontSize->10]], 
     SuperscriptBox[
      SubscriptBox["Y", "u"], 
      StyleBox[
       TemplateBox[{"p", "r"},
        "RowDefault"],
       FontSize->10]]}], "-", 
    RowBox[{"2", 
     SuperscriptBox[
      OverscriptBox[
       SubscriptBox["Y", "u"], 
       StyleBox["_",
        FontWeight->Bold]], 
      StyleBox[
       TemplateBox[{"s", "t"},
        "RowDefault"],
       FontSize->10]], 
     SuperscriptBox[
      SubscriptBox["Y", "u"], 
      StyleBox[
       TemplateBox[{"p", "t"},
        "RowDefault"],
       FontSize->10]]}]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellChangeTimes->{
  3.9772982235556383`*^9, {3.9772993854141483`*^9, 3.977299404183464*^9}},
 CellLabel->"Out[20]//NiceForm=",
 CellID->988983688,ExpressionUUID->"01d151d8-b575-4e8f-a8de-9d1825c373d6"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{"-", 
    SuperscriptBox[
     OverscriptBox[
      SubscriptBox["Y", "u"], 
      StyleBox["_",
       FontWeight->Bold]], 
     StyleBox[
      TemplateBox[{"s", "r"},
       "RowDefault"],
      FontSize->10]], 
    SuperscriptBox[
     SubscriptBox["Y", "u"], 
     StyleBox[
      TemplateBox[{"p", "r"},
       "RowDefault"],
      FontSize->10]]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellChangeTimes->{
  3.9772982235556383`*^9, {3.9772993854141483`*^9, 3.9772994041844673`*^9}},
 CellLabel->"Out[21]//NiceForm=",
 CellID->325416436,ExpressionUUID->"479d949d-2e9d-4960-b7a7-2286bd4cb52c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "944e4caa-3d38-4d13-906a-4343307d57dc"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->1734913160,ExpressionUUID->"04bab99d-97b5-481e-a439-f43914fa8b60"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SimplifyCouplings",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/SimplifyCouplings"]], "InlineFormula",
  ExpressionUUID->"b5ff9966-d428-4814-a786-994a07a936ad"],
 " accounts for the (anti-)symmetries of couplings used in coupling \
contractions. Take the case where we add a two-index symmetric coupling ",
 StyleBox["S", "InlineCode"],
 ", which is contracted with the up-type Yukawa coupling:"
}], "ExampleText",
 CellChangeTimes->{{3.977299490626959*^9, 3.977299599636561*^9}, {
  3.977299644631002*^9, 3.977299645275539*^9}, {3.9772997510745573`*^9, 
  3.977299761225762*^9}},
 CellID->896899791,ExpressionUUID->"74e1f0ad-18e4-40f7-98bd-6150d46b7a40"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefineCoupling", "[", 
   RowBox[{"S", ",", " ", 
    RowBox[{"Indices", "\[Rule]", " ", 
     RowBox[{"{", 
      RowBox[{"Flavor", ",", "Flavor"}], "}"}]}], ",", 
    RowBox[{"Symmetries", "\[Rule]", " ", 
     RowBox[{"{", 
      RowBox[{"SymmetricPermutation", "[", 
       RowBox[{"2", ",", " ", "1"}], "]"}], "}"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"S", "[", 
     RowBox[{"p", ",", "s"}], "]"}], 
    RowBox[{"Yu", "[", 
     RowBox[{"s", ",", "r"}], "]"}]}], "+", 
   RowBox[{"2", 
    RowBox[{"S", "[", 
     RowBox[{"s", ",", "p"}], "]"}], 
    RowBox[{"Yu", "[", 
     RowBox[{"s", ",", "r"}], "]"}]}]}], "//", "NiceForm"}], "\n", 
 RowBox[{
  RowBox[{"%", "//", "SimplifyCouplings"}], "//", "NiceForm"}]}], "Input",
 CellChangeTimes->{{3.977299542287341*^9, 3.977299542797406*^9}},
 CellLabel->"In[22]:=",
 CellID->519270404,ExpressionUUID->"023b1246-555d-4b14-a50d-5cf95a067ae2"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["S", 
      StyleBox[
       TemplateBox[{"p", "s"},
        "RowDefault"],
       FontSize->10]], 
     SuperscriptBox[
      SubscriptBox["Y", "u"], 
      StyleBox[
       TemplateBox[{"s", "r"},
        "RowDefault"],
       FontSize->10]]}], "+", 
    RowBox[{"2", 
     SuperscriptBox["S", 
      StyleBox[
       TemplateBox[{"s", "p"},
        "RowDefault"],
       FontSize->10]], 
     SuperscriptBox[
      SubscriptBox["Y", "u"], 
      StyleBox[
       TemplateBox[{"s", "r"},
        "RowDefault"],
       FontSize->10]]}]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellChangeTimes->{3.977298280792561*^9, 3.977299543981538*^9},
 CellLabel->"Out[23]//NiceForm=",
 CellID->847609749,ExpressionUUID->"7755426f-1b8c-4f2a-b4e9-9a6a2f2bf1c6"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{"3", 
    SuperscriptBox["S", 
     StyleBox[
      TemplateBox[{"p", "s"},
       "RowDefault"],
      FontSize->10]], 
    SuperscriptBox[
     SubscriptBox["Y", "u"], 
     StyleBox[
      TemplateBox[{"s", "r"},
       "RowDefault"],
      FontSize->10]]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellChangeTimes->{3.977298280792561*^9, 3.977299543983605*^9},
 CellLabel->"Out[24]//NiceForm=",
 CellID->1518020892,ExpressionUUID->"aeaf6f6b-6620-4464-8c6f-600432824a6c"]
}, Open  ]],

Cell[TextData[{
 "The two terms are of the same form only when accounting for the symmetries \
of ",
 StyleBox["S", "InlineCode"],
 "."
}], "ExampleText",
 CellChangeTimes->{{3.977299603113851*^9, 3.977299630426285*^9}},
 CellID->1785842183,ExpressionUUID->"22fb916d-8528-4b16-9a36-3602e5472db9"]
}, Open  ]]
}, Open  ]],

