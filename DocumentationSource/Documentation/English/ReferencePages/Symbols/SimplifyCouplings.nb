Notebook[{

Cell[CellGroupData[{
Cell["SimplifyCouplings", "ObjectName",
 CellID->1303798840,ExpressionUUID->"a3147dcb-574f-4c28-a834-cd650511bc21"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3c4f5dc6-0a57-455e-8a20-660d4264812d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimplifyCouplings",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/SimplifyCouplings"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "f06956d2-545f-488a-b19e-a90073048df8"],
 "\[LineSeparator]simplifies coupling expressions with multiple terms by \
identifying dummy index contractions between couplings."
}], "Usage",
 CellChangeTimes->{
  3.977298147988822*^9, {3.977298629454399*^9, 3.97729866689789*^9}, {
   3.977299300101407*^9, 3.97729931051536*^9}},
 CellID->23969892,ExpressionUUID->"735ede81-8c31-46ca-84c9-2ec69666e431"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SimplifyCouplings",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/SimplifyCouplings"]], "InlineFormula",
  ExpressionUUID->"7aae71c0-52a9-4831-ba29-f6a8de5c3a77"],
 " compares each coupling contraction to other contractions appearing in the \
same sum, bringing them on the same form if identical. It does not seek to \
provide a canonical form for the contraction. "
}], "Notes",
 CellChangeTimes->{{3.977299060458848*^9, 3.977299074515914*^9}, {
  3.977299115597933*^9, 3.977299178969728*^9}},
 CellID->788742992,ExpressionUUID->"1f9938c2-6920-48e9-a505-3f4e9dbcdb01"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SimplifyCouplings",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/SimplifyCouplings"]], "InlineFormula",
  ExpressionUUID->"cd2077f6-b2f9-4a90-bb4f-8ccc6f77a075"],
 " account for defined coupling symmetries. "
}], "Notes",
 CellChangeTimes->{{3.977299260243237*^9, 3.977299285800465*^9}},
 CellID->1549366929,ExpressionUUID->"0b9b077e-471c-4631-a6cb-a6bb217b8287"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SimplifyCouplings",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/SimplifyCouplings"]], "InlineFormula",
  ExpressionUUID->"49795403-5a82-49ad-8318-7c10b3ef0f86"],
 " expands out products before attempting to identify contractions.  "
}], "Notes",
 CellChangeTimes->{{3.977299077290969*^9, 3.977299106133821*^9}},
 CellID->1795654405,ExpressionUUID->"22c773af-0750-47ef-9127-92eec831cf2a"],

Cell[TextData[{
 "In simple cases ",
 Cell[BoxData[
  ButtonBox["RelabelIndices",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/RelabelIndices"]], "InlineFormula",
  ExpressionUUID->"55724166-9efe-4113-91da-b743bf74d925"],
 " can be used to get internal dummy index labels to agree, collapsing \
multiple terms. However, ",
 Cell[BoxData[
  ButtonBox["RelabelIndices",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/RelabelIndices"]], "InlineFormula",
  ExpressionUUID->"4ad4c267-315a-4c7a-873f-a203863e7240"],
 " does not generate a canonical labeling of the dummy indices. Thus, there \
is no guarantee that mathematically identical coupling contractions are \
identified. For this reason ",
 Cell[BoxData[
  ButtonBox["SimplifyCouplings",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/SimplifyCouplings"]], "InlineFormula",
  ExpressionUUID->"fa7a96ad-dc0c-4da9-ac62-652dbb635caa"],
 " provide a more robust simplification method."
}], "Notes",
 CellChangeTimes->{{3.977298671957831*^9, 3.977298754254854*^9}, {
  3.977298944360141*^9, 3.977299054820765*^9}, {3.97729919267738*^9, 
  3.977299222906404*^9}},
 CellID->1282532855,ExpressionUUID->"fc0a15c3-7976-4959-abd2-d83573d81ec2"]
}, Open  ]],

