Cell[TextData[{
 "For a gauged field we instead have ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["D", "\[Mu]"], " ", "=", " ", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "\[Mu]"], " ", 
     RowBox[{"-", " ", "\[ImaginaryI]"}]}], " ", 
    UnderscriptBox["\[CapitalSigma]", "reps"], 
    TemplateBox[{"A", "\[Mu]", "a"},
     "Subsuperscript"], " ", 
    SuperscriptBox["T", "a"]}]}]], "InlineFormula",ExpressionUUID->
  "1d97938f-0dbb-4387-8bd4-ee8e06cf53be"],
 ", where the sum runs over all representations of the fields with the \
corresponding generators ",
 Cell[BoxData[
  RowBox[{"(", 
   SuperscriptBox["T", "a"], ")"}]], "InlineFormula",ExpressionUUID->
  "16d498ef-0631-439c-8f44-50ac11dc0895"],
 " and gauge fields ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     RowBox[{"(", "A"}], "\[Mu]", "a"},
    "Subsuperscript"], ")"}]], "InlineFormula",ExpressionUUID->
  "3fbc0e78-a6fc-4b47-b7d9-e83480168953"],
 "."
}], "ExampleText",
 CellID->1694715545,ExpressionUUID->"1c47abd5-a24b-4db8-bb39-52a27db93983"],

Cell[BoxData[
 RowBox[{"DefineGaugeGroup", "[", 
