Cell["Defining a scalar field:", "ExampleText",
 CellID->1689732516,ExpressionUUID->"360deeea-ffb6-4728-9e66-0041badcaf2e"],

Cell[BoxData[
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar"}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->892576249,ExpressionUUID->"8898bd59-95ef-4cd5-a6a0-c6fee0b52f9d"],

Cell[TextData[{
 "Since the scalars does not transform under any gauge group, the covariant \
derivative is equivalent to a partial derivative here ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    SubscriptBox["D", "\[Mu]"], "=", 
    SubscriptBox["\[PartialD]", "\[Mu]"]}], ")"}]], "InlineFormula",
  ExpressionUUID->"3d1ccbe6-a61b-4134-9b6a-503fc9f9e7e1"],
 "."
}], "ExampleText",
 CellID->598551098,ExpressionUUID->"435c0d32-cabb-45e5-a983-2d1961d9fd6e"],

Cell["Apply a single derivative to one field:", "ExampleText",
 CellID->2112015424,ExpressionUUID->"ace2afc2-6101-4415-84f1-4fcb87499b26"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"CD", "[", 
  RowBox[{"\[Mu]", ",", 
   RowBox[{"\[Phi]", "[", "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[3]:=",
 CellID->2068589498,ExpressionUUID->"20297820-f9e5-4313-93cc-13dd3a2eb054"],

Cell[BoxData[
 RowBox[{"Field", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"Index", "[", 
     RowBox[{"\[Mu]", ",", "Lorentz"}], "]"}], "}"}]}], "]"}]], "Output",
 CellLabel->"Out[3]=",
