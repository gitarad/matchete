Cell[BoxData[
 RowBox[{"Field", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Index", "[", 
      RowBox[{"\[Mu]", ",", "Lorentz"}], "]"}], ",", 
     RowBox[{"Index", "[", 
      RowBox[{"\[Nu]", ",", "Lorentz"}], "]"}]}], "}"}]}], "]"}]], "Output",
 CellLabel->"Out[5]=",
