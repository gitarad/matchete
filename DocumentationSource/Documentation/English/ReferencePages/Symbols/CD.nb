 FormBox[
  StyleBox[
   RowBox[{
    FormBox[
     StyleBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         OverscriptBox["\[Psi]", 
          StyleBox["_",
           FontWeight->Bold]], 
         StyleBox["a",
          FontSize->10]], "\[CenterDot]", 
        TemplateBox[{
          SubscriptBox["D", "\[Mu]"], 
          SuperscriptBox["\[Psi]", 
           StyleBox["a", FontSize -> 10]]},
         "RowDefault"]}], ")"}],
      SpanSymmetric->False],
     StandardForm], "+", 
    FormBox[
     StyleBox[
      RowBox[{"(", 
       RowBox[{
        TemplateBox[{
          SubscriptBox["D", "\[Mu]"], 
          SubscriptBox[
           OverscriptBox["\[Psi]", 
            StyleBox["_", FontWeight -> Bold]], 
           StyleBox["a", FontSize -> 10]]},
         "RowDefault"], "\[CenterDot]", 
        SuperscriptBox["\[Psi]", 
         StyleBox["a",
          FontSize->10]]}], ")"}],
      SpanSymmetric->False],
