Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CD", "[", 
   RowBox[{"\[Mu]", ",", 
    RowBox[{
     RowBox[{"Bar", "@", 
      RowBox[{"\[Psi]", "[", "a", "]"}]}], "**", 
     RowBox[{"\[Psi]", "[", "a", "]"}]}]}], "]"}], "//", 
  "NiceForm"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->165828746,ExpressionUUID->"2fdec7b6-663c-40ca-8336-d50c806dec26"],

