 CellID->1621713221,ExpressionUUID->"1de55b88-52b6-4797-bdb7-3f614cdc3100"],

Cell[TextData[{
 "Covariant derivatives always apply the product rule. Therefore, the Warsaw \
basis operator ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"H", "\[ConjugateTranspose]"}], "H"}], ")"}], 
    RowBox[{"\[Square]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"H", "\[ConjugateTranspose]"}], "H"}], ")"}]}]}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"H", "\[ConjugateTranspose]"}], "H"}], ")"}], 
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"H", "\[ConjugateTranspose]"}], "H"}], ")"}]}]}]}]], 
  "InlineFormula",ExpressionUUID->"8da7f4cd-df36-4d5c-bb87-d92203e05a88"],
 " cannot be kept in its unevaluated form in Matchete."
}], "ExampleText",
 CellID->2142227926,ExpressionUUID->"e40f3f34-276d-4e3e-80f1-ec01527a43e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalL]SM", "=", 
   RowBox[{"LoadModel", "[", "\"\<SM\>\"", "]"}]}], ";"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->1051257730,ExpressionUUID->"42139e24-fa96-4383-920a-6db5f83a4f13"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Bar", "@", 
      RowBox[{"H", "[", "i", "]"}]}], 
     RowBox[{"H", "[", "i", "]"}]}], ")"}], 
   RowBox[{"CD", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Mu]", ",", "\[Mu]"}], "}"}], ",", 
     RowBox[{
      RowBox[{"Bar", "@", 
       RowBox[{"H", "[", "j", "]"}]}], 
      RowBox[{"H", "[", "j", "]"}]}]}], "]"}]}], "//", "NiceForm"}]], "Input",\

 CellLabel->"In[9]:=",
 CellID->1930219940,ExpressionUUID->"f918c57a-356d-44a9-b4bf-816ac17ceb13"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{" ", 
    RowBox[{
     FormBox[
      StyleBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          TemplateBox[{
            SuperscriptBox["D", 2], 
            SubscriptBox[
             OverscriptBox["H", 
              StyleBox["_", FontWeight -> Bold]], 
             StyleBox["j", FontSize -> 10]]},
           "RowDefault"], 
          SuperscriptBox["H", 
           StyleBox["j",
            FontSize->10]]}], "+", 
         RowBox[{"2", 
          TemplateBox[{
            SubscriptBox["D", "\[Mu]"], 
            SubscriptBox[
             OverscriptBox["H", 
              StyleBox["_", FontWeight -> Bold]], 
             StyleBox["j", FontSize -> 10]]},
           "RowDefault"], 
          TemplateBox[{
            SubscriptBox["D", "\[Mu]"], 
            SuperscriptBox["H", 
             StyleBox["j", FontSize -> 10]]},
           "RowDefault"]}], "+", 
         RowBox[{
          SubscriptBox[
           OverscriptBox["H", 
            StyleBox["_",
             FontWeight->Bold]], 
           StyleBox["j",
            FontSize->10]], 
          TemplateBox[{
            SuperscriptBox["D", 2], 
            SuperscriptBox["H", 
             StyleBox["j", FontSize -> 10]]},
           "RowDefault"]}]}], ")"}],
       SpanSymmetric->False],
      StandardForm], 
     SubscriptBox[
      OverscriptBox["H", 
       StyleBox["_",
        FontWeight->Bold]], 
      StyleBox["i",
       FontSize->10]], 
     SuperscriptBox["H", 
      StyleBox["i",
       FontSize->10]]}]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[9]//NiceForm=",
