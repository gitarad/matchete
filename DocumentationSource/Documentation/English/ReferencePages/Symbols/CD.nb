Cell[CellGroupData[{
Cell["CD", "ObjectName",
 CellID->1066309793,ExpressionUUID->"1c5e038d-326a-46a5-b45a-1968899f6f16"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9d7726bb-ba8d-4f46-a563-1eb5e080755f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CD",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/CD"], "[", 
   RowBox[{
    StyleBox["ind", "TI"], ",", 
    StyleBox["expr", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e374a48c-c4d0-48bd-acba-bc3dfb3317fb"],
 "\[LineSeparator]returns the covariant derivative(s) of a given expression \
",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "c279e2f0-3d82-4757-aca4-a6f96982c9d1"],
 ". The argument ",
 Cell[BoxData[
  StyleBox["ind", "TI"]], "InlineFormula",ExpressionUUID->
  "08023fa2-c9a8-45e4-afd7-8dde8e127357"],
 " can either be a single ",
 Cell[BoxData[
  ButtonBox["Lorentz",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Lorentz"]], "InlineFormula",
  ExpressionUUID->"d954fcc2-4f88-4720-92ae-ac42e7ba5f4a"],
 " index or a list of ",
 Cell[BoxData[
  ButtonBox["Lorentz",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Lorentz"]], "InlineFormula",
  ExpressionUUID->"7a5c76c3-8565-49aa-8b9c-3715a0b97200"],
 " indices."
}], "Usage",
 CellID->717656736,ExpressionUUID->"670f4168-77e2-4c4d-a6dd-2ca68d31ba31"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["CD",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/CD"]], "InlineFormula",ExpressionUUID->
  "5c6fbddf-f87f-410a-80a3-7399af957d88"],
 " automatically distributes over sums and applies the product rule."
}], "Notes",
 CellID->1388600400,ExpressionUUID->"981528f3-147c-49a0-9532-8c172c6497b3"],

Cell["\<\
The exact representation of the covariant derivative is only implicitly \
defined through the gauge quantum numbers of single field or composite \
operator that the derivative is acting on.\
\>", "Notes",
 CellID->1163606804,ExpressionUUID->"84a01b55-07c1-4ec2-ae9c-062e59e27e3f"],

Cell[TextData[{
 "When acting on a single instance of ",
 Cell[BoxData[
  ButtonBox["Field",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Field"]], "InlineFormula",ExpressionUUID->
  "bcadfe29-cbb6-4654-8c77-06c6fdb6e5d5"],
 " the the ",
 Cell[BoxData[
  ButtonBox["CD",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/CD"]], "InlineFormula",ExpressionUUID->
  "ce54ce85-ce98-47e1-b28b-6aafd8c02bee"],
 " head will disappear and its indices will be added to the last argument of \
the ",
 Cell[BoxData[
  ButtonBox["Field",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Field"]], "InlineFormula",ExpressionUUID->
  "c5863adc-a432-4e2d-a19f-b073b6f77630"],
 "."
}], "Notes",
 CellID->602002137,ExpressionUUID->"6ecaa8fd-c198-40e8-851e-0720ba409e44"]
}, Open  ]],

