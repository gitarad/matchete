Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CD", "[", 
   RowBox[{"\[Mu]", ",", 
    RowBox[{"\[Psi]", "[", "a", "]"}]}], "]"}], "//", "NiceForm"}]], "Input",
 CellLabel->"In[4]:=",
