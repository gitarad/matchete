Notebook[{

Cell[CellGroupData[{
Cell["ReductionIdentities", "ObjectName",
 CellID->506646271,ExpressionUUID->"24a4a41e-9b5c-4256-9fb4-18abc888da72"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4fab8805-9ce3-46fa-952b-58b8ef32a305"],
 Cell[BoxData[
  ButtonBox["ReductionIdentities",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/ReductionIdentities"]], "InlineFormula",
  ExpressionUUID->"1eec8044-b557-4be6-b0f0-b24cc36b9e98"],
 "\[LineSeparator]is an option used in simplification functions."
}], "Usage",
 CellID->431216342,ExpressionUUID->"ad4aee88-9b87-4b8a-b40e-e4576b543718"],

Cell[TextData[{
 "The option values for ",
 Cell[BoxData[
  ButtonBox["ReductionIdentities",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/ReductionIdentities"]], "InlineFormula",
  ExpressionUUID->"76907be5-3e01-479b-9d13-7a7fd9e154bb"],
 " are\n",
 Cell[BoxData[GridBox[{
    {Cell[
     "      ", "ModInfo",ExpressionUUID->
      "638ef9c5-b6a7-4283-83bb-14ab9dc125b5"], 
     ButtonBox["dDimensional",
      BaseStyle->"Link",
      ButtonData->"paclet:Matchete/ref/dDimensional"], Cell["\<\
applies only simplification identities that are strictly valid in \
\[ScriptD]-dimensional space time. \
\>", "TableText",ExpressionUUID->"fdba6e52-fcd1-4186-9402-f9a822211b0b"]},
    {Cell[
     "      ", "ModInfo",ExpressionUUID->
      "e7c80bf5-1157-4b3d-9250-95e59ceb303f"], 
     ButtonBox["EvanescenceFree",
      BaseStyle->"Link",
      ButtonData->"paclet:Matchete/ref/EvanescenceFree"], Cell[TextData[{
      "reduces operators to a physical (four-dimensional) basis using the \
evanescent prescription and then performs a finite evanescent shift to remove \
resulting evanescent operators. This option requires that the imput is a ",
      StyleBox["full valid Lagrangian",
       FontWeight->"Bold"],
      " and not just a part.  "
     }], "TableText",ExpressionUUID->
      "bee53a1b-3751-4d61-9780-28f74a20980b"]},
    {Cell[
     "      ", "ModInfo",ExpressionUUID->
      "81c5284f-e161-44f5-af96-70c8a357a394"], 
     ButtonBox["Evanescent",
      BaseStyle->"Link",
      ButtonData->"paclet:Matchete/ref/Evanescent"], Cell["\<\
reduces operators to a physical (four-dimensional) basis using the evanescent \
prescription. The resulting evanescent operators are kept in the output. \
\>", "TableText",ExpressionUUID->"2b6f789f-7f9f-46b9-8dba-056548007554"]},
    {Cell[
     "      ", "ModInfo",ExpressionUUID->
      "34361391-51a4-4a09-b20c-758042991851"], 
     ButtonBox["FourDimensional",
      BaseStyle->"Link",
      ButtonData->"paclet:Matchete/ref/FourDimensional"], Cell[TextData[{
      "simplifies with four-dimensional identities. This is ",
      StyleBox["incompatible with other \[ScriptD]-dimensional calculations",
       FontWeight->"Bold"],
      ", such as one-loop matching."
     }], "TableText",ExpressionUUID->"e6bf7c33-072c-4c40-957c-b6ba4ef157a5"]}
   }]], "2ColumnTableMod",ExpressionUUID->
  "5141c73c-9377-4ca3-bb3d-117588e6fda5"]
}], "Notes",
 CellID->1843235016,ExpressionUUID->"461db208-a3e9-45c3-9ccb-6625834a956b"]
}, Open  ]],

