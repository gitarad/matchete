Cell["\<\
By default, the function notifies the user of the progress as well as \
replacements of effective couplings:\
\>", "ExampleText",
 CellID->2021160431,ExpressionUUID->"50a41631-eaf3-4f35-ad37-d72b26f60d38"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}], ",", 
   RowBox[{"Mass", "\[Rule]", "Light"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"\[CapitalLambda]", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EOMSimplify", "[", " ", 
   RowBox[{
    RowBox[{"FreeLag", "[", "]"}], "+", 
    RowBox[{"hbar", " ", 
     SuperscriptBox[
      RowBox[{"\[CapitalLambda]", "[", "]"}], "2"], 
     SuperscriptBox[
      RowBox[{"\[Phi]", "[", "]"}], "2"]}]}], "]"}], ";"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->1943649192,ExpressionUUID->"653b0769-9b06-42c7-a492-0b61cefd2ef3"],

Cell[BoxData["\<\"The Lagrangian contains terms of lower power than dimension \
4. Defining effective couplings and assuming these terms to be dimension 4. \
Use 'PrintEffectiveCouplings' and 'ReplaceEffectiveCouplings' to recover \
explicit expressions.\"\>"], "Echo",
 CellID->308803503,ExpressionUUID->"6778f0fd-bd6f-4af2-92ba-68dd6805b48a"]
}, Open  ]],

