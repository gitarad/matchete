Cell[BoxData[{
 RowBox[{"ResetAll", "[", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LSM", "=", 
   RowBox[{"LoadModel", "[", "\"\<SM\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"c1", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DefineCoupling", "[", 
   RowBox[{"c2", ",", 
    RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"NiceForm", "[", 
  RowBox[{"\[Delta]\[ScriptCapitalL]", "=", 
   RowBox[{"RelabelIndices", "[", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"c1", "[", "]"}], 
      RowBox[{
       RowBox[{"Bar", "@", 
        RowBox[{"u", "[", 
         RowBox[{"a", ",", "i"}], "]"}]}], "**", 
       RowBox[{"\[Gamma]", "[", "\[Mu]", "]"}], "**", 
       RowBox[{"d", "[", 
        RowBox[{"b", ",", "j"}], "]"}]}], " ", 
      RowBox[{
       RowBox[{"Bar", "@", 
        RowBox[{"d", "[", 
         RowBox[{"b", ",", "j"}], "]"}]}], "**", 
       RowBox[{"\[Gamma]", "[", "\[Mu]", "]"}], "**", 
       RowBox[{"u", "[", 
        RowBox[{"a", ",", "i"}], "]"}]}]}], "+", 
     RowBox[{
      RowBox[{"c2", "[", "]"}], 
      RowBox[{
       RowBox[{"Bar", "@", 
        RowBox[{"u", "[", 
         RowBox[{"a", ",", "i"}], "]"}]}], "**", 
       RowBox[{"\[Gamma]", "[", "\[Mu]", "]"}], "**", "PR", "**", 
       RowBox[{"u", "[", 
        RowBox[{"a", ",", "i"}], "]"}]}], " ", 
      RowBox[{"CD", "[", 
       RowBox[{"\[Nu]", ",", 
        RowBox[{"FS", "[", 
         RowBox[{"B", ",", "\[Mu]", ",", "\[Nu]"}], "]"}]}], "]"}]}]}], 
    "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalL]", "=", 
   RowBox[{"LSM", "+", "\[Delta]\[ScriptCapitalL]"}]}], ";"}]}], "Input",
