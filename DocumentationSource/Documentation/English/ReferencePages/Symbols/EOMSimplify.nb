Cell["\<\
Lagrangians need kinetic terms for the occuring fields for field \
redefinitions to be successful:\
\>", "ExampleText",
 CellID->207226270,ExpressionUUID->"57483358-3011-4ab7-97b6-3a53ae17070d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}], ",", 
   RowBox[{"Mass", "\[Rule]", "Light"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"\[Lambda]", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"c1", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"c2", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"EOMSimplify", "[", 
  RowBox[{
   RowBox[{"c2", "[", "]"}], " ", 
   SuperscriptBox[
    RowBox[{"\[Phi]", "[", "]"}], "3"], 
   RowBox[{"CD", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Mu]", ",", "\[Mu]"}], "}"}], ",", 
     RowBox[{"\[Phi]", "[", "]"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->925675708,ExpressionUUID->"4276b4fc-c36d-4016-90fd-86cb02ea3704"],

Cell[BoxData[
 TemplateBox[{
  "EOMSimplify", "InvalidLagrangian", 
   "\"The Lagrangian contains no valid kinetic terms for the occuring Kinetic \
terms and thus cannot be simplified.\"", 2, 5, 1, 27248410457881973495, 
   "Local", "Matchete`EOMSimplify"},
  "MessageTemplate2"]], "Message", "MSG",
 CellLabel->"During evaluation of In[1]:=",
 CellID->225231694,ExpressionUUID->"409d2cdc-249a-f64c-94c7-aa8ef0c4c59e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Coupling", "[", 
   RowBox[{"c2", ",", 
    RowBox[{"{", "}"}], ",", "0"}], "]"}], " ", 
  SuperscriptBox[
   RowBox[{"Field", "[", 
    RowBox[{"\[Phi]", ",", "Scalar", ",", 
     RowBox[{"{", "}"}], ",", 
     RowBox[{"{", "}"}]}], "]"}], "3"], " ", 
  RowBox[{"Field", "[", 
   RowBox[{"\[Phi]", ",", "Scalar", ",", 
    RowBox[{"{", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Index", "[", 
       RowBox[{"\[Mu]", ",", "Lorentz"}], "]"}], ",", 
      RowBox[{"Index", "[", 
       RowBox[{"\[Mu]", ",", "Lorentz"}], "]"}]}], "}"}]}], "]"}]}]], "Output",\

 CellLabel->"Out[5]=",
 CellID->329758107,ExpressionUUID->"3331d04f-cda0-3b4a-a10e-6c57659303fe"]
}, Open  ]],

