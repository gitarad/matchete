Cell["\<\
Defining a real scalar theory with one redundant operator at dimension 6\
\>", "ExampleText",
 CellID->449174267,ExpressionUUID->"106d133e-6698-4dd2-802e-6a033aee3f55"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}], ",", 
   RowBox[{"Mass", "\[Rule]", "Light"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"\[Lambda]", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"c1", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"c2", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalL]", " ", "=", " ", 
   RowBox[{
    RowBox[{"FreeLag", "[", "]"}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"\[Lambda]", "[", "]"}], 
      RowBox[{"4", "!"}]], 
     SuperscriptBox[
      RowBox[{"\[Phi]", "[", "]"}], "4"]}], "+", 
    RowBox[{
     RowBox[{"c1", "[", "]"}], 
     SuperscriptBox[
      RowBox[{"\[Phi]", "[", "]"}], "6"]}], "+", 
    RowBox[{
     RowBox[{"c2", "[", "]"}], " ", 
     SuperscriptBox[
      RowBox[{"\[Phi]", "[", "]"}], "3"], 
     RowBox[{"CD", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Mu]", ",", "\[Mu]"}], "}"}], ",", 
       RowBox[{"\[Phi]", "[", "]"}]}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"NiceForm", "[", "\[ScriptCapitalL]", "]"}]}], "Input",
 CellLabel->"In[68]:=",
 CellID->1544174255,ExpressionUUID->"2aa0494c-a8bc-444b-a7c2-08f4412d1e33"],

Cell[BoxData[
 RowBox[{
  FormBox[
   RowBox[{
    FormBox[
     FractionBox["1", "2"],
     StandardForm], 
    SuperscriptBox[
     FormBox[
      StyleBox[
       RowBox[{"(", 
        FormBox[
         TagBox[
          FormBox[
           TemplateBox[{
             SubscriptBox["D", 
              StyleBox[
               TagBox[
                FormBox[
                 FormBox[
                  StyleBox["\"\[Mu]\"", 10, StripOnInput -> False], 
                  Matchete`NiceForm], Matchete`NiceForm], 
                Format[#, Matchete`NiceForm]& ], FontSize -> 12, StripOnInput -> 
               False]], 
             TagBox[
              FormBox["\[Phi]", StandardForm], StandardForm, Editable -> 
              True]},
            "RowDefault"],
           StandardForm],
          StandardForm,
          Editable->True],
         Matchete`NiceForm], ")"}],
       SpanSymmetric->False],
      StandardForm], "2"]}],
   StandardForm], "-", 
  FormBox[
   RowBox[{
    FormBox[
     FractionBox["1", "2"],
     StandardForm], 
    SuperscriptBox[
     FormBox[
      TagBox[
       FormBox["m\[Phi]",
        StandardForm],
       StandardForm,
       Editable->True],
      Matchete`NiceForm], 
     FormBox["2",
      StandardForm]], 
    SuperscriptBox[
     FormBox[
      TagBox[
       FormBox["\[Phi]",
        StandardForm],
       StandardForm,
       Editable->True],
      Matchete`NiceForm], "2"]}],
   StandardForm], "+", 
  FormBox[
   RowBox[{
    FormBox[
     FractionBox["1", "24"],
     StandardForm], 
    FormBox[
     TagBox[
      FormBox["\[Lambda]",
       StandardForm],
      StandardForm,
      Editable->True],
     Matchete`NiceForm], 
    SuperscriptBox[
     FormBox[
      TagBox[
       FormBox["\[Phi]",
        StandardForm],
       StandardForm,
       Editable->True],
      Matchete`NiceForm], "4"]}],
   StandardForm], "+", 
  FormBox[
   RowBox[{
    FormBox[
     TagBox[
      FormBox["c1",
       StandardForm],
      StandardForm,
      Editable->True],
     Matchete`NiceForm], 
    SuperscriptBox[
     FormBox[
      TagBox[
       FormBox["\[Phi]",
        StandardForm],
       StandardForm,
       Editable->True],
      Matchete`NiceForm], "6"]}],
   StandardForm], "+", 
  FormBox[
   RowBox[{
    FormBox[
     TagBox[
      FormBox["c2",
       StandardForm],
      StandardForm,
      Editable->True],
     Matchete`NiceForm], 
    FormBox[
     TagBox[
      FormBox[
       TemplateBox[{
         SuperscriptBox["D", "2"], 
         TagBox[
          FormBox["\[Phi]", StandardForm], StandardForm, Editable -> True]},
        "RowDefault"],
       StandardForm],
      StandardForm,
      Editable->True],
     Matchete`NiceForm], 
    SuperscriptBox[
     FormBox[
      TagBox[
       FormBox["\[Phi]",
        StandardForm],
       StandardForm,
       Editable->True],
      Matchete`NiceForm], "3"]}],
   StandardForm]}]], "Output",
 CellLabel->"Out[73]//NiceForm=",
 CellID->1828571578,ExpressionUUID->"8369f64e-17ac-4be0-8896-53c9c4794b74"]
}, Open  ]],

Cell[TextData[{
 "Calling EOMSimplify on the Lagrangian removes the redundant operator, the \
coefficients of the ",
 Cell[BoxData[
  SuperscriptBox["\[Phi]", "4"]], "InlineFormula",ExpressionUUID->
  "9d86d34e-67fb-44bf-8742-b199029b2b80"],
 " and ",
 Cell[BoxData[
  SuperscriptBox["\[Phi]", "6"]], "InlineFormula",ExpressionUUID->
  "09bf2c2d-a522-4447-996c-5a42c9bb0b38"],
 " operators have changed:"
}], "ExampleText",
 CellID->1336788442,ExpressionUUID->"65c2b60b-1b65-4fd2-bb84-dad5f6387fde"],

