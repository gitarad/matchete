Cell["\<\
Defining a Yukawa theory with a light scalar and two heavy fermions, and \
integrating out the latter at one-loop:\
\>", "ExampleText",
 CellID->1095411968,ExpressionUUID->"9fb5e117-4d0a-463b-800e-f6f55924be1b"],

Cell[BoxData[{
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Psi]", ",", "Fermion", ",", 
   RowBox[{"Mass", "\[Rule]", "Heavy"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Chi]", ",", "Fermion", ",", 
   RowBox[{"Mass", "\[Rule]", "Heavy"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}], ",", 
   RowBox[{"Mass", "\[Rule]", "Light"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"\[Lambda]", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"y", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalL]UV", " ", "=", " ", 
   RowBox[{
    RowBox[{"FreeLag", "[", "]"}], "+", 
    RowBox[{"PlusHc", "[", 
     RowBox[{
      RowBox[{"y", "[", "]"}], 
      RowBox[{"\[Phi]", "[", "]"}], " ", 
      RowBox[{
       RowBox[{"Bar", "[", 
        RowBox[{"\[Psi]", "[", "]"}], "]"}], "**", 
       RowBox[{"\[Chi]", "[", "]"}]}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalL]Greens", "=", 
   RowBox[{"GreensSimplify", "[", 
    RowBox[{"Match", "[", "\[ScriptCapitalL]UV", "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[60]:=",
 CellID->621278059,ExpressionUUID->"e1a51069-daa0-422a-894e-2e49ef72b2e5"],

