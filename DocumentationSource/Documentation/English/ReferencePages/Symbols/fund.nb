Cell[TextData[{
 "The fundamental representation of a (gauge or global) group named ",
 StyleBox["G", "InlineCode"],
 " is referred to by ",
 StyleBox["G[", "InlineCode"],
 Cell[BoxData[
  ButtonBox["fund",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/fund"]], "InlineFormula",ExpressionUUID->
  "a1952af3-55b4-40e0-881c-a98838bd2f38"],
 StyleBox["]", "InlineCode"],
 ". The representation is automatically initialized with the group when using \
",
 Cell[BoxData[
  ButtonBox["DefineGaugeGroup",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DefineGaugeGroup"]], "InlineFormula",
  ExpressionUUID->"ce4cdbe6-f8ab-4fd4-9a36-7243f7543c6d"],
 " and ",
 Cell[BoxData[
  ButtonBox["DefineGlobalGroup",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DefineGlobalGroup"]], "InlineFormula",
  ExpressionUUID->"528ca05d-5d2b-40d3-9ac6-dd2b88d3fcfd"],
 ".  "
}], "Notes",
 CellID->529215859,ExpressionUUID->"35379fa2-7065-4cfb-9c1a-ce55eab8e503"]
