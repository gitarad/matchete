Cell[TextData[{
 "If we initialize a new symmetry group Gr, its fundamental representation is \
referred to as Gr[adj]. This is seen here in the ",
 Cell[BoxData[
  ButtonBox["Index",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/Index"]], "InlineFormula",ExpressionUUID->
  "418efbe9-9e7b-486f-a447-86ff89c3ab9f"],
 " labels of the generator of the fundamental representation in the internal \
Matchete form:"
}], "ExampleText",
 CellID->63602367,ExpressionUUID->"a17e101a-9b3f-4b5b-8bd1-acb5b717b495"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefineGlobalGroup", "[", 
   RowBox[{"Gr", ",", 
    RowBox[{"SU", "@", "3"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gen", "[", 
   RowBox[{"Gr", "@", "fund"}], "]"}], "[", 
  RowBox[{"A", ",", "i", ",", "j"}], "]"}]}], "Input",
 CellLabel->"In[12]:=",
 CellID->950104424,ExpressionUUID->"46d94fd6-29bb-42ec-a681-cc2a5e3f81b2"],

Cell[BoxData[
 RowBox[{"CG", "[", 
  RowBox[{
   RowBox[{"gen", "[", 
    RowBox[{"Gr", "[", "fund", "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Index", "[", 
      RowBox[{"A", ",", 
       RowBox[{"Gr", "[", "adj", "]"}]}], "]"}], ",", 
     RowBox[{"Index", "[", 
      RowBox[{"i", ",", 
       RowBox[{"Gr", "[", "fund", "]"}]}], "]"}], ",", 
     RowBox[{"Bar", "[", 
      RowBox[{"Index", "[", 
       RowBox[{"j", ",", 
        RowBox[{"Gr", "[", "fund", "]"}]}], "]"}], "]"}]}], "}"}]}], 
  "]"}]], "Output",
 CellLabel->"Out[13]=",
 CellID->1430584310,ExpressionUUID->"0645422d-412d-48b1-9aab-4a24438c196f"]
}, Open  ]]
}, Open  ]],

