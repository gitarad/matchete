Cell[TextData[{
 "If we initialize a new SU(4) group ",
 StyleBox["Gr", "InlineCode"],
 ", ",
 StyleBox["dSym[Gr]", "InlineCode"],
 " will refer to the three-index symmetric CG and can be used as shorthand to \
input the ",
 Cell[BoxData[
  ButtonBox["CG",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/CG"]], "InlineFormula",ExpressionUUID->
  "0c73ebdb-f52e-44c0-9d3e-57148d3159bd"],
 ":"
}], "ExampleText",
 CellID->63602367,ExpressionUUID->"87312cf4-1af2-4dce-86e5-32161fe31880"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefineGlobalGroup", "[", 
   RowBox[{"Gr", ",", 
    RowBox[{"SU", "@", "4"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dSym", "[", "Gr", "]"}], "[", 
  RowBox[{"a", ",", "b", ",", "c"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[17]:=",
 CellID->950104424,ExpressionUUID->"6df0a6de-4417-4eeb-ba79-40da8866596f"],

Cell[BoxData[
 RowBox[{"CG", "[", 
  RowBox[{
   RowBox[{"dSym", "[", "Gr", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Index", "[", 
      RowBox[{"a", ",", 
       RowBox[{"Gr", "[", "adj", "]"}]}], "]"}], ",", 
     RowBox[{"Index", "[", 
      RowBox[{"b", ",", 
       RowBox[{"Gr", "[", "adj", "]"}]}], "]"}], ",", 
     RowBox[{"Index", "[", 
      RowBox[{"c", ",", 
       RowBox[{"Gr", "[", "adj", "]"}]}], "]"}]}], "}"}]}], "]"}]], "Output",
 CellLabel->"Out[18]=",
 CellID->1130422405,ExpressionUUID->"f70a747d-903f-461b-bc57-7fb1c00850e9"],

Cell[BoxData[
 FormBox[
