Cell[TextData[{
 "If we initialize a new SU(4) group ",
 StyleBox["Gr", "InlineCode"],
 ", ",
 StyleBox["tFundf[Gr]", "InlineCode"],
 " will refer to the three-index symmetric CG and can be used as shorthand to \
input the ",
 Cell[BoxData[
  ButtonBox["CG",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/CG"]], "InlineFormula",ExpressionUUID->
  "721bfed9-a3b2-4fda-bc50-dd3b4852d310"],
 ":"
}], "ExampleText",
 CellID->63602367,ExpressionUUID->"b06cd2b8-d8f4-4179-b7f6-47cfbdbb70ca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefineGlobalGroup", "[", 
   RowBox[{"Gr", ",", 
    RowBox[{"SU", "@", "4"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tFundf", "[", "Gr", "]"}], "[", 
  RowBox[{"i", ",", "j", ",", "A", ",", "B"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[3]:=",
 CellID->950104424,ExpressionUUID->"04954458-64f2-41c2-908b-19773afa5eb8"],

Cell[BoxData[
 RowBox[{"CG", "[", 
  RowBox[{
   RowBox[{"tFundf", "[", "Gr", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Index", "[", 
      RowBox[{"i", ",", 
       RowBox[{"Gr", "[", "fund", "]"}]}], "]"}], ",", 
     RowBox[{"Bar", "[", 
      RowBox[{"Index", "[", 
       RowBox[{"j", ",", 
        RowBox[{"Gr", "[", "fund", "]"}]}], "]"}], "]"}], ",", 
     RowBox[{"Index", "[", 
      RowBox[{"A", ",", 
       RowBox[{"Gr", "[", "adj", "]"}]}], "]"}], ",", 
     RowBox[{"Index", "[", 
      RowBox[{"B", ",", 
       RowBox[{"Gr", "[", "adj", "]"}]}], "]"}]}], "}"}]}], "]"}]], "Output",
 CellLabel->"Out[4]=",
 CellID->1114265895,ExpressionUUID->"5435dbf1-c7b7-4572-8cb5-ce9977b42c71"],

Cell[BoxData[
 FormBox[
  StyleBox[
   SubsuperscriptBox[
    RowBox[{"tFundf", "[", "Gr", "]"}], 
    StyleBox["j",
     FontSize->10], 
    StyleBox[
     TemplateBox[{"i", "A", "B"},
      "RowDefault"],
     FontSize->10]], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[5]//NiceForm=",
 CellID->1409495425,ExpressionUUID->"09e3bccf-5338-4b75-9dac-ab5d57553704"]
}, Open  ]],

