   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Bar", "@", 
       RowBox[{"\[Phi]", "[", "a", "]"}]}], 
      RowBox[{"\[Phi]", "[", "a", "]"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Bar", "@", 
       RowBox[{"\[Phi]", "[", "b", "]"}]}], 
      RowBox[{"\[Phi]", "[", "b", "]"}]}], ")"}]}], "//", 
