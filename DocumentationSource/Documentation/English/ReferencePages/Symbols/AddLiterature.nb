Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cbdb42aa-dcab-480c-b840-1a31e6b0ea73"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AddLiterature",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/AddLiterature"], "[", 
   RowBox[{
    StyleBox["name", "TI"], ",", 
    StyleBox["info", "TI"], ",", 
    StyleBox["bibtex", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "67918d06-b5cd-4ab0-b411-fb3b4ff59f06"],
 "\[LineSeparator]adds a paper labeled by ",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",ExpressionUUID->
  "ebc1f737-96b8-4a28-9b10-516ebfdab933"],
 " to the list of references used by ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["SuggestBibliography",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/SuggestBibliography"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"68e579a9-ed91-40f2-86f7-db48b7824748"],
 ". The argument ",
 Cell[BoxData[
  StyleBox["info", "TI"]], "InlineFormula",ExpressionUUID->
  "91b2153a-2401-4d15-8a50-c376aea75095"],
 " provides a description of the paper and ",
 Cell[BoxData[
  StyleBox["bibtex", "TI"]], "InlineFormula",ExpressionUUID->
  "c531ef8d-32db-4d21-91c9-e96acd75af81"],
 " should give the corresponding ",
 Cell[BoxData[
  StyleBox["bibtex", "TI"]], "InlineFormula",ExpressionUUID->
  "75680e4b-425b-46c1-8558-d1a7d66ef24e"],
 " code."
}], "Usage",
