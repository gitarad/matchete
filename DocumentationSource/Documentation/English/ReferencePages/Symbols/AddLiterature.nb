Cell["Add the Supertracer paper to the literature list:", "ExampleText",
 CellID->1520171802,ExpressionUUID->"229f9781-15cb-4e68-b484-359c5c2a05bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AddLiterature", "[", "\n", 
   RowBox[{
   "\"\<SuperTracer\>\"", ",", "\n", "\"\<One-loop supertrace evaluation\>\"",
     ",", "\n", 
    "\"\<@article{Fuentes-Martin:2020udw,\n    author = {Fuentes-Martin, \
Javier and K{\\\\\\\"o}nig, Matthias and Pag{\\\\`e}s, Julie and Thomsen, \
Anders Eller and Wilsch, Felix},\n    title = \\\"{SuperTracer: A Calculator \
of Functional Supertraces for One-Loop EFT Matching}\\\",\n    eprint = \
\\\"2012.08506\\\",\n    archivePrefix = \\\"arXiv\\\",\n    primaryClass = \
\\\"hep-ph\\\",\n    reportNumber = \\\"MITP-20-076, TUM-HEP-1302/20, \
ZU-TH-54/20\\\",\n    doi = \\\"10.1007/JHEP04(2021)281\\\",\n    journal = \
\\\"JHEP\\\",\n    volume = \\\"04\\\",\n    pages = \\\"281\\\",\n    year = \
\\\"2021\\\"\n}\>\""}], "\n", "]"}], ";"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->1030493382,ExpressionUUID->"665385f4-9dbb-4af2-a1b6-784674b96750"],

