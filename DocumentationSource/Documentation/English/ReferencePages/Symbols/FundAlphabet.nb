Cell["\<\
Define a SU(3) gauge group with fundamental alphabet \"a\", \"b\", \
\"c\",\"d\":\
\>", "ExampleText",
 CellID->1520267031,ExpressionUUID->"9aa898a5-0f46-4716-97a6-16062d5d8c21"],

Cell[BoxData[
 RowBox[{"DefineGaugeGroup", "[", 
  RowBox[{"G", ",", 
   RowBox[{"SU", "@", "3"}], ",", "g", ",", "F", ",", "\[IndentingNewLine]", 
   "\t", 
   RowBox[{"FundAlphabet", "->", 
    RowBox[{"CharacterRange", "[", 
     RowBox[{"\"\<a\>\"", ",", "\"\<d\>\""}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->386109940,ExpressionUUID->"c2a80b91-e2a2-41aa-9f63-35d7455858fd"],

Cell["\<\
Define a field transforming under under adjoint of this gauge group:\
\>", "ExampleText",
 CellID->2050907684,ExpressionUUID->"36bf4411-c76f-444e-9650-1ef4a1657cb8"],

Cell[BoxData[
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", 
     RowBox[{"G", "[", "fund", "]"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->707681659,ExpressionUUID->"dea16440-6696-471a-9484-738bd3dec50c"],

Cell["NiceForm printing of the fields with given labels:", "ExampleText",
 CellID->1708077093,ExpressionUUID->"cd2eaafb-b56d-4ccd-ac7e-b9bd7c081072"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"expr", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Bar", "@", 
       RowBox[{"\[Phi]", "[", "i1", "]"}]}], 
      RowBox[{"\[Phi]", "[", "i1", "]"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Bar", "@", 
       RowBox[{"\[Phi]", "[", "i2", "]"}]}], 
      RowBox[{"\[Phi]", "[", "i2", "]"}]}], ")"}]}], "//", 
   "NiceForm"}]}]], "Input",
 CellLabel->"In[4]:=",
 CellID->1398012651,ExpressionUUID->"59c4870b-5efc-4114-b7ce-ac892bc72d57"],

