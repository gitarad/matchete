     OverscriptBox["\[Phi]", 
      StyleBox["_",
       FontWeight->Bold]], 
     StyleBox["i1",
      FontSize->10]], 
    SubscriptBox[
     OverscriptBox["\[Phi]", 
      StyleBox["_",
       FontWeight->Bold]], 
     StyleBox["i2",
      FontSize->10]], 
    SuperscriptBox["\[Phi]", 
