  RowBox[{"DefineGlobalGroup", "[", 
   RowBox[{"Gr", ",", 
    RowBox[{"SU", "@", "4"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eps", "[", "Gr", "]"}], "[", 
  RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[23]:=",
