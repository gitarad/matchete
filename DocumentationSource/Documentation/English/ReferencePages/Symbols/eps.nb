Cell[BoxData[
 RowBox[{"CG", "[", 
  RowBox[{
   RowBox[{"eps", "[", "Gr", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Index", "[", 
      RowBox[{"i", ",", 
       RowBox[{"Gr", "[", "fund", "]"}]}], "]"}], ",", 
     RowBox[{"Index", "[", 
      RowBox[{"j", ",", 
       RowBox[{"Gr", "[", "fund", "]"}]}], "]"}], ",", 
     RowBox[{"Index", "[", 
      RowBox[{"k", ",", 
       RowBox[{"Gr", "[", "fund", "]"}]}], "]"}], ",", 
     RowBox[{"Index", "[", 
      RowBox[{"l", ",", 
       RowBox[{"Gr", "[", "fund", "]"}]}], "]"}]}], "}"}]}], "]"}]], "Output",\

 CellLabel->"Out[24]=",
 CellID->1608464890,ExpressionUUID->"39da77a4-50e7-4676-8be0-23c54d0b0570"],

