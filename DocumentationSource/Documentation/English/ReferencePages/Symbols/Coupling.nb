Cell["\<\
Defining a real coupling scaling like 0 powers of the light mass scale:\
\>", "ExampleText",
 CellID->1031713317,ExpressionUUID->"62d5776b-a760-4a15-8bbc-555fe4b181c3"],

Cell[BoxData[
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"\[Kappa]", ",", 
   RowBox[{"SelfConjugate", "->", "True"}], ",", 
   RowBox[{"EFTOrder", "->", "0"}]}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->2130447812,ExpressionUUID->"4ac8f441-bee6-44fc-becf-3c50d091fc9a"],

Cell["\<\
Afterwards, couplings can be easily written down by writing down their label:\
\
\>", "ExampleText",
 CellID->1066741629,ExpressionUUID->"445759c4-65a3-4c0d-99ed-ba1287257ee4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"\[Kappa]", "[", "]"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[4]:=",
 CellID->1969838974,ExpressionUUID->"2d6ce7b2-f116-433d-9c25-8c2b6cba3669"],

Cell[BoxData[
 RowBox[{"Coupling", "[", 
  RowBox[{"\[Kappa]", ",", 
   RowBox[{"{", "}"}], ",", "0"}], "]"}]], "Output",
 CellLabel->"Out[4]=",
 CellID->1637794343,ExpressionUUID->"bf157187-1823-4de2-9086-e0d25c010440"],

Cell[BoxData[
 FormBox[
  StyleBox["\[Kappa]", "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[5]//NiceForm=",
 CellID->2111619202,ExpressionUUID->"4f303ef6-c746-4beb-8714-50bb8d1e16b9"]
}, Open  ]],

