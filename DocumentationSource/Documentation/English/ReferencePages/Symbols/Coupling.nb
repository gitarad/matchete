Cell["A coupling with flavor indices can be defined by:", "ExampleText",
 CellID->740222126,ExpressionUUID->"eb1e1f40-314d-4fff-ad54-6e78fc0b2e78"],

Cell[BoxData[
 RowBox[{"DefineFlavorIndex", "[", 
  RowBox[{"Flavor", ",", "3", ",", 
   RowBox[{"IndexAlphabet", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<p\>\"", ",", "\"\<r\>\"", ",", "\"\<s\>\"", ",", "\"\<t\>\""}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->844880014,ExpressionUUID->"69ed7d29-ca5d-4e0f-b300-392e01493acb"],

Cell[BoxData[
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"\[Lambda]", ",", 
   RowBox[{"Indices", "->", 
    RowBox[{"{", 
     RowBox[{"Flavor", ",", "Flavor"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->647651927,ExpressionUUID->"5a979f85-0dd9-4a30-9482-78f893b8280e"],

Cell["This coupling can be obtained with the short-cut:", "ExampleText",
 CellID->1079984434,ExpressionUUID->"7cc83dda-78e3-443a-9b73-bf480fbcefc1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"\[Lambda]", "[", 
  RowBox[{"i", ",", "j"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[3]:=",
 CellID->12712384,ExpressionUUID->"a55cdf4a-62c8-41d2-8922-c7b585a5f9e7"],

Cell[BoxData[
 RowBox[{"Coupling", "[", 
  RowBox[{"\[Lambda]", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Index", "[", 
      RowBox[{"i", ",", "Flavor"}], "]"}], ",", 
     RowBox[{"Index", "[", 
      RowBox[{"j", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], 
  "]"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->704927707,ExpressionUUID->"2cd7305f-b0f5-4728-bdc8-04ecd898aa56"],

Cell[BoxData[
 FormBox[
  StyleBox[
   SuperscriptBox["\[Lambda]", 
    StyleBox[
     TemplateBox[{"i", "j"},
      "RowDefault"],
     FontSize->10]], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[4]//NiceForm=",
 CellID->52691050,ExpressionUUID->"c6c59e0d-2aa4-44c5-b4b8-b55092e3c595"]
}, Open  ]],

