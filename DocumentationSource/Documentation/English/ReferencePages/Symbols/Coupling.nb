Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox["\[Lambda]", 
      StyleBox["_",
       FontWeight->Bold]], 
     StyleBox[
      TemplateBox[{"p", "r"},
       "RowDefault"],
      FontSize->10]], 
    SuperscriptBox["\[Lambda]", 
     StyleBox[
      TemplateBox[{"p", "r"},
       "RowDefault"],
      FontSize->10]]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[5]//NiceForm=",
 CellID->1743852511,ExpressionUUID->"6d5d77d9-5cfa-47c9-a667-092b2bd88c5a"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

