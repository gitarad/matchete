Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Bar", "@", 
     RowBox[{"\[Lambda]", "[", 
      RowBox[{"i", ",", "j"}], "]"}]}], 
    RowBox[{"\[Lambda]", "[", 
     RowBox[{"i", ",", "j"}], "]"}]}], "//", "RelabelIndices"}], "//", 
  "NiceForm"}]], "Input",
 CellLabel->"In[5]:=",
