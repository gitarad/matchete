 CellID->2110595118,ExpressionUUID->"ce5ed00e-a989-493a-94a4-76ec358035f1"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    SubsuperscriptBox["E1", 
     TemplateBox[{
       SuperscriptBox["e", "2"], 
       SuperscriptBox[
        OverscriptBox["e", 
         StyleBox["_", FontWeight -> Bold]], "2"]},
      "RowDefault"], 
     StyleBox[
      TemplateBox[{"r", "t", "p", "s"},
       "RowDefault"],
      FontSize->10]], "-", 
    RowBox[{"8", 
     SubsuperscriptBox["E2", 
      TemplateBox[{
        SuperscriptBox["e", "2"], 
        SuperscriptBox[
         OverscriptBox["e", 
          StyleBox["_", FontWeight -> Bold]], "2"]},
       "RowDefault"], 
      StyleBox[
       TemplateBox[{"r", "t", "s", "p"},
        "RowDefault"],
       FontSize->10]]}], "+", 
    RowBox[{"8", " ", 
     FormBox[
      StyleBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FormBox[
           StyleBox[
            RowBox[{"(", 
             SuperscriptBox[
              OverscriptBox["e", 
               StyleBox["_",
                FontWeight->Bold]], 
              StyleBox["p",
               FontSize->10]], "\[CenterDot]", 
             RowBox[{
              SubscriptBox["\[Gamma]", 
               StyleBox["\[Mu]",
                FontSize->10]], 
              SubscriptBox["P", "R"]}], "\[CenterDot]", 
             SuperscriptBox["e", 
              StyleBox["t",
               FontSize->10]], ")"}],
            SpanSymmetric->False],
           StandardForm], 
          FormBox[
           StyleBox[
            RowBox[{"(", 
             SuperscriptBox[
              OverscriptBox["e", 
               StyleBox["_",
                FontWeight->Bold]], 
              StyleBox["s",
               FontSize->10]], "\[CenterDot]", 
             RowBox[{
              SubscriptBox["\[Gamma]", 
               StyleBox["\[Mu]",
                FontSize->10]], 
              SubscriptBox["P", "R"]}], "\[CenterDot]", 
             SuperscriptBox["e", 
              StyleBox["r",
               FontSize->10]], ")"}],
            SpanSymmetric->False],
           StandardForm]}], "+", 
         RowBox[{
          FormBox[
           StyleBox[
            RowBox[{"(", 
             SuperscriptBox[
              OverscriptBox["e", 
               StyleBox["_",
                FontWeight->Bold]], 
              StyleBox["p",
               FontSize->10]], "\[CenterDot]", 
             RowBox[{
              SubscriptBox["\[Gamma]", 
               StyleBox["\[Mu]",
                FontSize->10]], 
              SubscriptBox["P", "R"]}], "\[CenterDot]", 
             SuperscriptBox["e", 
              StyleBox["r",
               FontSize->10]], ")"}],
            SpanSymmetric->False],
           StandardForm], 
          FormBox[
           StyleBox[
            RowBox[{"(", 
             SuperscriptBox[
              OverscriptBox["e", 
               StyleBox["_",
                FontWeight->Bold]], 
              StyleBox["s",
               FontSize->10]], "\[CenterDot]", 
             RowBox[{
              SubscriptBox["\[Gamma]", 
               StyleBox["\[Mu]",
                FontSize->10]], 
              SubscriptBox["P", "R"]}], "\[CenterDot]", 
             SuperscriptBox["e", 
              StyleBox["t",
               FontSize->10]], ")"}],
            SpanSymmetric->False],
           StandardForm]}]}], ")"}],
       SpanSymmetric->False],
      StandardForm]}]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[51]//NiceForm=",
 CellID->1007007031,ExpressionUUID->"7d02178c-a462-4385-80fe-a4166b7535b1"]
}, Open  ]],

Cell[TextData[{
 "Here the physical basis has explicit symmetry in the r\[LeftRightArrow]t \
indices. This option often leaves remnant evanescent operators (E1, E2 \
above), which may or may not be relevant in further calculations. When \
simplifying an entire Lagrangian, the user will typically want to use the \
option ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ReductionIdentities",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/ReductionIdentities"], "\[Rule]", 
   ButtonBox["EvanescenceFree",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/EvanescenceFree"]}]], "InlineFormula",
  ExpressionUUID->"f4932feb-60ea-4ffe-9389-4be5af78b32d"],
 " to remove the evanescent operators in favor of a finite shift in the \
physical operator coefficients. "
}], "ExampleText",
 CellID->1687106792,ExpressionUUID->"a262abaa-3e4b-4331-a0bc-7b0a34c6a505"],

Cell[TextData[{
 "To obtain a strictly four-dimensional reduction (incompatible with \
\[ScriptD]-dimensional matching and running), the option value ",
 Cell[BoxData[
  ButtonBox["FourDimensional",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/FourDimensional"]], "InlineFormula",
  ExpressionUUID->"7e512b29-2e94-42d7-b370-978f70b78477"],
 " can be used:"
}], "ExampleText",
 CellID->84607603,ExpressionUUID->"de619bf6-03a8-454d-959f-b6c705a08d18"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"GreensSimplify", "[", 
   RowBox[{"op", ",", 
    RowBox[{"ReductionIdentities", "->", "FourDimensional"}]}], "]"}], "//", 
  "NiceForm"}]], "Input",
 CellLabel->"In[52]:=",
 CellID->711185565,ExpressionUUID->"c6b598ae-153c-4302-b6c0-af277938037a"],

