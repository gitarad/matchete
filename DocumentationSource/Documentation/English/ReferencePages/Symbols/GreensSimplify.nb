Notebook[{

Cell[CellGroupData[{
Cell["GreensSimplify", "ObjectName",
 CellID->1737892489,ExpressionUUID->"88ac36d1-e09f-48d1-a846-6dd7c0a696bd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1d63eadc-5b1d-430d-92ae-279ad01e6dba"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GreensSimplify",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/GreensSimplify"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "283dd4e0-2de3-40f7-9336-1f20bf99784e"],
 "\[LineSeparator]simplifies (part of) a Lagrangian to a Green's (off-shell) \
basis. "
}], "Usage",
 CellID->833979776,ExpressionUUID->"66656f78-e336-46fc-b63e-d2ca6812800f"],

Cell[TextData[{
 "The operator basis used by ",
 Cell[BoxData[
  ButtonBox["GreensSimplify",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/GreensSimplify"]], "InlineFormula",
  ExpressionUUID->"886c8019-38e6-4939-bb7a-23eb1b6b97a1"],
 " is determined from a heuristic scoring and will not typically agree with \
literature basis choices. The output is expressed in terms of the basis \
operators and ",
 Cell[BoxData[
  ButtonBox["GreensSimplify",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/GreensSimplify"]], "InlineFormula",
  ExpressionUUID->"28641946-1773-4150-96f0-974b443296df"],
 " will not attempt to reduce an expression to the minimal number of \
operators. As a result simple expressions may look more complicated after \
application of the simplification function. "
}], "Notes",
 CellID->2099536602,ExpressionUUID->"18d2fa2d-4d83-46fd-b59c-536a49161fc1"],

Cell[TextData[{
 "In addition to simplifying operators to a set of basis operators, ",
 Cell[BoxData[
  ButtonBox["GreensSimplify",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/GreensSimplify"]], "InlineFormula",
  ExpressionUUID->"22ff6a86-2b6d-4cc1-9fc5-0b8d43c01a18"],
 " also collects and simplify the coefficients in front of coefficients. "
}], "Notes",
 CellID->1893736222,ExpressionUUID->"476a93b4-c2c0-44b1-9107-60cf52694dae"],

Cell["The following options can be given: ", "Notes",
 CellID->72331263,ExpressionUUID->"1f732115-84ec-475a-80a1-faf3ab163bce"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "294fe27e-dca4-43e3-9971-8344f3cc66dc"], 
    ButtonBox["ReductionIdentities",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/ReductionIdentities"], 
    ButtonBox["dDimensional",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/dDimensional"], Cell["\<\
determines how to treat identies related to Dirac and Lorentz algebra that \
are valid only in four dimensions.\
\>", "TableText",ExpressionUUID->"e84a7d24-1bea-4fef-9bd2-28f9dc48b8cd"]}
  }]], "3ColumnTableMod",
 CellID->195793039,ExpressionUUID->"dac5d1cc-4cd6-48d6-a9c1-a3f9d33d857a"],

Cell[TextData[{
 "The option values for ",
 Cell[BoxData[
  ButtonBox["ReductionIdentities",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/ReductionIdentities"]], "InlineFormula",
  ExpressionUUID->"409b96a0-f550-4ca4-8511-f83cf128269b"],
 " are"
}], "Notes",
 CellID->622094682,ExpressionUUID->"245fc822-235c-48c3-b649-6fea3666ba87"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "16dc56a6-9371-402f-9f13-0d2958aabd2c"], 
    ButtonBox["dDimensional",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/dDimensional"], Cell["\<\
applies only the identities that are strictly valid in \[ScriptD]-dimensional \
space time. \
\>", "TableText",ExpressionUUID->"92ae3b00-bef4-4f2f-8256-9aff71824b13"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3090795a-7d38-4814-8f01-af2f0b862dce"], 
    ButtonBox["EvanescenceFree",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/EvanescenceFree"], Cell[TextData[{
     "reduces operators to a physical (four-dimensional) basis using the \
evanescent prescription and then performs a finite evanescent shift to remove \
resulting evanescent operators. This option requires that the imput is a ",
     StyleBox["full valid Lagrangian",
      FontWeight->"Bold"],
     " and not just a part.  "
    }], "TableText",ExpressionUUID->"c0a0461d-cd91-4bc8-9991-bf2767671567"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9e75ed13-0c17-4dc4-896f-12ee6bab903e"], 
    ButtonBox["Evanescent",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/Evanescent"], Cell["\<\
reduces operators to a physical (four-dimensional) basis using the evanescent \
prescription. The resulting evanescent operators are kept in the output. \
\>", "TableText",ExpressionUUID->"70365c4d-5181-4a86-a8e9-777e379ed1a1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fb8e835f-cbe7-4d13-aa99-438f249a6639"], 
    ButtonBox["FourDimensional",
     BaseStyle->"Link",
     ButtonData->"paclet:Matchete/ref/FourDimensional"], Cell[TextData[{
     "simplifies with four-dimensional identities. This is ",
     StyleBox["incompatible with other \[ScriptD]-dimensional calculations",
      FontWeight->"Bold"],
     ", such as one-loop matching."
    }], "TableText",ExpressionUUID->"df16ff5b-339e-4dd8-a97a-36bd8dcad2e9"]}
  }]], "2ColumnTableMod",
 CellID->646620032,ExpressionUUID->"ae77015f-a040-4a9a-9961-83e602844eab"]
}, Open  ]],

