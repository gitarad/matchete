Cell[TextData[{
 "In a real-scalar toy model, ",
 Cell[BoxData[
  ButtonBox["GreensSimplify",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/GreensSimplify"]], "InlineFormula",
  ExpressionUUID->"69d5ded7-2d32-4275-b5a1-ea2544d4e84f"],
 " performs integration by parts relations (a real scalar is defined with ",
 Cell[BoxData[
  ButtonBox["DefineField",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DefineField"]], "InlineFormula",
  ExpressionUUID->"32569cb8-2c19-48bc-9dec-85ffabebc9c6"],
 ")"
}], "ExampleText",
 CellID->49926713,ExpressionUUID->"f661f047-596d-4522-b9bd-c6505b442627"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DefineField", "[", 
  RowBox[{"\[Phi]", ",", "Scalar", ",", 
   RowBox[{"SelfConjugate", "\[Rule]", "True"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"-", "2"}], " ", 
    RowBox[{"\[Phi]", "[", "]"}], 
    RowBox[{"CD", "[", 
     RowBox[{"\[Mu]", ",", 
      RowBox[{"\[Phi]", "[", "]"}]}], "]"}], 
    RowBox[{"CD", "[", 
     RowBox[{"\[Mu]", ",", 
      RowBox[{"\[Phi]", "[", "]"}]}], "]"}]}], "+", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"\[Phi]", "[", "]"}], "2"], 
    RowBox[{"CD", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Nu]", ",", "\[Nu]"}], "}"}], ",", 
      RowBox[{"\[Phi]", "[", "]"}]}], "]"}]}]}], "//", "NiceForm"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "//", "GreensSimplify"}], "//", 
  "NiceForm"}], "\[IndentingNewLine]"}], "Input",
 CellLabel->"In[13]:=",
 CellID->530024857,ExpressionUUID->"5b4787e3-c917-4ea8-9afa-5391e8ec401f"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], "\[Phi]", 
     SuperscriptBox[
      FormBox[
       StyleBox[
        RowBox[{"(", 
         TemplateBox[{
           SubscriptBox["D", "\[Mu]"], "\[Phi]"},
          "RowDefault"], ")"}],
        SpanSymmetric->False],
       StandardForm], "2"]}], "+", 
    RowBox[{
     TemplateBox[{
       SuperscriptBox["D", 2], "\[Phi]"},
      "RowDefault"], 
     SuperscriptBox["\[Phi]", "2"]}]}], "StandardForm"], 
  Matchete`NiceForm]], "Output",
 CellLabel->"Out[14]//NiceForm=",
 CellID->567764329,ExpressionUUID->"c9a5a72e-7cd4-4427-8bbb-1eef6ac8c037"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{"2", 
    TemplateBox[{
      SuperscriptBox["D", 2], "\[Phi]"},
     "RowDefault"], 
    SuperscriptBox["\[Phi]", "2"]}], "StandardForm"], 
  Matchete`NiceForm]], "Output",
 CellLabel->"Out[15]//NiceForm=",
 CellID->1145233882,ExpressionUUID->"8dbb9b55-d1c4-4fc9-9d15-9c324153459f"]
}, Open  ]]
