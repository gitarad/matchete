Cell[TextData[{
 "When dealing with operators involving \[ScriptD]-dimensional Dirac algebra \
such as  (the SM definitions are loaded with ",
 Cell[BoxData[
  ButtonBox["LoadModel",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/LoadModel"]], "InlineFormula",
  ExpressionUUID->"5230ed16-5a9e-4b5b-9739-c6f1edf21870"],
 ")"
}], "ExampleText",
 CellID->498294387,ExpressionUUID->"782c72a4-d56b-488d-91e8-3474906da9ba"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"LoadModel", "[", "\"\<SM\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"op", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Bar", "[", 
      RowBox[{"e", "[", "p", "]"}], "]"}], "**", 
     RowBox[{"\[Gamma]", "[", "\[Mu]", "]"}], "**", 
     RowBox[{"\[Gamma]", "[", "\[Nu]", "]"}], "**", 
     RowBox[{"\[Gamma]", "[", "\[Rho]", "]"}], "**", 
     RowBox[{"e", "[", "r", "]"}]}], 
    RowBox[{
     RowBox[{"Bar", "[", 
      RowBox[{"e", "[", "s", "]"}], "]"}], "**", 
     RowBox[{"\[Gamma]", "[", "\[Mu]", "]"}], "**", 
     RowBox[{"\[Gamma]", "[", "\[Nu]", "]"}], "**", 
     RowBox[{"\[Gamma]", "[", "\[Rho]", "]"}], "**", 
     RowBox[{"e", "[", "t", "]"}]}]}], "//", "NiceForm"}]}]}], "Input",
 CellLabel->"In[48]:=",
 CellID->1681112305,ExpressionUUID->"daec1999-7ad3-4c27-bcf2-66b3f0365eac"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    FormBox[
     StyleBox[
      RowBox[{"(", 
       SuperscriptBox[
        OverscriptBox["e", 
         StyleBox["_",
          FontWeight->Bold]], 
        StyleBox["p",
         FontSize->10]], "\[CenterDot]", 
       RowBox[{
        SubscriptBox["\[Gamma]", 
         StyleBox["\[Mu]",
          FontSize->10]], 
        SubscriptBox["\[Gamma]", 
         StyleBox["\[Nu]",
          FontSize->10]], 
        SubscriptBox["\[Gamma]", 
         StyleBox["\[Rho]",
          FontSize->10]], 
        SubscriptBox["P", "R"]}], "\[CenterDot]", 
       SuperscriptBox["e", 
        StyleBox["r",
         FontSize->10]], ")"}],
      SpanSymmetric->False],
     StandardForm], 
    FormBox[
     StyleBox[
      RowBox[{"(", 
       SuperscriptBox[
        OverscriptBox["e", 
         StyleBox["_",
          FontWeight->Bold]], 
        StyleBox["s",
         FontSize->10]], "\[CenterDot]", 
       RowBox[{
        SubscriptBox["\[Gamma]", 
         StyleBox["\[Mu]",
          FontSize->10]], 
        SubscriptBox["\[Gamma]", 
         StyleBox["\[Nu]",
          FontSize->10]], 
        SubscriptBox["\[Gamma]", 
         StyleBox["\[Rho]",
          FontSize->10]], 
        SubscriptBox["P", "R"]}], "\[CenterDot]", 
       SuperscriptBox["e", 
        StyleBox["t",
         FontSize->10]], ")"}],
      SpanSymmetric->False],
     StandardForm]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[49]//NiceForm=",
 CellID->1978859253,ExpressionUUID->"ee6f961e-6185-4ad4-b6d7-a874acf91c18"]
}, Open  ]],

Cell["\<\
it is often insufficient to simplify using strictly \[ScriptD]-dimensional \
identities. For instance, \
\>", "ExampleText",
 CellID->608224082,ExpressionUUID->"a14669b8-cbbe-4ca1-b9f7-48d24d0c5c4e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"GreensSimplify", "[", "op", "]"}], "//", "NiceForm"}]], "Input",
 CellLabel->"In[50]:=",
