Cell[TextData[{
 "In such cases the ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ReductionIdentities",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/ReductionIdentities"], "\[Rule]", 
   "Evanescent"}]], "InlineFormula",ExpressionUUID->
  "37c56f75-3625-46db-ac78-d64847b3903c"],
 " option can be used to reduce the expression to a physical operator basis:"
}], "ExampleText",
 CellID->485880837,ExpressionUUID->"7507d6ef-76b1-4a2d-8a3f-c6768d84b023"],

Cell[CellGroupData[{

Cell[BoxData[
