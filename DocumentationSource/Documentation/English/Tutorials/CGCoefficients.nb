Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ContractCGs",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/ContractCGs"]], "InlineFormula",
  ExpressionUUID->"f297971e-4de2-412b-a713-8b4bc010c37f"],
 " is a versatile implementation of all manner of CG contractions. This \
versatility is due to contractions being performed numerically, a technique \
that is generally applicable to all possible CG contractions. However, \
numerical contractions of tensors can be computationally expensive, \
especially if the representations are large. "
}], "Text",
 CellID->1027299401,ExpressionUUID->"ad37c4a6-e6d2-4356-998f-6ea98c121c1a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Going outside the CG basis", "Subsection",
 CellID->1397868064,ExpressionUUID->"53ffb04a-3263-4d44-a2a1-397908c7ffa4"],

Cell[TextData[{
 "Finally, we see what happens when the predefined CGs are insufficient to \
identify a CG showing up in a product. In that case a new CG will simply be \
added and a message is displayed to inform the user about it. Any new CG \
defined this way can be used in ",
 Cell[BoxData[
  ButtonBox["CG",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/CG"]], "InlineFormula",ExpressionUUID->
  "1d74b341-ab77-4334-8798-a590d35473e0"],
 " objects same as any user defined CGs."
}], "Text",
 CellID->149962616,ExpressionUUID->"28b9abf7-f0f2-494b-9d44-23570178f48f"],

Cell[CellGroupData[{

Cell[TextData[{
 "An example of going outside the CG basis derived from the previously \
defined CGs is  the generator product ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["T", "A"], 
       SuperscriptBox["T", "B"]}], ")"}], "i"], "j"], TraditionalForm]],
  ExpressionUUID->"9b9b193b-89ee-4297-b2db-d7f10e5185e2"],
 " of two generators of the ",
 StyleBox["fund",
  FontWeight->"Bold"],
 " representation of ",
 StyleBox["SU3c",
  FontWeight->"Bold"],
 ": "
}], "MathCaption",
 CellID->1326063212,ExpressionUUID->"00a6d355-80c6-47c3-85a4-a57062dddae4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"t3", "[", 
     RowBox[{"a", ",", "i", ",", "k"}], "]"}], 
    RowBox[{"t3", "[", 
     RowBox[{"b", ",", "k", ",", "j"}], "]"}]}], "//", "ContractCGs"}], "//", 
  "NiceForm"}]], "Input",
 CellLabel->"In[38]:=",
 CellID->559115518,ExpressionUUID->"9faa9767-d6c2-4c03-910c-bd369138935b"],

Cell[BoxData[
 InterpretationBox["\<\"Added new CG \\!\\(\\*RowBox[{\\\"cg1\\\"}]\\) with \
indices \\!\\(\\*RowBox[{\\\"{\\\", RowBox[{\\\"adj\\\", \\\",\\\", \
\\\"fund\\\", \\\",\\\", \\\"adj\\\", \\\",\\\", RowBox[{\\\"Bar\\\", \\\"[\\\
\", \\\"fund\\\", \\\"]\\\"}]}], \\\"}\\\"}]\\)\"\>",
  StringForm[
  "Added new CG `1` with indices `2`", $CellContext`cg1, {
   Matchete`adj, Matchete`fund, Matchete`adj, 
    Matchete`Bar[Matchete`fund]}],
