     TemplateBox[{"a", "i", "b"},
      "RowDefault"],
     FontSize->10]], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[38]//NiceForm=",
 CellID->865534071,ExpressionUUID->"f3adfdf0-d062-4b86-9e00-2f3b05eb1e9b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The new CG gets a generic name, ",
 StyleBox["cg1",
  FontWeight->"Bold"],
 " in this case, the user might therefore wish to rename it for easier \
reference with ",
 Cell[BoxData[
  ButtonBox["RenameCG",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/RenameCG"]], "InlineFormula",
  ExpressionUUID->"f38ae256-d26c-4233-b964-5e37bae612d1"],
 "; however, this is purely optional and not required to use the CG."
}], "MathCaption",
 CellID->1561233747,ExpressionUUID->"d307db0f-2ffa-4e9c-9507-6dc560ffe68c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"RenameCG", "[", 
  RowBox[{"cg1", "\[Rule]", "t3t3"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"t3", "[", 
     RowBox[{"a", ",", "i", ",", "k"}], "]"}], 
    RowBox[{"t3", "[", 
     RowBox[{"b", ",", "k", ",", "j"}], "]"}]}], "//", "ContractCGs"}], "//", 
  "NiceForm"}]}], "Input",
 CellLabel->"In[39]:=",
 CellID->1700386783,ExpressionUUID->"d6f8be89-b924-4cb9-9a81-848d659f5f4b"],

Cell[BoxData[
 FormBox[
  StyleBox[
   SubsuperscriptBox["t3t3", 
    StyleBox["j",
     FontSize->10], 
    StyleBox[
     TemplateBox[{"a", "i", "b"},
      "RowDefault"],
     FontSize->10]], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[40]//NiceForm=",
 CellID->772010626,ExpressionUUID->"5e464aec-04d6-4773-819a-db3d38eeac2f"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Some detective work is typically required to figure out what a new CG is. \
Particularly if it got defined deep in some Matchete calculation outside the \
control of the user. It can also happen that a CG is defined during the \
course of an evaluation but never makes it to the output. The first clue is \
to look at the message informing about the creation of the new CG, which \
provides a list of the representation of all the indices of the new CG. In \
some simple cases the user might be able to identify the CG through the \
explicit tensor representation with ",
 Cell[BoxData[
  ButtonBox["GetCGTensor",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/GetCGTensor"]], "InlineFormula",
  ExpressionUUID->"7799b95d-3fe7-48c9-81e4-ce72837e1aa7"],
 ", although more often than not this is next to meaningless to humans (and \
basis dependent). More commonly, the new CG can be traced back by using ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ReplaceCGs",
    BaseStyle->"Link",
    ButtonData->"paclet:Matchete/ref/ReplaceCGs"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "dbea7d1d-9329-472d-9dd9-3f44a7fcbe16"],
 " to re-expand the new CG. By default ",
 Cell[BoxData[
  ButtonBox["ReplaceCGs",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/ReplaceCGs"]], "InlineFormula",
  ExpressionUUID->"98526eda-5847-42af-968f-2231a039b36e"],
 " replaces all composite CGs created both by the user an automatically. \
Using the option ",
 Cell[BoxData[
  ButtonBox["CGsToReplace",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/CGsToReplace"]], "InlineFormula",
  ExpressionUUID->"237cacc1-9e0e-4338-81a8-f0bb35391a22"],
 " (default ",
 Cell[BoxData[
  ButtonBox["All",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "ca23ac90-d826-46e6-a523-c2eecaa72720"],
 "), only the specified CGs will be replaced in an expression."
}], "Text",
 CellID->786367001,ExpressionUUID->"105f349f-b8ec-4371-b7bc-189d549dbd9e"],

Cell[CellGroupData[{

Cell[TextData[{
 "The composite CGs ",
 StyleBox["Tr4",
  FontWeight->"Bold"],
 " (defined by the user with ",
 Cell[BoxData[
  ButtonBox["DefineCompositeCG",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/DefineCompositeCG"]], "InlineFormula",
  ExpressionUUID->"d0fa461b-93b5-465a-b6e5-9e77b73bcdc7"],
 ") and ",
 StyleBox["t3t3",
  FontWeight->"Bold"],
 " (defined automatically during ",
 Cell[BoxData[
  ButtonBox["ContractCGs",
   BaseStyle->"Link",
   ButtonData->"paclet:Matchete/ref/ContractCGs"]], "InlineFormula",
  ExpressionUUID->"f6e3bfcd-8a43-4227-aa76-302560649d83"],
 ") can be replaced simultaneously or one at a time to reveal the underlying \
contraction of CGs: "
}], "MathCaption",
 CellID->949318001,ExpressionUUID->"a80c4787-958b-4a04-8b8f-d57fbd91bd02"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ReplaceCGs", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Tr4", "[", 
       RowBox[{"a", ",", "b", ",", "c", ",", "e"}], "]"}], ",", 
      RowBox[{"t3t3", "[", 
       RowBox[{"a", ",", "i", ",", "b", ",", "j"}], "]"}]}], "}"}], "]"}], "//",
    "RelabelIndices"}], "//", "NiceForm"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ReplaceCGs", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Tr4", "[", 
        RowBox[{"a", ",", "b", ",", "c", ",", "e"}], "]"}], ",", 
       RowBox[{"t3t3", "[", 
        RowBox[{"a", ",", "i", ",", "b", ",", "j"}], "]"}]}], "}"}], ",", 
     RowBox[{"CGsToReplace", "\[Rule]", 
      RowBox[{"{", "t3t3", "}"}]}]}], "]"}], "//", "RelabelIndices"}], "//", 
  "NiceForm"}]}], "Input",
 CellLabel->"In[41]:=",
 CellID->1531629244,ExpressionUUID->"3e035f93-eb9e-410e-a2f6-a10e5b9aea3d"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["t3", 
       StyleBox["y",
        FontSize->10], 
       StyleBox[
        TemplateBox[{"a", "x"},
         "RowDefault"],
        FontSize->10]], 
      SubsuperscriptBox["t3", 
       StyleBox["z",
        FontSize->10], 
       StyleBox[
        TemplateBox[{"b", "y"},
         "RowDefault"],
        FontSize->10]], 
      SubsuperscriptBox["t3", 
       StyleBox[
        SubscriptBox["x", "1"],
        FontSize->10], 
       StyleBox[
        TemplateBox[{"c", "z"},
         "RowDefault"],
        FontSize->10]], 
      SubsuperscriptBox["t3", 
       StyleBox["x",
        FontSize->10], 
       StyleBox[
        TemplateBox[{"e", 
          SubscriptBox["x", "1"]},
         "RowDefault"],
        FontSize->10]]}], ",", 
     RowBox[{
      SubsuperscriptBox["t3", 
       StyleBox["x",
        FontSize->10], 
       StyleBox[
        TemplateBox[{"a", "i"},
         "RowDefault"],
        FontSize->10]], 
      SubsuperscriptBox["t3", 
       StyleBox["j",
        FontSize->10], 
       StyleBox[
        TemplateBox[{"b", "x"},
         "RowDefault"],
        FontSize->10]]}]}], "}"}], "StandardForm"], 
  Matchete`NiceForm]], "Output",
 CellLabel->"Out[41]//NiceForm=",
 CellID->1354423416,ExpressionUUID->"ef60995a-0c86-46c1-88cb-69d5043d5507"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{"{", 
    RowBox[{
     SuperscriptBox["Tr4", 
      StyleBox[
       TemplateBox[{"a", "b", "c", "e"},
        "RowDefault"],
       FontSize->10]], ",", 
     RowBox[{
      SubsuperscriptBox["t3", 
       StyleBox["x",
        FontSize->10], 
       StyleBox[
        TemplateBox[{"a", "i"},
         "RowDefault"],
        FontSize->10]], 
      SubsuperscriptBox["t3", 
       StyleBox["j",
        FontSize->10], 
       StyleBox[
        TemplateBox[{"b", "x"},
         "RowDefault"],
        FontSize->10]]}]}], "}"}], "StandardForm"], 
  Matchete`NiceForm]], "Output",
 CellLabel->"Out[42]//NiceForm=",
 CellID->467694512,ExpressionUUID->"f4ed90cc-be96-46f0-81c9-25c3453c2438"]
}, Open  ]]
}, Open  ]],

Cell["\<\
The user might wonder what then is the reason for adding the new CG at all if \
we simply wish to deconstruct it again? The benefit is that it simplifies \
expressions, and removes all internal index contractions, which helps \
identify and collect terms in complicated expressions.\
\>", "Text",
 CellID->2098098696,ExpressionUUID->"25e1ada2-b121-4c69-acf1-3d042f754d91"],

Cell[CellGroupData[{

Cell[TextData[{
 "Having defined ",
 StyleBox["t3t3", "Input",
  FontWeight->"Bold"],
 ", it becomes active in the CG basis and it can be identified in other CG \
contractions, such as"
}], "MathCaption",
 CellID->1890811392,ExpressionUUID->"c5bf062e-dbcb-44ce-931a-484ebac5771f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"t3", "[", 
     RowBox[{"a", ",", "i", ",", "k"}], "]"}], 
    RowBox[{"t3", "[", 
     RowBox[{"c", ",", "k", ",", "l"}], "]"}], 
    RowBox[{"t3", "[", 
     RowBox[{"b", ",", "l", ",", "m"}], "]"}], 
    RowBox[{"t3", "[", 
     RowBox[{"c", ",", "m", ",", "j"}], "]"}]}], "//", "ContractCGs"}], "//", 
  "NiceForm"}]], "Input",
 CellLabel->"In[43]:=",
 CellID->404057038,ExpressionUUID->"63a4afe7-dc41-4f90-bbd7-e6ed8ff3f5f3"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{"-", 
    FractionBox["1", "6"], 
    SubsuperscriptBox["t3t3", 
     StyleBox["j",
      FontSize->10], 
     StyleBox[
      TemplateBox[{"a", "i", "b"},
       "RowDefault"],
      FontSize->10]]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[43]//NiceForm=",
 CellID->60237728,ExpressionUUID->"393164e4-d832-4cda-b88c-5d409a8d8956"]
}, Open  ]]
}, Open  ]],

Cell["\<\
When dealing with new composite CGs showing up in a calculation, it can at \
times be beneficial to go back to the beginning and add a specific suitable \
CG to the basis (with definite symmetries) rather than relying on those that \
are automatically defined. Matchete does not attempt to be clever when \
assigning new CGs but takes the first new contraction that goes outside its \
basis as a new basis element with no consideration for further \
practicalities. \
\>", "Text",
 CellID->447073332,ExpressionUUID->"4611f3dd-eaba-4479-b156-6f630d135909"],

Cell[CellGroupData[{

Cell[TextData[{
 "In place of the contraction of two ",
 StyleBox["fund",
  FontWeight->"Bold"],
 " generators, which does not poses any definite symmetry between the two \
adjoint indices, we might instead contract the generator with the ",
 StyleBox["f3",
  FontWeight->"Bold"],
 " or ",
 StyleBox["d3",
  FontWeight->"Bold"],
 " tensors. So we remove the automatically defined tensor (removing it from \
the basis) and define the two new tensors"
}], "MathCaption",
 CellID->7963293,ExpressionUUID->"f1abdeb8-5748-4f5f-b044-1968ad3b33fd"],

Cell[BoxData[{
 RowBox[{"RemoveCG", "[", "t3t3", "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCompositeCG", "[", 
  RowBox[{"tf3", ",", 
   RowBox[{"{", 
    RowBox[{"f3", ",", "t3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "i", ",", "j"}], "}"}]}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCompositeCG", "[", 
  RowBox[{"td3", ",", 
   RowBox[{"{", 
    RowBox[{"d3", ",", "t3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "i", ",", "j"}], "}"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[44]:=",
 CellID->695079337,ExpressionUUID->"c7183d38-53d9-4128-b685-b118ecd9ed9b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
This time the projection of the generator product onto the basis space is \
done exclusively in terms of CGs that we have manually defined: CGs with \
definite symmetries between the adjoint indices:\
\>", "MathCaption",
 CellID->1449729939,ExpressionUUID->"097974dc-a0d3-4d9a-b334-41a15a099905"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"t3", "[", 
     RowBox[{"a", ",", "i", ",", "k"}], "]"}], 
    RowBox[{"t3", "[", 
     RowBox[{"b", ",", "k", ",", "j"}], "]"}]}], "//", "ContractCGs"}], "//", 
  "NiceForm"}]], "Input",
 CellLabel->"In[47]:=",
 CellID->261625911,ExpressionUUID->"3b2f21f8-3bf9-46fb-aa48-aab13742698b"],

Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     SubsuperscriptBox["td3", 
      StyleBox["j",
       FontSize->10], 
      StyleBox[
       TemplateBox[{"a", "b", "i"},
        "RowDefault"],
       FontSize->10]]}], "+", 
    RowBox[{
     FractionBox["\[ImaginaryI]", "2"], 
     SubsuperscriptBox["tf3", 
      StyleBox["j",
       FontSize->10], 
      StyleBox[
       TemplateBox[{"a", "b", "i"},
        "RowDefault"],
       FontSize->10]]}], "+", 
    RowBox[{
     FractionBox["1", "6"], 
     SuperscriptBox["\[Delta]", 
      StyleBox[
       TemplateBox[{"a", "b"},
        "RowDefault"],
       FontSize->10]], 
     SubsuperscriptBox["\[Delta]", 
      StyleBox["j",
       FontSize->10], 
      StyleBox["i",
       FontSize->10]]}]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->"Out[47]//NiceForm=",
 CellID->657037245,ExpressionUUID->"e49cc6fa-a875-4740-a342-224f1132a781"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

