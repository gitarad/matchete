Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"getTestResults", "[", "tr_TestReportObject", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fields", ",", "results", ",", "abbreviations"}], "}"}], ",", 
     RowBox[{
      RowBox[{"fields", "=", 
       RowBox[{"{", 
        RowBox[{
        "\"\<TestIndex\>\"", ",", "\"\<Outcome\>\"", ",", 
         "\"\<AbsoluteTimeUsed\>\"", ",", "\"\<MemoryUsed\>\"", ",", 
         "\"\<TestID\>\""}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"abbreviations", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<TestIndex\>\"", "\[Rule]", "\"\<Idx\>\""}], ",", 
         RowBox[{
         "\"\<AbsoluteTimeUsed\>\"", "\[Rule]", "\"\<Time [s]\>\""}]}], 
        "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"results", "=", 
       RowBox[{"ReplaceRepeated", "[", 
        RowBox[{
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#1", "[", "#2", "]"}], "&"}], ",", 
           RowBox[{"Values", "[", 
            RowBox[{"tr", "[", "\"\<TestResults\>\"", "]"}], "]"}], ",", 
           "fields"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x_Quantity", "\[RuleDelayed]", 
            RowBox[{"QuantityMagnitude", "[", "x", "]"}]}], ",", 
           RowBox[{"x_Real", "\[RuleDelayed]", 
            RowBox[{"Round", "[", 
             RowBox[{"x", ",", "0.001"}], "]"}]}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"fields", "/.", "abbreviations"}], "}"}], ",", "results"}], 
       "]"}]}]}], "]"}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"printTestResults", "[", "tr_TestReportObject", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"list", ",", "indx", ",", "time", ",", "noTests"}], "}"}], ",", 
    RowBox[{
     RowBox[{"list", "=", 
      RowBox[{"getTestResults", "[", "tr", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"indx", "=", 
      RowBox[{"MapIndexed", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"#1", ",", 
             RowBox[{
             "\"\<Failure\>\"", "|", "\"\<MessagesFailure\>\"", "|", 
              "\"\<Error\>\""}]}], "]"}], ",", 
           RowBox[{"First", "[", "#2", "]"}], ",", "Nothing"}], "]"}], "&"}], 
        ",", "list"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"time", "=", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"QuantityMagnitude", "[", 
         RowBox[{"tr", "[", "\"\<TimeElapsed\>\"", "]"}], "]"}], ",", 
        "0.01"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"noTests", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"tr", "[", "\"\<TestResults\>\"", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
      "noTests", ",", "\"\< tests run in \>\"", ",", "time", ",", 
       "\"\< seconds.\>\""}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"TrueQ", "@", 
        RowBox[{"tr", "[", "\"\<AllTestsSucceeded\>\"", "]"}]}], ",", 
       RowBox[{"Print", "[", "\"\<All tests succeeded!\>\"", "]"}], ",", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{
          RowBox[{"tr", "[", "\"\<TestsFailedCount\>\"", "]"}], ",", 
          "\"\< tests failed!\>\""}], "]"}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "@", 
      RowBox[{"Grid", "[", 
       RowBox[{"list", ",", 
        RowBox[{"Alignment", "\[Rule]", "Left"}], ",", 
        RowBox[{"Dividers", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"None", ",", 
           RowBox[{"{", 
            RowBox[{"2", "\[Rule]", "True"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"Background", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"None", ",", 
           RowBox[{"Thread", "[", 
            RowBox[{"indx", "\[Rule]", "Pink"}], "]"}]}], "}"}]}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", "tr"}]}], "]"}]}]}], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"c5846aa9-1bf4-425d-881b-234eff3a5d80"]
}, Closed]],

